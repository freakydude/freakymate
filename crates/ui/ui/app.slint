// Main window: status bar, navigation, current page and overlays.

import { Theme } from "theme.slint";
import { Actions, Backlight, Confirm, Dialogs, EddyDialog, MeshDialogs, MmuDialogs, Navigation, Network, Page, Printer, SpoolPicker, UiSettings } from "state.slint";
import { NavRail, StatusBar } from "components/chrome.slint";
import { CalibrationDialog } from "components/calibration-dialog.slint";
import { ConfirmDialog } from "components/confirm-dialog.slint";
import { MessagesFlyout } from "components/messages-flyout.slint";
import { SpoolDialog } from "components/spool-dialog.slint";
import { HistoryDialog } from "components/history.slint";
import { BedMeshDialog, BedMeshProfilesDialog } from "components/bed-mesh.slint";
import { EddyProbeDialog } from "components/eddy-probe-dialog.slint";
import { LightPanel } from "components/light.slint";
import { PrintPage } from "pages/print.slint";
import { MotionPage } from "pages/motion.slint";
import { TemperaturePage } from "pages/temperature.slint";
import { FilamentPage } from "pages/filament.slint";
import { ChangerPage } from "pages/changer.slint";
import { ConsolePage } from "pages/console.slint";
import { SystemPage } from "pages/system.slint";
import { UpdatesPage } from "pages/updates.slint";
import { SettingsPage } from "pages/settings.slint";
import { NetworkPage } from "pages/network-page.slint";
import { ConnectionPage } from "pages/connection.slint";

export { Actions, Backlight, Confirm, EddyDialog, MeshDialogs, MmuDialogs, Navigation, Network, Page, Printer, SpoolPicker, UiSettings }
export { ChartLabel, PidValueItem, FilamentPathItem, PathPartItem, PathPartKind, FileItem, HeaterItem, HeadItem, SensorItem, FanItem, LedItem, LedEffectItem, TuningItem, FilamentSensorItem, MmuGateItem, MmuGatePage, MmuPageRange, MmuSensorItem, AfcHubReturnItem, AfcToolItem, SpoolItem, PrintObjectItem, BedMapItem, BedMeshMap, MeshCellItem, MeshFrameItem, ConsoleItem, MessageItem, MacroItem, MacroParamItem, PowerItem, UpdateItem, PresetItem, ScrewItem, EddyValue, WifiItem, WiredItem, HostInterfaceItem } from "state.slint";

export component AppWindow inherits Window {
    title: "Sailhand";
    icon: @image-url("../../../assets/logo/sailhand.svg");
    preferred-width: 800px;
    preferred-height: 480px;
    // The layout is made for 800x480 and needs that room: a window is never smaller, only larger. Fullscreen fits
    // the layout to any display instead (`display.rs`).
    min-width: 800px;
    min-height: 480px;
    // Started with `--fullscreen`: no frame, also when fullscreen is switched off (`app.rs`).
    in property <bool> kiosk;
    no-frame: root.kiosk;
    background: Theme.background;
    default-font-size: Theme.font-normal;
    // Edges the system draws over (Android: navigation bar, camera cutout); the layout stays clear of them, and Rust
    // fits the design size into the rest (`display.rs`). Zero on the desktop.
    out property <length> covered-width: self.safe-area-insets.left + self.safe-area-insets.right;
    out property <length> covered-height: self.safe-area-insets.top + self.safe-area-insets.bottom;

    // Pages that are useful even without a ready printer.
    property <bool> page-works-offline: Navigation.page == Page.system || Navigation.page == Page.settings
        || Navigation.page == Page.network
        || ((Navigation.page == Page.console || Navigation.page == Page.updates) && Printer.is-connected);
    property <bool> network-visible: Navigation.page == Page.network;
    property <bool> printer-ready: Printer.ready;
    property <bool> motion-locked: Printer.motion-locked;

    changed network-visible => { Network.watch(self.network-visible); }
    // A print that starts (here or elsewhere) must not get the moves of an open dialog or confirmation: they close. The
    // Filament page stays with its moves locked, the Motion page shows Tune only.
    changed motion-locked => {
        if (self.motion-locked && (Navigation.page == Page.filament || Navigation.page == Page.motion)) {
            Dialogs.dismiss();
        }
    }
    // Without Moonraker or Klipper the dialogs of the printer pages no longer apply; they close like a cancel. The
    // pages that work offline keep theirs (Moonraker address, Wi-Fi password).
    changed printer-ready => {
        if (!self.printer-ready && !self.page-works-offline) { Dialogs.dismiss(); }
    }

    VerticalLayout {
        // Standby draws nothing but the black cover below.
        visible: !Backlight.off;
        padding-left: root.safe-area-insets.left;
        padding-top: root.safe-area-insets.top;
        padding-right: root.safe-area-insets.right;
        padding-bottom: root.safe-area-insets.bottom;
        StatusBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            NavRail { }
            Rectangle {
                horizontal-stretch: 1;
                // The window sizes the content area, not the page in it: an element with `x` and `y` does not pass
                // its size constraints to its parent (since edition 1.19 an `if` page would).
                Rectangle {
                    x: 0;
                    y: 0;
                    if Navigation.page == Page.print: PrintPage { }
                    if Navigation.page == Page.motion: MotionPage { }
                    if Navigation.page == Page.temperature: TemperaturePage { }
                    if Navigation.page == Page.filament: FilamentPage { }
                    if Navigation.page == Page.changer: ChangerPage { }
                    if Navigation.page == Page.console: ConsolePage { }
                    if Navigation.page == Page.system: SystemPage { }
                    if Navigation.page == Page.updates: UpdatesPage { }
                    if Navigation.page == Page.settings: SettingsPage { }
                    if Navigation.page == Page.network: NetworkPage { }
                    if !Printer.ready && !root.page-works-offline: ConnectionPage { }
                }
                // Dialogs cover only the content area: the status bar and the navigation stay usable, and a tap
                // there cancels the dialog (`Dialogs.dismiss`).
                HistoryDialog { }
                SpoolDialog { }
                CalibrationDialog { }
                BedMeshDialog { }
                BedMeshProfilesDialog { }
                EddyProbeDialog { }
                ConfirmDialog { }
            }
        }
    }

    if Navigation.light-open: LightPanel {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: parent.width - root.covered-width;
        height: parent.height - root.covered-height;
    }

    if Navigation.messages-open: MessagesFlyout {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: parent.width - root.covered-width;
        height: parent.height - root.covered-height;
    }

    // Standby: the backlight is off as well; Rust swallows the touches that wake the screen.
    if Backlight.off: Rectangle {
        background: black;
        TouchArea { }
    }
}
