// Shared data between Rust and UI. Rust writes `Printer` and `UiSettings`, the UI calls `Actions`.

import { Icons } from "icons.slint";

// `updates`, `network`, `console` and `settings` (the Display tab) are tabs of the system pages.
export enum Page { print, move, temperature, tune, filament, console, system, settings, updates, network }

export struct HeaterItem {
    object: string,
    label: string,
    temperature: float,
    target: float,
    power: float,
    // Target is below Klipper's max_temp.
    can-raise: bool,
    // The targets Klipper takes (min_temp to max_temp), as a note for typing one; empty without max_temp.
    target-range: string,
    // The temperature the spool in use recommends, when the target is off from it; empty otherwise.
    spool-hint: string,
    // Moonraker keeps its temperature history, so a tap can show it.
    has-history: bool,
}

export struct SensorItem {
    object: string,
    label: string,
    temperature: float,
    // false while the sensor has no value, e.g. a stepper driver that is switched off.
    known: bool,
    // Moonraker keeps its temperature history, so a tap can show it.
    has-history: bool,
}

// A fan. `kind`: part | generic | heater | controller; only part and generic fans can be set.
export struct FanItem {
    object: string,
    label: string,
    kind: string,
    controllable: bool,
    // 0 to 100.
    speed: float,
    // Measured speed as text ("2800 rpm"), empty without a tachometer.
    rpm: string,
    // Should turn, but the tachometer has reported 0 rpm since the spin-up time.
    stalled: bool,
}

export struct LedItem {
    object: string,
    label: string,
    on: bool,
    // Brightness from 0 to 100, of a Klipper LED its brightest channel; unknown for a WLED strip after a preset.
    level-known: bool,
    level: float,
}

// An effect of the led_effect plugin.
export struct LedEffectItem {
    name: string,
    label: string,
    enabled: bool,
}

// A motion or extrusion value of the expert tab; `id` names it (e.g. max_accel), the texts are formatted.
export struct TuningItem {
    id: string,
    value: string,
    configured: string,
    changed: bool,
    can-reset: bool,
}

export struct FilamentSensorItem {
    label: string,
    enabled: bool,
    detected: bool,
}

// One gate of the MMU. `availability`: unknown | empty | available | buffered.
export struct MmuGateItem {
    index: int,
    availability: string,
    name: string,
    material: string,
    color: color,
    has-color: bool,
    // Spoolman's multi-colour filaments: the second and third colour, and how many colours there are (0 to 3).
    color-2: color,
    color-3: color,
    color-count: int,
    // The colours follow each other along the filament instead of lying side by side.
    longitudinal: bool,
    // Tools that take their filament from this gate, as "T0 T3"; empty without one.
    tools: string,
    // EndlessSpool group of the gate, -1 if Happy Hare reports none.
    group: int,
    selected: bool,
    // Remaining filament of the spool in the gate (for example "613 g"), empty without Spoolman or spool.
    spool-text: string,
    spool-low: bool,
    // Spoolman id of the spool in the gate, -1 for none.
    spool-id: int,
}

// A tool of the MMU and the gate it takes its filament from (Happy Hare's tool-to-gate map).
export struct MmuToolItem {
    tool: int,
    gate: int,
}

// A label of the temperature chart at `position`, a share from 0 to 1 along its axis.
export struct ChartLabel {
    text: string,
    position: float,
}

// The way of the filament of the selected gate (Happy Hare's `filament_pos`, see `FilamentPath`). Sensors: -1 not
// fitted, 0 free, 1 triggered; in order along the way: gate entry, gate exit, extruder, toolhead. `bowden-progress`
// is 0 to 1 during a move through the bowden, -1 otherwise. The colours are those of the spool, as for `ColorBar`.
export struct FilamentPathItem {
    position: int,
    direction: int,
    distance: string,
    gate-label: string,
    bowden-progress: float,
    gate-entry-sensor: int,
    gate-sensor: int,
    extruder-sensor: int,
    toolhead-sensor: int,
    color: color,
    color-2: color,
    color-3: color,
    color-count: int,
    longitudinal: bool,
}

// A spool of Spoolman in the picker. `place`: where it sits ("Gate 2", "In use") or empty.
export struct SpoolItem {
    id: int,
    title: string,
    material: string,
    // What is left, e.g. "613 g"; empty if Spoolman does not know.
    remaining: string,
    color: color,
    color-2: color,
    color-3: color,
    // 0 to 3 colours
    color-count: int,
    longitudinal: bool,
    place: string,
    low: bool,
}

// A sensor of the MMU. `state`: disabled | open | triggered.
export struct MmuSensorItem {
    label: string,
    state: string,
}

export struct PrintObjectItem {
    name: string,
    excluded: bool,
    // Klipper prints it right now.
    printing: bool,
    // Outline on the bed map as path commands in the view box of `BedMapItem`; empty without the map.
    outline: string,
}

// View box of the bed map: the bed in mm, Y upwards; `grid` as path commands.
export struct BedMapItem {
    shown: bool,
    width: float,
    depth: float,
    grid: string,
}

// The active bed mesh, back at the top: a dense mesh as a picture of one pixel per probed point, a small one as cells. `aspect` is width to depth of the
// measured area; `limit` the end of the colour scale on both sides of 0; `filled`: corners of a round bed, not probed.
export struct BedMeshMap {
    shown: bool,
    image: image,
    columns: int,
    rows: int,
    aspect: float,
    range: string,
    lowest: string,
    highest: string,
    limit: string,
    averaged: int,
    filled: bool,
}

// A cell of a small mesh map with its value, counted from the top left; `dark` text on a light cell.
export struct MeshCellItem {
    column: int,
    row: int,
    text: string,
    colour: color,
    dark: bool,
}

// The points a faulty region replaced with the average around it, counted from the top left.
export struct MeshFrameItem {
    column: int,
    row: int,
    columns: int,
    rows: int,
}

// Texts of a file row; an empty text is a fact the file does not have.
// One screw from the last SCREWS_TILT_CALCULATE.
export struct ScrewItem {
    name: string,
    // Turns as Klipper reports them ("01:15" = one and a quarter turns); empty for the base screw.
    turns: string,
    clockwise: bool,
    is-base: bool,
}

export struct FileItem {
    path: string,
    name: string,
    modified: string,
    // The slicer's filament type, one per tool for files with several (`PLA;PETG`).
    material: string,
    // Filament the print takes, e.g. "52 g" or "~270 g".
    weight: string,
    nozzle: string,
    time: string,
    extruder-temperature: string,
    bed-temperature: string,
    chamber-temperature: string,
    thumbnail: image,
    has-thumbnail: bool,
    // False for a file that has no thumbnail: its row then starts with the text.
    show-thumbnail: bool,
}

export struct ConsoleItem {
    text: string,
    time: string,
    is-command: bool,
    is-error: bool,
}

export struct MessageItem {
    text: string,
    time: string,
    is-error: bool,
    top: length,
    height: length,
}

export struct MacroItem {
    name: string,
    visible: bool,
}

// One parameter of a macro in the run form; `placeholder` is the Klipper default, used when `value` stays empty.
export struct MacroParamItem {
    name: string,
    placeholder: string,
    value: string,
    // The default is a number: the field opens the numeric keypad.
    numeric: bool,
}

export struct PowerItem {
    name: string,
    on: bool,
    locked: bool,
}

export struct UpdateItem {
    name: string,
    version: string,
    detail: string,
    has-update: bool,
    up-to-date: bool,
}

export struct PresetItem {
    name: string,
    extruder: float,
    bed: float,
}

export struct WifiItem {
    ssid: string,
    // Signal strength as bars 1..3.
    bars: int,
    secured: bool,
    supported: bool,
    known: bool,
    active: bool,
    // false: saved network that is currently not received.
    in-range: bool,
}

export struct WiredItem {
    interface: string,
    cable: bool,
    connected: bool,
    address: string,
}

export struct HostInterfaceItem {
    name: string,
    wireless: bool,
    addresses: string,
    mac: string,
}

export global Printer {
    // Connection: connection = connecting | connected | disconnected | login-required; klippy-state as in Moonraker.
    in property <string> connection: "connecting";
    in property <string> klippy-state: "disconnected";
    in property <string> klippy-message;
    in property <string> endpoint;
    in property <bool> ready;
    // How the display got into Moonraker: as the user logged in here, with the API key of the credentials file,
    // or neither (Moonraker trusts this machine).
    in property <string> login-user;
    in property <bool> api-key;
    // Moonraker's reason for refusing the last login; empty once a login is no longer asked for.
    in property <string> login-error;

    // Print job (print_stats.state)
    in property <string> print-state: "standby";
    // Machine activity (idle_timeout.state): ready | busy | idle
    in property <string> activity: "ready";
    // A command from here that waits long for its answer (homing, leveling, an update); "" if none.
    in property <string> running-command;
    in property <string> filename;
    in property <string> job-name;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> eta;
    in property <string> layers;
    // Height of the current layer and of the object, e.g. "2.40 / 24.0 mm"; empty if neither is known.
    in property <string> print-heights;
    in property <string> filament;
    // When a finished job ended, from the job history; "-" if unknown.
    in property <string> ended;
    // What the sources state about a pause or an error, one fact per line; empty if nothing is stated.
    in property <string> interruption-text;
    // A pause at a layer can be planned with Mainsail's macros (only while the slicer reports the layers).
    in property <bool> layer-pause-next;
    in property <bool> layer-pause-at;
    in property <int> current-layer;
    // 0 if the slicer does not report the number of layers.
    in property <int> total-layers;
    // The macros' variables tell what is planned; without them the plan is not known.
    in property <bool> layer-pause-plan-known;
    // The planned pause in a word: "next" or the layer; empty if nothing is planned or not known.
    in property <string> layer-pause-planned;
    in property <image> job-thumbnail;
    in property <bool> has-job-thumbnail;

    // Motion
    in property <float> position-x;
    in property <float> position-y;
    in property <float> position-z;
    in property <bool> homed-x;
    in property <bool> homed-y;
    in property <bool> homed-z;
    in property <float> z-offset;
    in property <float> speed-factor: 100;
    in property <float> live-velocity;
    in property <float> live-flow;

    // Temperatures and fans
    in property <[HeaterItem]> heaters;
    in property <[SensorItem]> sensors;
    in property <float> nozzle-temperature;
    in property <float> nozzle-target;
    in property <bool> has-bed;
    in property <float> bed-temperature;
    in property <float> bed-target;
    // Part fan first, then the other fans.
    in property <[FanItem]> fans;
    in property <[LedItem]> leds;
    in property <[LedEffectItem]> led-effects;
    // The main light (chamber or case light): there is one, its name, and whether it is on.
    in property <bool> has-light;
    in property <string> light-name;
    in property <bool> light-on;
    in property <[TuningItem]> tuning;
    // Temperature history of one heater or sensor, drawn as SVG path commands in a 1000 x 1000 view box.
    in property <string> history-title;
    in property <string> history-current;
    in property <string> history-temperature-path;
    in property <string> history-target-path;
    in property <string> history-power-path;
    // Grid of the chart: lines as path commands in the same view box, and their labels at a share (0 to 1) of the
    // height from the top or of the width from the left.
    in property <string> history-grid-path;
    in property <[ChartLabel]> history-temperature-labels;
    in property <[ChartLabel]> history-time-labels;
    in property <bool> can-extrude;
    // Lengths for extruding by hand that Klipper accepts (`max_extrude_only_distance`).
    in property <[float]> extrude-lengths: [5, 10, 25, 50];
    in property <[FilamentSensorItem]> filament-sensors;
    // Objects of the running print; excluded ones cannot be printed again.
    in property <[PrintObjectItem]> print-objects;
    // The bed the objects lie on; not shown if the slicer did not tell where they are.
    in property <BedMapItem> bed-map;
    // Happy Hare (4.1 or newer). Without it the Filament page has no MMU tabs.
    in property <bool> has-mmu;
    in property <bool> mmu-unsupported;
    in property <[MmuGateItem]> mmu-gates;
    in property <[MmuSensorItem]> mmu-sensors;
    // loaded | unloaded | unknown
    in property <string> mmu-filament;
    // Klipper's action text, for example "Idle" or "Loading".
    in property <string> mmu-action;
    // Selected gate and tool, -1 for none or unknown.
    in property <int> mmu-gate: -1;
    in property <int> mmu-tool: -1;
    // The bypass is selected instead of a gate: filament fed by hand past the gates.
    in property <bool> mmu-bypass;
    // Every tool with its gate, in tool order.
    in property <[MmuToolItem]> mmu-tools;
    // EndlessSpool: on a runout Happy Hare continues with the next gate of the same group.
    in property <bool> mmu-endless-spool;
    in property <bool> mmu-paused;
    in property <bool> mmu-locked;
    in property <bool> mmu-homed;
    // Position of the selector servo: up, down, move or unknown; empty when the selector has no servo.
    in property <string> mmu-servo;
    in property <bool> mmu-has-buffer;
    // compressed | neutral | tension | inactive | disabled
    in property <string> mmu-buffer-state;
    // -1 (tension) over 0 (neutral) to +1 (compressed).
    in property <float> mmu-buffer-bias;
    // off | ready | monitoring | boosting (tangle prevention raises the gear current) | triggered
    in property <string> mmu-flowguard-state;
    in property <string> mmu-flowguard-detail;
    // Percent from the encoder, -1 without an encoder.
    in property <float> mmu-flow-rate: -1;

    // What the sources of this printer offer (see Sources in the core)
    in property <bool> can-quad-gantry-level;
    in property <bool> can-z-tilt;
    in property <bool> has-probe;
    in property <bool> has-load-macro;
    in property <bool> has-unload-macro;
    in property <bool> has-power;
    in property <bool> has-update-manager;
    in property <bool> save-config-pending;
    // What SAVE_CONFIG would write, one entry per section: "probe: z_offset = 0.550 · bed_mesh default: 8 values".
    in property <string> pending-config;
    in property <string> leveling-state;

    // Calibration (see CalibrationSetup and CalibrationState in the core)
    in property <bool> has-bed-mesh;
    in property <bool> has-screws-tilt;
    in property <bool> has-bed-screws;
    // How the Z height is found by paper test: probe | endstop, empty if neither.
    in property <string> z-calibration;
    // The active mesh profile, empty without one.
    in property <string> bed-mesh-active;
    in property <[string]> bed-mesh-profiles;
    in property <BedMeshMap> bed-mesh-map;
    in property <[MeshCellItem]> bed-mesh-cells;
    in property <[MeshFrameItem]> bed-mesh-frames;
    in property <[ScrewItem]> screw-results;
    // The mode Klipper waits in until ACCEPT or ABORT: manual-probe | bed-screws, empty if none.
    in property <string> calibration-mode;
    // manual-probe: the height now and the nearest heights tried below and above (empty if none).
    in property <string> probe-z;
    in property <string> probe-z-lower;
    in property <string> probe-z-upper;
    // bed-screws: the screw to adjust, whether this is the fine round, accepted screws in a row and their number.
    in property <string> bed-screw;
    in property <bool> bed-screw-fine;
    in property <int> bed-screws-accepted;
    in property <int> bed-screws-count;

    // Lists
    in property <[string]> macros;
    // Every macro of the printer with its visibility, for the settings.
    in property <[MacroItem]> macro-items;
    // Parameter form of the macro chosen in the console.
    in property <string> macro-form-name;
    in property <[MacroParamItem]> macro-form;
    // Spoolman: configured in Moonraker, and not reachable although it is.
    in property <bool> has-spoolman;
    in property <bool> spoolman-offline;
    in property <int> spoolman-pending;
    // The spool in use: that of the selected gate, or the active spool of a printer without MMU.
    in property <bool> has-spool;
    // Spoolman id of the spool in use, -1 for none.
    in property <int> spool-id: -1;
    in property <string> spool-title;
    in property <string> spool-material;
    // What is left of the spool, for example "613 g".
    in property <string> spool-weight;
    in property <color> spool-color;
    in property <color> spool-color-2;
    in property <color> spool-color-3;
    // 0 to 3 colours
    in property <int> spool-color-count;
    in property <bool> spool-longitudinal;
    // Where the filament of the selected gate is, for the drawing of its way.
    in property <FilamentPathItem> mmu-path;
    in property <bool> spool-low;
    // Heating to what the spool in use recommends.
    in property <bool> has-spool-preset;
    in property <string> spool-preset-text;
    in property <[SpoolItem]> spools;
    in property <bool> spools-loading;
    in property <[FileItem]> files;
    in property <bool> files-loading;
    in property <[ConsoleItem]> console;
    in property <[PowerItem]> power-devices;
    in property <[UpdateItem]> updates;
    // How many of them have an update waiting.
    in property <int> updates-available;

    in property <string> clock;
    // Status bar: the message it shows (first line), and the flyout list, newest first.
    in property <string> status-message;
    in property <bool> status-message-error;
    in property <bool> status-message-visible;
    in property <[MessageItem]> messages;
    in property <length> messages-height;

    out property <bool> is-printing: print-state == "printing" || print-state == "paused";
    // Moving and extruding are allowed while paused, e.g. to change the filament; a running print locks them.
    out property <bool> motion-locked: print-state == "printing";
    // Restarts, reboots and updates would abort a print or a running command (idle_timeout "Printing").
    // After a shutdown the last print state stays, but nothing runs any more and a restart is the way out.
    out property <bool> host-actions-locked: klippy-state == "ready" && (is-printing || activity == "busy");
    out property <bool> homed-xy: homed-x && homed-y;
}

export global UiSettings {
    in-out property <string> moonraker;
    in-out property <bool> fullscreen;
    // The console leaves out Klipper's temperature reports while it waits for a heater.
    in-out property <bool> hide-temperature-reports: true;
    in-out property <float> move-step: 10;
    in-out property <float> z-offset-step: 0.025;
    in-out property <float> temperature-step: 5;
    in-out property <float> extrude-length: 10;
    in-out property <float> extrude-speed: 5;
    in-out property <[PresetItem]> presets;
    in property <string> settings-file;
    in property <string> version;

    // Rust saves after every change.
    callback steps-changed();
    callback moonraker-entered(string);
    callback fullscreen-toggled(bool);
    callback hide-temperature-reports-toggled(bool);
}

export global Actions {
    callback home(bool, bool, bool);
    callback jog(string, float);
    callback disable-motors();
    callback level();
    callback set-heater(string, float);
    // + or − by the step (with sign); respects Klipper's min_temp/max_temp.
    callback step-heater(string, float);
    callback apply-preset(int);
    callback cool-down();
    // Fan by Klipper object name, 0 to 100.
    callback set-fan(string, float);
    // White light of an LED, 0 to 100.
    callback set-light(string, float);
    callback toggle-light();
    callback set-led-effect(string, bool);
    // A value of the expert tab by id: one step (direction 1 or -1), or back to the configuration.
    callback step-tuning(string, float);
    callback reset-tuning(string);
    // Temperature history of a heater or sensor (Klipper object name) in an overlay.
    callback open-history(string);
    callback close-history();
    callback adjust-z-offset(float);
    callback reset-z-offset();
    callback apply-z-offset();
    callback save-config();
    callback calibrate-bed-mesh();
    callback load-bed-mesh(string);
    callback clear-bed-mesh();
    callback save-bed-mesh(string);
    callback remove-bed-mesh(string);
    // Why a typed name cannot be saved, or that it overwrites a profile; empty if neither.
    pure callback bed-mesh-name-hint(string) -> string;
    callback calculate-screws-tilt();
    callback adjust-bed-screws();
    // PROBE_CALIBRATE or Z_ENDSTOP_CALIBRATE, whichever the printer has.
    callback calibrate-z();
    // Within the manual probe: a relative move in mm; bisect-z goes halfway up (1) or down (-1) to the nearest
    // height tried.
    callback test-z(float);
    callback bisect-z(int);
    callback accept-calibration();
    callback screw-adjusted();
    callback abort-calibration();
    callback set-speed-factor(float);
    callback extrude(float, float);
    callback load-filament();
    callback unload-filament();
    callback run-macro(string);
    callback exclude-object(string);
    // User and password; only Moonraker sees the password.
    callback log-in(string, string);
    callback log-out();
    // The index of the print object under a tap on the bed map, or -1: position and the finger's reach as shares of
    // the map's width and height, from the top left.
    callback print-object-at(float, float, float) -> int;
    callback mmu-select-gate(int);
    callback mmu-load();
    // Selects the gate and loads it.
    callback mmu-load-gate(int);
    callback mmu-unload();
    callback mmu-home();
    callback mmu-eject(int);
    callback mmu-recover();
    callback mmu-unlock();
    callback mmu-motors-off();
    callback mmu-check-gate(int);
    callback mmu-check-all-gates();
    callback mmu-preload(int);
    callback mmu-servo-up();
    callback mmu-servo-down();
    callback mmu-select-bypass();
    // Selects the bypass and loads the filament fed into it.
    callback mmu-load-bypass();
    // The tool takes its filament from the gate: (tool, gate).
    callback mmu-map-tool(int, int);
    callback mmu-reset-tool-map();
    callback mmu-set-endless-spool(bool);
    // Moves a gate into an EndlessSpool group: (gate, group).
    callback mmu-set-endless-spool-group(int, int);
    // Material or colour of a gate in Happy Hare's gate map, for printers without Spoolman.
    callback set-gate-material(int, string);
    callback set-gate-color(int, color);
    callback run-gcode(string);
    callback refresh-files();
    callback start-print(string);
    callback pause-print();
    callback resume-print();
    callback cancel-print();
    callback pause-at-layer(int);
    callback clear-layer-pause();
    // The height a layer ahead will have, e.g. "~10.00 mm"; empty if it cannot be told.
    pure callback height-at-layer(int) -> string;
    callback emergency-stop();
    callback restart-klipper();
    callback firmware-restart();
    callback refresh-system();
    callback set-power(string, bool);
    callback restart-service(string);
    callback reboot-host();
    callback shutdown-host();
    callback refresh-updates();
    callback upgrade(string);
    callback load-console();
    callback clear-console();
    callback messages-seen();
    callback messages-clear();
    // A key of the on-screen keyboard (the text it types, or a special key such as Key.Backspace); the focused field
    // handles it like a key of a physical keyboard.
    callback press-key(string);
    callback set-macro-visible(string, bool);
    callback macro-has-params(string) -> bool;
    // Spoolman. `gate` is -1 for a printer without MMU.
    callback load-spools();
    callback set-active-spool(int);
    callback assign-gate-spool(int, int);
    // Spool id and the gross weight in grams as typed.
    callback measure-spool(int, string);
    callback apply-spool-preset();
    // What differs between a file and the spools, as lines of text for the confirmation; empty if nothing.
    pure callback print-hints(string) -> string;
    // Klipper would refuse the typed target of a heater (Klipper object, text as typed); false while it is no number.
    pure callback heater-target-outside(string, string) -> bool;
    callback open-macro-form(string);
    callback set-macro-param(int, string);
    callback macro-form-script() -> string;
}

// Networks of the host freakymate runs on. Rust writes the state, the UI calls the callbacks.
export global Network {
    // Changes are possible: NetworkManager present and Moonraker runs on this host.
    in property <bool> managed;
    // Moonraker runs on this host (otherwise only the printer host's interfaces are shown).
    in property <bool> local;
    in property <string> unavailable-reason;
    in property <bool> wifi-present;
    in property <bool> wifi-enabled;
    in property <string> active-ssid;
    in property <string> wifi-address;
    in property <string> busy;
    in property <[WifiItem]> networks;
    in property <[WiredItem]> wired;
    in property <[HostInterfaceItem]> host-interfaces;

    // Connection waiting for confirmation while a print is running.
    in-out property <string> pending-ssid;
    in-out property <string> pending-password;
    in-out property <bool> pending-hidden;

    callback refresh();
    // The network tab is shown or hidden; NetworkManager is only read regularly while it is visible.
    callback watch(bool);
    callback scan();
    callback connect(string, string, bool);
    callback disconnect();
    callback forget(string);
    callback set-wifi-enabled(bool);
    callback set-wired(string, bool);

    public function connect-pending() {
        self.connect(self.pending-ssid, self.pending-password, self.pending-hidden);
        self.pending-password = "";
    }
}

// The dialog to pick a spool, weigh it, or assign it to a gate.
export global SpoolPicker {
    in-out property <bool> open;
    // The gate to assign a spool to, -1 for the active spool of a printer without MMU.
    in-out property <int> gate: -1;
    // The spool the gate (or the printer) has now, -1 for none; the dialog opens with it selected.
    in-out property <int> current: -1;

    public function show(gate: int, current: int) {
        self.gate = gate;
        self.current = current;
        self.open = true;
        Actions.load-spools();
    }
}

// The dialogs of the Gates tab: the gate a tap opened (-1 for none), or the bypass.
export global MmuDialogs {
    in-out property <int> gate: -1;
    in-out property <bool> bypass-open;
}

// Tabs of the Filament page; without an MMU it shows the extruder alone.
export enum FilamentTab { gates, extruder, tools, service }

export global Navigation {
    in-out property <Page> page: Page.print;
    in-out property <bool> files-open;
    in-out property <bool> messages-open;
    // Filament page; with an MMU it opens on the Gates tab.
    in-out property <FilamentTab> filament-tab;
    // Page of gate tiles the Gates tab shows, counted from 0.
    in-out property <int> mmu-page;
    // Thermal page: 0 = heaters, 1 = fans, 2 = sensors.
    in-out property <int> heat-tab;
    // Tune page: 0 = basics, 1 = expert; the navigation rail opens the basics.
    in-out property <int> tune-tab;
    // 0 move, 1 calibrate.
    in-out property <int> move-tab;
    in-out property <bool> history-open;
    // Width to height of the drawing area of the temperature chart; the chart's lines are drawn for this shape.
    in-out property <float> history-aspect: 2;
    // The light panel at the light symbol of the status bar.
    in-out property <bool> light-open;

    // A tap on a temperature reading leads to the heaters; a quiet shortcut, not styled as a button.
    public function show-heaters() {
        self.files-open = false;
        self.heat-tab = 0;
        self.page = Page.temperature;
    }
}

// Confirmation dialog: pages set text and action, `execute` runs the action after OK.
export global Confirm {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> action;
    in-out property <string> argument;
    in-out property <bool> danger;

    public function ask(title: string, message: string, action: string, argument: string, danger: bool) {
        self.title = title;
        self.message = message;
        self.action = action;
        self.argument = argument;
        self.danger = danger;
        self.open = true;
    }

    public function execute() {
        self.open = false;
        if (self.action == "start-print") { Actions.start-print(self.argument); }
        if (self.action == "cancel-print") { Actions.cancel-print(); }
        if (self.action == "emergency-stop") { Actions.emergency-stop(); }
        if (self.action == "run-macro") { Actions.run-macro(self.argument); }
        if (self.action == "mmu-eject") { Actions.mmu-eject(self.argument.to-float()); }
        if (self.action == "mmu-motors-off") { Actions.mmu-motors-off(); }
        if (self.action == "mmu-check-gate") { Actions.mmu-check-gate(self.argument.to-float()); }
        if (self.action == "mmu-check-all-gates") { Actions.mmu-check-all-gates(); }
        if (self.action == "mmu-reset-tool-map") { Actions.mmu-reset-tool-map(); }
        if (self.action == "save-config") { Actions.save-config(); }
        if (self.action == "remove-bed-mesh") { Actions.remove-bed-mesh(self.argument); }
        if (self.action == "reboot-host") { Actions.reboot-host(); }
        if (self.action == "shutdown-host") { Actions.shutdown-host(); }
        if (self.action == "restart-service") { Actions.restart-service(self.argument); }
        if (self.action == "upgrade") { Actions.upgrade(self.argument); }
        if (self.action == "firmware-restart") { Actions.firmware-restart(); }
        if (self.action == "restart-klipper") { Actions.restart-klipper(); }
        if (self.action == "log-out") { Actions.log-out(); }
        if (self.action == "disable-motors") { Actions.disable-motors(); }
        if (self.action == "power-off") { Actions.set-power(self.argument, false); }
        if (self.action == "connect-network") { Network.connect-pending(); }
        if (self.action == "disconnect-network") { Network.disconnect(); }
        if (self.action == "forget-network") { Network.forget(self.argument); }
        if (self.action == "wifi-off") { Network.set-wifi-enabled(false); }
        if (self.action == "wired-off") { Network.set-wired(self.argument, false); }
    }
}

// The map of the active bed mesh and the saved profiles, opened from the Calibrate tab.
export global MeshDialogs {
    in-out property <bool> map-open;
    in-out property <bool> profiles-open;
}

// Dialogs lie in the content area, beside the navigation and below the status bar. A tap there cancels every open
// dialog before the button does its own work (Frank, 2026-10-27): `dismiss` closes the dialogs of the window, and
// the dialogs of the pages close when `dismissals` changes.
export global Dialogs {
    out property <int> dismissals;

    public function dismiss() {
        Confirm.open = false;
        SpoolPicker.open = false;
        MmuDialogs.gate = -1;
        MmuDialogs.bypass-open = false;
        MeshDialogs.map-open = false;
        MeshDialogs.profiles-open = false;
        if (Navigation.history-open) { Actions.close-history(); }
        // Closing the dialog of a calibration mode leaves the mode (Frank, 2026-10-28).
        if (Printer.ready && Printer.calibration-mode != "") { Actions.abort-calibration(); }
        self.dismissals += 1;
    }
}

// Icons and texts for the three state levels: connection/Klipper (webhooks), machine activity
// (idle_timeout) and print job (print_stats). The same state name uses the same icon on every level.
export global StateIcons {
    public pure function print-state-label(state: string) -> string {
        if (state == "printing") { return @tr("Printing"); }
        if (state == "paused") { return @tr("Paused"); }
        if (state == "complete") { return @tr("Complete"); }
        if (state == "cancelled") { return @tr("Cancelled"); }
        if (state == "error") { return @tr("Print error"); }
        return @tr("No print");
    }

    public pure function print-state(state: string) -> image {
        if (state == "printing") { return Icons.state-printing; }
        if (state == "paused") { return Icons.state-paused; }
        if (state == "complete") { return Icons.state-complete; }
        if (state == "cancelled") { return Icons.state-cancelled; }
        if (state == "error") { return Icons.state-error; }
        return Icons.state-standby;
    }

    public pure function activity-label(activity: string) -> string {
        if (activity == "busy") { return @tr("Busy"); }
        if (activity == "idle") { return @tr("Idle"); }
        return @tr("Ready");
    }

    public pure function activity(activity: string) -> image {
        if (activity == "busy") { return Icons.state-busy; }
        if (activity == "idle") { return Icons.state-idle; }
        return Icons.state-ready;
    }

    public pure function klippy-label(connection: string, state: string) -> string {
        if (connection == "connecting") { return @tr("Moonraker: connecting"); }
        if (connection == "login-required") { return @tr("Moonraker: login required"); }
        if (connection != "connected") { return @tr("Moonraker: not reachable"); }
        if (state == "ready") { return @tr("Klipper ready"); }
        if (state == "startup") { return @tr("Klipper: starting"); }
        if (state == "shutdown") { return @tr("Klipper: shutdown"); }
        if (state == "error") { return @tr("Klipper: error"); }
        return @tr("Klipper: not connected");
    }

    // Status bar: connection/Klipper while not ready, then a print job if there is one, otherwise the activity.
    public pure function summary-label() -> string {
        if (!Printer.ready) { return self.klippy-label(Printer.connection, Printer.klippy-state); }
        if (Printer.is-printing) { return Printer.job-name; }
        if (Printer.print-state != "standby") { return self.print-state-label(Printer.print-state); }
        return self.activity-label(Printer.activity);
    }

    // The value after the summary that must not be cut off: the progress of a print.
    public pure function summary-value() -> string {
        if (Printer.ready && Printer.is-printing) { return round(Printer.progress * 100) + "%"; }
        return "";
    }

    // Whether the summary says that all is fine: Klipper ready and nothing running, or the print finished.
    public pure function summary-is-fine() -> bool {
        if (!Printer.ready) { return false; }
        if (Printer.print-state == "complete") { return true; }
        return Printer.print-state == "standby" && Printer.activity != "busy";
    }

    public pure function summary() -> image {
        if (!Printer.ready) { return self.klippy-state(Printer.connection, Printer.klippy-state); }
        if (Printer.print-state != "standby") { return self.print-state(Printer.print-state); }
        return self.activity(Printer.activity);
    }

    public pure function klippy-state(connection: string, state: string) -> image {
        if (connection == "login-required") { return Icons.ui-lock; }
        if (connection != "connected") { return Icons.system-disconnected; }
        if (state == "ready") { return Icons.state-ready; }
        if (state == "startup") { return Icons.state-startup; }
        if (state == "shutdown") { return Icons.state-shutdown; }
        if (state == "error") { return Icons.state-error; }
        return Icons.state-disconnected;
    }
}
