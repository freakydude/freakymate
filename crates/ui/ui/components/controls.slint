// Basic building blocks for touch input: buttons, step selection, cards, progress.

import { Theme } from "../theme.slint";

// Button with icon and optional text. `kind`: normal | accent | danger.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> checked;
    // What the button does has taken effect and is fine (homed, levelled): marked like `checked`, but in `success`.
    in property <bool> done;
    in property <string> kind: "normal";
    in property <length> icon-size: Theme.icon;
    // Icon left of the text instead of above it.
    in property <bool> horizontal;
    // With `horizontal`: the content starts at the left edge instead of the middle, so the icons of buttons
    // stacked in a column start at the same position.
    in property <bool> align-start;
    callback clicked;

    property <bool> has-icon: root.icon.width > 0;
    property <bool> marked: root.checked || root.done;
    property <color> base: root.kind == "accent" ? Theme.accent : root.kind == "danger" ? Theme.danger-fill : root.marked ? Theme.surface-active : Theme.surface-raised;
    property <color> pressed: root.kind == "accent" ? Theme.accent-pressed : root.kind == "danger" ? Theme.danger-fill-pressed : Theme.surface-active;
    property <color> content: !root.enabled ? Theme.disabled-foreground : root.kind == "accent" ? Theme.on-accent : Theme.foreground;

    min-width: Theme.touch;
    min-height: Theme.touch;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.surface : touch.pressed ? root.pressed : root.base;
    border-width: root.marked && root.kind == "normal" ? 2px : 0px;
    border-color: root.checked ? Theme.accent : Theme.success;
    accessible-role: button;
    accessible-label: root.text;

    animate background { duration: 80ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if !root.horizontal: VerticalLayout {
        padding: 4px;
        spacing: 2px;
        alignment: center;
        if root.has-icon: Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: root.icon-size;
            height: root.icon-size;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.content;
            font-size: root.has-icon ? Theme.font-small : Theme.font-normal;
            font-weight: root.has-icon ? 400 : 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.horizontal: HorizontalLayout {
        padding-left: root.align-start ? 12px : 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: root.align-start ? LayoutAlignment.start : LayoutAlignment.center;
        if root.has-icon: Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: root.icon-size;
            height: root.icon-size;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.content;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A setting that is on or off: the name at the left, a switch at the right edge; the whole row is the touch area.
export component ToggleRow inherits Rectangle {
    in property <string> text;
    // Optional symbol left of the name.
    in property <image> icon;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;

    min-height: 44px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.surface : touch.pressed ? Theme.surface-active : Theme.surface-raised;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checked: root.checked;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: Theme.spacing;
        if root.icon.width > 0: Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.enabled ? Theme.foreground : Theme.disabled-foreground;
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.enabled ? Theme.foreground : Theme.disabled-foreground;
            font-size: Theme.font-normal;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            cross-axis-self-alignment: center;
            width: 48px;
            height: 28px;
            border-radius: self.height / 2;
            background: root.checked && root.enabled ? Theme.accent : Theme.surface;
            border-width: root.checked ? 0px : 1px;
            border-color: Theme.border;
            animate background { duration: 120ms; }
            Rectangle {
                x: root.checked ? parent.width - self.width - 3px : 3px;
                width: 22px;
                height: 22px;
                border-radius: self.height / 2;
                background: !root.enabled ? Theme.disabled-foreground : root.checked ? Theme.on-accent : Theme.foreground;
                animate x { duration: 120ms; }
            }
        }
    }
}

// Panel of a flyout over the page: slightly see-through, with an outline and a shadow so its edge stands out. The
// software renderer draws no shadows, so the outline alone must carry it there. Taps inside stay inside.
export component FlyoutPanel inherits Rectangle {
    background: Theme.surface.with-alpha(Theme.flyout-opacity);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.flyout-border;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    TouchArea { }

    @children
}

// Selection of a step size from fixed levels.
export component StepSelector inherits HorizontalLayout {
    in property <[float]> values;
    in property <string> unit;
    in property <string> label;
    in-out property <float> selected;
    callback changed(float);

    spacing: 4px;
    alignment: center;

    if root.label != "": Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    for value in root.values: Rectangle {
        min-width: 52px;
        height: 44px;
        border-radius: Theme.radius;
        background: value == root.selected ? Theme.accent : step-touch.pressed ? Theme.surface-active : Theme.surface-raised;
        accessible-role: button;
        accessible-label: value + root.unit;
        step-touch := TouchArea {
            clicked => {
                root.selected = value;
                root.changed(value);
            }
        }

        Text {
            text: value + root.unit;
            color: value == root.selected ? Theme.on-accent : Theme.foreground;
            font-size: Theme.font-small;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A tab of a page: flat, the chosen one in the accent colour with a bar below. Unlike IconButton it does not look like
// an action, so it reads as a place to switch to (Frank, 2026-10-28). Confirmations keep the button look, at the right.
export component TabButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Waiting items (updates), as a small badge after the text.
    in property <int> count;
    callback clicked;

    property <color> content: !root.enabled ? Theme.disabled-foreground : root.checked ? Theme.accent : Theme.muted;

    min-width: 130px;
    max-width: 190px;
    horizontal-stretch: 1;
    min-height: Theme.touch;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.text;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 3px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0: Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: 20px;
            height: 20px;
        }
        Text {
            text: root.text;
            color: root.content;
            font-size: Theme.font-normal;
            font-weight: root.checked ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.count > 0: Rectangle {
            cross-axis-self-alignment: center;
            width: max(18px, count-text.preferred-width + 8px);
            height: 18px;
            border-radius: 9px;
            background: Theme.accent;
            count-text := Text {
                text: root.count;
                color: Theme.on-accent;
                font-size: Theme.font-small;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: 3px;
        border-radius: 1.5px;
        background: root.checked ? Theme.accent : transparent;
    }
}

// The row of tabs above a page's content, on a line across the page. Extra children (a status text) follow the tabs.
export component TabBar inherits Rectangle {
    // Pages whose layout has no padding of its own (Move, Tune, Thermal, Filament) keep the gap here.
    in property <length> inset: Theme.padding;
    height: Theme.touch + root.inset;

    Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        padding-top: root.inset;
        spacing: Theme.spacing;
        alignment: start;
        @children
    }
}

// Panel with optional heading for related controls.
export component Card inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    // A tap on free space of the card calls `clicked`; its own buttons lie above and keep their taps.
    in property <bool> tappable;
    callback clicked;
    background: Theme.surface;
    border-radius: Theme.radius;

    TouchArea {
        enabled: root.tappable;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: Theme.padding;
        spacing: 6px;
        if root.title != "": HorizontalLayout {
            spacing: 6px;
            height: 20px;
            if root.icon.width > 0: Image {
                cross-axis-self-alignment: center;
                source: root.icon;
                colorize: Theme.muted;
                width: 18px;
                height: 18px;
            }
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        @children
    }
}

// Label above a value, e.g. "Elapsed / 01:23".
export component ValueTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    // A state that the tile reports (a finished print) colours its icon.
    in property <color> icon-color: Theme.muted;
    // Share of the width among tiles side by side (4 and 5: four to five).
    in property <float> weight: 1;
    // A tile that opens something on a tap shows a small muted icon at its right edge.
    in property <image> action-icon;
    in property <bool> enabled-action;
    // A word under the action icon about what is set there (a planned pause); colours the icon with the accent.
    in property <string> action-note;
    callback clicked;
    background: tile-touch.pressed ? Theme.surface-raised : Theme.surface;
    border-radius: Theme.radius;
    min-height: 52px;
    // The width of tiles side by side follows their `weight` only (default: equal), never their text:
    // a changing value must not move the columns.
    horizontal-stretch: root.weight;
    preferred-width: 0px;
    min-width: 0px;

    tile-touch := TouchArea {
        enabled: root.enabled-action;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;
        if root.icon.width > 0: Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.icon-color;
            width: 22px;
            height: 22px;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }

            Text {
                text: root.value;
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
                overflow: elide;
            }
        }
        if root.enabled-action && root.action-icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                horizontal-alignment: center;
                source: root.action-icon;
                colorize: root.action-note != "" ? Theme.accent : Theme.muted;
                width: 18px;
                height: 18px;
            }
            if root.action-note != "": Text {
                text: root.action-note;
                color: Theme.accent;
                font-size: Theme.font-small;
                horizontal-alignment: center;
            }
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> progress;
    in property <color> bar-color: Theme.accent;
    height: 12px;
    border-radius: self.height / 2;
    background: Theme.surface-raised;
    clip: true;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.bar-color;
        animate width { duration: 250ms; }
    }
}

// Vertical list for long content: swipe, or drag/tap the slim bar at the right edge.
// The rows are placed inside with `y` and `width: <id>.row-width`.
export component ScrollList inherits Rectangle {
    in property <length> content-height;
    out property <length> row-width: list.width;
    in-out property <length> offset <=> list.content-y;
    property <length> range: max(0px, list.content-height - list.height);
    property <bool> scrollable: root.content-height > root.height;
    property <length> bar-width: 36px;

    // Fixed geometry instead of a layout: the bar must not change the size of the list's container.
    list := Flickable {
        x: 0;
        y: 0;
        width: root.scrollable ? root.width - root.bar-width - 4px : root.width;
        height: root.height;
        content-height: max(self.height, root.content-height);
        @children
    }

    bar := Rectangle {
        property <length> thumb-height: min(self.height, max(Theme.touch, self.height * list.height / list.content-height));
        property <length> travel: self.height - self.thumb-height;
        x: root.width - root.bar-width;
        y: 0;
        width: root.bar-width;
        height: root.height;
        visible: root.scrollable;

        function scroll-to(pointer-y: length) {
            if (self.travel > 0) {
                list.content-y = -clamp((pointer-y - self.thumb-height / 2) / self.travel, 0, 1) * root.range;
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            width: 4px;
            border-radius: 2px;
            background: Theme.surface-raised;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.range > 0 ? -list.content-y / root.range * bar.travel : 0;
            width: bar-touch.pressed ? 12px : 6px;
            height: bar.thumb-height;
            border-radius: self.width / 2;
            background: bar-touch.pressed ? Theme.accent : Theme.muted;
        }

        bar-touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    bar.scroll-to(self.mouse-y);
                }
            }
            moved => { bar.scroll-to(self.mouse-y); }
        }
    }
}

// Slider for values where the exact number does not matter (e.g. fan speed); reports on release.
export component TouchSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 5;
    in property <bool> enabled: true;
    // Value under the finger while dragging, afterwards until the printer reports back.
    out property <float> shown: slider-touch.pressed || root.waiting ? root.dragged : root.value;
    callback changed(float);

    property <float> dragged;
    property <bool> waiting;
    property <length> knob: 36px;
    property <float> ratio: clamp((root.shown - root.minimum) / (root.maximum - root.minimum), 0, 1);
    height: Theme.touch;
    accessible-role: slider;
    accessible-value: round(root.shown);

    changed value => { root.waiting = false; }

    function value-at(pointer-x: length) -> float {
        let ratio = clamp((pointer-x - root.knob / 2) / (root.width - root.knob), 0, 1);
        return round((root.minimum + ratio * (root.maximum - root.minimum)) / root.step) * root.step;
    }

    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.width - root.knob;
        height: 8px;
        border-radius: 4px;
        background: Theme.surface-raised;
    }

    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: (root.width - root.knob) * root.ratio;
        height: 8px;
        border-radius: 4px;
        background: root.enabled ? Theme.accent : Theme.disabled-foreground;
    }

    Rectangle {
        x: (root.width - root.knob) * root.ratio;
        y: (root.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: !root.enabled ? Theme.surface-active : slider-touch.pressed ? Theme.accent : Theme.foreground;
    }

    slider-touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragged = root.value-at(self.mouse-x);
            }
            if (event.kind == PointerEventKind.up) {
                root.dragged = root.value-at(self.mouse-x);
                root.waiting = root.dragged != root.value;
                root.changed(root.dragged);
            }
        }
        moved => { root.dragged = root.value-at(self.mouse-x); }
    }

    Timer {
        interval: 3s;
        running: root.waiting;
        triggered => { root.waiting = false; }
    }
}

// A describing text and a value on one line, e.g. "Sunlu PETG · 38 g". Only the text is shortened when room is
// short; the value (a number, a weight, a percentage) always stays whole. `alignment: end` puts the line at the right.
export component TextWithValue inherits HorizontalLayout {
    in property <string> text;
    in property <string> value;
    in property <string> separator: " · ";
    in property <color> color: Theme.muted;
    in property <length> font-size: Theme.font-small;
    in property <int> font-weight: 400;
    alignment: start;

    if root.text != "": Text {
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.value != "": Text {
        min-width: self.preferred-width;
        text: (root.text != "" ? root.separator : "") + root.value;
        color: root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
    }
}

// Row with icon and text, e.g. for status displays.
export component IconLabel inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    in property <color> color: Theme.foreground;
    in property <length> font-size: Theme.font-normal;
    in property <length> icon-size: 20px;
    spacing: 6px;

    Image {
        cross-axis-self-alignment: center;
        source: root.icon;
        colorize: root.color;
        width: root.icon-size;
        height: root.icon-size;
    }

    Text {
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The colour or colours of a filament as one bar, in one, two or three equal parts (Spoolman has up to three colours).
// The colours of a filament, one to three. The bar stands for a piece of filament along its long side (`vertical`
// turns it upright): the colours of a coaxial filament run side by side along the whole length, those of a
// longitudinal one take turns along it (Spoolman's `multi_color_direction`). Without colour (`count` 0) the bar is
// neutral, or the accent colour with `generic`. Only the outer pieces are rounded, each on its outer corners, so the bar keeps its shape in every renderer.
export component ColorBar inherits Rectangle {
    in property <color> first;
    in property <color> second;
    in property <color> third;
    in property <int> count: 1;
    in property <bool> vertical;
    in property <bool> longitudinal;
    // Filament whose colour is not known (`count` 0): the bar is drawn in the accent colour as a generic filament,
    // purely as a look, instead of neutral. Leave it off where there may be no filament at all (an empty gate).
    in property <bool> generic;
    // Length of one colour of a longitudinal filament.
    in property <length> stripe: 6px;
    // The ends are as round as the outline minus its width.
    property <length> end: max(0px, root.border-radius - 1px);
    property <length> long: (root.vertical ? root.height : root.width) - 2px;
    property <length> across: (root.vertical ? root.width : root.height) - 2px;
    // Pieces: the colours across the bar (coaxial) or the stripes along it (longitudinal).
    property <int> pieces: root.count < 1 ? 0 : root.longitudinal && root.count > 1 ? max(1, ceil(root.long / root.stripe)) : root.count;
    property <bool> shows-generic: root.generic && root.count < 1;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.shows-generic ? Theme.accent : Theme.border;
    background: root.shows-generic ? Theme.accent : Theme.border;

    pure function nth(index: int) -> color {
        return index == 1 ? root.second : index == 2 ? root.third : root.first;
    }

    for piece in root.pieces: Rectangle {
        // Along the long side for stripes, across it for coaxial colours.
        property <bool> along: root.longitudinal && root.count > 1;
        property <length> size: self.along ? root.stripe : root.across / root.count;
        property <length> start: piece * self.size;
        property <length> length: self.along ? min(root.stripe, root.long - self.start) : self.size;
        property <bool> head: piece == 0;
        property <bool> tail: piece == root.pieces - 1;
        // Which outer corners this piece rounds: the head and tail of a stripe sequence round the ends of the bar;
        // the outer bands of coaxial colours round their long edge, and every band rounds both ends.
        property <bool> left-round: self.along ? (root.vertical ? true : self.head) : (root.vertical ? self.head : true);
        property <bool> right-round: self.along ? (root.vertical ? true : self.tail) : (root.vertical ? self.tail : true);
        property <bool> top-round: self.along ? (root.vertical ? self.head : true) : (root.vertical ? true : self.head);
        property <bool> bottom-round: self.along ? (root.vertical ? self.tail : true) : (root.vertical ? true : self.tail);
        x: 1px + (root.vertical != self.along ? self.start : 0px);
        y: 1px + (root.vertical == self.along ? self.start : 0px);
        width: root.vertical != self.along ? self.length : (root.vertical ? root.across : root.long);
        height: root.vertical == self.along ? self.length : (root.vertical ? root.long : root.across);
        // A colour with alpha lies over a checkerboard of 2x2 fields, so it reads as see-through. Rounded corners are set
        // on every layer (no clipping), the dark fields only on their outer corner.
        property <color> tint: root.nth(mod(piece, root.count));
        property <bool> see-through: self.tint.alpha < 255;
        background: self.see-through ? Theme.checker-light : self.tint;
        border-top-left-radius: self.top-round && self.left-round ? root.end : 0px;
        border-top-right-radius: self.top-round && self.right-round ? root.end : 0px;
        border-bottom-left-radius: self.bottom-round && self.left-round ? root.end : 0px;
        border-bottom-right-radius: self.bottom-round && self.right-round ? root.end : 0px;

        if self.see-through: Rectangle {
            x: parent.width / 2;
            width: parent.width / 2;
            height: parent.height / 2;
            background: Theme.checker-dark;
            border-top-right-radius: parent.border-top-right-radius;
        }
        if self.see-through: Rectangle {
            y: parent.height / 2;
            width: parent.width / 2;
            height: parent.height / 2;
            background: Theme.checker-dark;
            border-bottom-left-radius: parent.border-bottom-left-radius;
        }
        if self.see-through: Rectangle {
            background: parent.tint;
            border-top-left-radius: parent.border-top-left-radius;
            border-top-right-radius: parent.border-top-right-radius;
            border-bottom-left-radius: parent.border-bottom-left-radius;
            border-bottom-right-radius: parent.border-bottom-right-radius;
        }
    }
}
