// The way of the filament from the gate to the nozzle, drawn from Happy Hare's state (`filament_pos`, direction,
// sensors, gate colour) instead of its console line: a tube that fills in the colour of the spool.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ColorBar } from "controls.slint";
import { BarColors, FilamentPathItem } from "../state.slint";

// A sensor on the way: -1 not fitted (not drawn), 0 free (dim), 1 triggered (bright). The symbol, not a coloured dot,
// so it stands out from any filament colour.
component SensorMark inherits Image {
    in property <int> state;
    width: root.state < 0 ? 0px : 20px;
    height: 20px;
    source: Icons.filament-sensor;
    colorize: root.state == 1 ? Theme.foreground : Theme.disabled-foreground;
}

// One piece of tube, filled to `fill` (0 to 1) from the left in the colours of the filament (see `ColorBar`).
component Tube inherits Rectangle {
    in property <float> fill;
    in property <BarColors> filament;
    height: 10px;
    border-radius: 5px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    if root.fill > 0: ColorBar {
        x: 0;
        width: max(root.height, parent.width * clamp(root.fill, 0, 1));
        height: parent.height;
        border-radius: parent.border-radius;
        colors: root.filament;
        generic: true;
    }
}

component Label inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    horizontal-alignment: center;
}

export component FilamentPath inherits VerticalLayout {
    // `position` is Happy Hare's `filament_pos`: -1 unknown, 0 parked in the gate, 1 at the gate sensor, 2 to 4 in
    // the bowden, 5 at the extruder entry sensor, 6 at the extruder gears, 7 gripped by them, 8 at the toolhead
    // sensor, 9 past it, 10 loaded to the nozzle. `direction`: 1 loading, -1 unloading, 0 standing.
    in property <FilamentPathItem> path;
    // Print page: one line without labels.
    in property <bool> compact;

    property <int> position: root.path.position;
    property <int> direction: root.path.direction;
    property <string> distance: root.compact ? "" : root.path.distance;
    // Unknown position, or a gate without colour: a neutral filament.
    property <bool> neutral: root.position < 0 || root.path.colors.count < 1;
    // The colours of the tubes: the neutral line colour, or the filament's own colours.
    property <BarColors> tube-colors: {
        first: root.line-color,
        second: root.path.colors.second,
        third: root.path.colors.third,
        count: root.neutral ? 1 : root.path.colors.count,
        longitudinal: root.path.colors.longitudinal,
    };
    property <color> line-color: root.neutral ? Theme.muted : root.path.colors.first;

    // How far each piece is filled at the current position.
    pure function fill(piece: int) -> float {
        if (root.position < 0) { return 0; }
        if (piece == 0) { return root.position >= 1 ? 1 : 0.6; }
        // In the bowden Happy Hare reports how far a move has come; without it the middle stands for "somewhere".
        if (piece == 1) {
            if (root.position >= 4) { return 1; }
            if (root.position >= 2 && root.path.bowden-progress >= 0) { return root.path.bowden-progress; }
            return root.position == 3 ? 0.5 : root.position == 2 ? 0.1 : 0;
        }
        if (piece == 2) { return root.position >= 5 ? 1 : 0; }
        // Behind the extruder gears: 7 means the gears have pulled the filament in.
        if (piece == 3) { return root.position >= 8 ? 1 : root.position == 7 ? 0.3 : 0; }
        return root.position >= 10 ? 1 : root.position == 9 ? 0.5 : 0;
    }

    spacing: Theme.spacing-small;

    // Symbols, tubes and distance all sit on the middle line of the row.
    HorizontalLayout {
        spacing: Theme.spacing-small;
        alignment: stretch;
        cross-axis-alignment: center;
        // Direction of movement at the left: the gate pushes or pulls.
        Image {
            width: 20px;
            height: 20px;
            source: root.direction < 0 ? Icons.ui-chevron-left : Icons.ui-chevron-right;
            colorize: Theme.accent;
            // The place stays, so the tube does not move when the filament starts or stops.
            opacity: root.direction == 0 ? 0 : 1;
        }
        // Where the filament enters the gate from the spool.
        SensorMark { state: root.path.gate-entry-sensor; }
        Tube { horizontal-stretch: 1; fill: root.fill(0); filament: root.tube-colors; }
        SensorMark { state: root.path.gate-sensor; }
        Tube { horizontal-stretch: 5; fill: root.fill(1); filament: root.tube-colors; }
        Tube { horizontal-stretch: 1; fill: root.fill(2); filament: root.tube-colors; }
        SensorMark { state: root.path.extruder-sensor; }
        // The extruder gears: lit once the filament has reached them (6) or they have it (7 and on).
        Image {
            width: Theme.icon-medium;
            height: Theme.icon-medium;
            source: Icons.filament-extruder-gears;
            colorize: root.position >= 6 ? root.line-color : Theme.muted;
        }
        Tube { horizontal-stretch: 1; fill: root.fill(3); filament: root.tube-colors; }
        SensorMark { state: root.path.toolhead-sensor; }
        Tube { horizontal-stretch: 1; fill: root.fill(4); filament: root.tube-colors; }
        Image {
            width: Theme.icon-medium;
            height: Theme.icon-medium;
            source: Icons.thermal-nozzle;
            colorize: root.position >= 10 ? root.line-color : Theme.muted;
        }
        if root.distance != "": Text {
            min-width: 70px;
            text: root.distance;
            color: Theme.muted;
            font-size: Theme.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // Names under the stations; left out on the print page.
    if !root.compact: HorizontalLayout {
        padding-left: 24px;
        padding-right: root.distance != "" ? 100px : 26px;
        Label { text: root.path.gate-label; horizontal-stretch: 1; horizontal-alignment: left; }
        Label { text: @tr("Bowden"); horizontal-stretch: 5; }
        Label { text: @tr("Extruder"); horizontal-stretch: 3; }
        Label { text: @tr("Nozzle"); horizontal-stretch: 1; horizontal-alignment: right; }
    }
}
