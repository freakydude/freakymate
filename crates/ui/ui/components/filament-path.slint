// The way of the filament from the gate or lane to the nozzle, drawn from the state of Happy Hare or AFC: the pieces
// the core lists in the order the filament passes them (`LoadPath::parts`), a tube that fills in the colour of the
// spool. The head of a tool changer shows only its own pieces: extruder sensor, gears, sensor behind them and nozzle.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { FilamentColors, FilamentSwatch } from "filament-swatch.slint";
import { BarColors, FilamentPathItem, PathPartItem, PathPartKind } from "../state.slint";

// One piece of tube, filled to `fill` (0 to 1) from the left in the colours of the filament (see `FilamentSwatch`).
component Tube inherits Rectangle {
    in property <float> fill;
    in property <BarColors> filament;
    height: 10px;
    border-radius: 5px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    if root.fill > 0: FilamentSwatch {
        x: 0;
        width: max(root.height, parent.width * clamp(root.fill, 0, 1));
        height: parent.height;
        radius: parent.border-radius;
        colors: FilamentColors.generic(root.filament);
    }
}

// One piece of the way with its name under it: the symbol or the tube on the middle line of the row.
component PathPart inherits VerticalLayout {
    in property <PathPartItem> part;
    in property <BarColors> filament;
    in property <string> lane-label;
    in property <bool> labelled;

    property <PathPartKind> kind: root.part.kind;
    property <bool> tube: root.kind == PathPartKind.lane || root.kind == PathPartKind.hub || root.kind == PathPartKind.bowden || root.kind == PathPartKind.link;
    // The symbol, not a coloured dot, so it stands out from any filament colour.
    property <image> symbol: root.kind == PathPartKind.gears ? Icons.filament-extruder-gears : root.kind == PathPartKind.nozzle ? Icons.thermal-nozzle : root.kind == PathPartKind.encoder ? Icons.mmu-encoder : root.kind == PathPartKind.buffer ? Icons.mmu-sync : Icons.filament-sensor;
    property <bool> large: root.kind == PathPartKind.gears || root.kind == PathPartKind.nozzle;
    property <length> symbol-size: root.large ? Theme.icon-large : Theme.icon-small;
    property <string> label: root.kind == PathPartKind.lane ? root.lane-label : root.kind == PathPartKind.hub ? @tr("Hub") : root.kind == PathPartKind.bowden ? @tr("Bowden") : root.kind == PathPartKind.encoder ? @tr("Encoder") : root.kind == PathPartKind.buffer ? @tr("Buffer") : root.kind == PathPartKind.gears ? @tr("Extruder") : root.kind == PathPartKind.nozzle ? @tr("Nozzle") : "";

    // The bowden is the long piece; the other tubes share what is left, symbols take what they need.
    horizontal-stretch: root.kind == PathPartKind.bowden ? 5 : root.tube ? 1 : 0;
    spacing: Theme.spacing-small;

    Rectangle {
        height: Theme.icon-large;
        min-width: root.tube ? 12px : root.symbol-size;
        if root.tube: Tube {
            y: (parent.height - self.height) / 2;
            width: parent.width;
            fill: root.part.fill;
            filament: root.filament;
        }
        if !root.tube: Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.symbol-size;
            height: root.symbol-size;
            source: root.symbol;
            // Bright once the filament is there (gears, nozzle) or while the piece reports something (sensors,
            // encoder, buffer), dim otherwise. Only the tube carries the filament's colour: a red or black symbol
            // would read as a state, or not at all.
            colorize: root.part.active ? Theme.foreground : root.large ? Theme.muted : Theme.disabled-foreground;
        }
    }
    // A station keeps its whole name, so neighbours stay `Theme.spacing` apart (the spacing of the row). The name of
    // the bowden, a section between stations, gives way when its piece is too short for it.
    if root.labelled: Text {
        min-width: root.kind == PathPartKind.bowden ? 0px : self.preferred-width;
        visible: root.kind != PathPartKind.bowden || root.width >= self.preferred-width + Theme.spacing;
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        horizontal-alignment: center;
    }
}

export component FilamentPath inherits HorizontalLayout {
    in property <FilamentPathItem> path;
    // Print page: one line without names and without the distance.
    in property <bool> compact;

    property <int> direction: root.path.direction;
    property <string> distance: root.compact ? "" : root.path.distance;
    // A gate without colour: a neutral filament.
    property <bool> neutral: root.path.colors.count < 1;
    property <color> line-color: root.neutral ? Theme.muted : root.path.colors.first;
    // The colours of the tubes: the neutral line colour, or the filament's own colours.
    property <BarColors> tube-colors: {
        first: root.line-color,
        second: root.path.colors.second,
        third: root.path.colors.third,
        count: root.neutral ? 1 : root.path.colors.count,
        longitudinal: root.path.colors.longitudinal,
    };

    // Names need room between the pieces; the line of the print page has none.
    spacing: root.compact ? Theme.spacing-small : Theme.spacing;

    // Direction of movement at the left: the gate pushes or pulls.
    VerticalLayout {
        alignment: start;
        Image {
            width: Theme.icon-small;
            height: Theme.icon-large;
            image-fit: contain;
            source: root.direction < 0 ? Icons.ui-chevron-left : Icons.ui-chevron-right;
            colorize: Theme.accent;
            // The place stays, so the tube does not move when the filament starts or stops.
            opacity: root.direction == 0 ? 0 : 1;
        }
    }
    for part in root.path.parts: PathPart {
        part: part;
        filament: root.tube-colors;
        lane-label: root.path.gate-label;
        labelled: !root.compact;
    }
    if root.distance != "": VerticalLayout {
        alignment: start;
        Text {
            height: Theme.icon-large;
            min-width: 70px;
            text: root.distance;
            color: Theme.muted;
            font-size: Theme.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
