// Tiles of the Filament page and the print page strip: a gate or the bypass as a slot, availability, buffer gauge and
// the texts of buffer and FlowGuard.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { MmuGateItem, Printer } from "../state.slint";
import { IconLabel } from "controls.slint";
import { FilamentColors, FilamentSwatch } from "filament-swatch.slint";

// Texts of the buffer and FlowGuard and the colour of FlowGuard, shared by the Gates tab and the strip on the print page.
export global MmuTexts {
    pure public function buffer(state: string) -> string {
        if (state == "neutral") { return @tr("Neutral"); }
        if (state == "tension") { return @tr("Tension"); }
        if (state == "compressed") { return @tr("Compression"); }
        if (state == "inactive") { return @tr("Inactive"); }
        return @tr("Off");
    }
    pure public function availability(availability: string) -> string {
        if (availability == "available") { return @tr("Available"); }
        if (availability == "buffered") { return @tr("Buffered"); }
        if (availability == "empty") { return @tr("Empty"); }
        return @tr("Unknown");
    }
}

// Whether a gate has filament, as an icon with a word; shared by the Gates tab and the gate dialog.
export component GateAvailabilityLabel inherits IconLabel {
    in property <string> availability;
    property <bool> has-filament: root.availability == "available" || root.availability == "buffered";

    icon: root.has-filament ? Icons.mmu-gate-available : root.availability == "empty" ? Icons.mmu-gate-empty : Icons.mmu-gate-unknown;
    text: MmuTexts.availability(root.availability);
    color: root.availability == "empty" ? Theme.warning : Theme.muted;
    font-size: Theme.font-small;
}

// The frame of a gate, the bypass or a tool: a tile to tap, with an accent border while selected.
export component SlotTile inherits Rectangle {
    in property <bool> selected;
    in property <string> label;
    in property <bool> enabled: true;
    // Room between the border and the content; a tile with a colour edge sets its own.
    in property <length> content-padding: Theme.padding;
    out property <bool> pressed: tile-touch.pressed;
    callback clicked;

    border-radius: Theme.radius;
    background: tile-touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-width: root.selected ? 3px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;

    tile-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: root.content-padding;
        spacing: Theme.spacing-medium;
        @children
    }
}

// How a tool of the compared file fits its gate: a tick when it fits, a warning when not; nothing to say otherwise.
export component VerdictIcon inherits Image {
    in property <string> verdict;

    width: Theme.icon-compact;
    height: Theme.icon-compact;
    visible: root.verdict != "";
    source: root.verdict == "fits" ? Icons.ui-check : Icons.ui-warning;
    colorize: root.verdict == "fits" ? Theme.success : Theme.warning;
}

// A gate or a lane of AFC as a tile: the colour of the filament as the left edge over the full height (`FilamentSwatch`), beside it the
// gate (or lane) and the tools that take its filament, the material (smaller in steps when long, never cut), the name or spool and
// what is left of it, and whether the gate has filament.
export component GateTile inherits SlotTile {
    in property <MmuGateItem> gate;

    property <bool> has-filament: root.gate.availability == "available" || root.gate.availability == "buffered";
    property <bool> shows-spool: Printer.has-spoolman && root.has-filament;
    property <string> material: root.gate.material == "" ? "-" : root.gate.material;
    // Long materials (PEEK-CF, PA6-GF30) step down instead of being cut.
    property <length> material-size: root.material.character-count <= 5 ? 19px : root.material.character-count <= 7 ? 16px : 14px;

    selected: root.gate.selected;
    label: root.gate.title;
    // The selection border takes 3 px; the colour edge sits inside it, otherwise it forms the corner of the tile.
    content-padding: root.selected ? 3px : 0px;

    HorizontalLayout {
        spacing: Theme.spacing;
        FilamentSwatch {
            width: 16px;
            left-edge: true;
            radius: root.selected ? Theme.radius - 3px : Theme.radius;
            colors: root.has-filament ? FilamentColors.generic(root.gate.colors) : root.gate.colors;
            empty: !root.has-filament;
            gap-color: root.pressed ? Theme.surface-active : Theme.surface-raised;
            ground: root.selected ? self.gap-color : Theme.background;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: Theme.spacing-medium;
            padding-bottom: Theme.spacing-medium;
            padding-right: Theme.spacing-medium;
            spacing: Theme.spacing-tight;
            HorizontalLayout {
                spacing: Theme.spacing-small;
                Text {
                    text: root.gate.title;
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                    font-weight: 700;
                    overflow: elide;
                }
                // The tools that take their filament from this gate; several share it after a remap.
                Text {
                    horizontal-stretch: 1;
                    text: root.gate.tools;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.gate.file-verdict != "": VerdictIcon {
                    cross-axis-self-alignment: center;
                    verdict: root.gate.file-verdict;
                }
            }
            Text {
                min-width: self.preferred-width;
                text: root.material;
                color: root.has-filament ? Theme.foreground : Theme.muted;
                font-size: root.material-size;
                font-weight: 700;
            }
            // With Spoolman the lines say the spool's name and what is left of it; a gate without one invites to pick
            // one in the gate's dialog. A spool that Happy Hare knows but Spoolman does not tell about (not
            // reachable) shows its number. The name takes two lines, then `…`.
            Text {
                height: Theme.font-small * 2.3;
                text: root.gate.name;
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
            Text {
                visible: root.shows-spool;
                height: root.shows-spool ? self.preferred-height : 0px;
                text: root.gate.spool-text != "" ? root.gate.spool-text : root.gate.spool-id >= 0 ? @tr("Spool #{}", root.gate.spool-id) : @tr("+ spool");
                color: root.gate.spool-low ? Theme.warning : root.gate.spool-text == "" && root.gate.spool-id < 0 ? Theme.accent : Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                GateAvailabilityLabel {
                    availability: root.gate.availability;
                }
                if Printer.mmu-endless-spool && root.gate.group >= 0: IconLabel {
                    icon: Icons.mmu-endless-spool;
                    text: root.gate.group;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
            }
        }
    }
}

// Happy Hare offers the bypass on every MMU: filament fed by hand past the gates. Material and colour of the bypass
// are not in its status, so the tile only names it.
export component BypassTile inherits SlotTile {
    selected: Printer.mmu-bypass;
    label: @tr("Bypass");

    Text {
        text: @tr("Bypass");
        color: Theme.foreground;
        font-size: Theme.font-normal;
        font-weight: 700;
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: center;
        Image {
            source: Icons.mmu-bypass;
            colorize: Printer.mmu-bypass ? Theme.accent : Theme.muted;
            width: 40px;
            height: 40px;
        }
    }
    Rectangle { vertical-stretch: 1; }
    Text {
        text: @tr("Fed by hand");
        color: Theme.muted;
        font-size: Theme.font-small;
        overflow: elide;
    }
}

// The scale of the buffer: tension at the left, compression at the right. The marker is the bias, the lighter ends
// the zones from where a proportional sensor counts as extreme, the stroke in the middle neutral, the stroke at the left the tension from which tangle prevention raises the gear current, and the
// strip growing from an end FlowGuard's level: how close it is to a tangle (left) or a clog (right) trigger. A side
// that no sensor measures (a one-sided switch buffer) is an outline only; FlowGuard still infers it.
component BufferScale inherits Rectangle {
    in property <float> bias;
    in property <string> sides;
    in property <float> level;
    in property <float> tangle-threshold;
    in property <float> extreme-threshold;
    in property <color> marker-color;
    in property <color> level-color;
    property <length> marker-width: 8px;
    // Where a bias sits: the marker's middle runs between the ends.
    pure function place(bias: float) -> length {
        return root.marker-width / 2 + clamp((bias + 1) / 2, 0, 1) * (root.width - root.marker-width);
    }

    height: 18px;
    Rectangle {
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;
    }
    if root.sides != "compression": Rectangle {
        x: 0;
        width: parent.width / 2;
        border-radius: Theme.radius-small;
        background: Theme.border;
    }
    if root.sides != "tension": Rectangle {
        x: parent.width / 2;
        width: parent.width / 2;
        border-radius: Theme.radius-small;
        background: Theme.border;
    }
    // The ends from where the sensor counts as extreme (FlowGuard's trigger zones), lighter than the sides.
    if root.extreme-threshold >= 0 && root.sides != "compression": Rectangle {
        x: 0;
        width: root.place(-root.extreme-threshold);
        border-radius: Theme.radius-small;
        background: Theme.flyout-border;
    }
    if root.extreme-threshold >= 0 && root.sides != "tension": Rectangle {
        x: root.place(root.extreme-threshold);
        width: parent.width - self.x;
        border-radius: Theme.radius-small;
        background: Theme.flyout-border;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 1px;
        background: Theme.muted;
    }
    if root.tangle-threshold >= 0: Rectangle {
        x: root.place(-root.tangle-threshold) - self.width / 2;
        width: 2px;
        background: Theme.muted;
    }
    if root.level != 0: Rectangle {
        x: root.level < 0 ? 0 : parent.width - self.width;
        y: parent.height - self.height;
        width: abs(root.level) * parent.width / 2;
        height: 5px;
        border-radius: Theme.radius-small;
        background: root.level-color;
    }
    Rectangle {
        width: root.marker-width;
        x: root.place(root.bias) - self.width / 2;
        border-radius: Theme.radius-small;
        background: root.marker-color;
    }
}

// Buffer, tangle prevention and FlowGuard of Happy Hare as one instrument, as all of them read the buffer: one line
// that states what stands out most, and the scale. Without a buffer (an encoder alone) only the line.
export component FlowGuardInstrument inherits VerticalLayout {
    // The print page shows the flow rate only where an encoder measures it; the estimate stays on the Filament page.
    in property <bool> measured-flow-only;
    // The buffer is the selected gate's: the card of another lane keeps FlowGuard's line and leaves the scale out.
    in property <bool> with-buffer: true;

    property <bool> has-buffer: Printer.mmu-has-buffer && root.with-buffer;
    property <string> buffer: Printer.mmu-buffer-state;
    property <string> guard: Printer.mmu-flowguard-state;
    property <bool> guarded: root.guard != "off";
    property <float> level: root.guarded ? Printer.mmu-flowguard-level : 0;
    // FlowGuard counts towards a trigger; small values come and go while the controller works.
    property <bool> rising: root.guard != "triggered" && abs(root.level) >= 0.1;
    property <color> tone: root.guard == "triggered" ? Theme.danger : root.rising || root.guard == "boosting" ? Theme.warning : Theme.muted;
    property <bool> shows-flow: Printer.mmu-flow-rate >= 0 && (Printer.mmu-flow-measured || !root.measured-flow-only);
    property <string> guard-word: root.guard == "monitoring" ? @tr("FlowGuard monitoring") : @tr("FlowGuard ready");
    property <string> statement: {
        if (root.guard == "triggered") {
            return @tr("FlowGuard triggered") + (Printer.mmu-flowguard-detail == "" ? "" : ": " + Printer.mmu-flowguard-detail);
        }
        if (root.rising && root.guard == "boosting") {
            return @tr("Tangle prevention · FlowGuard tangle level {} %", round(abs(root.level) * 100));
        }
        if (root.rising) {
            return root.level > 0 ? @tr("FlowGuard: clog level {} %", round(root.level * 100)) : @tr("FlowGuard: tangle level {} %", round(-root.level * 100));
        }
        if (root.guard == "boosting") {
            return @tr("Tangle prevention: gear current raised");
        }
        if (!root.has-buffer) {
            return root.guard-word;
        }
        return @tr("Buffer: {}", MmuTexts.buffer(root.buffer)) + (root.guarded ? " · " + root.guard-word : "");
    }

    spacing: Theme.spacing-small;

    HorizontalLayout {
        spacing: Theme.spacing;
        // The figures are short and stay whole; the statement gives way when the line is narrow.
        IconLabel {
            horizontal-stretch: 1;
            min-width: 0px;
            icon: root.guarded ? Icons.mmu-flowguard : Icons.mmu-sync;
            text: root.statement;
            color: root.tone;
            font-size: Theme.font-small;
        }
        if Printer.mmu-encoder-headroom != "": IconLabel {
            horizontal-stretch: 0;
            icon: Icons.mmu-encoder;
            text: @tr("Headroom {}", Printer.mmu-encoder-headroom);
            color: Theme.muted;
            font-size: Theme.font-small;
        }
        if root.shows-flow: IconLabel {
            horizontal-stretch: 0;
            icon: Icons.filament-flow;
            text: @tr("Flow {} %", round(Printer.mmu-flow-rate));
            color: Theme.muted;
            font-size: Theme.font-small;
        }
    }
    // The ends are named by what FlowGuard makes of them, while it watches.
    if root.has-buffer: HorizontalLayout {
        spacing: Theme.spacing;
        Text {
            text: root.guarded ? @tr("Tangle") : @tr("Tension");
            color: root.level <= -0.1 ? root.tone : Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        BufferScale {
            horizontal-stretch: 1;
            bias: Printer.mmu-buffer-bias;
            sides: Printer.mmu-buffer-sides;
            level: root.level;
            tangle-threshold: Printer.mmu-tangle-threshold;
            extreme-threshold: Printer.mmu-extreme-threshold;
            level-color: root.guard == "triggered" ? Theme.danger : Theme.warning;
            // Leaning to a side is the controller at work, not a deviation.
            marker-color: root.tone != Theme.muted ? root.tone : root.buffer == "neutral" ? Theme.success : root.buffer == "tension" || root.buffer == "compressed" ? Theme.foreground : Theme.muted;
        }
        Text {
            text: root.guarded ? @tr("Clog") : @tr("Compression");
            color: root.level >= 0.1 ? root.tone : Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}
