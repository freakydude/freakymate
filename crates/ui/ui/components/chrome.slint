// Application frame: status bar at the top, navigation rail on the left.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Dialogs, Navigation, Network, Page, Printer, StateIcons, TuneTab } from "../state.slint";
import { BusyWheel } from "busy-wheel.slint";
import { TextWithValue } from "controls.slint";

// A temperature of the status bar; a tap leads to the heaters without looking like a button.
component TemperatureReading inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> heating;
    min-width: reading.min-width;
    preferred-width: reading.preferred-width;

    TouchArea {
        clicked => {
            Dialogs.dismiss();
            Navigation.show-heaters();
        }
    }

    reading := HorizontalLayout {
        spacing: 4px;
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.heating ? Theme.accent : Theme.muted;
            width: 20px;
            height: 20px;
        }
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
    }
}

export component StatusBar inherits Rectangle {
    // The one place for what is running right now: a command of this display that waits long for its answer, what
    // the MMU is doing (whoever started it), or the network being changed.
    property <string> activity: Printer.running-command != "" ? Printer.running-command
        : Printer.mmu-action != "" && Printer.mmu-action != "Idle" ? Printer.mmu-action
        : Network.busy;

    height: 44px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            // While something runs, the turning wheel and its name replace the summary.
            if root.activity != "": BusyWheel {
                cross-axis-self-alignment: center;
                width: 40px;
                height: 40px;
            }
            if root.activity == "": Image {
                cross-axis-self-alignment: center;
                source: StateIcons.summary();
                colorize: !Printer.ready ? Theme.warning : StateIcons.summary-is-fine() ? Theme.success : Theme.foreground;
                width: 24px;
                height: 24px;
            }
            // The progress of a print stays whole when a long file name is shortened.
            TextWithValue {
                text: root.activity != "" ? root.activity + " …" : StateIcons.summary-label();
                value: root.activity != "" ? "" : StateIcons.summary-value();
                separator: "  ";
                color: Theme.foreground;
                font-size: Theme.font-normal;
            }
        }

        TemperatureReading {
            visible: Printer.ready;
            icon: Icons.thermal-nozzle;
            heating: Printer.nozzle-target > 0;
            text: round(Printer.nozzle-temperature) + "°" + (Printer.nozzle-target > 0 ? " / " + round(Printer.nozzle-target) + "°" : "");
        }
        if Printer.has-bed: TemperatureReading {
            visible: Printer.ready;
            icon: Icons.thermal-bed;
            heating: Printer.bed-target > 0;
            text: round(Printer.bed-temperature) + "°" + (Printer.bed-target > 0 ? " / " + round(Printer.bed-target) + "°" : "");
        }
        // Newest message of the status bar; tapping it opens the flyout with all messages.
        if Printer.status-message-visible: Rectangle {
            horizontal-stretch: 1;
            // Leaves the state, the temperatures and the light symbol their room.
            max-width: 300px;
            border-radius: Theme.radius;
            // An error is filled red and stays until seen; an information is quiet, only its symbol is blue.
            background: Printer.status-message-error ? Theme.danger-fill : Theme.surface-raised;
            accessible-role: button;
            accessible-label: Printer.status-message;
            status-touch := TouchArea {
                clicked => {
                    Dialogs.dismiss();
                    Navigation.messages-open = true;
                    Actions.messages-seen();
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Image {
                    cross-axis-self-alignment: center;
                    source: Printer.status-message-error ? Icons.ui-error : Icons.ui-info;
                    colorize: Printer.status-message-error ? Theme.foreground : Theme.info;
                    width: 20px;
                    height: 20px;
                }
                Text {
                    text: Printer.status-message;
                    color: Theme.foreground;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        // Opens the light panel; lit while the main light (chamber or case light) is on.
        if Printer.leds.length > 0 && Printer.ready: Rectangle {
            width: 44px;
            border-radius: Theme.radius;
            background: light-touch.pressed ? Theme.surface-raised : transparent;
            accessible-role: button;
            accessible-label: @tr("Light");
            light-touch := TouchArea {
                clicked => {
                    Dialogs.dismiss();
                    Navigation.light-open = !Navigation.light-open;
                }
            }
            Image {
                source: Icons.accessory-light;
                colorize: Printer.light-on ? Theme.accent : Theme.muted;
                width: 24px;
                height: 24px;
            }
        }
        Text {
            text: Printer.clock;
            color: Theme.muted;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
        VerticalLayout {
            padding-top: Theme.spacing-tight;
            padding-bottom: Theme.spacing-tight;
            Rectangle {
                width: 64px;
                border-radius: Theme.radius;
                background: stop-touch.pressed ? Theme.danger-fill-pressed : Theme.danger-fill;
                accessible-role: button;
                accessible-label: @tr("Emergency stop");
                stop-touch := TouchArea {
                    clicked => {
                        Dialogs.dismiss();
                        Confirm.ask(@tr("Emergency stop"), @tr("Stops all motors and heaters immediately. Klipper must be restarted afterwards."), "emergency-stop", "", true);
                    }
                }
                Image {
                    source: Icons.system-emergency-stop;
                    colorize: Theme.foreground;
                    width: 28px;
                    height: 28px;
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <Page> page;
    in property <bool> enabled: true;
    // System stays marked on its pages below (console, settings, updates), so a tap leads back.
    property <bool> active: Navigation.page == root.page || (root.page == Page.system
        && (Navigation.page == Page.console || Navigation.page == Page.settings || Navigation.page == Page.updates
            || Navigation.page == Page.network));
    property <color> content: !root.enabled ? Theme.disabled-foreground : root.active ? Theme.accent : Theme.foreground;

    border-radius: Theme.radius;
    // The chosen page on the raised surface: the accent label stays readable there (on `surface-active` it is not).
    background: nav-touch.pressed ? Theme.surface-active : root.active ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;

    nav-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            // The Tune page opens with the basics; the expert tab is one tap away.
            if (root.page == Page.tune) { Navigation.tune-tab = TuneTab.basics; }
            Dialogs.dismiss();
            Navigation.page = root.page;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: 26px;
            height: 26px;
        }
        Text {
            text: root.label;
            color: root.content;
            font-size: Theme.font-label;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component NavRail inherits Rectangle {
    width: 76px;
    background: Theme.surface;

    VerticalLayout {
        padding: 3px;
        spacing: 1px;
        NavItem { icon: Icons.nav-printer; label: @tr("Print"); page: Page.print; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-move; label: @tr("Move"); page: Page.move; enabled: Printer.ready && !Printer.motion-locked; }
        NavItem { icon: Icons.nav-thermal; label: @tr("Thermal"); page: Page.temperature; enabled: Printer.ready; }
        NavItem { icon: Icons.filament-extrude; label: @tr("Filament"); page: Page.filament; enabled: Printer.ready && !Printer.motion-locked; }
        NavItem { icon: Icons.nav-tuning; label: @tr("Tune"); page: Page.tune; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-system; label: @tr("System"); page: Page.system; }
    }
}
