// Application frame: status bar at the top, navigation rail on the left.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Backlight, Confirm, Dialogs, Navigation, Network, Page, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { BusyWheel } from "busy-wheel.slint";

// A temperature of the status bar; a tap leads to the heaters without looking like a button.
component TemperatureReading inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> heating;
    // The name of the head this reading belongs to, shown before the icon; empty for none.
    in property <string> head;
    min-width: reading.min-width;
    preferred-width: reading.preferred-width;

    TouchArea {
        clicked => {
            Dialogs.dismiss();
            Navigation.show-heaters();
        }
    }

    reading := HorizontalLayout {
        spacing: Theme.spacing-small;
        if root.head != "": Text {
            text: root.head;
            color: Theme.muted;
            font-size: Theme.font-normal;
            vertical-alignment: center;
            overflow: elide;
            max-width: 56px;
        }
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.heating ? Theme.accent : Theme.muted;
            width: 20px;
            height: 20px;
        }
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
    }
}

// Counter of the errors not read yet; it stays until the message list is opened. The one coloured area besides buttons.
component UnreadCounter inherits Rectangle {
    in property <int> count;
    width: counter-row.preferred-width;
    height: 26px;
    border-radius: 13px;
    background: Theme.danger-fill;
    counter-row := HorizontalLayout {
        padding-left: Theme.spacing-medium;
        padding-right: 9px;
        spacing: 3px;
        Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-error;
            colorize: Theme.foreground;
            width: Theme.icon-compact;
            height: Theme.icon-compact;
        }
        Text {
            text: root.count;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

export component StatusBar inherits Rectangle {
    // The one place for what is running right now: a command of this display that waits long for its answer, what
    // the MMU is doing (whoever started it), or the network being changed.
    property <string> activity: Printer.running-command != "" ? Printer.running-command
        : Printer.mmu-action != "" && Printer.mmu-action != "Idle" ? Printer.mmu-action
        : Network.busy;
    property <Severity> severity: StateIcons.summary-severity();
    property <bool> shows-progress: !StateIcons.print-page-open() && Printer.ready && (Printer.print-state == "printing" || Printer.print-state == "paused");

    height: 44px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.spacing-small;
        padding-right: Theme.spacing-tight;
        spacing: Theme.spacing-large;

        // State and messages in one field. The state rests here; an event (an error or an information) lies in
        // front of it for a while; a tap opens the message list, or closes it.
        field := Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius;
            background: field-touch.pressed || Navigation.messages-open ? Theme.surface-active
                : Printer.status-message-visible ? Theme.surface-raised : transparent;
            accessible-role: button;
            accessible-label: Printer.status-message-visible ? Printer.status-message : StateIcons.summary-label();
            field-touch := TouchArea {
                clicked => {
                    if (Navigation.messages-open) {
                        Navigation.close-messages();
                    } else {
                        Dialogs.dismiss();
                        Navigation.open-messages();
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.spacing-medium;
                padding-right: Theme.spacing-medium;
                spacing: Theme.spacing;

                if Printer.status-message-visible: HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing;
                    Image {
                        cross-axis-self-alignment: center;
                        source: Printer.status-message-error ? Icons.ui-error : Icons.ui-info;
                        colorize: Printer.status-message-error ? Theme.danger : Theme.info;
                        width: Theme.icon-large;
                        height: Theme.icon-large;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Printer.status-message;
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // While something runs, the turning wheel and its name replace the state.
                if !Printer.status-message-visible && root.activity != "": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing-medium;
                    BusyWheel {
                        cross-axis-self-alignment: center;
                        width: 40px;
                        height: 40px;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.activity + " …";
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if !Printer.status-message-visible && root.activity == "": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing;
                    Image {
                        cross-axis-self-alignment: center;
                        source: StateIcons.summary();
                        colorize: StateIcons.severity-color(root.severity);
                        width: Theme.icon-large;
                        height: Theme.icon-large;
                    }
                    // The progress of a print stays whole when the detail is shortened.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing;
                        if StateIcons.summary-label() != "": Text {
                            min-width: self.preferred-width;
                            text: StateIcons.summary-label();
                            color: StateIcons.label-color(root.severity);
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if StateIcons.summary-value() != "": Text {
                            min-width: self.preferred-width;
                            text: StateIcons.summary-value();
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: StateIcons.summary-detail();
                            color: Theme.muted;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                if Printer.unread-errors > 0: UnreadCounter {
                    y: (parent.height - self.height) / 2;
                    count: Printer.unread-errors;
                }
            }

            // Progress of the print along the lower edge: accent while it runs, grey while it stands.
            if root.shows-progress: Rectangle {
                x: 6px;
                y: parent.height - 4px;
                width: parent.width - 12px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.surface-active;
                Rectangle {
                    x: 0;
                    width: parent.width * Printer.progress;
                    border-radius: 1.5px;
                    background: Printer.print-state == "printing" ? StateIcons.severity-color(Severity.running) : Theme.muted;
                }
            }
        }

        TemperatureReading {
            visible: Printer.ready;
            icon: Icons.thermal-nozzle;
            head: Printer.nozzle-head;
            heating: Printer.nozzle-selected && Printer.nozzle-target > 0;
            text: !Printer.nozzle-selected ? @tr("No head") : round(Printer.nozzle-temperature) + "°" + (Printer.nozzle-target > 0 ? " / " + round(Printer.nozzle-target) + "°" : "");
        }
        if Printer.has-bed: TemperatureReading {
            visible: Printer.ready;
            icon: Icons.thermal-bed;
            heating: Printer.bed-target > 0;
            text: round(Printer.bed-temperature) + "°" + (Printer.bed-target > 0 ? " / " + round(Printer.bed-target) + "°" : "");
        }
        // Opens the light panel; lit while the main light (chamber or case light) is on. A controllable backlight
        // of the display is reason enough, also without a ready printer.
        if (Printer.leds.length > 0 && Printer.ready) || Backlight.available: Rectangle {
            width: 44px;
            border-radius: Theme.radius;
            background: light-touch.pressed ? Theme.surface-raised : transparent;
            accessible-role: button;
            accessible-label: @tr("Light");
            light-touch := TouchArea {
                clicked => {
                    Dialogs.dismiss();
                    Navigation.light-open = !Navigation.light-open;
                }
            }
            Image {
                source: Icons.accessory-light;
                colorize: Printer.light-on ? Theme.accent : Theme.muted;
                width: Theme.icon-large;
                height: Theme.icon-large;
            }
        }
        VerticalLayout {
            padding-top: Theme.spacing-tight;
            padding-bottom: Theme.spacing-tight;
            Rectangle {
                width: 64px;
                border-radius: Theme.radius;
                background: stop-touch.pressed ? Theme.danger-fill-pressed : Theme.danger-fill;
                accessible-role: button;
                accessible-label: @tr("Emergency stop");
                stop-touch := TouchArea {
                    clicked => {
                        Dialogs.dismiss();
                        Confirm.ask(@tr("Emergency stop"), @tr("Stops all motors and heaters immediately. Klipper must be restarted afterwards."), "emergency-stop", "", true);
                    }
                }
                Image {
                    source: Icons.system-emergency-stop;
                    colorize: Theme.foreground;
                    width: Theme.icon;
                    height: Theme.icon;
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <Page> page;
    in property <bool> enabled: true;
    // Something needs a look: a small dot in the top right corner.
    in property <bool> warn;
    // System stays marked on its pages below (console, settings, updates), so a tap leads back.
    property <bool> active: Navigation.page == root.page || (root.page == Page.system
        && (Navigation.page == Page.console || Navigation.page == Page.settings || Navigation.page == Page.updates
            || Navigation.page == Page.network));
    property <color> content: !root.enabled ? Theme.disabled-foreground : root.active ? Theme.accent : Theme.foreground;

    border-radius: Theme.radius;
    // The chosen page on the raised surface: the accent label stays readable there (on `surface-active` it is not).
    background: nav-touch.pressed ? Theme.surface-active : root.active ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;

    nav-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            Dialogs.dismiss();
            Navigation.page = root.page;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing-tight;
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: Theme.icon-nav;
            height: Theme.icon-nav;
        }
        Text {
            text: root.label;
            color: root.content;
            font-size: Theme.font-label;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.warn: Rectangle {
        x: parent.width - self.width - 10px;
        y: 6px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.warning;
    }
}

export component NavRail inherits Rectangle {
    width: 76px;
    background: Theme.surface;

    VerticalLayout {
        padding: 3px;
        spacing: 1px;
        NavItem { icon: Icons.nav-printer; label: @tr("Print"); page: Page.print; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-move; label: @tr("Motion"); page: Page.motion; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-thermal; label: @tr("Thermal"); page: Page.temperature; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-filament; label: @tr("Filament"); page: Page.filament; enabled: Printer.ready && !Printer.motion-locked; }
        if Printer.has-changer: NavItem { icon: Icons.nav-changer; label: @tr("Changer"); page: Page.changer; enabled: Printer.ready; warn: Printer.has-changer-sensors && Printer.filament-sensor-runout; }
        NavItem { icon: Icons.nav-system; label: @tr("System"); page: Page.system; }
    }
}
