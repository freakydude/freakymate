// The spool in use, in one line; a tap opens the picker. Only for a printer without MMU: with one, the gate says it.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Printer, SpoolPicker } from "../state.slint";
import { ColorBar, TextWithValue } from "controls.slint";

export component SpoolStrip inherits Rectangle {
    height: 52px;
    background: Theme.surface;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: @tr("Spool");

    HorizontalLayout {
        padding: 6px;
        padding-left: 10px;
        spacing: 10px;
        ColorBar {
            cross-axis-self-alignment: center;
            width: 14px;
            height: 34px;
            vertical: true;
            first: Printer.spool-color;
            second: Printer.spool-color-2;
            third: Printer.spool-color-3;
            count: Printer.spool-color-count;
            longitudinal: Printer.spool-longitudinal;
            generic: true;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: Printer.has-spool ? Printer.spool-title : @tr("No spool selected");
                color: Printer.has-spool ? Theme.foreground : Theme.muted;
                font-size: Theme.font-normal;
                font-weight: 600;
                overflow: elide;
            }
            if Printer.has-spool: TextWithValue {
                text: Printer.spool-material;
                value: Printer.spool-weight;
                color: Printer.spool-low ? Theme.warning : Theme.muted;
            }
        }
        Image {
            cross-axis-self-alignment: center;
            source: Icons.filament-spool;
            colorize: Theme.muted;
            width: 22px;
            height: 22px;
        }
    }
    TouchArea {
        clicked => { SpoolPicker.show(-1, Printer.spool-id); }
    }
}
