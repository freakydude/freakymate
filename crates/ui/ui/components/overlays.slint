// Overlays: confirmation, messages flyout, on-screen keyboard, text and number entry, macro form, exclude objects,
// layer pause, the dialog of Klipper's calibration modes and the spool picker.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Dialogs, Navigation, Page, PrintObjectItem, Printer, SpoolPicker } from "../state.slint";
import { ColorBar, FlyoutPanel, IconButton, IconLabel, ScrollList, TextWithValue } from "controls.slint";
import { BedMap, BedMapLegend } from "bed-map.slint";
import { DialogHeader, DialogPanel, Scrim } from "dialog.slint";

export component ConfirmDialog inherits Scrim {
    visible: Confirm.open;

    DialogPanel {
        width: min(parent.width - 80px, 480px);
        height: min(parent.height - 24px, 270px);
        danger: Confirm.danger;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Confirm.title;
                close => { Confirm.open = false; }
            }

            Text {
                text: Confirm.message;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            IconButton {
                height: Theme.touch;
                icon: Confirm.danger ? Icons.ui-warning : Icons.ui-check;
                text: @tr("Confirm");
                kind: Confirm.danger ? "danger" : "accent";
                horizontal: true;
                clicked => { Confirm.execute(); }
            }
        }
    }
}

component SectionHeading inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    font-weight: 600;
    height: 18px;
    vertical-alignment: center;
}

// Flyout below the field of the status bar with all errors and informations, newest first: what came since the
// last time stands under "New", the rest under "Earlier". The page beside it stays covered by a tap catcher: a tap
// there closes the flyout and does nothing else, like a menu. Every way out goes through `Navigation.close-messages()`.
export component MessagesFlyout inherits Rectangle {
    // Below the status bar, so that its field, the light and the emergency stop stay in reach.
    TouchArea {
        y: 44px;
        height: root.height - 44px;
        clicked => { Navigation.close-messages(); }
    }

    FlyoutPanel {
        x: 8px;
        y: 50px;
        width: min(520px, root.width - 16px);
        height: root.height - 58px;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            DialogHeader {
                title: @tr("Messages");
                close => { Navigation.close-messages(); }
            }

            messages-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.messages-height;
                if Printer.messages-has-new: SectionHeading {
                    x: 0;
                    y: 0;
                    width: messages-list.row-width;
                    text: @tr("NEW");
                }
                if Printer.messages-has-earlier: SectionHeading {
                    x: 0;
                    y: Printer.messages-earlier-top;
                    width: messages-list.row-width;
                    text: @tr("EARLIER");
                }
                for message in Printer.messages: Rectangle {
                    x: 0;
                    y: message.top;
                    width: messages-list.row-width;
                    height: message.height;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Image {
                            y: 0px;
                            source: message.is-error ? Icons.ui-error : Icons.ui-info;
                            colorize: message.is-error ? Theme.danger : Theme.info;
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: message.text;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: message.new ? 600 : 400;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        Text {
                            text: message.time;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                        }
                    }
                }
            }

            // Flat and wide: the height belongs to the messages, the width keeps the buttons easy to hit.
            HorizontalLayout {
                spacing: Theme.spacing;
                height: 44px;
                alignment: end;
                IconButton {
                    width: 140px;
                    text: @tr("Clear");
                    icon: Icons.ui-delete;
                    icon-size: 20px;
                    horizontal: true;
                    min-height: 44px;
                    // Nothing is left to read: the flyout closes with it.
                    clicked => {
                        Actions.messages-clear();
                        Navigation.close-messages();
                    }
                }
                IconButton {
                    width: 140px;
                    text: @tr("Console");
                    icon: Icons.nav-console;
                    icon-size: 20px;
                    horizontal: true;
                    min-height: 44px;
                    clicked => {
                        Navigation.close-messages();
                        Navigation.page = Page.console;
                    }
                }
            }
        }
    }
}

component Key inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Orange like every confirming button (enter).
    in property <bool> accent;
    in property <length> font-size: Theme.font-normal;
    callback pressed;
    min-width: 40px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.accent ? (key-touch.pressed ? Theme.accent-pressed : Theme.accent)
        : (key-touch.pressed ? Theme.accent : Theme.surface-raised);
    property <color> content: root.accent || key-touch.pressed ? Theme.on-accent : Theme.foreground;
    accessible-role: button;
    accessible-label: root.label;

    key-touch := TouchArea {
        clicked => { root.pressed(); }
    }

    if root.icon.width > 0: Image {
        source: root.icon;
        colorize: root.content;
        width: 22px;
        height: 22px;
    }
    if root.icon.width == 0: Text {
        text: root.label;
        color: root.content;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// On-screen keyboard for devices without a physical keyboard. It only reports the keys; the text field edits itself.
export component OnScreenKeyboard inherits VerticalLayout {
    in-out property <bool> upper: true;
    in-out property <bool> symbols;
    // A character key (the text on it), backspace and enter.
    callback typed(string);
    callback backspace;
    callback enter;

    property <[[string]]> lower-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "="],
        ["z", "x", "c", "v", "b", "n", "m", ".", "-", "_"],
    ];
    property <[[string]]> upper-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L", "="],
        ["Z", "X", "C", "V", "B", "N", "M", ".", "-", "_"],
    ];
    property <[[string]]> symbol-rows: [
        ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"],
        ["+", "=", "?", "'", "\"", ",", ";", "<", ">", "|"],
        ["[", "]", "{", "}", "\\", "~", "`", "€", "§", "°"],
        ["ä", "ö", "ü", "ß", "Ä", "Ö", "Ü", ".", "-", "_"],
    ];

    spacing: 4px;

    for row in (root.symbols ? root.symbol-rows : root.upper ? root.upper-rows : root.lower-rows): HorizontalLayout {
        spacing: 4px;
        // The rows share the height of the dialog, so the keys get as large as the screen allows.
        min-height: 40px;
        vertical-stretch: 1;
        for key in row: Key {
            label: key;
            pressed => { root.typed(key); }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        // The rows share the height of the dialog, so the keys get as large as the screen allows.
        min-height: 40px;
        vertical-stretch: 1;
        Key {
            label: root.upper ? "abc" : "ABC";
            horizontal-stretch: 2;
            pressed => {
                root.symbols = false;
                root.upper = !root.upper;
            }
        }

        Key {
            label: root.symbols ? "abc" : "#+=";
            horizontal-stretch: 2;
            pressed => { root.symbols = !root.symbols; }
        }

        Key {
            label: ":";
            pressed => { root.typed(":"); }
        }

        Key {
            label: "/";
            pressed => { root.typed("/"); }
        }

        Key {
            label: @tr("space");
            horizontal-stretch: 3;
            pressed => { root.typed(" "); }
        }

        Key {
            label: @tr("backspace");
            icon: Icons.ui-chevron-left;
            horizontal-stretch: 2;
            pressed => { root.backspace(); }
        }

        Key {
            label: @tr("enter");
            icon: Icons.ui-check;
            accent: true;
            horizontal-stretch: 2;
            pressed => { root.enter(); }
        }
    }
}

// Full-screen text entry with on-screen keyboard; `secret` hides the input (passwords). The field is Slint's own
// `TextInput`: cursor, selection, Home/End, Delete, Backspace, Ctrl+C/V and the like come from it, for the physical
// keyboard and, as key presses, for the on-screen keys alike.
export component TextEntryDialog inherits Scrim {
    in property <string> title;
    in property <bool> secret;
    in-out property <string> text;
    in-out property <bool> open;
    callback accepted(string);
    property <bool> reveal;
    // A tap on the status bar or the navigation cancels the entry.
    property <int> dismissals: Dialogs.dismissals;
    visible: root.open;

    function close() {
        root.reveal = false;
        root.open = false;
    }

    changed dismissals => {
        root.close();
    }

    changed open => {
        if (root.open) {
            field.focus();
            field.select-all();
        }
    }

    FocusScope {
        width: parent.width;
        height: parent.height;
        // Escape closes the dialog; every other key is for the field.
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        DialogPanel {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;

            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.spacing;
                HorizontalLayout {
                    spacing: Theme.spacing;
                    // As high as the buttons in it, so they keep the gap to the keys.
                    height: Theme.touch;
                    // The name of the field, not a title: the keyboard needs the room.
                    Text {
                        text: root.title;
                        color: Theme.muted;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        max-width: 260px;
                        overflow: elide;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.background;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.accent;
                        clip: true;
                        forward-focus: field;
                        field := TextInput {
                            // Keeps the cursor in view when the text is longer than the field.
                            property <length> computed-x;
                            x: 8px + min(0px, max(parent.width - 16px - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - 16px - self.text-cursor-width, self.preferred-width);
                            height: 100%;
                            single-line: true;
                            vertical-alignment: center;
                            text <=> root.text;
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            input-type: root.secret && !root.reveal ? InputType.password : InputType.text;
                            accepted => {
                                root.close();
                                root.accepted(root.text);
                            }
                            cursor-position-changed(position) => {
                                if (position.x + self.computed-x < 0px) {
                                    self.computed-x = -position.x;
                                } else if (position.x + self.computed-x > parent.width - 16px - self.text-cursor-width) {
                                    self.computed-x = parent.width - 16px - position.x - self.text-cursor-width;
                                }
                            }
                        }
                    }

                    if root.secret: IconButton {
                        icon: root.reveal ? Icons.ui-unlock : Icons.ui-lock;
                        width: 56px;
                        checked: root.reveal;
                        accessible-label: @tr("Show password");
                        clicked => { root.reveal = !root.reveal; }
                    }
                    IconButton {
                        icon: Icons.ui-close;
                        width: 56px;
                        clicked => { root.close(); }
                    }
                }

                OnScreenKeyboard {
                    vertical-stretch: 1;
                    typed(key) => { Actions.press-key(key); }
                    backspace => { Actions.press-key(Key.Backspace); }
                    enter => { Actions.press-key(Key.Return); }
                }
            }
        }
    }
}

// Keys for numbers, 7 8 9 on top as on a calculator; enter wide at the bottom right like on the full keyboard.
component NumericKeypad inherits VerticalLayout {
    callback typed(string);
    callback backspace;
    callback enter;

    property <[[string]]> rows: [["7", "8", "9"], ["4", "5", "6"], ["1", "2", "3"]];
    // The key at the right end of each of the rows above.
    property <[string]> row-ends: ["", "-", "."];

    spacing: 6px;

    for row[index] in root.rows: HorizontalLayout {
        spacing: 6px;
        vertical-stretch: 1;
        for key in row: Key {
            label: key;
            font-size: Theme.font-large;
            pressed => { root.typed(key); }
        }
        if index == 0: Key {
            label: @tr("backspace");
            icon: Icons.ui-chevron-left;
            pressed => { root.backspace(); }
        }
        if index > 0: Key {
            label: root.row-ends[index];
            font-size: Theme.font-large;
            pressed => { root.typed(self.label); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        vertical-stretch: 1;
        Key {
            label: "0";
            font-size: Theme.font-large;
            horizontal-stretch: 2;
            pressed => { root.typed("0"); }
        }
        Key {
            label: @tr("enter");
            icon: Icons.ui-check;
            accent: true;
            horizontal-stretch: 2;
            pressed => { root.enter(); }
        }
    }
}

// Entry of a number with the numeric keypad, as a small dialog in the middle of the content area. Like the text
// entry, the field is Slint's own `TextInput`, so a physical keyboard works too. What the number may be (range,
// decimals) the receiver decides; Klipper checks its own limits.
export component NumberEntryDialog inherits Scrim {
    in property <string> title;
    // Shown after the number, e.g. "°C" or "g".
    in property <string> unit;
    // A quiet note below the field, e.g. the range the printer takes; with `hint-warning` it says the typed value lies
    // outside. Nothing is blocked: the receiver (Klipper) decides.
    in property <string> hint;
    in property <bool> hint-warning;
    in-out property <string> text;
    in-out property <bool> open;
    callback accepted(string);
    // A tap on the status bar or the navigation cancels the entry.
    property <int> dismissals: Dialogs.dismissals;
    visible: root.open;

    changed dismissals => {
        root.open = false;
    }

    changed open => {
        if (root.open) {
            field.focus();
            field.select-all();
        }
    }

    FocusScope {
        width: parent.width;
        height: parent.height;
        // Escape closes the dialog; every other key is for the field.
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.open = false;
                return accept;
            }
            reject
        }

        DialogPanel {
            width: 380px;
            height: parent.height - 16px;
            x: (parent.width - self.width) / 2;
            y: 8px;

            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.spacing;
                DialogHeader {
                    title: root.title;
                    close => { root.open = false; }
                }
                Rectangle {
                    height: Theme.touch;
                    background: Theme.background;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    clip: true;
                    forward-focus: field;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        field := TextInput {
                            horizontal-stretch: 1;
                            single-line: true;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            text <=> root.text;
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            font-weight: 600;
                            input-type: InputType.decimal;
                            accepted => {
                                root.open = false;
                                root.accepted(root.text);
                            }
                        }
                        if root.unit != "": Text {
                            text: root.unit;
                            color: Theme.muted;
                            font-size: Theme.font-large;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.hint != "" && !root.hint-warning: Text {
                    text: root.hint;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                if root.hint != "" && root.hint-warning: IconLabel {
                    alignment: end;
                    icon: Icons.ui-warning;
                    icon-size: 14px;
                    text: root.hint;
                    color: Theme.warning;
                    font-size: Theme.font-small;
                }
                NumericKeypad {
                    vertical-stretch: 1;
                    typed(key) => { Actions.press-key(key); }
                    backspace => { Actions.press-key(Key.Backspace); }
                    enter => { Actions.press-key(Key.Return); }
                }
            }
        }
    }
}

// Parameters of a macro: one field per parameter, Klipper defaults as placeholders. Running asks for confirmation.
export component MacroFormDialog inherits Scrim {
    in-out property <bool> open;
    property <int> edit-index: -1;
    // A tap on the status bar or the navigation cancels the form.
    property <int> dismissals: Dialogs.dismissals;
    visible: root.open;

    changed dismissals => {
        root.open = false;
    }

    DialogPanel {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Printer.macro-form-name;
                close => { root.open = false; }
            }

            // Each parameter is an input field: its name on the left, the value (or the Klipper default in grey) on the
            // right. The names share one column width, so the fields line up.
            params-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.macro-form.length * (Theme.touch + Theme.spacing);
                for param[index] in Printer.macro-form: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: params-list.row-width - 16px;
                    height: Theme.touch;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 12px;
                        Text {
                            width: min(220px, params-list.row-width * 0.3);
                            text: param.name;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: param.value != "" ? param.value : param.placeholder;
                                color: param.value != "" ? Theme.foreground : Theme.disabled-foreground;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.edit-index = index;
                            if (param.numeric) {
                                edit-number.title = param.name;
                                edit-number.text = param.value;
                                edit-number.open = true;
                            } else {
                                edit.title = param.name;
                                edit.text = param.value;
                                edit.open = true;
                            }
                        }
                    }
                }
            }

            IconButton {
                height: Theme.touch;
                text: @tr("Run");
                icon: Icons.ui-check;
                kind: "accent";
                horizontal: true;
                // Running is the confirmation: the user has just seen every parameter.
                clicked => {
                    Actions.run-macro(Actions.macro-form-script());
                    root.open = false;
                }
            }
        }
    }

    edit := TextEntryDialog {
        accepted(text) => { Actions.set-macro-param(root.edit-index, text); }
    }
    edit-number := NumberEntryDialog {
        accepted(text) => { Actions.set-macro-param(root.edit-index, text); }
    }
}

// Objects of the running print: on a map of the bed if the slicer told where they lie, and always as a list (the way
// to objects that overlap or have no place). Tapping only selects; "Exclude" then skips the object for the rest of
// the print, which replaces a confirmation. Names are shown as Klipper reports them and may wrap.
export component ExcludeObjectsDialog inherits Scrim {
    in-out property <bool> open;
    in-out property <int> selected: -1;
    property <bool> has-selection: root.selected >= 0 && root.selected < Printer.print-objects.length;
    property <PrintObjectItem> chosen: Printer.print-objects[root.selected];
    // Room for the map: the dialog without its margin, padding, title and buttons; the list keeps the rest.
    property <length> map-room-height: root.height - 16px - 2 * Theme.dialog-padding - 2 * Theme.touch - 2 * Theme.spacing;
    property <length> map-width: min(root.map-room-height * Printer.bed-map.width / Printer.bed-map.depth, (root.width - 16px - 2 * Theme.dialog-padding) * 0.55);
    // A tap on the status bar or the navigation closes the dialog without excluding anything.
    property <int> dismissals: Dialogs.dismissals;
    visible: root.open;
    changed open => {
        root.selected = -1;
    }
    changed dismissals => {
        root.open = false;
    }

    DialogPanel {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("Exclude objects");
                close => { root.open = false; }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.spacing;
                // Wrapper: the map keeps the bed's shape at the top of the column.
                if Printer.bed-map.shown: Rectangle {
                    width: root.map-width;
                    BedMap {
                        y: 0;
                        width: parent.width;
                        height: parent.width * Printer.bed-map.depth / Printer.bed-map.width;
                        selected <=> root.selected;
                    }
                }
                objects-list := ScrollList {
                    vertical-stretch: 1;
                    content-height: Printer.print-objects.length * (Theme.touch + Theme.spacing);
                    for item[index] in Printer.print-objects: Rectangle {
                        x: 8px;
                        y: index * (Theme.touch + Theme.spacing);
                        width: objects-list.row-width - 16px;
                        height: Theme.touch;
                        background: item.excluded ? Theme.background : Theme.surface-raised;
                        border-radius: Theme.radius;
                        border-width: index == root.selected ? 2px : 0px;
                        border-color: Theme.foreground;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            // Long names wrap onto a second line instead of being cut short.
                            Text {
                                horizontal-stretch: 1;
                                text: item.name;
                                color: item.excluded ? Theme.disabled-foreground : Theme.foreground;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                wrap: char-wrap;
                                overflow: elide;
                            }
                            Text {
                                text: item.excluded ? @tr("Excluded") : item.printing ? @tr("Printing") : "";
                                color: item.printing && !item.excluded ? Theme.accent : Theme.muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.selected = index; }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                if Printer.bed-map.shown: BedMapLegend {
                    width: root.map-width;
                }
                IconButton {
                    text: @tr("Exclude");
                    icon: Icons.print-exclude-object;
                    horizontal: true;
                    kind: "danger";
                    enabled: Printer.is-printing && root.has-selection && !root.chosen.excluded;
                    clicked => { Actions.exclude-object(root.chosen.name); }
                }
            }
        }
    }
}

// Plans a pause at a layer with Mainsail's macros: one counter from the next layer on, the core picks the macro.
// What is planned shows if the macros' variables tell it; otherwise "Clear" is always offered.
export component LayerPauseDialog inherits Scrim {
    property <bool> shown;
    property <int> layer;
    property <int> first-layer: Printer.current-layer + 1;
    // Only the next layer without SET_PAUSE_AT_LAYER; without a reported total the layer has no upper limit.
    property <int> last-layer: !Printer.layer-pause-at ? root.first-layer : Printer.total-layers > 0 ? Printer.total-layers : 999999;
    // The chosen layer, never one the print has reached meanwhile.
    property <int> target: max(root.first-layer, min(root.last-layer, root.layer));
    property <bool> next-layer: root.target == root.first-layer;
    property <string> target-height: Actions.height-at-layer(root.target);
    // A tap on the status bar or the navigation closes the dialog without planning a pause.
    property <int> dismissals: Dialogs.dismissals;
    visible: root.shown && (Printer.layer-pause-next || Printer.layer-pause-at);

    changed dismissals => {
        root.shown = false;
    }

    public function open() {
        root.layer = root.first-layer;
        root.shown = true;
    }

    function step(delta: int) {
        root.layer = max(root.first-layer, min(root.last-layer, root.target + delta));
    }

    DialogPanel {
        width: min(parent.width - 16px, 520px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("Pause at a layer");
                close => { root.shown = false; }
            }
            Text {
                text: (Printer.total-layers > 0 ? @tr("Now at layer {} of {}", Printer.current-layer, Printer.total-layers) : @tr("Now at layer {}", Printer.current-layer)) + (Printer.print-heights != "" ? " · " + Printer.print-heights : "");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
            if Printer.layer-pause-planned != "": Text {
                text: Printer.layer-pause-planned == "next" ? @tr("Planned: pause at the next layer") : @tr("Planned: pause at layer {}", Printer.layer-pause-planned);
                color: Theme.accent;
                font-size: Theme.font-small;
            }
            if Printer.layer-pause-at: HorizontalLayout {
                spacing: Theme.spacing;
                IconButton {
                    text: "−10";
                    clicked => { root.step(-10); }
                }
                IconButton {
                    icon: Icons.ui-minus;
                    clicked => { root.step(-1); }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.target;
                        color: Theme.foreground;
                        font-size: Theme.font-large;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    // A layer ahead has a predicted height; the next layer also says so.
                    Text {
                        text: root.next-layer ? (root.target-height != "" ? @tr("next layer · {}", root.target-height) : @tr("next layer")) : root.target-height;
                        color: Theme.muted;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                    }
                }
                IconButton {
                    icon: Icons.ui-plus;
                    clicked => { root.step(1); }
                }
                IconButton {
                    text: "+10";
                    clicked => { root.step(10); }
                }
            }
            IconButton {
                icon: Icons.print-pause;
                text: root.next-layer ? @tr("Pause at the next layer") : @tr("Pause at layer {}", root.target);
                horizontal: true;
                kind: "accent";
                clicked => {
                    Actions.pause-at-layer(root.target);
                    root.shown = false;
                }
            }
            if !Printer.layer-pause-plan-known || Printer.layer-pause-planned != "": IconButton {
                icon: Icons.ui-delete;
                text: @tr("Clear planned pause");
                horizontal: true;
                clicked => {
                    Actions.clear-layer-pause();
                    root.shown = false;
                }
            }
        }
    }
}

// The mode Klipper waits in during a calibration (manual probe or bed screws), started here or elsewhere. It opens
// by itself and closes when Klipper leaves the mode; closing it here leaves the mode with ABORT (Frank, 2026-10-28).
export component CalibrationDialog inherits Scrim {
    property <string> mode: Printer.calibration-mode;
    property <bool> probing: root.mode == "manual-probe";
    // Closed here; stays hidden until Klipper reports the end of the mode or the printer is back.
    property <bool> closing;
    property <bool> ready: Printer.ready;
    property <int> dismissals: Dialogs.dismissals;
    visible: root.mode != "" && !root.closing;

    changed dismissals => {
        if (root.mode != "") { root.closing = true; }
    }
    changed mode => {
        if (root.mode == "") { root.closing = false; }
    }
    changed ready => {
        root.closing = false;
    }

    DialogPanel {
        width: min(parent.width - 16px, 640px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: root.probing ? @tr("Paper test: Z height") : @tr("Paper test: bed screws");
                close => { Dialogs.dismiss(); }
            }
            Text {
                text: root.probing
                    ? @tr("Move the nozzle until a sheet of paper between nozzle and bed drags slightly, then accept.")
                    : @tr("Turn the screw until a sheet of paper drags slightly. Accept if it needed no turn, Adjusted if you turned it.");
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }

            if root.probing: HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    text: @tr("Z {} mm", Printer.probe-z);
                    color: Theme.foreground;
                    font-size: Theme.font-huge;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: (Printer.probe-z-lower != "" ? @tr("tried below: {}", Printer.probe-z-lower) : "")
                        + (Printer.probe-z-lower != "" && Printer.probe-z-upper != "" ? "\n" : "")
                        + (Printer.probe-z-upper != "" ? @tr("tried above: {}", Printer.probe-z-upper) : "");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            if root.probing: HorizontalLayout {
                spacing: Theme.spacing;
                for distance in [-1, -0.1, -0.05, -0.01, 0.01, 0.05, 0.1, 1]: IconButton {
                    horizontal-stretch: 1;
                    text: (distance > 0 ? "+" : "−") + abs(distance);
                    clicked => { Actions.test-z(distance); }
                }
            }
            if root.probing: HorizontalLayout {
                spacing: Theme.spacing;
                IconButton {
                    horizontal-stretch: 1;
                    horizontal: true;
                    icon: Icons.ui-chevron-down;
                    text: @tr("Halfway down");
                    enabled: Printer.probe-z-lower != "";
                    clicked => { Actions.bisect-z(-1); }
                }
                IconButton {
                    horizontal-stretch: 1;
                    horizontal: true;
                    icon: Icons.ui-chevron-up;
                    text: @tr("Halfway up");
                    enabled: Printer.probe-z-upper != "";
                    clicked => { Actions.bisect-z(1); }
                }
            }

            if !root.probing: Text {
                text: Printer.bed-screw;
                color: Theme.foreground;
                font-size: Theme.font-huge;
                font-weight: 600;
                overflow: elide;
            }
            if !root.probing: Text {
                text: (Printer.bed-screw-fine ? @tr("Fine adjustment") + " · " : "")
                    + @tr("accepted in a row: {} of {}", Printer.bed-screws-accepted, Printer.bed-screws-count);
                color: Theme.muted;
                font-size: Theme.font-small;
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                if !root.probing: IconButton {
                    height: Theme.touch;
                    horizontal-stretch: 1;
                    horizontal: true;
                    icon: Icons.calibration-bed-screws;
                    text: @tr("Adjusted");
                    clicked => { Actions.screw-adjusted(); }
                }
                IconButton {
                    height: Theme.touch;
                    horizontal-stretch: 1;
                    horizontal: true;
                    icon: Icons.ui-check;
                    text: @tr("Accept");
                    kind: "accent";
                    clicked => { Actions.accept-calibration(); }
                }
            }
        }
    }
}

// Picks a spool of Spoolman for the gate (or, without MMU, as the active spool), weighs it, or takes it out of the gate.
// The list shows the spools in a lane first, then the most recently used ones.
export component SpoolDialog inherits Scrim {
    property <int> selected: -1;
    visible: SpoolPicker.open;

    changed visible => {
        root.selected = self.visible ? SpoolPicker.current : -1;
    }

    DialogPanel {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: SpoolPicker.gate >= 0 ? @tr("Spool for gate {}", SpoolPicker.gate) : @tr("Spool in use");
                close => { SpoolPicker.open = false; }
                if Printer.spoolman-offline: IconLabel {
                    icon: Icons.ui-warning;
                    text: Printer.spoolman-pending > 0 ? @tr("Spoolman offline, {} reports waiting", Printer.spoolman-pending) : @tr("Spoolman offline");
                    color: Theme.warning;
                    font-size: Theme.font-small;
                }
            }
            spools-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.spools.length * (Theme.touch + Theme.spacing);
                for spool[index] in Printer.spools: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: spools-list.row-width - 16px;
                    height: Theme.touch;
                    background: spool.id == root.selected ? Theme.surface-active : Theme.surface-raised;
                    border-radius: Theme.radius;
                    border-width: spool.id == root.selected ? 2px : 0px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 10px;
                        ColorBar {
                            cross-axis-self-alignment: center;
                            width: 14px;
                            height: 34px;
                            vertical: true;
                            first: spool.color;
                            second: spool.color-2;
                            third: spool.color-3;
                            count: spool.color-count;
                            longitudinal: spool.longitudinal;
                            generic: true;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: spool.title;
                                color: Theme.foreground;
                                font-size: Theme.font-normal;
                                font-weight: 600;
                                overflow: elide;
                            }
                            TextWithValue {
                                text: spool.material;
                                value: spool.remaining;
                                color: spool.low ? Theme.warning : Theme.muted;
                            }
                        }
                        Text {
                            text: spool.place;
                            color: Theme.accent;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.selected = spool.id; }
                    }
                }
            }
            if Printer.spools.length == 0: Text {
                text: Printer.spools-loading ? @tr("Loading") : @tr("No spools");
                color: Theme.muted;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                // Takes only the link to Spoolman away; Happy Hare keeps material and colour of the gate.
                if SpoolPicker.gate >= 0: IconButton {
                    text: @tr("Unlink");
                    horizontal: true;
                    enabled: SpoolPicker.current >= 0;
                    clicked => {
                        Actions.assign-gate-spool(SpoolPicker.gate, -1);
                        SpoolPicker.open = false;
                    }
                }
                IconButton {
                    icon: Icons.filament-spool;
                    text: @tr("Weigh");
                    horizontal: true;
                    enabled: root.selected >= 0;
                    clicked => {
                        weigh.text = "";
                        weigh.open = true;
                    }
                }
                IconButton {
                    icon: Icons.ui-check;
                    text: SpoolPicker.gate >= 0 ? @tr("Assign") : @tr("Use");
                    horizontal: true;
                    kind: "accent";
                    enabled: root.selected >= 0;
                    clicked => {
                        if (SpoolPicker.gate >= 0) {
                            Actions.assign-gate-spool(SpoolPicker.gate, root.selected);
                        } else {
                            Actions.set-active-spool(root.selected);
                        }
                        SpoolPicker.open = false;
                    }
                }
            }
        }
    }

    // The weight of the spool with its core, as the scale shows it; Spoolman subtracts the empty spool.
    weigh := NumberEntryDialog {
        title: @tr("Weight with the empty spool");
        unit: "g";
        accepted(text) => { Actions.measure-spool(root.selected, text); }
    }
}
