// Temperature history of one heater or sensor: the last minutes from Moonraker, growing while it is open.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Printer } from "../state.slint";
import { ButtonKind, IconButton, Note } from "controls.slint";
import { DialogHeader, DialogPanel, Scrim } from "dialog.slint";
import { NumberEntryDialog } from "entry-dialogs.slint";

// A line of the chart. The view box is 1000 high and as wide as the drawing area's shape, because a path is scaled
// evenly; the lines are computed for that shape (`Navigation.history-aspect`).
component ChartLine inherits Path {
    viewbox-width: 1000 * Navigation.history-aspect;
    viewbox-height: 1000;
    stroke-width: 2px;
}

component Legend inherits HorizontalLayout {
    in property <color> color;
    in property <string> text;
    spacing: Theme.spacing-medium;
    Rectangle { cross-axis-self-alignment: center; width: 16px; height: 3px; background: root.color; }
    Text { text: root.text; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
}

// A value that is read: the name above, the value below.
component Labelled inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    alignment: center;
    Text { text: root.label; color: Theme.muted; font-size: Theme.font-small; }
    Text { text: root.value; color: Theme.foreground; font-size: Theme.font-normal; font-weight: 600; }
}

export component HistoryDialog inherits Scrim {
    visible: Navigation.history-open;

    // The target of a PID tuning: what the person typed, else what the core offers (230 °C for a nozzle, 70 °C for
    // the bed, nothing for another heater).
    property <bool> open: Navigation.history-open;
    property <bool> typed;
    property <float> typed-target;
    property <float> pid-target: root.typed ? root.typed-target : Printer.history-pid-target;
    changed open => { root.typed = false; }

    DialogPanel {
        x: Theme.dialog-inset;
        y: Theme.dialog-inset;
        width: parent.width - 2 * Theme.dialog-inset;
        height: parent.height - 2 * Theme.dialog-inset;
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: Theme.spacing;
        DialogHeader {
            title: Printer.history-title;
            close => { Actions.close-history(); }
            Text {
                text: Printer.history-current;
                color: Theme.accent;
                font-size: Theme.font-large;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Temperature labels left of the chart, time labels below it; both at the grid lines.
        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;
            temperature-axis := Rectangle {
                width: 56px;
                for label in Printer.history-temperature-labels: Text {
                    x: 0;
                    y: Theme.dialog-inset + (parent.height - 2 * Theme.dialog-inset) * label.position - 8px;
                    width: parent.width;
                    height: 16px;
                    text: label.text;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            chart := Rectangle {
                horizontal-stretch: 1;
                init => { Navigation.history-aspect = (self.width - 2 * Theme.dialog-inset) / max(1px, self.height - 2 * Theme.dialog-inset); }
                changed width => { Navigation.history-aspect = (self.width - 2 * Theme.dialog-inset) / max(1px, self.height - 2 * Theme.dialog-inset); }
                changed height => { Navigation.history-aspect = (self.width - 2 * Theme.dialog-inset) / max(1px, self.height - 2 * Theme.dialog-inset); }
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                ChartLine {
                    x: Theme.dialog-inset;
                    y: Theme.dialog-inset;
                    width: parent.width - 2 * Theme.dialog-inset;
                    height: parent.height - 2 * Theme.dialog-inset;
                    commands: Printer.history-grid-path;
                    stroke: Theme.border;
                    stroke-width: 1px;
                }
                ChartLine {
                    x: Theme.dialog-inset;
                    y: Theme.dialog-inset;
                    width: parent.width - 2 * Theme.dialog-inset;
                    height: parent.height - 2 * Theme.dialog-inset;
                    commands: Printer.history-power-path;
                    stroke: Theme.chart-secondary;
                }
                ChartLine {
                    x: Theme.dialog-inset;
                    y: Theme.dialog-inset;
                    width: parent.width - 2 * Theme.dialog-inset;
                    height: parent.height - 2 * Theme.dialog-inset;
                    commands: Printer.history-target-path;
                    stroke: Theme.muted;
                }
                ChartLine {
                    x: Theme.dialog-inset;
                    y: Theme.dialog-inset;
                    width: parent.width - 2 * Theme.dialog-inset;
                    height: parent.height - 2 * Theme.dialog-inset;
                    commands: Printer.history-temperature-path;
                    stroke: Theme.accent;
                    stroke-width: 3px;
                }
                if Printer.history-temperature-path == "": Text {
                    text: @tr("Loading the history from Moonraker …");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            height: 18px;
            Rectangle { width: temperature-axis.width; }
            Rectangle {
                horizontal-stretch: 1;
                for label in Printer.history-time-labels: Text {
                    x: Theme.dialog-inset + (parent.width - 2 * Theme.dialog-inset) * label.position - self.width / 2;
                    width: 60px;
                    text: label.text;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                }
                Text {
                    x: parent.width - 8px - self.width / 2;
                    text: @tr("now");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
            }
        }

        HorizontalLayout {
            spacing: 2 * Theme.spacing;
            alignment: end;
            Legend { color: Theme.accent; text: @tr("Temperature"); }
            if Printer.history-target-path != "": Legend { color: Theme.muted; text: @tr("Target"); }
            if Printer.history-power-path != "": Legend { color: Theme.chart-secondary; text: @tr("Power"); }
        }

        // Klipper has found values for this heater, whoever started the tuning: show them with the old ones.
        if Printer.history-pid-available && Printer.history-pid-running-target <= 0 && Printer.history-pid-has-result: VerticalLayout {
            spacing: Theme.spacing;
            Note { text: @tr("Result of PID_CALIBRATE, pending for printer.cfg. Takes effect after Save config, which restarts Klipper."); }
            HorizontalLayout {
                height: Theme.touch;
                spacing: Theme.spacing-large;
                for value in Printer.history-pid-result: Labelled {
                    label: value.current != "" ? @tr("{} (was {})", value.name, value.current) : value.name;
                    value: value.pending;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    width: 200px;
                    horizontal: true;
                    icon: Icons.ui-save;
                    text: @tr("Save config");
                    kind: ButtonKind.accent;
                    clicked => { Confirm.ask(@tr("Save config"), @tr("Klipper writes the configuration and restarts."), "save-config", "", false); }
                }
            }
        }
        // Our own PID_CALIBRATE has not been answered: Klipper is busy.
        if Printer.history-pid-available && Printer.history-pid-running-target > 0: HorizontalLayout {
            height: Theme.touch;
            spacing: Theme.spacing-large;
            Image {
                source: Icons.calibration-pid;
                colorize: Theme.foreground;
                width: Theme.icon-large;
                height: Theme.icon-large;
                cross-axis-self-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("PID_CALIBRATE at {} °C", round(Printer.history-pid-running-target));
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                    font-weight: 600;
                }
                Note { text: @tr("Klipper accepts no other command until it ends. Only the emergency stop ends it early."); }
            }
        }
        // Without a result the heater can be tuned: the target is a field like on the heater row.
        if Printer.history-pid-available && Printer.history-pid-running-target <= 0 && !Printer.history-pid-has-result: HorizontalLayout {
            height: Theme.touch;
            spacing: Theme.spacing;
            Rectangle {
                width: 110px;
                border-radius: Theme.radius;
                background: target-touch.pressed ? Theme.surface-active : Theme.surface-raised;
                accessible-role: button;
                accessible-label: @tr("Target");
                target-touch := TouchArea {
                    clicked => {
                        pid-entry.text = root.pid-target > 0 ? round(root.pid-target) : "";
                        pid-entry.open = true;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: @tr("Target"); color: Theme.muted; font-size: Theme.font-small; horizontal-alignment: center; }
                    Text {
                        text: root.pid-target > 0 ? round(root.pid-target) + " °C" : "—";
                        color: root.pid-target > 0 ? Theme.accent : Theme.muted;
                        font-size: Theme.font-large;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }
            }
            if Printer.history-pid-current != "": Labelled {
                horizontal-stretch: 1;
                label: @tr("In printer.cfg now");
                value: Printer.history-pid-current;
            }
            if Printer.history-pid-current == "": Rectangle { horizontal-stretch: 1; }
            IconButton {
                width: 200px;
                horizontal: true;
                icon: Icons.calibration-pid;
                text: @tr("PID tune");
                kind: ButtonKind.accent;
                enabled: root.pid-target > 0 && !Printer.is-printing;
                clicked => {
                    Confirm.ask(@tr("PID tune {}", Printer.history-title),
                        @tr("Heats to {} °C and takes several minutes. Klipper accepts no other command meanwhile; only the emergency stop ends it early.", round(root.pid-target)),
                        "pid-tune", round(root.pid-target), false);
                    Confirm.confirm-text = @tr("Start");
                }
            }
        }
    }
    }

    pid-entry := NumberEntryDialog {
        unit: "°C";
        title: @tr("PID tune target");
        hint: Printer.history-pid-range;
        hint-warning: Actions.heater-target-outside(Printer.history-object, self.text);
        accepted(text) => {
            if (text.is-float()) {
                root.typed-target = text.to-float();
                root.typed = true;
            }
        }
    }
}
