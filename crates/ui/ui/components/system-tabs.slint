// Tabs of the system pages: the machine (Klipper, host, power devices), updates, the host's network, the console
// and the settings of this display. Each tab is a page of its own; the navigation rail keeps System marked on all of them.

import { Icons } from "../icons.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { TabBar, TabButton } from "controls.slint";

component SystemTab inherits TabButton {
    in property <Page> page;
    in property <string> label;
    // Five tabs share the width of the page.
    min-width: 0px;
    text: root.label;
    checked: Navigation.page == root.page;
    clicked => { Navigation.page = root.page; }
}

// The pages around it have their own padding.
export component SystemTabs inherits TabBar {
    inset: 0px;
    SystemTab { page: Page.system; icon: Icons.system-host; label: @tr("Machine"); }
    if Printer.has-update-manager: SystemTab {
        page: Page.updates;
        icon: Icons.system-update;
        label: @tr("Updates");
        count: Printer.updates-available;
        enabled: Printer.connection == "connected";
    }
    SystemTab { page: Page.network; icon: Icons.system-network; label: @tr("Network"); }
    SystemTab {
        page: Page.console;
        icon: Icons.nav-console;
        label: @tr("Console");
        enabled: Printer.connection == "connected";
    }
    SystemTab { page: Page.settings; icon: Icons.nav-settings; label: @tr("Settings"); }
}
