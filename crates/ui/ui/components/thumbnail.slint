// Preview image of a G-code file, with a quiet greyscale logo as placeholder while there is none.

import { Theme } from "../theme.slint";

export component Thumbnail inherits Rectangle {
    in property <image> source;
    in property <bool> available;
    background: Theme.surface-raised;
    border-radius: Theme.radius;
    clip: true;

    if root.available: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: contain;
    }
    // About half of the tile, centred; the greys sit close to the tile so real previews stand out.
    if !root.available: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../../../../assets/logo/sailhand-placeholder.svg");
        width: min(parent.width, parent.height) / 2;
        height: self.width;
        image-fit: contain;
    }
}
