// The head level of the Filament page for a tool changer: a tab per head with the colour of its spool and its nozzle
// temperature, beside them (after a gap) the tabs of the machine, below them the tabs of the chosen head's path, and
// one line for what the tool changer does differently (docs/multi-tool.md, D1). Choosing only changes what the page
// shows, it never moves the printer.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, FilamentTab, HeadItem, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, IconButton, IconLabel, TabBar, TabButton } from "controls.slint";
import { FilamentSwatch } from "filament-swatch.slint";

// A head: the edge in the colour of its spool, `T<n>` (with a check where the detection found it on the carriage) and
// the temperature of its nozzle at the right; below them the name of its section if that is not `T<n>` itself.
component HeadTab inherits Rectangle {
    in property <HeadItem> head;
    in property <bool> checked;
    callback clicked;

    property <color> content: root.checked ? Theme.accent : Theme.muted;

    min-height: Theme.touch;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.head.subtitle != "" ? root.head.label + " " + root.head.subtitle : root.head.label;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-medium;
        padding-right: Theme.spacing-small;
        padding-bottom: 3px;
        spacing: Theme.spacing-medium;
        FilamentSwatch {
            cross-axis-self-alignment: center;
            width: 5px;
            height: 32px;
            radius: 2px;
            colors: root.head.spool-colors;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            // `T1` with the nozzle temperature at the right; the check marks the head the detection found.
            HorizontalLayout {
                spacing: Theme.spacing-small;
                Text {
                    text: root.head.label;
                    color: root.content;
                    font-size: Theme.font-normal;
                    font-weight: root.checked ? 700 : 600;
                    overflow: elide;
                }
                if root.head.detected: Image {
                    cross-axis-self-alignment: center;
                    source: Icons.ui-check;
                    colorize: StateIcons.severity-color(Severity.fine);
                    width: Theme.icon-tiny;
                    height: Theme.icon-tiny;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.head.has-nozzle ? round(root.head.temperature) + "°" : "";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
            // The section name, where it says more than the label.
            if root.head.subtitle != "": Text {
                text: root.head.subtitle;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: 3px;
        border-radius: 1.5px;
        background: root.checked ? Theme.accent : transparent;
    }
}

// Pages the row of heads when they do not fit beside the tabs of the machine.
component PagingButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;

    min-height: Theme.touch;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-raised : transparent;
    accessible-role: button;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        colorize: root.enabled ? Theme.muted : Theme.disabled-foreground;
        width: 20px;
        height: 20px;
    }
}

// What the tool changer does differently, with the button that helps. Nothing is replaced by it: the page stays as
// it is. Changing heads is for a printer whose print is not running (a pause is fine) and a changer that is ready. The text and the button
// are in a row of their own or, with the path tabs, at the right of them (the Gates page has no room for another row).
component ChangerNoteItems inherits HorizontalLayout {
    // At the right of the path tabs there is less room: the error text without "Tool".
    in property <bool> short;
    spacing: Theme.spacing;
    IconLabel {
        icon: Printer.changer-note == "error" ? Icons.ui-error : Printer.changer-note == "mismatch" ? Icons.ui-warning : Icons.ui-info;
        color: StateIcons.severity-color(Printer.changer-note == "error" ? Severity.error : Printer.changer-note == "mismatch" ? Severity.attention : Severity.info);
        text: Printer.changer-note == "error" ? (root.short ? @tr("Changer error, see console") : @tr("Tool changer error, see console"))
            : Printer.changer-note == "mismatch" ? @tr("{} selected, {} detected", Printer.changer-selected, Printer.changer-detected)
            : @tr("Not initialized");
    }
    Rectangle { horizontal-stretch: 1; }
    if Printer.changer-note == "uninitialized": IconButton {
        icon: Icons.ui-refresh;
        text: @tr("Initialize");
        horizontal: true;
        min-width: 150px;
        max-width: 150px;
        enabled: !Printer.motion-locked;
        clicked => { Actions.initialize-toolchanger(false); }
    }
    if Printer.changer-note == "error": IconButton {
        icon: Icons.mmu-recover;
        text: @tr("Recover");
        horizontal: true;
        min-width: 150px;
        max-width: 150px;
        enabled: !Printer.motion-locked;
        clicked => {
            Confirm.ask(@tr("Recover tool changer"), @tr("Initializes the tool changer and restores the position after the error."), "recover-toolchanger", "", false);
            Confirm.confirm-text = @tr("Recover");
        }
    }
}

// The line under the tabs, just the button's height: the page below is full, a taller line would push its last row out.
component ChangerNote inherits Rectangle {
    height: Theme.touch + 2px;

    ChangerNoteItems {
        padding-left: Theme.padding;
        padding-right: Theme.padding;
        padding-top: 2px;
    }
}

export component HeadTabs inherits VerticalLayout {
    // The head the page shows, a row of `Printer.heads`, and the tab that is open.
    in property <int> head-index;
    in property <FilamentTab> tab;
    // The head has lanes of its own: Gates and Extruder below the heads.
    in property <bool> path-tabs;
    callback head-chosen(int);
    callback tab-chosen(FilamentTab);

    property <length> head-width: 98px;
    property <length> machine-width: 96px;
    property <length> paging-width: 40px;
    // Tools and Service belong to the machine (Happy Hare); they follow the heads after a gap.
    property <int> machine-tabs: Printer.has-mmu ? 2 : 0;
    property <length> machine-total: root.machine-tabs > 0 ? Theme.spacing + 1px + root.machine-tabs * (Theme.spacing + root.machine-width) : 0px;
    property <length> available: root.width - 2 * Theme.padding - root.machine-total;
    property <length> step: root.head-width + Theme.spacing;
    property <int> count: Printer.heads.length;
    property <int> fit-all: floor((root.available + Theme.spacing) / root.step);
    property <bool> paged: root.count > root.fit-all;
    property <int> per-page: root.paged ? max(1, floor((root.available - 2 * (root.paging-width + Theme.spacing) + Theme.spacing) / root.step)) : root.count;
    // The first head of the page that is shown; the row never ends in empty space.
    in-out property <int> first;
    property <int> start: max(0, min(root.first, root.count - root.per-page));
    property <int> shown: min(root.per-page, root.count - root.start);

    function reveal() {
        if (root.head-index < root.start) {
            root.first = root.head-index;
        } else if (root.head-index >= root.start + root.per-page) {
            root.first = root.head-index - root.per-page + 1;
        }
    }
    changed head-index => { root.reveal(); }
    init => { root.reveal(); }

    TabBar {
        if root.paged: PagingButton {
            width: root.paging-width;
            icon: Icons.ui-chevron-left;
            enabled: root.start > 0;
            clicked => { root.first = max(0, root.start - root.per-page); }
        }
        Rectangle {
            width: root.shown * root.step - Theme.spacing;
            for head[row] in Printer.heads: HeadTab {
                visible: row >= root.start && row < root.start + root.per-page;
                x: (row - root.start) * root.step;
                width: root.head-width;
                height: parent.height;
                head: head;
                checked: row == root.head-index && (root.tab == FilamentTab.gates || root.tab == FilamentTab.extruder);
                clicked => { root.head-chosen(row); }
            }
        }
        if root.paged: PagingButton {
            width: root.paging-width;
            icon: Icons.ui-chevron-right;
            enabled: root.start + root.per-page < root.count;
            clicked => { root.first = min(root.count - 1, root.start + root.per-page); }
        }
        if root.machine-tabs > 0: Rectangle {
            width: 1px;
            height: 28px;
            cross-axis-self-alignment: center;
            background: Theme.border;
        }
        if Printer.has-mmu: TabButton {
            min-width: root.machine-width;
            max-width: root.machine-width;
            text: @tr("Tools");
            checked: root.tab == FilamentTab.tools;
            clicked => { root.tab-chosen(FilamentTab.tools); }
        }
        if Printer.has-mmu: TabButton {
            min-width: root.machine-width;
            max-width: root.machine-width;
            text: @tr("Service");
            checked: root.tab == FilamentTab.service;
            clicked => { root.tab-chosen(FilamentTab.service); }
        }
    }
    if root.path-tabs: TabBar {
        TabButton {
            icon: Icons.mmu-unit;
            text: @tr("Gates");
            checked: root.tab == FilamentTab.gates;
            clicked => { root.tab-chosen(FilamentTab.gates); }
        }
        TabButton {
            icon: Icons.filament-extruder-gears;
            text: @tr("Extruder");
            checked: root.tab == FilamentTab.extruder;
            clicked => { root.tab-chosen(FilamentTab.extruder); }
        }
        if Printer.changer-note != "": ChangerNoteItems {
            short: true;
            horizontal-stretch: 1;
            padding-left: Theme.padding;
        }
    }
    if Printer.changer-note != "" && !root.path-tabs: ChangerNote { }
}
