// The light panel at the light symbol of the status bar: the main light with one tap, every LED with a dimmer, and
// the effects of the led_effect plugin when it is installed.

import { Theme } from "../theme.slint";
import { Units } from "../units.slint";
import { Icons } from "../icons.slint";
import { Actions, Backlight, LedItem, Navigation, Printer } from "../state.slint";
import { FlyoutPanel, IconButton, ScrollList, SliderRow, ToggleRow } from "controls.slint";

// On and off, and the brightness: white light on a Klipper LED, the brightness of a WLED strip.
component LedRow inherits SliderRow {
    in property <LedItem> led;
    icon: Icons.accessory-light;
    icon-color: root.led.on ? Theme.accent : Theme.muted;
    label: root.led.label;
    // Moonraker does not know a WLED strip's brightness after a preset; then only "on" is certain.
    value-text: !root.led.on ? @tr("Off") : root.led.level-known ? Units.percent(root.shown) : @tr("On");
    value: root.led.level;
    off-clicked => { Actions.set-light(root.led.object, 0); }
    full-clicked => { Actions.set-light(root.led.object, 100); }
    changed(level) => { Actions.set-light(root.led.object, level); }
}

// The backlight of this display, like a light: Off is the standby, the lowest step keeps the screen usable.
component DisplayRow inherits SliderRow {
    icon: Icons.system-brightness;
    icon-color: Theme.accent;
    label: @tr("Display");
    value-text: Units.percent(root.shown);
    minimum: 10;
    value: Backlight.brightness;
    off-clicked => { Backlight.sleep(); }
    full-clicked => { Backlight.brightness-chosen(100); }
    changed(level) => { Backlight.brightness-chosen(level); }
}

export component LightPanel inherits Rectangle {
    property <length> row-step: 64px;
    // The display row stands first, the LEDs below it.
    property <int> display-rows: Backlight.available ? 1 : 0;
    // Effects stand in a grid below the LEDs; a printer may define many of them (scenes built from several effects).
    property <int> effect-columns: 2;
    property <int> effect-rows: ceil(Printer.led-effects.length / root.effect-columns);
    property <int> effects-first-row: root.display-rows + Printer.leds.length;
    property <int> rows: root.effects-first-row + root.effect-rows;
    // Same inset as the LED rows, so the strip symbol stands in their symbol column.
    property <length> effects-x: Theme.padding + Theme.icon + Theme.spacing;
    property <length> effect-width: (list.row-width - root.effects-x - (root.effect-columns - 1) * Theme.spacing) / root.effect-columns;

    // Not modal: the page beside the panel stays usable; the close button or the light symbol closes it.
    FlyoutPanel {
        x: root.width - self.width - 8px;
        y: 52px;
        width: min(620px, root.width - 16px);
        height: min(root.height - 60px, 64px + 2 * Theme.padding + Theme.spacing + root.rows * root.row-step);

        VerticalLayout {
            padding: Theme.padding;
            spacing: Theme.spacing;
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                // The main light as a switch: highlighted while it is on.
                if Printer.has-light: ToggleRow {
                    icon: Icons.accessory-light;
                    text: Printer.light-name;
                    checked: Printer.light-on;
                    toggled => { Actions.toggle-light(); }
                }
                IconButton {
                    width: Theme.touch;
                    icon: Icons.ui-close;
                    accessible-label: @tr("Close");
                    clicked => { Navigation.light-open = false; }
                }
            }
            list := ScrollList {
                vertical-stretch: 1;
                content-height: root.rows * root.row-step;
                if Backlight.available: DisplayRow {
                    y: 0;
                    width: list.row-width;
                }
                for led[index] in Printer.leds: LedRow {
                    y: (root.display-rows + index) * root.row-step;
                    width: list.row-width;
                    led: led;
                }
                // Effects in a grid beside the strip symbol; a tap starts or stops one.
                if Printer.led-effects.length > 0: Image {
                    x: Theme.padding;
                    y: root.effects-first-row * root.row-step + (root.row-step - Theme.spacing - self.height) / 2;
                    source: Icons.accessory-led-strip;
                    colorize: Theme.muted;
                    width: Theme.icon;
                    height: Theme.icon;
                }
                for effect[index] in Printer.led-effects: ToggleRow {
                    x: root.effects-x + mod(index, root.effect-columns) * (root.effect-width + Theme.spacing);
                    y: (root.effects-first-row + floor(index / root.effect-columns)) * root.row-step;
                    width: root.effect-width;
                    height: root.row-step - Theme.spacing;
                    text: effect.label;
                    checked: effect.enabled;
                    toggled => { Actions.set-led-effect(effect.name, !effect.enabled); }
                }
            }
        }
    }
}
