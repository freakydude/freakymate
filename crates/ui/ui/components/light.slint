// The light panel at the light symbol of the status bar: the main light with one tap, every LED with a dimmer, and
// the effects of the led_effect plugin when it is installed.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Backlight, LedItem, Navigation, Printer } from "../state.slint";
import { FlyoutPanel, IconButton, ScrollList, ToggleRow, TouchSlider } from "controls.slint";

// On and off, and the brightness: white light on a Klipper LED, the brightness of a WLED strip.
component LedRow inherits Rectangle {
    in property <LedItem> led;
    height: 60px;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: Icons.accessory-light;
            colorize: root.led.on ? Theme.accent : Theme.muted;
            width: 28px;
            height: 28px;
        }
        VerticalLayout {
            alignment: center;
            width: 170px;
            Text { text: root.led.label; color: Theme.muted; font-size: Theme.font-small; overflow: elide; }
            Text {
                // Moonraker does not know a WLED strip's brightness after a preset; then only "on" is certain.
                text: !root.led.on ? @tr("off") : root.led.level-known ? round(light-slider.shown) + " %" : @tr("on");
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
            }
        }
        IconButton {
            width: 64px;
            text: @tr("Off");
            checked: !root.led.on;
            clicked => { Actions.set-light(root.led.object, 0); }
        }
        light-slider := TouchSlider {
            cross-axis-self-alignment: center;
            horizontal-stretch: 1;
            value: root.led.level;
            changed(level) => { Actions.set-light(root.led.object, level); }
        }
        IconButton {
            width: 64px;
            text: "100%";
            checked: root.led.on && root.led.level > 99;
            clicked => { Actions.set-light(root.led.object, 100); }
        }
    }
}

// The backlight of this display, like a light: Off is the standby, the lowest step keeps the screen usable.
component DisplayRow inherits Rectangle {
    height: 60px;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: Icons.system-brightness;
            colorize: Theme.accent;
            width: 28px;
            height: 28px;
        }
        VerticalLayout {
            alignment: center;
            width: 170px;
            Text { text: @tr("Display"); color: Theme.muted; font-size: Theme.font-small; overflow: elide; }
            Text {
                text: round(display-slider.shown) + " %";
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
            }
        }
        IconButton {
            width: 64px;
            text: @tr("Off");
            clicked => { Backlight.sleep(); }
        }
        display-slider := TouchSlider {
            cross-axis-self-alignment: center;
            horizontal-stretch: 1;
            minimum: 10;
            value: Backlight.brightness;
            changed(level) => { Backlight.brightness-chosen(level); }
        }
        IconButton {
            width: 64px;
            text: "100%";
            checked: Backlight.brightness > 99;
            clicked => { Backlight.brightness-chosen(100); }
        }
    }
}

export component LightPanel inherits Rectangle {
    property <length> row-step: 64px;
    // The display row stands first, the LEDs below it.
    property <int> display-rows: Backlight.available ? 1 : 0;

    // Not modal: the page beside the panel stays usable; the close button or the light symbol closes it.
    FlyoutPanel {
        x: root.width - self.width - 8px;
        y: 52px;
        width: min(620px, root.width - 16px);
        height: min(root.height - 60px, 64px + 2 * Theme.padding + Theme.spacing
            + (root.display-rows + Printer.leds.length + (Printer.led-effects.length > 0 ? 1 : 0)) * root.row-step);

        VerticalLayout {
            padding: Theme.padding;
            spacing: Theme.spacing;
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                // The main light as a switch: highlighted while it is on.
                if Printer.has-light: ToggleRow {
                    icon: Icons.accessory-light;
                    text: Printer.light-name;
                    checked: Printer.light-on;
                    toggled => { Actions.toggle-light(); }
                }
                IconButton {
                    width: Theme.touch;
                    icon: Icons.ui-close;
                    accessible-label: @tr("Close");
                    clicked => { Navigation.light-open = false; }
                }
            }
            list := ScrollList {
                vertical-stretch: 1;
                content-height: (root.display-rows + Printer.leds.length + (Printer.led-effects.length > 0 ? 1 : 0)) * root.row-step;
                if Backlight.available: DisplayRow {
                    y: 0;
                    width: list.row-width;
                }
                for led[index] in Printer.leds: LedRow {
                    y: (root.display-rows + index) * root.row-step;
                    width: list.row-width;
                    led: led;
                }
                // Effects side by side; a tap starts or stops one.
                if Printer.led-effects.length > 0: HorizontalLayout {
                    y: (root.display-rows + Printer.leds.length) * root.row-step;
                    width: list.row-width;
                    height: root.row-step - Theme.spacing;
                    // Same inset as the LED rows, so the symbols stand in one column.
                    padding-left: 10px;
                    spacing: Theme.spacing;
                    Image {
                        cross-axis-self-alignment: center;
                        source: Icons.accessory-led-strip;
                        colorize: Theme.muted;
                        width: 28px;
                        height: 28px;
                    }
                    for effect in Printer.led-effects: IconButton {
                        text: effect.label;
                        checked: effect.enabled;
                        clicked => { Actions.set-led-effect(effect.name, !effect.enabled); }
                    }
                }
            }
        }
    }
}
