// Confirmation dialog of dangerous or irreversible actions.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Confirm } from "../state.slint";
import { ButtonKind, IconButton, ScrollList } from "controls.slint";
import { DialogHeader, DialogPanel, Scrim } from "dialog.slint";

export component ConfirmDialog inherits Scrim {
    visible: Confirm.open;

    DialogPanel {
        width: min(parent.width - 80px, 480px);
        // Rows of items take more room than a message.
        height: min(parent.height - 24px, Confirm.items.length > 0 ? 340px : 270px);
        danger: Confirm.danger;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Confirm.title;
                close => { Confirm.open = false; }
            }

            if Confirm.message != "": Text {
                text: Confirm.message;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
                overflow: elide;
                vertical-stretch: Confirm.items.length == 0 ? 1 : 0;
            }
            // One row per item, so each stands apart; more than fit scroll. Always there and empty without items: a
            // conditional list here caps the height of the whole window.
            items := ScrollList {
                property <length> row-height: 44px;
                property <length> row-step: self.row-height + 6px;
                visible: Confirm.items.length > 0;
                vertical-stretch: Confirm.items.length > 0 ? 1 : 0;
                content-height: Confirm.items.length * self.row-step - 6px;
                for item[index] in Confirm.items: Rectangle {
                    y: index * items.row-step;
                    width: items.row-width;
                    height: items.row-height;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Image {
                            cross-axis-self-alignment: center;
                            source: Confirm.items-are-hints ? Icons.ui-warning : Icons.file-gcode;
                            colorize: Confirm.items-are-hints ? Theme.warning : Theme.muted;
                            width: 18px;
                            height: 18px;
                        }
                        // Two lines at most: a long file name keeps its end, a hint its figures.
                        Text {
                            horizontal-stretch: 1;
                            text: item;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }
            }

            IconButton {
                height: Theme.touch;
                icon: Confirm.danger ? Icons.ui-warning : Icons.ui-check;
                text: @tr("Confirm");
                kind: Confirm.danger ? ButtonKind.danger : ButtonKind.accent;
                horizontal: true;
                clicked => { Confirm.execute(); }
            }
        }
    }
}
