// Confirmation dialog of dangerous or irreversible actions.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Confirm } from "../state.slint";
import { ButtonKind, IconButton, ScrollList } from "controls.slint";
import { FilamentCompareRow } from "filament-compare.slint";
import { Printer } from "../state.slint";
import { DialogHeader, DialogPanel, Scrim } from "dialog.slint";

export component ConfirmDialog inherits Scrim {
    visible: Confirm.open;

    DialogPanel {
        width: Confirm.tools.length > 0 ? min(parent.width - 40px, 640px) : min(parent.width - 80px, 480px);
        // Rows of items take more room than a message, about three rows of tools more still.
        // With tools it grows with their rows (three at most, more scroll), so one tool leaves no empty space.
        height: min(parent.height - 24px, Confirm.tools.length > 0 ? 250px + min(3, Confirm.tools.length) * tools.row-step : Confirm.items.length > 0 ? 340px : 270px);
        danger: Confirm.danger;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Confirm.title;
                close => { Confirm.open = false; }
            }

            if Confirm.message != "": Text {
                text: Confirm.message;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
                overflow: elide;
                vertical-stretch: Confirm.items.length == 0 && Confirm.tools.length == 0 ? 1 : 0;
            }
            // One row per item, so each stands apart; more than fit scroll. Always there and empty without items: a
            // conditional list here caps the height of the whole window.
            items := ScrollList {
                property <length> row-height: 44px;
                property <length> row-step: self.row-height + 6px;
                visible: Confirm.items.length > 0;
                vertical-stretch: Confirm.items.length > 0 ? 1 : 0;
                content-height: Confirm.items.length * self.row-step - 6px;
                for item[index] in Confirm.items: Rectangle {
                    y: index * items.row-step;
                    width: items.row-width;
                    height: items.row-height;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: Theme.padding;
                        padding-right: Theme.padding;
                        spacing: Theme.spacing;
                        Image {
                            cross-axis-self-alignment: center;
                            source: Icons.file-gcode;
                            colorize: Theme.muted;
                            width: Theme.icon-small;
                            height: Theme.icon-small;
                        }
                        // Two lines at most: a long file name keeps its end.
                        Text {
                            horizontal-stretch: 1;
                            text: item;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }
            }

            // Column titles over the rows of the tools, aligned to FilamentCompareRow (padding, tool number, gaps).
            if Confirm.tools.length > 0: HorizontalLayout {
                padding-left: 60px;
                padding-right: Theme.dialog-padding;
                spacing: Theme.spacing;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("File");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
                Text {
                    horizontal-stretch: 1;
                    text: Printer.has-mmu ? @tr("Gate") : @tr("Spool");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
            }
            // The tools of the file that do not fit, one row each. Always there like the items list above.
            tools := ScrollList {
                property <length> row-step: 56px + 6px;
                visible: Confirm.tools.length > 0;
                vertical-stretch: Confirm.tools.length > 0 ? 1 : 0;
                content-height: Confirm.tools.length * self.row-step - 6px;
                for tool[index] in Confirm.tools: FilamentCompareRow {
                    y: index * tools.row-step;
                    width: tools.row-width;
                    mapping: tool;
                    with-gates: Printer.has-mmu;
                }
            }

            IconButton {
                height: Theme.touch;
                icon: Confirm.danger ? Icons.ui-warning : Icons.ui-check;
                text: Confirm.confirm-text != "" ? Confirm.confirm-text : @tr("Confirm");
                kind: Confirm.danger ? ButtonKind.danger : ButtonKind.accent;
                horizontal: true;
                clicked => { Confirm.execute(); }
            }
        }
    }
}
