// Print job: preview, progress, controls and file selection.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Printer } from "../state.slint";
import { ButtonKind, IconButton, ProgressBar, ValueTile } from "../components/controls.slint";
import { ExcludeObjectsDialog, LayerPauseDialog } from "../components/print-dialogs.slint";
import { Thumbnail } from "../components/thumbnail.slint";
import { SpoolStrip } from "../components/spool-strip.slint";
import { MmuStrip } from "mmu.slint";
import { FileBrowser } from "files.slint";
import { PreparedJob } from "print-prepared.slint";

// A paused or failed print and what the sources state about it; the reason is never guessed.
component InterruptionBanner inherits Rectangle {
    in property <bool> failed;
    in property <string> details;
    property <color> tone: root.failed ? Theme.danger : Theme.warning;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.tone;
    min-height: Theme.row-height-small;

    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        spacing: 8px;
        Image {
            cross-axis-self-alignment: center;
            source: root.failed ? Icons.ui-error : Icons.print-pause;
            colorize: root.tone;
            width: Theme.icon-medium;
            height: Theme.icon-medium;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.failed ? @tr("Print failed") : @tr("Paused");
                color: root.tone;
                font-size: Theme.font-normal;
                font-weight: 600;
            }
            if root.details != "": Text {
                text: root.details;
                color: Theme.foreground;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// A tall button of the action column beside the job.
component ActionTile inherits IconButton {
    height: 96px;
}

export component PrintPage inherits Rectangle {
    property <bool> has-job: Printer.filename != "";
    // A prepared file is the job until a print starts; then the running file is.
    property <bool> prepared: Printer.prepared-path != "" && !Printer.is-printing;
    property <bool> finished: Printer.print-state == "complete" || Printer.print-state == "cancelled" || Printer.print-state == "error";
    property <length> side-width: 220px;

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        VerticalLayout {
            width: root.side-width;
            spacing: Theme.spacing;
            Thumbnail {
                height: root.side-width;
                source: root.prepared ? Printer.prepared.thumbnail : Printer.job-thumbnail;
                available: root.prepared ? Printer.prepared.has-thumbnail : root.has-job && Printer.has-job-thumbnail;
            }
            // Progress of the printer's job; a prepared file has none yet.
            if !root.prepared && root.has-job: HorizontalLayout {
                spacing: 10px;
                height: 48px;
                Text {
                    text: round(Printer.progress * 100) + "%";
                    color: Theme.foreground;
                    font-size: Theme.font-huge;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                ProgressBar {
                    cross-axis-self-alignment: center;
                    horizontal-stretch: 1;
                    progress: Printer.progress;
                    bar-color: Printer.print-state == "paused" ? Theme.warning : Printer.print-state == "error" ? Theme.danger : Theme.accent;
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing;
            // The status bar shows the state of the print. Long names have no spaces and keep what matters at the end
            // (a version): break anywhere, two lines at most.
            Text {
                height: 48px;
                text: root.prepared ? Printer.prepared.name : root.has-job ? Printer.job-name : @tr("No print loaded");
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
                wrap: char-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.prepared: PreparedJob { }
            if !root.prepared: VerticalLayout {
                spacing: Theme.spacing;
                // Left the times, right the figures of the job. The times are short, the figures need room: 4 to 5.
                VerticalLayout {
                    spacing: Theme.spacing;
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        ValueTile {
                            weight: 4;
                            icon: Icons.print-duration;
                            label: @tr("Elapsed");
                            value: Printer.elapsed;
                        }
                        // The heights take the place of the label, as the flow does on the speed tile. A tap plans a pause
                        // at a layer, if the printer has Mainsail's macros for it; a planned one shows at the pause icon.
                        ValueTile {
                            weight: 5;
                            icon: Icons.print-layers;
                            label: Printer.print-heights != "" ? Printer.print-heights : @tr("Layer");
                            value: Printer.layers;
                            action-icon: Icons.print-pause;
                            action-note: Printer.layer-pause-planned;
                            enabled-action: Printer.layer-pause-next || Printer.layer-pause-at;
                            clicked => { layer-pause-dialog.open(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        if !root.finished: ValueTile {
                            weight: 4;
                            icon: Icons.print-eta;
                            label: @tr("Remaining");
                            value: Printer.remaining;
                        }
                        if root.finished: ValueTile {
                            weight: 4;
                            icon: Printer.print-state == "complete" ? Icons.print-complete : Printer.print-state == "cancelled" ? Icons.print-cancel : Icons.state-error;
                            icon-color: Printer.print-state == "complete" ? Theme.success : Theme.muted;
                            label: Printer.print-state == "complete" ? @tr("Finished") : Printer.print-state == "cancelled" ? @tr("Cancelled") : @tr("Failed");
                            value: Printer.ended;
                        }
                        ValueTile {
                            weight: 5;
                            icon: Icons.filament-spool;
                            label: @tr("Filament");
                            value: Printer.filament;
                        }
                    }
                    // Times and speed only say something while the print runs; a pause or an error shows what is known
                    // about it instead.
                    if Printer.print-state == "paused" || Printer.print-state == "error": InterruptionBanner {
                        failed: Printer.print-state == "error";
                        details: Printer.interruption-text;
                    }
                    if Printer.print-state == "printing": HorizontalLayout {
                        spacing: Theme.spacing;
                        ValueTile {
                            weight: 4;
                            icon: Icons.ui-info;
                            label: @tr("ETA");
                            value: Printer.eta;
                        }
                        ValueTile {
                            weight: 5;
                            icon: Icons.motion-speed;
                            // Two short lines instead of one long value: the speed, and under the icon's label the flow.
                            label: @tr("Flow {} mm³/s", Printer.live-flow.to-fixed(1));
                            value: round(Printer.live-velocity) + " mm/s";
                        }
                    }
                }
                if Printer.has-spoolman && !Printer.has-mmu: SpoolStrip { }
                if Printer.has-mmu: MmuStrip { }
            }
            // Free room stays at the bottom; it must sit outside the conditional blocks, which would cap the column's
            // height otherwise.
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            width: 104px;
            spacing: Theme.spacing;
            if !Printer.is-printing: ActionTile {
                icon: Icons.print-load;
                text: @tr("Files");
                clicked => {
                    Navigation.files-open = true;
                    Actions.refresh-files();
                }
            }
            if root.prepared: ActionTile {
                icon: Icons.print-start;
                text: @tr("Print");
                kind: ButtonKind.accent;
                clicked => { Confirm.ask-for-items(@tr("Start print"), Printer.prepared.name, Actions.print-hints(Printer.prepared-path), true, "start-print", Printer.prepared-path, false); }
            }
            if !Printer.is-printing && !root.prepared && root.has-job: ActionTile {
                icon: root.finished ? Icons.print-repeat : Icons.print-start;
                text: root.finished ? @tr("Reprint") : @tr("Start");
                kind: ButtonKind.accent;
                clicked => { Confirm.ask-for-items(@tr("Start print"), Printer.job-name, Actions.print-hints(Printer.filename), true, "start-print", Printer.filename, false); }
            }
            if Printer.print-state == "printing": ActionTile {
                icon: Icons.print-pause;
                text: @tr("Pause");
                clicked => { Actions.pause-print(); }
            }
            if Printer.print-state == "paused": ActionTile {
                icon: Icons.print-resume;
                text: @tr("Resume");
                kind: ButtonKind.accent;
                clicked => { Actions.resume-print(); }
            }
            if Printer.is-printing && Printer.print-objects.length > 0: ActionTile {
                icon: Icons.print-exclude-object;
                text: @tr("Objects");
                clicked => { objects-dialog.open = true; }
            }
            if Printer.is-printing: ActionTile {
                icon: Icons.print-cancel;
                text: @tr("Cancel");
                kind: ButtonKind.danger;
                clicked => { Confirm.ask(@tr("Cancel print"), @tr("The current print will be stopped and cannot be resumed."), "cancel-print", "", true); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    FileBrowser { }

    objects-dialog := ExcludeObjectsDialog { }

    layer-pause-dialog := LayerPauseDialog { }
}
