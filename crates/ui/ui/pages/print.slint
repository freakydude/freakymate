// Print job: preview, progress, controls and file selection.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, FileItem, Navigation, Printer } from "../state.slint";
import { ButtonKind, IconButton, ProgressBar, ValueTile } from "../components/controls.slint";
import { ExcludeObjectsDialog, LayerPauseDialog } from "../components/print-dialogs.slint";
import { Thumbnail } from "../components/thumbnail.slint";
import { SpoolStrip } from "../components/spool-strip.slint";
import { MmuStrip } from "mmu.slint";
import { FileBrowser } from "files.slint";
import { PreparedJob } from "print-prepared.slint";

// A paused or failed print and what the sources state about it; the reason is never guessed.
component InterruptionBanner inherits Rectangle {
    in property <bool> failed;
    in property <string> details;
    // Where the print stands, beside the title.
    in property <string> position;
    property <color> tone: root.failed ? Theme.danger : Theme.warning;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.tone;
    min-height: Theme.row-height-small;

    HorizontalLayout {
        padding: Theme.spacing-medium;
        padding-left: Theme.padding;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: root.failed ? Icons.state-error : Icons.print-pause;
            colorize: root.tone;
            width: Theme.icon-large;
            height: Theme.icon-large;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-tight;
            HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    text: root.failed ? @tr("Print failed") : @tr("Paused");
                    color: root.tone;
                    font-size: Theme.font-normal;
                    font-weight: 600;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.position;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.details != "": Text {
                text: root.details;
                color: Theme.foreground;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// A tall button of the action column beside the job.
component ActionTile inherits IconButton {
    height: 96px;
}

// A figure under the progress bar: what it is (a word or an icon), small, and its value. The value stays whole; the
// word gives way when the card is narrow.
component ProgressDetail inherits HorizontalLayout {
    in property <string> label;
    in property <image> icon;
    in property <string> value;
    spacing: Theme.spacing-small;
    if root.icon.width > 0: Image {
        cross-axis-self-alignment: center;
        width: Theme.icon-compact;
        height: Theme.icon-compact;
        source: root.icon;
        colorize: Theme.muted;
    }
    if root.label != "": Text {
        min-width: 0px;
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: Theme.foreground;
        font-size: Theme.font-small;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// The main thing of a job: how far it is and how long it still takes, or when it ended; under the bar the figures
// that go with it.
component ProgressCard inherits Rectangle {
    in property <bool> finished;
    vertical-stretch: 0;
    property <string> state: Printer.print-state;
    background: Theme.surface;
    border-radius: Theme.radius;

    VerticalLayout {
        padding: Theme.spacing-medium;
        padding-left: Theme.padding;
        padding-right: Theme.padding;
        spacing: Theme.spacing-medium;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.spacing;
            Text {
                text: round(Printer.progress * 100) + "%";
                color: Theme.foreground;
                font-size: Theme.font-huge;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                cross-axis-self-alignment: center;
                width: Theme.icon-large;
                height: Theme.icon-large;
                source: !root.finished ? Icons.print-remaining : root.state == "complete" ? Icons.print-complete : root.state == "cancelled" ? Icons.print-cancel : Icons.state-error;
                colorize: root.state == "complete" ? Theme.success : Theme.muted;
            }
            // While it runs the time that is left; afterwards when it ended, which is longer and one step smaller.
            Text {
                text: root.finished ? Printer.ended : Printer.remaining;
                color: Theme.foreground;
                font-size: root.finished ? Theme.font-large : Theme.font-huge;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        ProgressBar {
            progress: Printer.progress;
            bar-color: root.state == "paused" ? Theme.warning : root.state == "error" ? Theme.danger : Theme.accent;
        }
        HorizontalLayout {
            spacing: Theme.spacing;
            ProgressDetail { label: @tr("Elapsed"); value: Printer.elapsed; }
            Rectangle { horizontal-stretch: 1; }
            ProgressDetail { icon: Icons.filament-spool; value: Printer.filament; }
            Rectangle { horizontal-stretch: 1; }
            if root.state == "printing": ProgressDetail { label: @tr("ETA"); value: Printer.eta; }
            if root.finished: Text {
                text: root.state == "complete" ? @tr("Finished") : root.state == "cancelled" ? @tr("Cancelled") : @tr("Failed");
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }
    }
}

// The layer and the heights, which take the place of the label as the flow does on the speed tile. A tap plans a pause
// at a layer, if the printer has Mainsail's macros for it: only then the tile is a field with the pause icon, and a
// planned pause shows there.
component LayerTile inherits ValueTile {
    icon: Icons.print-layers;
    label: Printer.print-heights != "" ? Printer.print-heights : @tr("Layer");
    value: Printer.layers;
    action-icon: Icons.print-pause;
    action-note: Printer.layer-pause-planned;
    enabled-action: Printer.layer-pause-next || Printer.layer-pause-at;
}

// Speed and flow, which only say something while the print runs. Two short lines instead of one long value: the
// speed, and under the icon's label the flow.
component SpeedTile inherits ValueTile {
    icon: Icons.motion-speed;
    label: @tr("Flow {} mm³/s", Printer.live-flow.to-fixed(1));
    value: round(Printer.live-velocity) + " mm/s";
}

// The printer's job, running or ended: preview, name, progress and the figures of the print in the upper block; below
// it over the full width what holds the print up and the filament in use.
component JobView inherits VerticalLayout {
    in property <bool> finished;
    callback plan-layer-pause();
    // With Happy Hare the lower band needs the room of its strip (recover buttons under a pause); otherwise the preview
    // takes more of it.
    property <length> top-height: Printer.has-mmu ? 220px : 272px;

    spacing: Theme.spacing;
    HorizontalLayout {
        height: root.top-height;
        spacing: Theme.spacing;
        Thumbnail {
            width: root.top-height;
            source: Printer.job-thumbnail;
            available: Printer.has-job-thumbnail;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            // The column takes what the preview leaves, whatever its texts would like.
            min-width: 0px;
            spacing: Theme.spacing;
            // The status bar shows the state of the print. Long names have no spaces and keep what matters at the end
            // (a version): break anywhere, two lines at most.
            Text {
                height: 48px;
                text: Printer.job-name;
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
                wrap: char-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
            ProgressCard { finished: root.finished; }
            // Beside the small preview the two tiles share a row; beside the large one they are stacked, so the
            // heights and a planned pause keep their room.
            if Printer.has-mmu: HorizontalLayout {
                spacing: Theme.spacing;
                LayerTile { clicked => { root.plan-layer-pause(); } }
                if Printer.print-state == "printing": SpeedTile { }
            }
            if !Printer.has-mmu: LayerTile { clicked => { root.plan-layer-pause(); } }
            if !Printer.has-mmu && Printer.print-state == "printing": SpeedTile { }
            // Free room stays under the tiles, so nothing moves when the speed tile leaves with a pause.
            Rectangle { vertical-stretch: 1; }
        }
    }
    // A pause or an error shows what is known about it, over the full width.
    if Printer.print-state == "paused" || Printer.print-state == "error": InterruptionBanner {
        failed: Printer.print-state == "error";
        details: Printer.interruption-text;
        position: Printer.interruption-position;
    }
    if Printer.has-spoolman && !Printer.has-mmu: SpoolStrip { }
    if Printer.has-mmu: MmuStrip { }
    // Free room stays at the bottom.
    Rectangle { vertical-stretch: 1; }
}

// One of the newest files: preview, name and print time; a tap prepares it like the choice in the file list.
component RecentFileTile inherits Rectangle {
    in property <FileItem> file;

    background: touch.pressed ? Theme.surface-active : Theme.surface;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: root.file.name;
    touch := TouchArea {
        clicked => { Actions.prepare-file(root.file.path); }
    }

    VerticalLayout {
        padding: Theme.spacing-medium;
        spacing: Theme.spacing-small;
        Thumbnail {
            height: self.width;
            source: root.file.thumbnail;
            available: root.file.has-thumbnail;
        }
        // Names keep what matters at the end (a version): break anywhere, two lines at most.
        Text {
            height: 2 * Theme.font-label * 1.3;
            text: root.file.name;
            color: Theme.foreground;
            font-size: Theme.font-label;
            font-weight: 600;
            wrap: char-wrap;
            overflow: elide;
        }
        Text {
            text: root.file.time;
            color: Theme.muted;
            font-size: Theme.font-small;
            overflow: elide;
        }
    }
}

// The newest files, offered while there is no job; as wide as four tiles, fewer files leave room on the right.
// Placed by hand, not in a layout: the tile width follows the width the page gives, which a layout would ask back.
component RecentFiles inherits Rectangle {
    property <length> tile-width: (self.width - 3 * Theme.spacing) / 4;

    // The square preview plus name (two lines) and time, as the tile's layout stacks them.
    height: root.tile-width + 64px;
    for file[index] in Printer.recent-files: RecentFileTile {
        x: index * (root.tile-width + Theme.spacing);
        y: 0;
        width: root.tile-width;
        height: root.height;
        file: file;
    }
}

export component PrintPage inherits Rectangle {
    property <bool> has-job: Printer.filename != "";
    // A prepared file is the job until a print starts; then the running file is.
    property <bool> prepared: Printer.prepared-path != "" && !Printer.is-printing;
    // No job and nothing prepared: the newest files instead of an empty preview.
    property <bool> idle: !root.prepared && !root.has-job;
    property <bool> finished: Printer.print-state == "complete" || Printer.print-state == "cancelled" || Printer.print-state == "error";
    property <length> side-width: 220px;

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        if !root.prepared && root.has-job: JobView {
            horizontal-stretch: 1;
            finished: root.finished;
            plan-layer-pause => { layer-pause-dialog.open(); }
        }

        if root.prepared: VerticalLayout {
            width: root.side-width;
            Thumbnail {
                height: root.side-width;
                source: Printer.prepared.thumbnail;
                available: Printer.prepared.has-thumbnail;
            }
            Rectangle { vertical-stretch: 1; }
        }

        if root.prepared || root.idle: VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing;
            // Long names have no spaces and keep what matters at the end (a version): break anywhere, two lines at
            // most.
            Text {
                height: 48px;
                text: root.prepared ? Printer.prepared.name : Printer.recent-files.length > 0 ? @tr("Recent files") : @tr("No print loaded");
                color: root.idle ? Theme.muted : Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
                wrap: char-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.prepared: PreparedJob { }
            if root.idle: RecentFiles { }
            // Free room stays at the bottom; it must sit outside the conditional blocks, which would cap the column's
            // height otherwise.
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            width: 104px;
            spacing: Theme.spacing;
            if !Printer.is-printing: ActionTile {
                icon: Icons.file-folder;
                text: @tr("Files");
                kind: !root.prepared && !root.has-job ? ButtonKind.accent : ButtonKind.normal;
                clicked => {
                    Navigation.files-open = true;
                    Actions.refresh-files();
                }
            }
            if root.prepared: ActionTile {
                icon: Icons.print-start;
                text: @tr("Print");
                kind: ButtonKind.accent;
                clicked => { Confirm.ask-to-start(Printer.prepared.name, Printer.prepared-path, Actions.start-tools(Printer.prepared-path)); }
            }
            if !Printer.is-printing && !root.prepared && root.has-job: ActionTile {
                icon: root.finished ? Icons.print-repeat : Icons.print-start;
                text: root.finished ? @tr("Reprint") : @tr("Start");
                kind: ButtonKind.accent;
                clicked => { Confirm.ask-to-start(Printer.job-name, Printer.filename, Actions.start-tools(Printer.filename)); }
            }
            if Printer.print-state == "printing": ActionTile {
                icon: Icons.print-pause;
                text: @tr("Pause");
                clicked => { Actions.pause-print(); }
            }
            if Printer.print-state == "paused": ActionTile {
                icon: Icons.print-resume;
                text: @tr("Resume");
                kind: ButtonKind.accent;
                clicked => { Actions.resume-print(); }
            }
            if Printer.is-printing && Printer.print-objects.length > 0: ActionTile {
                icon: Icons.print-exclude-object;
                text: @tr("Objects");
                clicked => { objects-dialog.open = true; }
            }
            Rectangle { vertical-stretch: 1; }
            // Rarely needed and asked back: at the bottom, away from Pause.
            if Printer.is-printing: ActionTile {
                icon: Icons.print-cancel;
                text: @tr("Cancel");
                kind: ButtonKind.danger;
                clicked => { Confirm.ask(@tr("Cancel print"), @tr("The current print will be stopped and cannot be resumed."), "cancel-print", "", true); }
            }
        }
    }

    FileBrowser { }

    objects-dialog := ExcludeObjectsDialog { }

    layer-pause-dialog := LayerPauseDialog { }
}
