// Filament: the gates of the MMU or the lanes of AFC, extrude by hand, load and unload, the tools of the MMU and its service commands.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, FilamentTab, HeadItem, Navigation, Printer, Severity, UiSettings } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, Card, IconButton, IconLabel, StepSelector, TabBar, TabButton } from "../components/controls.slint";
import { FilamentSensorGrid } from "../components/sensor-grid.slint";
import { FilamentPath } from "../components/filament-path.slint";
import { SpoolStrip } from "../components/spool-strip.slint";
import { HeadTabs } from "../components/head-tabs.slint";
import { MmuGatesTab } from "mmu.slint";
import { BypassDialog, GateDialog } from "mmu-dialogs.slint";
import { MmuServiceTab } from "mmu-service.slint";
import { EndlessSpoolDialog, MmuToolsTab, ToolDialog, ToolGateDialog } from "mmu-tools.slint";

component LengthSelector inherits StepSelector {
    label: @tr("Length");
    values: Printer.extrude-lengths;
    unit: " mm";
    selected <=> UiSettings.extrude-length;
    changed => { UiSettings.steps-changed(); }
}

component SpeedSelector inherits StepSelector {
    label: @tr("Speed");
    values: [1, 2, 5, 10];
    unit: " mm/s";
    selected <=> UiSettings.extrude-speed;
    changed => { UiSettings.steps-changed(); }
}

// The nozzle, the spool and the extruder by hand. On a tool changer it is the view of one head (`head-index`, a row of
// `Printer.heads`): its nozzle and spool, whether it is mounted or not; -1 on a printer without swappable heads.
component ExtruderTab inherits Rectangle {
    in property <int> head-index: -1;

    property <bool> has-head: root.head-index >= 0 && root.head-index < Printer.heads.length;
    property <HeadItem> head: Printer.heads[root.head-index];
    // The head is not on the carriage: extruding, loading and unloading act on the mounted one.
    property <bool> parked: root.has-head && !root.head.mounted;
    // Changing heads waits while a print runs (not while it is paused: the plugin recommends pausing on an error and
    // initialising before the resume) and for a changer that is ready.
    property <bool> can-change: !Printer.motion-locked && Printer.changer-ready;
    property <bool> has-select: root.parked && root.head.pick-up != "";
    property <bool> has-drop: root.has-head && root.head.mounted && Printer.has-drop;
    property <bool> has-head-action: root.has-select || root.has-drop;
    property <string> change-blocked: Printer.motion-locked ? @tr("not while printing") : !Printer.changer-ready ? @tr("tool changer not ready") : "";
    property <float> nozzle-temperature: root.has-head ? root.head.temperature : Printer.nozzle-temperature;
    property <float> nozzle-target: root.has-head ? root.head.target : Printer.nozzle-target;
    property <bool> can-extrude: Printer.can-extrude && !root.parked;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        if Printer.mmu-unsupported: IconLabel {
            icon: Icons.ui-warning;
            text: @tr("Happy Hare 4.1 or newer is required for the MMU");
            color: Theme.warning;
            font-size: Theme.font-small;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                if Printer.has-spoolman && !root.has-head && !Printer.has-mmu: SpoolStrip { }
                if Printer.has-spoolman && root.has-head && root.head.lanes <= 1: SpoolStrip {
                    for-head: true;
                    head: root.head;
                }
                Card {
                    title: root.has-head ? @tr("Nozzle {}", root.head.label) : @tr("Nozzle");
                    icon: Icons.thermal-nozzle;
                    tappable: true;
                    clicked => { Navigation.show-heaters(); }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text {
                            text: root.nozzle-temperature.to-fixed(1) + " / " + round(root.nozzle-target) + " °C";
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.parked: IconLabel {
                            icon: Icons.ui-info;
                            text: root.change-blocked != "" && root.has-select ? @tr("{} is not mounted, {}", root.head.label, root.change-blocked) : @tr("{} is not mounted", root.head.label);
                            color: Theme.info;
                            font-size: Theme.font-small;
                        }
                        if !root.parked && !Printer.can-extrude: IconLabel {
                            icon: Icons.ui-warning;
                            text: @tr("Too cold to extrude");
                            color: Theme.warning;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    vertical-stretch: 1;
                    IconButton {
                        icon: Icons.filament-retract;
                        text: @tr("Retract {} mm", UiSettings.extrude-length);
                        icon-size: root.has-head ? Theme.icon : 40px;
                        enabled: root.can-extrude;
                        clicked => { Actions.extrude(-UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                    IconButton {
                        icon: Icons.filament-extrude;
                        text: @tr("Extrude {} mm", UiSettings.extrude-length);
                        icon-size: root.has-head ? Theme.icon : 40px;
                        kind: ButtonKind.accent;
                        enabled: root.can-extrude;
                        clicked => { Actions.extrude(UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                }
                // A tool changer shows the head's part of the filament path here; the sensors of the machine are on System.
                if root.has-head && root.head.has-nozzle: Card {
                    icon: Icons.filament-sensor;
                    FilamentPath {
                        path: root.head.path;
                        head-only: true;
                    }
                }
                if !root.has-head && Printer.filament-sensors.length > 0: Card {
                    title: @tr("Filament sensors");
                    icon: Icons.filament-sensor;
                    FilamentSensorGrid { }
                }
            }

            VerticalLayout {
                // With Happy Hare, loading and unloading belong to the Gates tab; without buttons the column goes away.
                width: Printer.has-load-macro || Printer.has-unload-macro || root.has-head-action ? 120px : 0px;
                spacing: Theme.spacing;
                if root.has-select: IconButton {
                    icon: Icons.mmu-tool-change;
                    text: root.head.pick-up == "macro" ? @tr("Select {}", root.head.label) : @tr("Pick up");
                    kind: ButtonKind.accent;
                    enabled: root.can-change;
                    clicked => {
                        if (root.head.pick-up == "macro") {
                            Actions.run-macro(root.head.pick-up-macro);
                        } else {
                            Actions.pick-up-head(root.head.name);
                        }
                    }
                }
                if root.has-drop: IconButton {
                    icon: Icons.motion-park;
                    text: @tr("Drop");
                    enabled: root.can-change;
                    clicked => { Actions.drop-head(); }
                }
                if Printer.has-load-macro: IconButton {
                    icon: Icons.filament-load;
                    text: @tr("Load");
                    enabled: !root.parked;
                    clicked => { Actions.load-filament(); }
                }
                if Printer.has-unload-macro: IconButton {
                    icon: Icons.filament-unload;
                    text: @tr("Unload");
                    enabled: !root.parked;
                    clicked => { Actions.unload-filament(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // The head tabs take a row; with them length and speed share one.
        if !root.has-head: LengthSelector { }
        if !root.has-head: SpeedSelector { }
        if root.has-head: HorizontalLayout {
            spacing: Theme.spacing;
            LengthSelector { }
            SpeedSelector { }
        }
    }
}

// With Happy Hare or AFC the gates (lanes) come first, then the extruder by hand, the tools with EndlessSpool and the service
// commands of the MMU (AFC has the first two tabs only); without either the extruder alone. The dialogs of a gate, the bypass and a tool cover the whole
// page. A tool changer adds the head level on top: a tab per head, the path tabs below the chosen head, and the tabs
// of the machine (Tools, Service) beside the heads; a printer with one head looks as before.
export component FilamentPage inherits Rectangle {
    property <bool> has-heads: Printer.heads.length > 0;
    property <int> head-index: Navigation.filament-head >= 0 && Navigation.filament-head < Printer.heads.length ? Navigation.filament-head : max(0, Printer.mounted-head);
    // Gates only where the head has several lanes.
    property <bool> path-tabs: root.has-heads && Printer.heads[root.head-index].lanes > 1;
    property <FilamentTab> raw-tab: Navigation.filament-tab;
    property <bool> machine-tab: root.raw-tab == FilamentTab.tools || root.raw-tab == FilamentTab.service;
    property <FilamentTab> tab: root.has-heads
        ? (root.machine-tab && Printer.has-mmu ? root.raw-tab : root.path-tabs && !root.machine-tab ? root.raw-tab : root.path-tabs ? FilamentTab.gates : FilamentTab.extruder)
        : Printer.has-mmu ? root.raw-tab : Printer.has-lanes ? (root.machine-tab ? FilamentTab.gates : root.raw-tab) : FilamentTab.extruder;

    VerticalLayout {
        if root.has-heads: HeadTabs {
            head-index: root.head-index;
            tab: root.tab;
            path-tabs: root.path-tabs;
            head-chosen(index) => {
                Navigation.filament-head = index;
                Navigation.mmu-page = -1;
                if (root.machine-tab) {
                    Navigation.filament-tab = FilamentTab.gates;
                }
            }
            tab-chosen(tab) => { Navigation.filament-tab = tab; }
        }
        if !root.has-heads && Printer.has-lanes: TabBar {
            TabButton {
                icon: Icons.mmu-unit;
                text: @tr("Gates");
                checked: root.tab == FilamentTab.gates;
                clicked => { Navigation.filament-tab = FilamentTab.gates; }
            }
            TabButton {
                icon: Icons.filament-extruder-gears;
                text: @tr("Extruder");
                checked: root.tab == FilamentTab.extruder;
                clicked => { Navigation.filament-tab = FilamentTab.extruder; }
            }
            if Printer.has-mmu: TabButton {
                icon: Icons.mmu-ttg-map;
                text: @tr("Tools");
                checked: root.tab == FilamentTab.tools;
                clicked => { Navigation.filament-tab = FilamentTab.tools; }
            }
            if Printer.has-mmu: TabButton {
                icon: Icons.mmu-maintenance;
                text: @tr("Service");
                checked: root.tab == FilamentTab.service;
                clicked => { Navigation.filament-tab = FilamentTab.service; }
            }
        }
        if root.tab == FilamentTab.gates: MmuGatesTab {
            compact: root.path-tabs;
            head-index: root.has-heads ? root.head-index : -1;
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.extruder: ExtruderTab {
            head-index: root.has-heads ? root.head-index : -1;
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.tools: MmuToolsTab {
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.service: MmuServiceTab {
            vertical-stretch: 1;
        }
    }

    if root.tab == FilamentTab.gates: GateDialog { }
    if root.tab == FilamentTab.gates: BypassDialog { }
    if root.tab == FilamentTab.tools: ToolDialog { }
    if root.tab == FilamentTab.tools: ToolGateDialog { }
    if root.tab == FilamentTab.tools: EndlessSpoolDialog { }
}
