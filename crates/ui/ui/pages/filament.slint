// Filament: the gates of the MMU, extrude by hand, load and unload, the tools of the MMU and its service commands.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, FilamentTab, Navigation, Printer, UiSettings } from "../state.slint";
import { Card, IconButton, IconLabel, StepSelector, TabBar, TabButton } from "../components/controls.slint";
import { SpoolStrip } from "../components/spool-strip.slint";
import { MmuGatesTab } from "mmu.slint";
import { BypassDialog, GateDialog } from "mmu-dialogs.slint";
import { MmuServiceTab } from "mmu-service.slint";
import { MmuToolsTab, ToolDialog } from "mmu-tools.slint";

component ExtruderTab inherits Rectangle {
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        if Printer.mmu-unsupported: IconLabel {
            icon: Icons.ui-warning;
            text: @tr("Happy Hare 4.1 or newer is required for the MMU");
            color: Theme.warning;
            font-size: Theme.font-small;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                if Printer.has-spoolman && !Printer.has-mmu: SpoolStrip { }
                Card {
                    title: @tr("Nozzle");
                    icon: Icons.thermal-nozzle;
                    tappable: true;
                    clicked => { Navigation.show-heaters(); }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text {
                            text: Printer.nozzle-temperature.to-fixed(1) + " / " + round(Printer.nozzle-target) + " °C";
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !Printer.can-extrude: IconLabel {
                            icon: Icons.ui-warning;
                            text: @tr("Too cold to extrude");
                            color: Theme.warning;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    vertical-stretch: 1;
                    IconButton {
                        icon: Icons.filament-retract;
                        text: @tr("Retract {} mm", UiSettings.extrude-length);
                        icon-size: 40px;
                        enabled: Printer.can-extrude;
                        clicked => { Actions.extrude(-UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                    IconButton {
                        icon: Icons.filament-extrude;
                        text: @tr("Extrude {} mm", UiSettings.extrude-length);
                        icon-size: 40px;
                        kind: "accent";
                        enabled: Printer.can-extrude;
                        clicked => { Actions.extrude(UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                }
                if Printer.filament-sensors.length > 0: Card {
                    title: @tr("Filament sensors");
                    icon: Icons.filament-sensor;
                    // Grid with equal columns, so every name gets the same width.
                    sensor-grid := Rectangle {
                        property <int> columns: max(1, min(Printer.filament-sensors.length, floor(self.width / 180px)));
                        property <length> cell-width: (self.width - (self.columns - 1) * Theme.spacing) / self.columns;
                        property <length> row-height: 26px;
                        height: ceil(Printer.filament-sensors.length / self.columns) * self.row-height;
                        for sensor[index] in Printer.filament-sensors: IconLabel {
                            x: mod(index, sensor-grid.columns) * (sensor-grid.cell-width + Theme.spacing);
                            y: floor(index / sensor-grid.columns) * sensor-grid.row-height;
                            width: sensor-grid.cell-width;
                            height: sensor-grid.row-height;
                            icon: !sensor.enabled ? Icons.ui-minus : sensor.detected ? Icons.ui-check : Icons.filament-runout;
                            text: sensor.label;
                            color: !sensor.enabled ? Theme.muted : sensor.detected ? Theme.success : Theme.warning;
                            font-size: Theme.font-small;
                        }
                    }
                }
            }

            VerticalLayout {
                // With Happy Hare, loading and unloading belong to the Gates tab; without buttons the column goes away.
                width: Printer.has-load-macro || Printer.has-unload-macro ? 120px : 0px;
                spacing: Theme.spacing;
                if Printer.has-load-macro: IconButton {
                    icon: Icons.filament-load;
                    text: @tr("Load");
                    clicked => { Actions.load-filament(); }
                }
                if Printer.has-unload-macro: IconButton {
                    icon: Icons.filament-unload;
                    text: @tr("Unload");
                    clicked => { Actions.unload-filament(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        StepSelector {
            label: @tr("Length");
            values: Printer.extrude-lengths;
            unit: " mm";
            selected <=> UiSettings.extrude-length;
            changed => { UiSettings.steps-changed(); }
        }
        StepSelector {
            label: @tr("Speed");
            values: [1, 2, 5, 10];
            unit: " mm/s";
            selected <=> UiSettings.extrude-speed;
            changed => { UiSettings.steps-changed(); }
        }
    }
}

// With Happy Hare the gates come first, then the extruder by hand, the tools with EndlessSpool and the service
// commands of the MMU; without it the extruder alone. The dialogs of a gate, the bypass and a tool cover the whole
// page.
export component FilamentPage inherits Rectangle {
    property <FilamentTab> tab: Printer.has-mmu ? Navigation.filament-tab : FilamentTab.extruder;

    VerticalLayout {
        if Printer.has-mmu: TabBar {
            TabButton {
                icon: Icons.mmu-unit;
                text: @tr("Gates");
                checked: root.tab == FilamentTab.gates;
                clicked => { Navigation.filament-tab = FilamentTab.gates; }
            }
            TabButton {
                icon: Icons.filament-extruder-gears;
                text: @tr("Extruder");
                checked: root.tab == FilamentTab.extruder;
                clicked => { Navigation.filament-tab = FilamentTab.extruder; }
            }
            TabButton {
                icon: Icons.mmu-ttg-map;
                text: @tr("Tools");
                checked: root.tab == FilamentTab.tools;
                clicked => { Navigation.filament-tab = FilamentTab.tools; }
            }
            TabButton {
                icon: Icons.mmu-maintenance;
                text: @tr("Service");
                checked: root.tab == FilamentTab.service;
                clicked => { Navigation.filament-tab = FilamentTab.service; }
            }
        }
        if root.tab == FilamentTab.gates: MmuGatesTab {
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.extruder: ExtruderTab {
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.tools: MmuToolsTab {
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.service: MmuServiceTab {
            vertical-stretch: 1;
        }
    }

    if root.tab == FilamentTab.gates: GateDialog { }
    if root.tab == FilamentTab.gates: BypassDialog { }
    if root.tab == FilamentTab.tools: ToolDialog { }
}

