// Filament: the path of one head: the gates of the MMU or the lanes of AFC, extrude by hand, load and unload.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, FilamentTab, HeadItem, Navigation, Printer, Severity, UiSettings } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, Card, IconButton, IconLabel, StepSelector, TabBar, TabButton } from "../components/controls.slint";
import { FilamentSensorGrid } from "../components/sensor-grid.slint";
import { FilamentPath } from "../components/filament-path.slint";
import { SpoolStrip } from "../components/spool-strip.slint";
import { ChangerHint, HeadChip } from "../components/head-chip.slint";
import { HeadPicker } from "../components/head-picker.slint";
import { MmuGatesTab } from "mmu.slint";
import { BypassDialog, GateDialog } from "mmu-dialogs.slint";

component LengthSelector inherits StepSelector {
    label: @tr("Length");
    values: Printer.extrude-lengths;
    unit: " mm";
    selected <=> UiSettings.extrude-length;
    changed => { UiSettings.steps-changed(); }
}

component SpeedSelector inherits StepSelector {
    label: @tr("Speed");
    values: [1, 2, 5, 10];
    unit: " mm/s";
    selected <=> UiSettings.extrude-speed;
    changed => { UiSettings.steps-changed(); }
}

// The nozzle, the spool and the extruder by hand. On a tool changer it is the view of one head (`head-index`, a row of
// `Printer.heads`): its nozzle and spool, whether it is mounted or not; -1 on a printer without swappable heads.
component ExtruderTab inherits Rectangle {
    in property <int> head-index: -1;

    property <bool> has-head: root.head-index >= 0 && root.head-index < Printer.heads.length;
    property <HeadItem> head: Printer.heads[root.head-index];
    // The head is not on the carriage: extruding, loading and unloading act on the mounted one (the picker selects it).
    property <bool> parked: root.has-head && !root.head.mounted;
    property <float> nozzle-temperature: root.has-head ? root.head.temperature : Printer.nozzle-temperature;
    property <float> nozzle-target: root.has-head ? root.head.target : Printer.nozzle-target;
    property <bool> can-extrude: Printer.can-extrude && !root.parked;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        if Printer.mmu-unsupported: IconLabel {
            icon: Icons.ui-warning;
            text: @tr("Happy Hare 4.1 or newer is required for the MMU");
            color: Theme.warning;
            font-size: Theme.font-small;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                if Printer.has-spoolman && !root.has-head && !Printer.has-mmu: SpoolStrip { }
                if Printer.has-spoolman && root.has-head && root.head.lanes <= 1: SpoolStrip {
                    for-head: true;
                    head: root.head;
                }
                Card {
                    title: root.has-head ? @tr("Nozzle {}", root.head.label) : @tr("Nozzle");
                    icon: Icons.thermal-nozzle;
                    tappable: true;
                    clicked => { Navigation.show-heaters(); }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text {
                            text: root.nozzle-temperature.to-fixed(1) + " / " + round(root.nozzle-target) + " °C";
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.parked: IconLabel {
                            icon: Icons.ui-info;
                            text: @tr("{} is not mounted", root.head.label);
                            color: Theme.info;
                            font-size: Theme.font-small;
                        }
                        if !root.parked && !Printer.can-extrude: IconLabel {
                            icon: Icons.ui-warning;
                            text: @tr("Too cold to extrude");
                            color: Theme.warning;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    vertical-stretch: 1;
                    IconButton {
                        icon: Icons.filament-retract;
                        text: @tr("Retract {} mm", UiSettings.extrude-length);
                        icon-size: root.has-head ? Theme.icon : 40px;
                        enabled: root.can-extrude;
                        clicked => { Actions.extrude(-UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                    IconButton {
                        icon: Icons.filament-extrude;
                        text: @tr("Extrude {} mm", UiSettings.extrude-length);
                        icon-size: root.has-head ? Theme.icon : 40px;
                        kind: ButtonKind.accent;
                        enabled: root.can-extrude;
                        clicked => { Actions.extrude(UiSettings.extrude-length, UiSettings.extrude-speed); }
                    }
                }
                // A tool changer shows the head's part of the filament path here; the sensors of the machine are on System.
                if root.has-head && root.head.has-nozzle: Card {
                    icon: Icons.filament-sensor;
                    FilamentPath {
                        path: root.head.path;
                        head-only: true;
                    }
                }
                if !root.has-head && Printer.filament-sensors.length > 0: Card {
                    title: @tr("Filament sensors");
                    icon: Icons.filament-sensor;
                    FilamentSensorGrid { }
                }
            }

            VerticalLayout {
                // With Happy Hare, loading and unloading belong to the Gates tab; without buttons the column goes away.
                width: Printer.has-load-macro || Printer.has-unload-macro ? 120px : 0px;
                spacing: Theme.spacing;
                if Printer.has-load-macro: IconButton {
                    icon: Icons.filament-load;
                    text: @tr("Load");
                    enabled: !root.parked;
                    clicked => { Actions.load-filament(); }
                }
                if Printer.has-unload-macro: IconButton {
                    icon: Icons.filament-unload;
                    text: @tr("Unload");
                    enabled: !root.parked;
                    clicked => { Actions.unload-filament(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // The chip takes a row; with it length and speed share one.
        if !root.has-head: LengthSelector { }
        if !root.has-head: SpeedSelector { }
        if root.has-head: HorizontalLayout {
            spacing: Theme.spacing;
            LengthSelector { }
            SpeedSelector { }
        }
    }
}

// With Happy Hare or AFC the gates (lanes) come first, then the extruder by hand; without either the extruder alone. The
// dialogs of a gate and the bypass cover the whole page. A tool changer adds a chip for the head at the right end of
// the tab row (the picker opens from it); the map of the tools, the service commands and the sensors of the machine are
// on the Changer page. A printer with one head looks as before.
export component FilamentPage inherits Rectangle {
    property <bool> has-heads: Printer.heads.length > 0;
    property <int> head-index: Navigation.filament-head >= 0 && Navigation.filament-head < Printer.heads.length ? Navigation.filament-head : max(0, Printer.mounted-head);
    // Gates only where the head has several lanes.
    property <bool> path-tabs: root.has-heads ? Printer.heads[root.head-index].lanes > 1 : Printer.has-lanes;
    property <FilamentTab> tab: root.path-tabs ? Navigation.filament-tab : FilamentTab.extruder;
    // Beside the chip the two tabs keep to their width.
    property <length> tab-width: root.has-heads ? 124px : 130px;

    VerticalLayout {
        if root.has-heads || Printer.has-lanes: Rectangle {
            height: Theme.touch + Theme.padding;
            TabBar {
                if root.path-tabs: TabButton {
                    min-width: root.tab-width;
                    max-width: root.has-heads ? root.tab-width : 190px;
                    icon: Icons.mmu-unit;
                    text: @tr("Gates");
                    checked: root.tab == FilamentTab.gates;
                    clicked => { Navigation.filament-tab = FilamentTab.gates; }
                }
                if root.path-tabs: TabButton {
                    min-width: root.tab-width;
                    max-width: root.has-heads ? root.tab-width : 190px;
                    icon: Icons.filament-extruder-gears;
                    text: @tr("Extruder");
                    checked: root.tab == FilamentTab.extruder;
                    clicked => { Navigation.filament-tab = FilamentTab.extruder; }
                }
            }
            // What the tool changer does differently takes the room between the tabs and the chip.
            if root.has-heads && Printer.changer-note != "": ChangerHint {
                x: root.path-tabs ? 2 * root.tab-width + 3 * Theme.spacing + Theme.padding : Theme.padding;
                y: Theme.padding;
                width: parent.width - self.x - 160px - 2 * Theme.padding - Theme.spacing;
                height: Theme.touch;
                narrow: root.path-tabs;
            }
            // At the right end of the row (a layout with `alignment: start` has no stretch for it).
            if root.has-heads: HeadChip {
                x: parent.width - self.width - Theme.padding;
                y: Theme.padding;
                head: Printer.heads[root.head-index];
                open: Navigation.head-picker-open;
                clicked => { Navigation.head-picker-open = true; }
            }
        }
        if root.tab == FilamentTab.gates: MmuGatesTab {
            head-index: root.has-heads ? root.head-index : -1;
            vertical-stretch: 1;
        }
        if root.tab == FilamentTab.extruder: ExtruderTab {
            head-index: root.has-heads ? root.head-index : -1;
            vertical-stretch: 1;
        }
    }

    if root.tab == FilamentTab.gates: GateDialog { }
    if root.tab == FilamentTab.gates: BypassDialog { }
    if root.has-heads: HeadPicker {
        head-index: root.head-index;
    }
}
