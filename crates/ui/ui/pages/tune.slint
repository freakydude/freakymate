// The Tune and Expert tabs of the Motion page: Z offset, speed and flow factor to correct during the print; in the
// expert tab pressure advance and the motion and extrusion values of the configuration, changed until the next restart.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Printer, TuningItem, UiSettings } from "../state.slint";
import { ButtonKind, Card, IconButton, ScrollList, StepSelector } from "../components/controls.slint";

// Names of the expert values; the core identifies them by id.
global TuningTexts {
    pure public function label(id: string) -> string {
        if (id == "flow_factor") { return @tr("Flow factor"); }
        if (id == "max_velocity") { return @tr("Max. velocity"); }
        if (id == "max_accel") { return @tr("Max. acceleration"); }
        if (id == "square_corner_velocity") { return @tr("Square corner velocity"); }
        if (id == "minimum_cruise_ratio") { return @tr("Minimum cruise ratio"); }
        if (id == "pressure_advance") { return @tr("Pressure advance"); }
        if (id == "pressure_advance_smooth_time") { return @tr("Pressure advance smooth time"); }
        if (id == "retract_length") { return @tr("Retract length"); }
        if (id == "retract_speed") { return @tr("Retract speed"); }
        if (id == "unretract_extra_length") { return @tr("Unretract extra length"); }
        if (id == "unretract_speed") { return @tr("Unretract speed"); }
        return id;
    }
}

// Value with minus/plus and optional reset.
component Adjuster inherits Card {
    in property <string> value;
    // The value differs from the normal one: shown in the warning colour.
    in property <bool> highlight;
    in property <bool> can-reset: true;
    in property <bool> resettable: true;
    callback decrease;
    callback increase;
    callback reset;

    HorizontalLayout {
        spacing: Theme.spacing;
        height: 56px;
        IconButton { width: Theme.button-narrow; icon: Icons.ui-minus; clicked => { root.decrease(); } }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: root.highlight ? Theme.warning : Theme.foreground;
            font-size: Theme.font-large;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        IconButton { width: Theme.button-narrow; icon: Icons.ui-plus; clicked => { root.increase(); } }
        if root.resettable: IconButton { width: Theme.button-narrow; icon: Icons.ui-reset; enabled: root.can-reset; clicked => { root.reset(); } }
    }
}

component TuningRow inherits Rectangle {
    in property <TuningItem> item;
    height: Theme.row-height;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: Theme.spacing-small;
        padding-left: Theme.dialog-padding;
        spacing: Theme.spacing;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: TuningTexts.label(root.item.id); color: Theme.muted; font-size: Theme.font-small; overflow: elide; }
            HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    text: root.item.value;
                    color: root.item.changed ? Theme.warning : Theme.foreground;
                    font-size: Theme.font-large;
                    font-weight: 600;
                }
                // The configuration's value, as a reminder that a change lasts only until the next restart.
                if root.item.changed: Text {
                    text: @tr("config {}", root.item.configured);
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }
        IconButton { width: Theme.button-narrow; icon: Icons.ui-minus; clicked => { Actions.step-tuning(root.item.id, -1); } }
        IconButton { width: Theme.button-narrow; icon: Icons.ui-plus; clicked => { Actions.step-tuning(root.item.id, 1); } }
        IconButton {
            width: Theme.button-narrow;
            icon: Icons.ui-reset;
            enabled: root.item.can-reset;
            accessible-label: @tr("Back to the configuration");
            clicked => { Actions.reset-tuning(root.item.id); }
        }
    }
}

// The values of the configuration that Klipper can change at runtime; they are back after a restart.
export component TuneExpertTab inherits Rectangle {
    property <length> row-step: 64px;

    list := ScrollList {
        x: Theme.padding;
        y: Theme.padding;
        width: parent.width - 2 * Theme.padding;
        height: parent.height - 2 * Theme.padding;
        content-height: Printer.tuning.length * root.row-step;
        for item[index] in Printer.tuning: TuningRow {
            y: index * root.row-step;
            width: list.row-width;
            item: item;
        }
    }
}

// What one corrects while watching a print: the Z offset of the first layer, and the speed and flow of the print.
// Calibration values (pressure advance, smooth time) and the limits are in the expert tab.
export component TuneBasicsTab inherits Rectangle {
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                Adjuster {
                    title: @tr("Z offset (babystep)");
                    icon: Icons.calibration-z-offset;
                    value: Printer.z-offset.to-fixed(3) + " mm";
                    can-reset: Printer.z-offset != 0;
                    decrease => { Actions.adjust-z-offset(-UiSettings.z-offset-step); }
                    increase => { Actions.adjust-z-offset(UiSettings.z-offset-step); }
                    reset => { Actions.reset-z-offset(); }
                }
                StepSelector {
                    values: [0.005, 0.01, 0.025, 0.05, 0.1];
                    unit: "";
                    selected <=> UiSettings.z-offset-step;
                    changed => { UiSettings.steps-changed(); }
                }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    height: 64px;
                    IconButton {
                        icon: Printer.has-probe ? Icons.calibration-probe : Icons.calibration-z-offset;
                        text: @tr("Apply offset");
                        enabled: Printer.z-offset != 0 && !Printer.is-printing;
                        clicked => { Actions.apply-z-offset(); }
                    }
                    IconButton {
                        icon: Icons.ui-save;
                        text: @tr("Save config");
                        enabled: Printer.save-config-pending && !Printer.is-printing;
                        kind: Printer.save-config-pending ? ButtonKind.accent : ButtonKind.normal;
                        clicked => { Confirm.ask(@tr("Save config"), @tr("Klipper writes the configuration and restarts."), "save-config", "", false); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                Adjuster {
                    title: @tr("Speed factor");
                    icon: Icons.motion-speed;
                    value: round(Printer.speed-factor) + " %";
                    highlight: round(Printer.speed-factor) != 100;
                    can-reset: round(Printer.speed-factor) != 100;
                    decrease => { Actions.set-speed-factor(max(10, Printer.speed-factor - 5)); }
                    increase => { Actions.set-speed-factor(Printer.speed-factor + 5); }
                    reset => { Actions.set-speed-factor(100); }
                }
                Adjuster {
                    title: @tr("Flow factor");
                    icon: Icons.filament-flow;
                    value: Printer.flow-factor.value;
                    highlight: Printer.flow-factor.changed;
                    can-reset: Printer.flow-factor.can-reset;
                    decrease => { Actions.step-tuning(Printer.flow-factor.id, -1); }
                    increase => { Actions.step-tuning(Printer.flow-factor.id, 1); }
                    reset => { Actions.reset-tuning(Printer.flow-factor.id); }
                }
                // A quiet note: the slicer planned layer times and cooling for 100 %. Below both factors, so the flow
                // factor does not move while the speed is tapped.
                if round(Printer.speed-factor) != 100: Text {
                    text: @tr("Layer times and cooling differ from what the slicer planned.");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
