// Network section of the Network tab: Wi-Fi and Ethernet of this host, or the printer host's interfaces (read-only).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AdapterItem, AdapterStatus, Confirm, HostInterfaceItem, Network, Printer, WifiItem } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { Card, IconButton, ListRow, IconLabel, ScrollList, TextWithValue, ToggleRow } from "../components/controls.slint";
import { TextEntryDialog } from "../components/entry-dialogs.slint";

// One network: tap to connect; buttons to disconnect (active) or remove (saved).
component WifiRow inherits ListRow {
    in property <WifiItem> network;
    callback selected;
    tappable: root.network.in-range && root.network.supported && !root.network.active;
    active: root.network.active;
    accessible-label: root.network.ssid;
    clicked => { root.selected(); }

    HorizontalLayout {
        padding-left: Theme.padding;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: !root.network.in-range ? Icons.network-wifi-saved : root.network.bars >= 3 ? Icons.system-network : root.network.bars == 2 ? Icons.network-wifi-fair : Icons.network-wifi-weak;
            colorize: root.network.in-range ? Theme.foreground : Theme.muted;
            width: Theme.icon-large;
            height: Theme.icon-large;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.network.ssid;
                color: root.network.in-range && root.network.supported ? Theme.foreground : Theme.muted;
                font-size: Theme.font-normal;
                font-weight: root.network.active ? 700 : 400;
                overflow: elide;
            }
            Text {
                text: root.network.active ? @tr("Connected")
                    : root.network.active-on-other != "" ? @tr("Connected on {}", root.network.active-on-other)
                    : !root.network.in-range ? @tr("Saved, not in range")
                    : !root.network.supported ? @tr("Not supported")
                    : root.network.known ? @tr("Saved") : root.network.secured ? @tr("Password needed") : @tr("Open");
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        if root.network.secured && root.network.in-range: Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-lock;
            colorize: Theme.muted;
            width: Theme.icon-compact;
            height: Theme.icon-compact;
        }
        if root.network.active: IconButton {
            width: Theme.touch;
            min-height: Theme.row-height-small;
            icon: Icons.network-wifi-off;
            accessible-label: @tr("Disconnect {}", root.network.ssid);
            clicked => {
                Confirm.ask(@tr("Disconnect {}", root.network.ssid), Printer.is-printing
                    ? @tr("A print is running. Without Wi-Fi this printer may no longer be reachable over the network.")
                    : @tr("This printer may no longer be reachable over the network. The network stays saved."), "disconnect-network", "", true);
            }
        }
        if root.network.known: IconButton {
            width: Theme.touch;
            min-height: Theme.row-height-small;
            icon: Icons.ui-delete;
            accessible-label: @tr("Remove {}", root.network.ssid);
            clicked => {
                Confirm.ask(@tr("Remove network"), root.network.active
                    ? @tr("\"{}\" is connected; removing it disconnects this printer from the network.", root.network.ssid)
                    : @tr("The saved password of \"{}\" is deleted.", root.network.ssid), "forget-network", root.network.ssid, true);
            }
        }
    }
}

// One adapter of the list: a tap selects it; the icon tells kind and status.
component AdapterRow inherits Rectangle {
    in property <AdapterItem> adapter;
    in property <bool> selected;
    property <bool> connected: root.adapter.status == AdapterStatus.connected;
    property <bool> connecting: root.adapter.status == AdapterStatus.connecting;
    property <bool> unavailable: root.adapter.status == AdapterStatus.unavailable;
    height: Theme.row-height-small;
    border-radius: Theme.radius;
    background: row-touch.pressed ? Theme.surface-active : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.adapter.interface;

    row-touch := TouchArea {
        clicked => { Network.select(root.adapter.interface); }
    }
    HorizontalLayout {
        padding-left: Theme.padding;
        padding-right: Theme.padding;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: root.adapter.wireless
                ? (root.connected || root.connecting ? Icons.system-network : Icons.network-wifi-off)
                : (root.unavailable ? Icons.network-ethernet-off : Icons.network-ethernet);
            colorize: root.connected ? Theme.foreground : Theme.muted;
            width: Theme.icon-large;
            height: Theme.icon-large;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.adapter.interface;
                color: Theme.foreground;
                font-size: Theme.font-normal;
                overflow: elide;
            }
            // Connected over Wi-Fi: the network name may be cut, the address stays whole.
            if root.connected && root.adapter.wireless: TextWithValue {
                text: root.adapter.ssid;
                value: root.adapter.address;
            }
            if !(root.connected && root.adapter.wireless): Text {
                text: root.connected ? root.adapter.address
                    : root.connecting ? @tr("Connecting")
                    : root.unavailable ? (root.adapter.wireless
                        ? (Network.wifi-enabled ? @tr("Not available") : @tr("Switched off"))
                        : @tr("No cable"))
                    : (root.adapter.wireless ? @tr("Not connected") : @tr("Disconnected"));
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }
    Rectangle {
        border-radius: Theme.radius;
        border-width: root.selected ? 2px : 0px;
        border-color: Theme.accent;
    }
}

component AdaptersCard inherits Card {
    title: @tr("Adapters");
    icon: Icons.network-ethernet;

    adapter-list := ScrollList {
        property <length> row-pitch: Theme.list-row-pitch;
        vertical-stretch: 1;
        content-height: Network.adapters.length * self.row-pitch;
        for adapter[index] in Network.adapters: AdapterRow {
            y: index * adapter-list.row-pitch;
            width: adapter-list.row-width;
            adapter: adapter;
            selected: adapter.interface == Network.selected.interface;
        }
    }
    if Network.adapters.length == 0: Text {
        text: @tr("No network adapter.");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
}

component WifiCard inherits Card {
    callback choose(WifiItem);
    callback hidden-network;
    // Below this width the button texts go under the icons.
    property <bool> wide: root.width > 440px;
    title: @tr("Wi-Fi · {}", Network.selected.interface);
    icon: Icons.system-network;

    HorizontalLayout {
        spacing: Theme.spacing;
        height: Theme.row-height-small;
        ToggleRow {
            horizontal-stretch: 1;
            icon: Network.wifi-enabled ? Icons.system-network : Icons.network-wifi-off;
            text: @tr("Wi-Fi");
            checked: Network.wifi-enabled;
            toggled => {
                if (Network.wifi-enabled) {
                    Confirm.ask(@tr("Switch off Wi-Fi"), Printer.is-printing
                        ? @tr("A print is running. Without Wi-Fi this printer may no longer be reachable over the network.")
                        : @tr("This printer may no longer be reachable over the network."), "wifi-off", "", true);
                } else {
                    Network.set-wifi-enabled(true);
                }
            }
        }
        IconButton {
            icon: Icons.ui-search;
            text: @tr("Search");
            horizontal: root.wide;
            enabled: Network.wifi-enabled;
            clicked => { Network.scan(); }
        }
        IconButton {
            icon: Icons.network-wifi-hidden;
            text: @tr("Hidden");
            horizontal: root.wide;
            enabled: Network.wifi-enabled;
            clicked => { root.hidden-network(); }
        }
    }
    wifi-list := ScrollList {
        property <length> row-pitch: Theme.list-row-pitch;
        vertical-stretch: 1;
        content-height: Network.networks.length * self.row-pitch;
        for network[index] in Network.networks: WifiRow {
            y: index * wifi-list.row-pitch;
            width: wifi-list.row-width;
            network: network;
            selected => { root.choose(network); }
            // The list opens at the connected network.
            init => {
                if (network.active) {
                    wifi-list.show-row(self.y, Theme.list-row-pitch);
                }
            }
        }
    }
    if !Network.wifi-enabled: Text {
        text: @tr("Wi-Fi is switched off");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
    if Network.wifi-enabled && Network.networks.length == 0: Text {
        text: @tr("No networks found.");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
}

// One fact of the Ethernet card; nothing without a value.
component FactRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <length> label-width;
    visible: root.value != "";
    spacing: Theme.spacing;
    Text {
        width: root.label-width;
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

component EthernetCard inherits Card {
    property <length> label-width: 120px;
    property <length> button-width: 200px;
    property <AdapterItem> adapter: Network.selected;
    property <bool> on: root.adapter.status == AdapterStatus.connected || root.adapter.status == AdapterStatus.connecting;
    title: @tr("Ethernet · {}", Network.selected.interface);
    icon: Icons.network-ethernet;

    FactRow {
        label: @tr("State");
        label-width: root.label-width;
        value: root.adapter.status == AdapterStatus.connected ? @tr("Connected")
            : root.adapter.status == AdapterStatus.connecting ? @tr("Connecting")
            : root.adapter.status == AdapterStatus.disconnected ? @tr("Disconnected") : @tr("No cable");
    }
    FactRow {
        label: @tr("Address");
        label-width: root.label-width;
        value: root.adapter.address == "" ? "" : root.adapter.address + (root.adapter.prefix > 0 ? "/" + root.adapter.prefix : "");
    }
    FactRow {
        label: @tr("Gateway");
        label-width: root.label-width;
        value: root.adapter.gateway;
    }
    FactRow {
        label: @tr("Speed");
        label-width: root.label-width;
        value: root.adapter.speed > 0 ? root.adapter.speed + " Mbit/s" : "";
    }
    FactRow {
        label: @tr("MAC");
        label-width: root.label-width;
        value: root.adapter.mac;
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: end;
        height: Theme.touch;
        IconButton {
            width: root.button-width;
            horizontal: true;
            icon: root.on ? Icons.network-ethernet-off : Icons.network-ethernet;
            text: root.on ? @tr("Disconnect") : @tr("Connect");
            enabled: root.on || root.adapter.status != AdapterStatus.unavailable;
            clicked => {
                if (root.on) {
                    Confirm.ask(@tr("Disconnect {}", root.adapter.interface), Printer.is-printing
                        ? @tr("A print is running. This printer may no longer be reachable over the network.")
                        : @tr("This printer may no longer be reachable over the network."), "wired-off", root.adapter.interface, true);
                } else {
                    Network.set-wired(root.adapter.interface, true);
                }
            }
        }
    }
}

component HostNetworkCard inherits Card {
    title: Network.local ? @tr("Network management not available") : @tr("Network of the printer host");
    icon: Icons.ui-info;

    HorizontalLayout {
        spacing: Theme.spacing;
        Text {
            text: Network.local
                ? @tr("Wi-Fi and Ethernet can only be changed with NetworkManager on Linux: {}", Network.unavailable-reason)
                : @tr("Sailhand runs on another computer than Moonraker, so the network can only be viewed here. Change it on the printer's own display or via SSH.");
            color: Theme.muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        IconButton {
            width: 104px;
            icon: Icons.ui-refresh;
            text: @tr("Refresh");
            clicked => { Network.refresh(); }
        }
    }
    for interface in Network.host-interfaces: HorizontalLayout {
        spacing: Theme.spacing;
        height: 44px;
        IconLabel {
            width: 120px;
            icon: interface.wireless ? Icons.system-network : Icons.network-ethernet;
            text: interface.name;
        }
        Text {
            text: interface.addresses != "" ? interface.addresses : @tr("No address");
            color: Theme.foreground;
            font-size: Theme.font-normal;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: interface.mac;
            color: Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
    if Network.host-interfaces.length == 0: Text {
        text: Printer.is-connected ? @tr("Moonraker reports no network interfaces.") : @tr("Not connected to Moonraker.");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
    Rectangle { vertical-stretch: 1; }
}

export component NetworkSection inherits Rectangle {
    in property <length> adapters-width: 248px;
    property <string> password-title;

    // Asks for confirmation while printing, otherwise connects right away.
    function start-connect(ssid: string, password: string, hidden: bool) {
        Network.pending-ssid = ssid;
        Network.pending-password = password;
        Network.pending-hidden = hidden;
        if (Printer.is-printing) {
            Confirm.ask(@tr("Change network"), @tr("A print is running. While switching to \"{}\" this printer is briefly not reachable over the network.", ssid), "connect-network", "", true);
        } else {
            Network.connect-pending();
        }
    }

    if Network.managed: HorizontalLayout {
        spacing: Theme.spacing;
        AdaptersCard {
            width: root.adapters-width;
        }
        if Network.selected.interface != "" && Network.selected.wireless: WifiCard {
            horizontal-stretch: 1;
            choose(network) => {
                if (network.known || !network.secured) {
                    root.start-connect(network.ssid, "", false);
                } else {
                    root.password-title = @tr("Password for {}", network.ssid);
                    Network.pending-ssid = network.ssid;
                    Network.pending-hidden = false;
                    password.text = "";
                    password.open = true;
                }
            }
            hidden-network => {
                ssid.text = "";
                ssid.open = true;
            }
        }
        if Network.selected.interface != "" && !Network.selected.wireless: EthernetCard {
            horizontal-stretch: 1;
        }
    }

    if !Network.managed: HostNetworkCard { }

    ssid := TextEntryDialog {
        title: @tr("Network name");
        accepted(text) => {
            if (text != "") {
                root.password-title = @tr("Password for {} (empty if open)", text);
                Network.pending-ssid = text;
                Network.pending-hidden = true;
                password.text = "";
                password.open = true;
            }
        }
    }

    password := TextEntryDialog {
        title: root.password-title;
        secret: true;
        accepted(text) => { root.start-connect(Network.pending-ssid, text, Network.pending-hidden); }
    }
}
