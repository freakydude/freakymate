// Calibrating the bed and the Z height, only with what the printer has. The cards follow Klipper's Bed_Level guide
// from left to right: bed screws, levelling and Z height, bed mesh; saving is the confirmation at the bottom right.
// Klipper runs each procedure; the modes it waits in open their own dialog.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, MeshDialogs, Printer, ScrewItem } from "../state.slint";
import { ButtonKind, Card, IconButton, Note, ScrollList } from "../components/controls.slint";
import { MeshMap } from "../components/bed-mesh.slint";

component ActionButton inherits IconButton {
    height: Theme.touch;
    horizontal: true;
    align-start: true;
}

// Icon above the text: two of them fit side by side in a card.
component CardButton inherits IconButton {
    height: Theme.touch;
    horizontal-stretch: 1;
}

component ScrewRow inherits HorizontalLayout {
    in property <ScrewItem> screw;
    spacing: Theme.spacing;
    height: 30px;
    Text {
        horizontal-stretch: 1;
        text: root.screw.name;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        vertical-alignment: center;
        overflow: elide;
    }
    // A screw that needs under 00:10 is done: a tick in the success colour instead of a direction.
    if !root.screw.is-base: Image {
        source: root.screw.level ? Icons.ui-check : root.screw.clockwise ? Icons.calibration-screw-clockwise : Icons.calibration-screw-counterclockwise;
        colorize: root.screw.level ? Theme.success : Theme.foreground;
        width: 28px;
        height: 28px;
        cross-axis-self-alignment: center;
        accessible-role: image;
        accessible-label: root.screw.level ? @tr("level") : root.screw.clockwise ? @tr("clockwise") : @tr("counterclockwise");
    }
    Text {
        text: root.screw.is-base ? @tr("base") : root.screw.turns;
        color: root.screw.is-base ? Theme.muted : root.screw.level ? Theme.success : Theme.foreground;
        font-size: Theme.font-normal;
        font-weight: root.screw.is-base ? 400 : 700;
        vertical-alignment: center;
    }
}

// The screw rows scroll: `screws_tilt_adjust` takes any number of screws, a large bed has nine.
component BedScrewsCard inherits Card {
    property <length> row-step: 32px;
    title: @tr("Bed screws");
    icon: Icons.calibration-bed-screws;
    HorizontalLayout {
        spacing: Theme.spacing;
        if Printer.has-screws-tilt: CardButton {
            icon: Icons.calibration-probe;
            text: @tr("Measure");
            clicked => { Actions.calculate-screws-tilt(); }
        }
        if Printer.has-bed-screws: CardButton {
            icon: Icons.calibration-bed-screws;
            text: @tr("Paper test");
            clicked => { Actions.adjust-bed-screws(); }
        }
    }
    screws := ScrollList {
        vertical-stretch: 1;
        content-height: Printer.screw-results.length * root.row-step;
        for screw[index] in Printer.screw-results: ScrewRow {
            y: index * root.row-step;
            width: screws.row-width;
            screw: screw;
        }
    }
    if Printer.screw-results.length > 0: Note {
        text: @tr("Turns as on a clock: 01:15 is one and a quarter turns.");
    }
}

component LevelCard inherits Card {
    title: @tr("Level and Z height");
    icon: Icons.calibration-gantry-level;
    ActionButton {
        icon: Icons.motion-home;
        text: @tr("Home all");
        done: Printer.homed-xy && Printer.homed-z;
        clicked => { Actions.home(true, true, true); }
    }
    if Printer.can-quad-gantry-level || Printer.can-z-tilt: ActionButton {
        icon: Icons.calibration-gantry-level;
        text: Printer.can-quad-gantry-level ? @tr("QGL") : @tr("Z tilt");
        done: Printer.leveling-state == "applied";
        clicked => { Actions.level(); }
    }
    if Printer.z-calibration != "": ActionButton {
        icon: Printer.z-calibration == "probe" ? Icons.calibration-probe : Icons.calibration-z-offset;
        text: Printer.z-calibration == "probe" ? @tr("Probe Z offset") : @tr("Z endstop");
        clicked => { Actions.calibrate-z(); }
    }
    Rectangle { vertical-stretch: 1; }
}

// A tile in the card: a tap opens a dialog.
component CardTile inherits Rectangle {
    callback clicked;
    height: Theme.touch;
    background: touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    @children
}

// The thumbnail of the active mesh opens its map; the profile selector the saved profiles.
component BedMeshCard inherits Card {
    title: @tr("Bed mesh");
    icon: Icons.calibration-bed-mesh;
    if Printer.bed-mesh-map.shown: CardTile {
        clicked => { MeshDialogs.map-open = true; }
        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing;
            Rectangle {
                width: 44px;
                MeshMap {
                    width: min(parent.width, parent.height * Printer.bed-mesh-map.aspect);
                    height: self.width / Printer.bed-mesh-map.aspect;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Range {}", Printer.bed-mesh-map.range);
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                    font-weight: 700;
                    overflow: elide;
                }
                Note {
                    text: Printer.bed-mesh-map.averaged > 0 ? @tr("{n} point averaged" | "{n} points averaged" % Printer.bed-mesh-map.averaged) : @tr("Tap for the map");
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
    }
    CardTile {
        clicked => { MeshDialogs.profiles-open = true; }
        HorizontalLayout {
            padding-left: Theme.dialog-padding;
            padding-right: Theme.padding;
            spacing: Theme.spacing;
            Text {
                horizontal-stretch: 1;
                text: Printer.bed-mesh-active != "" ? Printer.bed-mesh-active : @tr("No mesh active");
                color: Printer.bed-mesh-active != "" ? Theme.foreground : Theme.muted;
                font-size: Theme.font-large;
                vertical-alignment: center;
                overflow: elide;
            }
            Note {
                text: @tr("{} saved", Printer.bed-mesh-profiles.length);
                vertical-alignment: center;
                wrap: no-wrap;
            }
            Image {
                source: Icons.ui-chevron-down;
                colorize: Theme.foreground;
                width: Theme.icon-large;
                height: Theme.icon-large;
                cross-axis-self-alignment: center;
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.spacing;
        CardButton {
            icon: Icons.calibration-bed-mesh;
            text: @tr("Measure");
            clicked => { Actions.calibrate-bed-mesh(); }
        }
        CardButton {
            icon: Icons.ui-delete;
            text: @tr("Clear");
            enabled: Printer.bed-mesh-active != "";
            clicked => { Actions.clear-bed-mesh(); }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component CalibrateTab inherits Rectangle {
    property <bool> has-screws: Printer.has-screws-tilt || Printer.has-bed-screws;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;
            // Shares of the width independent of the content, so the cards keep their size when results come. The
            // level card holds only buttons and gets just their width; screws and mesh share the rest.
            if root.has-screws: BedScrewsCard {
                preferred-width: 0px;
                horizontal-stretch: 1;
            }
            LevelCard {
                width: 190px;
            }
            if Printer.has-bed-mesh: BedMeshCard {
                preferred-width: 0px;
                horizontal-stretch: 1;
            }
        }

        // What SAVE_CONFIG would write, and the confirmation at the right like Start or Exclude.
        HorizontalLayout {
            spacing: Theme.spacing;
            height: Theme.touch;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Note {
                    text: Printer.save-config-pending ? Printer.pending-config : @tr("Nothing to save.");
                    wrap: no-wrap;
                    overflow: elide;
                }
                if Printer.save-config-pending: Note {
                    text: @tr("Takes effect after Save config, which restarts Klipper.");
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
            IconButton {
                width: 220px;
                icon: Icons.ui-save;
                text: @tr("Save config");
                horizontal: true;
                kind: ButtonKind.accent;
                enabled: Printer.save-config-pending;
                clicked => { Confirm.ask(@tr("Save config"), @tr("Klipper writes the configuration and restarts."), "save-config", "", false); }
            }
        }
    }
}
