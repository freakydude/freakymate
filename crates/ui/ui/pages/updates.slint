// Updates of the printer host through Moonraker's update manager; a tab of the system pages.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Printer, UiSettings } from "../state.slint";
import { Card, IconButton, IconLabel, ScrollList } from "../components/controls.slint";
import { SystemTabs } from "../components/system-tabs.slint";

export component UpdatesPage inherits Rectangle {
    init => { Actions.refresh-system(); }

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;
        SystemTabs { }
        Card {
            title: @tr("Updates");
            icon: Icons.system-update;
            vertical-stretch: 1;
            // Moonraker's updates replace only the program folder; what install.sh set up as root may be older.
            if UiSettings.setup-command != "": IconLabel {
                icon: Icons.ui-warning;
                text: @tr("Finish the last update: run {} once on the printer host.", UiSettings.setup-command);
                color: Theme.warning;
                font-size: Theme.font-small;
                icon-size: Theme.icon-compact;
            }
            update-list := ScrollList {
                property <length> row-pitch: 54px;
                vertical-stretch: 1;
                content-height: Printer.updates.length * self.row-pitch;
                for update[index] in Printer.updates: HorizontalLayout {
                    y: index * update-list.row-pitch;
                    width: update-list.row-width;
                    height: 48px;
                    spacing: Theme.spacing;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: update.label; color: Theme.foreground; font-size: Theme.font-normal; overflow: elide; }
                        if update.up-to-date: IconLabel { icon: Icons.ui-check; text: update.detail; color: Theme.success; font-size: Theme.font-small; icon-size: Theme.icon-compact; }
                        if !update.up-to-date: Text { text: update.detail; color: update.has-update ? Theme.warning : Theme.muted; font-size: Theme.font-small; overflow: elide; }
                    }
                    IconButton {
                        width: 128px;
                        // Fits the row, so the buttons of two updates do not touch.
                        min-height: 40px;
                        icon: Icons.system-update;
                        icon-size: Theme.icon-small;
                        horizontal: true;
                        text: @tr("Update");
                        enabled: update.has-update && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Update {}", update.label), update.detail, "upgrade", update.name, false); }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                // Why the buttons are grey; the busy wheel in the status bar shows the running command.
                if Printer.updates-busy: IconLabel {
                    horizontal-stretch: 1;
                    icon: Icons.ui-lock;
                    text: @tr("Locked while updating");
                    color: Theme.warning;
                    font-size: Theme.font-small;
                }
                if !Printer.updates-busy: Rectangle { horizontal-stretch: 1; }
                IconButton {
                    width: 140px;
                    height: 48px;
                    icon: Icons.ui-refresh;
                    icon-size: Theme.icon-small;
                    horizontal: true;
                    text: @tr("Check");
                    enabled: !Printer.host-actions-locked;
                    clicked => { Actions.refresh-updates(); }
                }
            }
        }
    }
}
