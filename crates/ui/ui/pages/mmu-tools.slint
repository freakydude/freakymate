// Tools tab of the Filament page: which tool takes its filament from which gate (Happy Hare's tool-to-gate map),
// compared with the job's file, and EndlessSpool with the groups of the gates in a dialog. Both are set here only; the
// Gates tab shows them.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, FilamentTab, MmuDialogs, MmuGateItem, Navigation, ToolMatchItem, Printer } from "../state.slint";
import { BarColors } from "../structs.slint";
import { ColorBar, IconButton, ScrollList, ToggleRow } from "../components/controls.slint";
import { FilamentSwatch, FilamentText } from "../components/filament-swatch.slint";
import { DialogHeader, DialogPanel, Scrim } from "../components/dialog.slint";
import { SlotTile, VerdictIcon } from "../components/mmu-tiles.slint";

// The colour of a gate as a vertical bar, the way the tiles of the gates show it.
export component GateColor inherits ColorBar {
    in property <MmuGateItem> gate;

    width: 10px;
    height: 32px;
    vertical: true;
    colors: root.gate.colors;
    generic: root.gate.availability == "available" || root.gate.availability == "buffered";
}

// The colour the file asks of a tool, as a dot beside the gate's bar; a clear filament shows the checkerboard.
export component WantedColor inherits ColorBar {
    in property <ToolMatchItem> mapping;

    width: 12px;
    height: 12px;
    border-radius: 6px;
    colors: root.mapping.wanted-colors;
}

// One side of a tool's row: a tap area with the filament's colour as its left edge over the full height.
component FilamentHalf inherits Rectangle {
    in property <BarColors> colors;
    in property <bool> empty;
    in property <bool> color-warn;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked;

    border-radius: 6px;
    background: touch.pressed ? Theme.surface-active : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.label;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-right: 10px;
        spacing: 10px;
        FilamentSwatch {
            width: 44px;
            left-edge: true;
            colors: root.colors;
            empty: root.empty;
            warn: root.color-warn;
        }
        @children
    }
}

// A tool: left what the file asks of it, right the gate it takes its filament from and what that gate holds. Yellow
// marks only what differs (material, colour as a frame, weight); tools the file does not use fade. Without a file to
// compare only the gate side shows. Both sides open the tool's dialog.
component ToolRow inherits Rectangle {
    in property <ToolMatchItem> mapping;
    in property <bool> has-file;
    in property <bool> can-choose;
    callback clicked;

    property <bool> has-gate: root.mapping.gate >= 0;
    property <bool> differs: root.mapping.used && root.mapping.material-differs;
    // Both sides equally wide: padding, tool number, arrow and four gaps take the rest.
    property <length> half-width: (root.width - 10px - 40px - 18px - 4 * 5px) / 2;

    border-radius: Theme.radius;
    background: Theme.surface;
    opacity: root.has-file && !root.mapping.used ? 0.45 : 1.0;

    HorizontalLayout {
        padding: 5px;
        spacing: 5px;
        VerticalLayout {
            width: 40px;
            alignment: center;
            spacing: 2px;
            Text {
                horizontal-alignment: center;
                text: "T" + root.mapping.tool;
                color: Theme.accent;
                font-size: 19px;
                font-weight: 700;
            }
            if root.mapping.used && root.mapping.verdict != "": VerdictIcon {
                x: (parent.width - self.width) / 2;
                verdict: root.mapping.verdict;
            }
        }
        if root.has-file: FilamentHalf {
            width: root.half-width;
            label: @tr("T{} in the file", root.mapping.tool);
            colors: root.mapping.wanted-colors;
            empty: !root.mapping.used;
            enabled: root.mapping.used;
            clicked => { root.clicked(); }
            if root.mapping.used: FilamentText {
                horizontal-stretch: 1;
                material: root.mapping.wanted-material == "" ? "-" : root.mapping.wanted-material;
                name: root.mapping.wanted-profile;
                trail: root.mapping.wanted-weight;
            }
            if !root.mapping.used: FilamentText {
                horizontal-stretch: 1;
                material: @tr("Not used");
                material-color: Theme.muted;
            }
        }
        if root.has-file: Image {
            width: 18px;
            source: Icons.ui-chevron-right;
            colorize: Theme.muted;
        }
        FilamentHalf {
            horizontal-stretch: 1;
            min-width: root.has-file ? root.half-width : 0px;
            label: root.has-gate ? @tr("Gate {}", root.mapping.gate) : @tr("No gate");
            colors: root.mapping.loaded-colors;
            empty: !root.has-gate || root.mapping.gate-empty;
            color-warn: root.mapping.used && root.mapping.color-differs;
            enabled: root.mapping.used || (root.can-choose && root.has-gate);
            clicked => { root.clicked(); }
            if !root.has-gate: FilamentText {
                horizontal-stretch: 1;
                material: @tr("No gate");
                material-warn: true;
                lead: @tr("The printer has no T{}", root.mapping.tool);
            }
            if root.has-gate && root.mapping.gate-empty: FilamentText {
                horizontal-stretch: 1;
                material: @tr("Empty");
                material-warn: root.mapping.used;
                lead: @tr("Gate {}", root.mapping.gate);
            }
            if root.has-gate && !root.mapping.gate-empty: FilamentText {
                horizontal-stretch: 1;
                material: root.mapping.loaded-material == "" ? "-" : root.mapping.loaded-material;
                material-warn: root.differs;
                lead: @tr("Gate {}", root.mapping.gate);
                name: root.mapping.loaded-name;
                trail: root.mapping.loaded-weight;
                trail-warn: root.mapping.used && root.mapping.weight-differs;
                extra: root.mapping.endless-weight;
            }
        }
    }
}

// Above the tools: what they are compared with and how many fit, or only the title without a file; then EndlessSpool
// and Reset.
component ToolsHeader inherits HorizontalLayout {
    spacing: Theme.spacing;
    height: 40px;
    if Printer.mmu-match-file == "": Text {
        horizontal-stretch: 1;
        text: @tr("Tool-to-gate map");
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    if Printer.mmu-match-file != "": HorizontalLayout {
        horizontal-stretch: 1;
        spacing: Theme.spacing-medium;
        VerdictIcon {
            y: (parent.height - self.height) / 2;
            verdict: Printer.mmu-match-verdict;
        }
        Text {
            text: Printer.mmu-match-summary;
            color: Printer.mmu-match-verdict == "differs" ? Theme.warning : Theme.foreground;
            font-size: Theme.font-label;
            font-weight: 600;
            vertical-alignment: center;
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: Icons.file-gcode;
            colorize: Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: Printer.mmu-match-file;
            color: Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Marked while EndlessSpool is on.
    IconButton {
        width: 168px;
        height: 40px;
        icon: Icons.mmu-endless-spool;
        icon-size: Theme.icon-small;
        text: @tr("EndlessSpool");
        checked: Printer.mmu-endless-spool;
        horizontal: true;
        clicked => { MmuDialogs.endless-spool-open = true; }
    }
    IconButton {
        width: 112px;
        height: 40px;
        icon: Icons.ui-refresh;
        icon-size: Theme.icon-small;
        text: @tr("Reset");
        horizontal: true;
        clicked => {
            Confirm.ask(@tr("Reset tools"), @tr("Every tool takes its filament from the gate configured for it again, usually the gate of its number."), "mmu-reset-tool-map", "", false);
        }
    }
}

// A gate with its EndlessSpool group; a tap on the group moves the gate to the next one.
component GroupRow inherits HorizontalLayout {
    in property <MmuGateItem> gate;

    spacing: 8px;
    GateColor {
        cross-axis-self-alignment: center;
        gate: root.gate;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: @tr("Gate {}", root.gate.index);
            color: Theme.foreground;
            font-size: Theme.font-small;
            overflow: elide;
        }
        Text {
            text: root.gate.material == "" ? "-" : root.gate.material;
            color: Theme.muted;
            font-size: Theme.font-small;
            overflow: elide;
        }
    }
    IconButton {
        width: 128px;
        icon: Icons.mmu-endless-spool;
        text: root.gate.group >= 0 ? @tr("Group {}", root.gate.group) : "-";
        horizontal: true;
        enabled: root.gate.group >= 0;
        clicked => { Actions.mmu-set-endless-spool-group(root.gate.index, mod(root.gate.group + 1, Printer.mmu-gates.length)); }
    }
}

// The tools in a list, one row each, with the line about the compared file above.
export component MmuToolsTab inherits Rectangle {
    // With one gate every tool takes its filament from it; there is nothing to choose.
    property <bool> can-choose: Printer.mmu-gates.length > 1;
    property <bool> has-file: Printer.mmu-match-file != "";

    VerticalLayout {
        padding: Theme.padding;
        padding-top: 4px;
        spacing: Theme.spacing-small;
        ToolsHeader { }
        tool-list := ScrollList {
            vertical-stretch: 1;
            property <length> row-height: 66px;
            property <length> row-step: self.row-height + Theme.spacing-medium;
            content-height: Printer.mmu-tools.length * self.row-step - Theme.spacing-medium;
            for mapping[index] in Printer.mmu-tools: ToolRow {
                y: index * tool-list.row-step;
                width: tool-list.row-width;
                height: tool-list.row-height;
                mapping: mapping;
                has-file: root.has-file;
                can-choose: root.can-choose;
                clicked => { MmuDialogs.tool = index; }
            }
        }
    }
}

// EndlessSpool: on a runout Happy Hare continues with the next gate of the same group instead of pausing; here it is
// switched and the groups are set.
export component EndlessSpoolDialog inherits Scrim {
    visible: MmuDialogs.endless-spool-open;

    function close() {
        MmuDialogs.endless-spool-open = false;
    }

    DialogPanel {
        width: min(parent.width - 16px, 520px);
        height: parent.height - 16px;
        x: (parent.width - self.width) / 2;
        y: 8px;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("EndlessSpool");
                close => { root.close(); }
            }
            ToggleRow {
                text: @tr("On a runout continue");
                checked: Printer.mmu-endless-spool;
                toggled => { Actions.mmu-set-endless-spool(!Printer.mmu-endless-spool); }
            }
            Text {
                text: Printer.mmu-endless-spool ? @tr("Instead of pausing, Happy Hare continues with the next gate of the same group.") : @tr("Instead of pausing, Happy Hare continues with the next gate of the same group. The groups show when it is on.");
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if Printer.mmu-endless-spool: group-list := ScrollList {
                vertical-stretch: 1;
                property <length> row-step: Theme.touch + 4px;
                content-height: Printer.mmu-gates.length * self.row-step - 4px;
                for gate[index] in Printer.mmu-gates: GroupRow {
                    y: index * group-list.row-step;
                    width: group-list.row-width;
                    height: Theme.touch;
                    gate: gate;
                }
            }
            if !Printer.mmu-endless-spool: Rectangle { vertical-stretch: 1; }
        }
    }
}

// A gate to choose for a tool: number, colour and material; the gate the tool takes its filament from now is marked.
// With a file to compare, a tick marks a gate whose filament fits what the file asks of the tool.
component GateOption inherits SlotTile {
    in property <MmuGateItem> gate;
    in property <bool> fits;

    label: @tr("Gate {}", root.gate.index);

    HorizontalLayout {
        spacing: Theme.spacing-medium;
        Text {
            horizontal-stretch: 1;
            text: @tr("Gate {}", root.gate.index);
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 700;
        }
        if root.fits: VerdictIcon {
            verdict: "fits";
        }
    }
    ColorBar {
        height: 12px;
        border-radius: 6px;
        colors: root.gate.colors;
        generic: root.gate.availability == "available" || root.gate.availability == "buffered";
    }
    Text {
        text: root.gate.material == "" ? "-" : root.gate.material;
        color: Theme.muted;
        font-size: Theme.font-small;
        overflow: elide;
    }
}

// What the file asks of a tool: colour, material, weight and the slicer's profile name.
component WantedLine inherits HorizontalLayout {
    in property <ToolMatchItem> mapping;

    spacing: 8px;
    Text {
        text: @tr("The file wants");
        color: Theme.muted;
        font-size: Theme.font-normal;
        vertical-alignment: center;
    }
    if root.mapping.wanted-colors.count > 0: WantedColor {
        cross-axis-self-alignment: center;
        mapping: root.mapping;
    }
    Text {
        text: root.mapping.wanted-material;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.mapping.wanted-weight;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.mapping.wanted-profile;
        color: Theme.muted;
        font-size: Theme.font-normal;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One tool: what the file asks of it, what to do when it does not fit, and the choice of gate; a tap on a gate maps
// the tool to it and closes the dialog.
export component ToolDialog inherits Scrim {
    property <ToolMatchItem> mapping: Printer.mmu-tools[MmuDialogs.tool];
    visible: MmuDialogs.tool >= 0 && MmuDialogs.tool < Printer.mmu-tools.length;

    function close() {
        MmuDialogs.tool = -1;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Printer.mmu-gates.length > 1 && root.mapping.gate >= 0 ? @tr("Gate for T{}", root.mapping.tool) : @tr("T{}", root.mapping.tool);
                close => { root.close(); }
            }
            if root.mapping.used: WantedLine {
                mapping: root.mapping;
            }
            if root.mapping.used && root.mapping.differences != "": Text {
                text: root.mapping.differences;
                color: Theme.warning;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            // What to do about it, and the gate to change right away.
            if root.mapping.used && root.mapping.advice != "": HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    horizontal-stretch: 1;
                    text: root.mapping.advice;
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.mapping.gate-to-load >= 0: IconButton {
                    width: 200px;
                    height: 48px;
                    icon: Icons.mmu-gate-map;
                    text: @tr("Open gate {}", root.mapping.gate-to-load);
                    horizontal: true;
                    clicked => {
                        MmuDialogs.gate = root.mapping.gate-to-load;
                        root.close();
                        Navigation.filament-tab = FilamentTab.gates;
                    }
                }
            }
            if root.mapping.gate >= 0: gate-grid := Rectangle {
                property <int> columns: max(1, floor(self.width / 120px));
                property <length> cell-width: (self.width - (self.columns - 1) * Theme.spacing) / self.columns;
                property <length> row-step: 84px + Theme.spacing;
                height: ceil(Printer.mmu-gates.length / self.columns) * self.row-step - Theme.spacing;
                for gate[index] in Printer.mmu-gates: GateOption {
                    x: mod(index, gate-grid.columns) * (gate-grid.cell-width + Theme.spacing);
                    y: floor(index / gate-grid.columns) * gate-grid.row-step;
                    width: gate-grid.cell-width;
                    height: 84px;
                    gate: gate;
                    fits: root.mapping.used && root.mapping.fitting-gates[gate.index];
                    selected: gate.index == root.mapping.gate;
                    clicked => {
                        if (!self.selected) {
                            Actions.mmu-map-tool(root.mapping.tool, gate.index);
                        }
                        root.close();
                    }
                }
            }
        }
    }
}
