// Tools tab of the Filament page: which tool takes its filament from which gate (Happy Hare's tool-to-gate map),
// compared with the job's file, and EndlessSpool with the groups of the gates in a dialog. Both are set here only; the
// Gates tab shows them.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, FilamentTab, MmuDialogs, MmuGateItem, Navigation, ToolMatchItem, Printer } from "../state.slint";
import { BarColors } from "../structs.slint";
import { ButtonKind, IconButton, ScrollList, ToggleRow } from "../components/controls.slint";
import { FilamentColors, FilamentSwatch, FilamentText } from "../components/filament-swatch.slint";
import { DialogHeader, DialogPanel, DialogTitle, Scrim } from "../components/dialog.slint";
import { SlotTile, VerdictIcon } from "../components/mmu-tiles.slint";

// One side of a tool's row: a tap area with the filament's colour as its left edge over the full height.
component FilamentHalf inherits Rectangle {
    in property <BarColors> colors;
    in property <bool> empty;
    in property <bool> color-warn;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked;

    border-radius: 6px;
    background: touch.pressed ? Theme.surface-active : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.label;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-right: 10px;
        spacing: 10px;
        FilamentSwatch {
            width: 44px;
            left-edge: true;
            ground: Theme.surface;
            colors: root.colors;
            empty: root.empty;
            warn: root.color-warn;
        }
        @children
    }
}

// A tool: left what the file asks of it, right the gate it takes its filament from and what that gate holds. Yellow
// marks only what differs (material, colour as a frame, weight); tools the file does not use fade. Without a file to
// compare only the gate side shows. The file side opens the tool's dialog, the gate side the choice of gate.
component ToolRow inherits Rectangle {
    in property <ToolMatchItem> mapping;
    in property <bool> has-file;
    in property <bool> can-choose;
    // The left side opens the tool's dialog, the right side the choice of its gate.
    callback clicked-file;
    callback clicked-gate;

    property <bool> has-gate: root.mapping.gate >= 0;
    property <bool> differs: root.mapping.used && root.mapping.material-differs;
    // Both sides equally wide: padding, tool number, arrow and four gaps take the rest.
    property <length> half-width: (root.width - 10px - 40px - 18px - 4 * 5px) / 2;

    border-radius: Theme.radius;
    background: Theme.surface;
    opacity: root.has-file && !root.mapping.used ? 0.45 : 1.0;

    HorizontalLayout {
        padding: 5px;
        spacing: 5px;
        VerticalLayout {
            width: 40px;
            alignment: center;
            spacing: 2px;
            Text {
                horizontal-alignment: center;
                text: "T" + root.mapping.tool;
                color: Theme.accent;
                font-size: 19px;
                font-weight: 700;
            }
            if root.mapping.used && root.mapping.verdict != "": VerdictIcon {
                x: (parent.width - self.width) / 2;
                verdict: root.mapping.verdict;
            }
        }
        if root.has-file: FilamentHalf {
            width: root.half-width;
            label: @tr("T{} in the file", root.mapping.tool);
            colors: root.mapping.wanted-colors;
            empty: !root.mapping.used;
            enabled: root.mapping.used;
            clicked => { root.clicked-file(); }
            if root.mapping.used: FilamentText {
                horizontal-stretch: 1;
                material: root.mapping.wanted-material == "" ? "-" : root.mapping.wanted-material;
                name: root.mapping.wanted-profile;
                trail: root.mapping.wanted-weight;
            }
            if !root.mapping.used: FilamentText {
                horizontal-stretch: 1;
                material: @tr("Not used");
                material-color: Theme.muted;
            }
        }
        if root.has-file: Image {
            width: 18px;
            source: Icons.ui-chevron-right;
            colorize: Theme.muted;
        }
        FilamentHalf {
            horizontal-stretch: 1;
            min-width: root.has-file ? root.half-width : 0px;
            label: root.has-gate ? @tr("Gate {}", root.mapping.gate) : @tr("No gate");
            colors: root.has-gate && !root.mapping.gate-empty ? FilamentColors.generic(root.mapping.loaded-colors) : root.mapping.loaded-colors;
            empty: !root.has-gate || root.mapping.gate-empty;
            color-warn: root.mapping.used && root.mapping.color-differs;
            enabled: root.has-gate && (root.mapping.used || root.can-choose);
            clicked => { root.clicked-gate(); }
            if !root.has-gate: FilamentText {
                horizontal-stretch: 1;
                material: @tr("No gate");
                material-warn: true;
                lead: @tr("The printer has no T{}", root.mapping.tool);
            }
            if root.has-gate && root.mapping.gate-empty: FilamentText {
                horizontal-stretch: 1;
                material: @tr("Empty");
                material-warn: root.mapping.used;
                lead: @tr("Gate {}", root.mapping.gate);
            }
            if root.has-gate && !root.mapping.gate-empty: FilamentText {
                horizontal-stretch: 1;
                material: root.mapping.loaded-material == "" ? "-" : root.mapping.loaded-material;
                material-warn: root.differs;
                lead: @tr("Gate {}", root.mapping.gate);
                name: root.mapping.loaded-name;
                trail: root.mapping.loaded-weight;
                trail-warn: root.mapping.used && root.mapping.weight-differs;
                extra: root.mapping.endless-weight;
            }
        }
    }
}

// Above the tools: what they are compared with and how many fit, or only the title without a file; then EndlessSpool
// and Reset.
component ToolsHeader inherits HorizontalLayout {
    spacing: Theme.spacing;
    height: 40px;
    if Printer.mmu-match-file == "": Text {
        horizontal-stretch: 1;
        text: @tr("Tool-to-gate map");
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    if Printer.mmu-match-file != "": HorizontalLayout {
        horizontal-stretch: 1;
        spacing: Theme.spacing-medium;
        VerdictIcon {
            y: (parent.height - self.height) / 2;
            verdict: Printer.mmu-match-verdict;
        }
        Text {
            text: Printer.mmu-match-summary;
            color: Printer.mmu-match-verdict == "differs" ? Theme.warning : Theme.foreground;
            font-size: Theme.font-label;
            font-weight: 600;
            vertical-alignment: center;
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: Icons.file-gcode;
            colorize: Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: Printer.mmu-match-file;
            color: Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Marked while EndlessSpool is on.
    IconButton {
        width: 168px;
        height: 40px;
        icon: Icons.mmu-endless-spool;
        icon-size: Theme.icon-small;
        text: @tr("EndlessSpool");
        checked: Printer.mmu-endless-spool;
        horizontal: true;
        clicked => { MmuDialogs.endless-spool-open = true; }
    }
    IconButton {
        width: 112px;
        height: 40px;
        icon: Icons.ui-refresh;
        icon-size: Theme.icon-small;
        text: @tr("Reset");
        horizontal: true;
        clicked => {
            Confirm.ask(@tr("Reset tools"), @tr("Every tool takes its filament from the gate configured for it again, usually the gate of its number."), "mmu-reset-tool-map", "", false);
        }
    }
}

// A gate with its EndlessSpool group; a tap on the group moves the gate to the next one.
component GroupRow inherits HorizontalLayout {
    in property <MmuGateItem> gate;

    spacing: 8px;
    FilamentSwatch {
        cross-axis-self-alignment: center;
        width: 10px;
        height: 32px;
        radius: 3px;
        colors: !self.empty ? FilamentColors.generic(root.gate.colors) : root.gate.colors;
        empty: root.gate.availability != "available" && root.gate.availability != "buffered";
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: @tr("Gate {}", root.gate.index);
            color: Theme.foreground;
            font-size: Theme.font-small;
            overflow: elide;
        }
        Text {
            text: root.gate.material == "" ? "-" : root.gate.material;
            color: Theme.muted;
            font-size: Theme.font-small;
            overflow: elide;
        }
    }
    IconButton {
        width: 128px;
        icon: Icons.mmu-endless-spool;
        text: root.gate.group >= 0 ? @tr("Group {}", root.gate.group) : "-";
        horizontal: true;
        enabled: root.gate.group >= 0;
        clicked => { Actions.mmu-set-endless-spool-group(root.gate.index, mod(root.gate.group + 1, Printer.mmu-gates.length)); }
    }
}

// The tools in a list, one row each, with the line about the compared file above.
export component MmuToolsTab inherits Rectangle {
    // With one gate every tool takes its filament from it; there is nothing to choose.
    property <bool> can-choose: Printer.mmu-gates.length > 1;
    property <bool> has-file: Printer.mmu-match-file != "";

    VerticalLayout {
        padding: Theme.padding;
        padding-top: 4px;
        spacing: Theme.spacing-small;
        ToolsHeader { }
        tool-list := ScrollList {
            vertical-stretch: 1;
            property <length> row-height: 66px;
            property <length> row-step: self.row-height + Theme.spacing-medium;
            content-height: Printer.mmu-tools.length * self.row-step - Theme.spacing-medium;
            for mapping[index] in Printer.mmu-tools: ToolRow {
                y: index * tool-list.row-step;
                width: tool-list.row-width;
                height: tool-list.row-height;
                mapping: mapping;
                has-file: root.has-file;
                can-choose: root.can-choose;
                clicked-file => { MmuDialogs.tool = index; }
                clicked-gate => { MmuDialogs.tool-gate = index; }
            }
        }
    }
}

// EndlessSpool: on a runout Happy Hare continues with the next gate of the same group instead of pausing; here it is
// switched and the groups are set.
export component EndlessSpoolDialog inherits Scrim {
    visible: MmuDialogs.endless-spool-open;

    function close() {
        MmuDialogs.endless-spool-open = false;
    }

    DialogPanel {
        width: min(parent.width - 16px, 520px);
        height: parent.height - 16px;
        x: (parent.width - self.width) / 2;
        y: 8px;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("EndlessSpool");
                close => { root.close(); }
            }
            ToggleRow {
                text: @tr("On a runout continue");
                checked: Printer.mmu-endless-spool;
                toggled => { Actions.mmu-set-endless-spool(!Printer.mmu-endless-spool); }
            }
            Text {
                text: Printer.mmu-endless-spool ? @tr("Instead of pausing, Happy Hare continues with the next gate of the same group.") : @tr("Instead of pausing, Happy Hare continues with the next gate of the same group. The groups show when it is on.");
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if Printer.mmu-endless-spool: group-list := ScrollList {
                vertical-stretch: 1;
                property <length> row-step: Theme.touch + 4px;
                content-height: Printer.mmu-gates.length * self.row-step - 4px;
                for gate[index] in Printer.mmu-gates: GroupRow {
                    y: index * group-list.row-step;
                    width: group-list.row-width;
                    height: Theme.touch;
                    gate: gate;
                }
            }
            if !Printer.mmu-endless-spool: Rectangle { vertical-stretch: 1; }
        }
    }
}

// A line of a dialog in the style of the tool rows: the filament's colour as the left edge, material and name beside it.
component FilamentLine inherits Rectangle {
    in property <BarColors> colors;
    in property <bool> empty;
    in property <bool> color-warn;
    in property <bool> selected;
    in property <bool> pressable;
    in property <string> label;
    callback clicked;

    height: 52px;
    border-radius: 6px;
    background: touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;

    touch := TouchArea {
        enabled: root.pressable;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-right: 10px;
        spacing: 10px;
        FilamentSwatch {
            width: 44px;
            left-edge: true;
            colors: root.colors;
            empty: root.empty;
            warn: root.color-warn;
        }
        @children
    }
}

// What the file asks of a tool.
component WantedLine inherits FilamentLine {
    in property <ToolMatchItem> mapping;

    colors: root.mapping.wanted-colors;
    label: @tr("The file wants");
    FilamentText {
        horizontal-stretch: 1;
        material: root.mapping.wanted-material == "" ? "-" : root.mapping.wanted-material;
        name: root.mapping.wanted-profile;
        trail: root.mapping.wanted-weight;
    }
}

// What the gate of a tool holds; yellow marks a colour or weight that differs from the file.
component LoadedLine inherits FilamentLine {
    in property <ToolMatchItem> mapping;

    colors: root.mapping.gate-empty ? root.mapping.loaded-colors : FilamentColors.generic(root.mapping.loaded-colors);
    empty: root.mapping.gate-empty;
    color-warn: root.mapping.used && root.mapping.color-differs;
    label: @tr("Gate {}", root.mapping.gate);
    if root.mapping.gate-empty: FilamentText {
        horizontal-stretch: 1;
        material: @tr("Empty");
        material-warn: root.mapping.used;
        lead: @tr("Gate {}", root.mapping.gate);
    }
    if !root.mapping.gate-empty: FilamentText {
        horizontal-stretch: 1;
        material: root.mapping.loaded-material == "" ? "-" : root.mapping.loaded-material;
        material-warn: root.mapping.used && root.mapping.material-differs;
        name: root.mapping.loaded-name;
        trail: root.mapping.loaded-weight;
        trail-warn: root.mapping.used && root.mapping.weight-differs;
        extra: root.mapping.endless-weight;
    }
}

// What differs and, unless the dialog has no room for it, what to do about it; nothing when the tool fits.
component Advice inherits VerticalLayout {
    in property <ToolMatchItem> mapping;
    in property <bool> with-advice: true;

    spacing: 4px;
    if root.mapping.used && root.mapping.differences != "": Text {
        text: root.mapping.differences;
        color: Theme.warning;
        font-size: Theme.font-normal;
        wrap: word-wrap;
    }
    if root.with-advice && root.mapping.used && root.mapping.advice != "": Text {
        text: root.mapping.advice;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        wrap: word-wrap;
    }
}

// Opens the gate of a tool on the Gates tab.
component OpenGateButton inherits IconButton {
    in property <int> gate;
    callback opened;

    icon: Icons.mmu-gate-map;
    text: @tr("Open gate {}", root.gate);
    horizontal: true;
    clicked => {
        MmuDialogs.gate = root.gate;
        root.opened();
        Navigation.filament-tab = FilamentTab.gates;
    }
}

// One tool, compact: what the file asks of it, what its gate holds, what differs and what to do about it.
export component ToolDialog inherits Scrim {
    property <ToolMatchItem> mapping: Printer.mmu-tools[MmuDialogs.tool];
    visible: MmuDialogs.tool >= 0 && MmuDialogs.tool < Printer.mmu-tools.length;

    function close() {
        MmuDialogs.tool = -1;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("T{} · What the file wants", root.mapping.tool);
                close => { root.close(); }
                VerdictIcon {
                    cross-axis-self-alignment: center;
                    verdict: root.mapping.used ? root.mapping.verdict : "";
                }
            }
            WantedLine {
                mapping: root.mapping;
            }
            if root.mapping.gate >= 0: Text {
                text: @tr("Gate {} holds", root.mapping.gate);
                color: Theme.muted;
                font-size: Theme.font-small;
            }
            if root.mapping.gate >= 0: LoadedLine {
                mapping: root.mapping;
            }
            Advice {
                mapping: root.mapping;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing;
                if root.mapping.gate >= 0: OpenGateButton {
                    width: 200px;
                    height: 48px;
                    gate: root.mapping.gate;
                    opened => { root.close(); }
                }
                if Printer.mmu-gates.length > 1 && root.mapping.gate >= 0: IconButton {
                    width: 200px;
                    height: 48px;
                    kind: ButtonKind.accent;
                    text: @tr("Choose gate");
                    clicked => {
                        MmuDialogs.tool-gate = MmuDialogs.tool;
                        root.close();
                    }
                }
            }
        }
    }
}

// A gate to choose for a tool: material and name with the gate's colour as the left edge, on the right the tools that
// take their filament from it ("free" for none) and a tick when it fits what the file asks of the tool.
component GateChoice inherits FilamentLine {
    in property <MmuGateItem> gate;
    in property <bool> fits;

    property <bool> is-empty: root.gate.availability == "empty";

    colors: root.is-empty ? root.gate.colors : FilamentColors.generic(root.gate.colors);
    empty: root.is-empty;
    pressable: true;
    label: @tr("Gate {}", root.gate.index);
    FilamentText {
        horizontal-stretch: 1;
        material: root.is-empty ? @tr("G{} · Empty", root.gate.index) : @tr("G{} · {}", root.gate.index, root.gate.material == "" ? "-" : root.gate.material);
        name: root.is-empty ? "" : root.gate.name;
        trail: root.is-empty ? "" : root.gate.spool-text;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.fits: VerdictIcon {
            cross-axis-self-alignment: center;
            verdict: "fits";
        }
        Rectangle {
            width: tools-text.preferred-width + 16px;
            height: 24px;
            cross-axis-self-alignment: center;
            border-radius: 4px;
            background: root.gate.tools == "" ? transparent : Theme.surface-active;
            border-width: root.gate.tools == "" ? 1px : 0px;
            border-color: Theme.muted;
            tools-text := Text {
                text: root.gate.tools == "" ? @tr("free") : root.gate.tools;
                color: root.gate.tools == "" ? Theme.muted : Theme.accent;
                font-size: Theme.font-small;
                font-weight: root.gate.tools == "" ? 400 : 700;
            }
        }
    }
}

// The gate of one tool: left what the file wants and what the gate holds, right all gates to map the tool to; a tap on
// a gate maps the tool to it and closes the dialog.
export component ToolGateDialog inherits Scrim {
    property <ToolMatchItem> mapping: Printer.mmu-tools[MmuDialogs.tool-gate];
    visible: MmuDialogs.tool-gate >= 0 && MmuDialogs.tool-gate < Printer.mmu-tools.length;

    function close() {
        MmuDialogs.tool-gate = -1;
    }

    DialogPanel {
        width: min(parent.width - 16px, 780px);
        height: parent.height - 16px;
        x: (parent.width - self.width) / 2;
        y: 8px;

        HorizontalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            VerticalLayout {
                width: 270px;
                spacing: Theme.spacing-medium;
                DialogTitle {
                    height: Theme.touch;
                    text: root.mapping.gate >= 0 ? @tr("T{} · Gate {}", root.mapping.tool, root.mapping.gate) : @tr("T{}", root.mapping.tool);
                }
                if root.mapping.used: Text {
                    text: @tr("The file wants");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
                if root.mapping.used: WantedLine {
                    mapping: root.mapping;
                }
                if root.mapping.gate >= 0: Text {
                    text: @tr("Gate {} holds", root.mapping.gate);
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
                if root.mapping.gate >= 0: LoadedLine {
                    mapping: root.mapping;
                }
                Advice {
                    mapping: root.mapping;
                    with-advice: false;
                }
                Rectangle { vertical-stretch: 1; }
                if root.mapping.gate >= 0: OpenGateButton {
                    height: 48px;
                    gate: root.mapping.gate;
                    opened => { root.close(); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing-medium;
                HorizontalLayout {
                    height: Theme.touch;
                    spacing: Theme.spacing;
                    Text {
                        horizontal-stretch: 1;
                        text: root.mapping.used ? @tr("Assign a gate to T{} · ✓ fits", root.mapping.tool) : @tr("Assign a gate to T{}", root.mapping.tool);
                        color: Theme.muted;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        width: Theme.touch;
                        icon: Icons.ui-close;
                        accessible-label: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
                choice-list := ScrollList {
                    vertical-stretch: 1;
                    property <length> row-step: 52px + 4px;
                    content-height: Printer.mmu-gates.length * self.row-step - 4px;
                    for gate[index] in Printer.mmu-gates: GateChoice {
                        y: index * choice-list.row-step;
                        width: choice-list.row-width;
                        gate: gate;
                        fits: root.mapping.used && root.mapping.fitting-gates[gate.index];
                        selected: gate.index == root.mapping.gate;
                        clicked => {
                            if (!self.selected) {
                                Actions.mmu-map-tool(root.mapping.tool, gate.index);
                            }
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
