// The prepared file on the print page: what the slicer plans, and how the filament at the printer fits it. Only hints:
// nothing here keeps the print from starting.

import { Theme } from "../theme.slint";
import { ToolLabel } from "../components/tool-label.slint";
import { Icons } from "../icons.slint";
import { FilamentTab, MmuDialogs, ToolMatchItem, Navigation, Page, Printer, SpoolPicker } from "../state.slint";
import { Card, ScrollList, ValueTile } from "../components/controls.slint";
import { VerdictIcon } from "../components/mmu-tiles.slint";
import { FilamentColors, FilamentSwatch, FilamentText } from "../components/filament-swatch.slint";

// A tool of the file as a small row: the colour the file asks for beside the colour of its gate (one field, split),
// the tool, its material (yellow when the gate holds another) and whether they fit.
component ToolChip inherits Rectangle {
    in property <ToolMatchItem> mapping;
    property <bool> has-gate: root.mapping.gate >= 0;
    callback clicked;
    background: chip-touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-radius: Theme.radius;

    chip-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        spacing: Theme.spacing-medium;
        padding-right: Theme.padding;
        // Wanted and loaded colour side by side, close together so they read as one field.
        HorizontalLayout {
            spacing: Theme.spacing-tight;
            FilamentSwatch {
                width: 18px;
                left-edge: true;
                ground: Theme.surface;
                colors: root.mapping.wanted-colors;
                empty: root.mapping.wanted-colors.count == 0;
            }
            FilamentSwatch {
                width: 18px;
                radius: 0px;
                colors: root.has-gate && !root.mapping.gate-empty ? FilamentColors.generic(root.mapping.loaded-colors) : root.mapping.loaded-colors;
                empty: !root.has-gate || root.mapping.gate-empty;
                warn: root.mapping.color-differs;
            }
        }
        Text {
            text: "T" + root.mapping.tool;
            color: Theme.accent;
            font-size: Theme.font-normal;
            font-weight: 700;
            vertical-alignment: center;
        }
        // The material the file asks for; in the warning colour when the gate holds another.
        Text {
            horizontal-stretch: 1;
            text: root.mapping.wanted-material;
            color: root.mapping.material-differs ? Theme.warning : Theme.foreground;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        VerdictIcon {
            cross-axis-self-alignment: center;
            width: Theme.icon-compact;
            height: Theme.icon-compact;
            verdict: root.mapping.verdict;
        }
    }
}

// Tools of the file as small rows, two in a row. The grid takes the free height of the page, at least one row and at most
// all of them; only what still does not fit scrolls. The first `skip` tools are left out.
component ToolChipGrid inherits ScrollList {
    in property <[ToolMatchItem]> tools;
    in property <int> skip;
    property <int> columns: 2;
    property <int> count: max(0, root.tools.length - root.skip);
    property <int> rows: ceil(root.count / root.columns);
    property <length> chip-height: 40px;
    property <length> gap: 6px;
    property <length> row-step: root.chip-height + root.gap;
    property <length> chip-width: (root.row-width - (root.columns - 1) * root.gap) / root.columns;
    callback clicked(mapping: ToolMatchItem);
    content-height: max(0px, root.rows * root.row-step - root.gap);
    min-height: min(root.content-height, root.chip-height);
    preferred-height: root.content-height;
    max-height: root.content-height;
    vertical-stretch: 1;

    for mapping[index] in root.tools: Rectangle {
        property <int> place: index - root.skip;
        x: mod(max(0, self.place), root.columns) * (root.chip-width + root.gap);
        y: floor(max(0, self.place) / root.columns) * root.row-step;
        width: root.chip-width;
        height: root.chip-height;
        if index >= root.skip: ToolChip {
            width: parent.width;
            height: parent.height;
            mapping: mapping;
            clicked => { root.clicked(mapping); }
        }
    }
}

// The tools of the file with their gates. A tap leads to the Tools tab, where the map is changed; a tap on a tool opens
// its dialog there, which says what to do when it does not fit. Closing it leaves the Tools tab open.
component ToolMatchCard inherits Card {
    title: @tr("Tool-to-gate map");
    icon: Icons.mmu-ttg-map;
    tappable: true;
    vertical-stretch: 1;
    clicked => { root.open-tools(); }

    function open-tools() {
        Navigation.filament-tab = FilamentTab.tools;
        Navigation.page = Page.filament;
    }

    HorizontalLayout {
        spacing: Theme.spacing-medium;
        height: 24px;
        VerdictIcon {
            cross-axis-self-alignment: center;
            verdict: Printer.mmu-match-verdict;
        }
        Text {
            horizontal-stretch: 1;
            text: Printer.mmu-match-summary;
            color: Printer.mmu-match-verdict == "differs" ? Theme.warning : Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-chevron-right;
            colorize: Theme.muted;
            width: 18px;
            height: 18px;
        }
    }
    ToolChipGrid {
        tools: Printer.prepared-tools;
        clicked(mapping) => {
            root.open-tools();
            MmuDialogs.tool = mapping.tools-row;
        }
    }
}

// What the file asks of the extruder beside the spool in use, as one row "T0 file → spool" like the Tools tab; a tap
// opens the spool picker when Spoolman is there. Without MMU only tool 0 can be compared: Spoolman knows one spool in
// use. Further tools of the file show as small rows. Without Spoolman only the file's side is shown.
component ExtruderMatchCard inherits Card {
    property <ToolMatchItem> first: Printer.prepared-tools[0];
    property <bool> several: Printer.prepared-tools.length > 1;
    property <bool> has-spool-side: Printer.has-spoolman;
    title: @tr("Filament");
    icon: Icons.filament-spool;
    tappable: Printer.has-spoolman;
    vertical-stretch: 1;
    clicked => { root.pick-spool(); }

    function pick-spool() {
        if (Printer.has-spoolman) {
            SpoolPicker.show-in-use();
        }
    }

    // A further tool: the spool of its own tool macro, or the spool in use; nothing when it has no spool to pick.
    function pick-tool-spool(mapping: ToolMatchItem) {
        if (!Printer.has-spoolman || mapping.spool-pick == -2) {
            return;
        }
        if (mapping.spool-pick >= 0) {
            SpoolPicker.show-tool(mapping.spool-pick, mapping.spool-id, mapping.spool-target);
        } else {
            SpoolPicker.show(-1, Printer.spool-id);
        }
    }

    HorizontalLayout {
        spacing: Theme.spacing-medium;
        height: 56px;
        ToolLabel {
            width: 40px;
            tool: root.first.tool;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            spacing: Theme.spacing;
            FilamentSwatch {
                width: 28px;
                colors: root.first.wanted-colors;
                empty: root.first.wanted-colors.count == 0;
                gap-color: Theme.surface;
            }
            FilamentText {
                horizontal-stretch: 1;
                material: root.first.wanted-material != "" ? root.first.wanted-material : @tr("No filament named");
                material-color: root.first.wanted-material != "" ? Theme.foreground : Theme.muted;
                name: root.first.wanted-profile;
                trail: root.first.wanted-weight;
            }
        }
        if root.has-spool-side: Image {
            width: 18px;
            source: Icons.ui-chevron-right;
            colorize: Theme.muted;
        }
        if root.has-spool-side: HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            spacing: Theme.spacing;
            FilamentSwatch {
                width: 28px;
                colors: Printer.has-spool ? FilamentColors.generic(Printer.spool-colors) : Printer.spool-colors;
                empty: !Printer.has-spool;
                warn: root.first.color-differs;
                gap-color: Theme.surface;
            }
            FilamentText {
                horizontal-stretch: 1;
                material: Printer.has-spool ? (Printer.spool-material != "" ? Printer.spool-material : "-") : @tr("No spool");
                material-elide: !Printer.has-spool;
                material-color: !Printer.has-spool ? Theme.muted : root.first.material-differs ? Theme.warning : Theme.foreground;
                name: Printer.has-spool ? Printer.spool-title : "";
                trail: Printer.has-spool ? Printer.spool-weight : "";
                trail-warn: Printer.has-spool && root.first.weight-differs;
            }
        }
    }
    if root.first.verdict == "fits" || root.first.verdict == "differs": HorizontalLayout {
        spacing: Theme.spacing-medium;
        VerdictIcon {
            cross-axis-self-alignment: start;
            verdict: root.first.verdict;
        }
        Text {
            horizontal-stretch: 1;
            text: root.first.verdict == "fits" ? @tr("The spool fits the file") : @tr("The spool differs from the file");
            color: root.first.verdict == "fits" ? Theme.foreground : Theme.warning;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
    if root.several: ToolChipGrid {
        tools: Printer.prepared-tools;
        skip: 1;
        clicked(mapping) => { root.pick-tool-spool(mapping); }
    }
}

// Middle column of the print page while a file is prepared: the slicer's plan in tiles, then the filament.
export component PreparedJob inherits VerticalLayout {
    spacing: Theme.spacing;

    HorizontalLayout {
        spacing: Theme.spacing;
        ValueTile {
            weight: 4;
            icon: Icons.print-duration;
            label: @tr("Estimated");
            value: Printer.prepared.time != "" ? Printer.prepared.time : "-";
        }
        ValueTile {
            weight: 5;
            icon: Icons.filament-spool;
            label: @tr("Filament");
            value: Printer.prepared.weight != "" ? Printer.prepared.weight : "-";
        }
    }
    HorizontalLayout {
        spacing: Theme.spacing;
        ValueTile {
            weight: 4;
            icon: Icons.print-nozzle-diameter;
            label: @tr("Nozzle diameter");
            value: Printer.prepared.nozzle != "" ? Printer.prepared.nozzle + " mm" : "-";
        }
        ValueTile {
            weight: 5;
            icon: Icons.thermal-nozzle;
            label: Printer.prepared.chamber-temperature != "" ? @tr("Nozzle / Bed / Chamber") : @tr("Nozzle / Bed");
            value: Printer.prepared.extruder-temperature == "" && Printer.prepared.bed-temperature == "" ? "-" : Printer.prepared.extruder-temperature + " / " + Printer.prepared.bed-temperature + (Printer.prepared.chamber-temperature != "" ? " / " + Printer.prepared.chamber-temperature : "");
        }
    }
    if Printer.has-mmu: ToolMatchCard { }
    if !Printer.has-mmu: ExtruderMatchCard { }
}
