// The machine tab of the system pages: Klipper, host and power devices.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Page, Printer } from "../state.slint";
import { Card, IconButton, IconLabel, ToggleRow } from "../components/controls.slint";
import { SystemTabs } from "../components/system-tabs.slint";

export component SystemPage inherits Rectangle {
    init => { Actions.refresh-system(); }

    VerticalLayout {
    padding: Theme.padding;
    spacing: Theme.spacing;
    SystemTabs { }
    HorizontalLayout {
        spacing: Theme.spacing;
        vertical-stretch: 1;

        VerticalLayout {
            width: 260px;
            spacing: Theme.spacing;
            Card {
                title: @tr("Klipper");
                icon: Icons.system-firmware-restart;
                IconLabel {
                    icon: Printer.is-connected ? Icons.system-connected : Icons.system-disconnected;
                    text: Printer.endpoint;
                    font-size: Theme.font-small;
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    height: 64px;
                    IconButton {
                        icon: Icons.system-restart;
                        text: @tr("Reload config");
                        enabled: Printer.is-connected && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Restart Klipper"), @tr("Reloads the configuration."), "restart-klipper", "", false); }
                    }
                    IconButton {
                        icon: Icons.system-firmware-restart;
                        text: @tr("Firmware");
                        enabled: Printer.is-connected && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Firmware restart"), @tr("Restarts Klipper and all MCUs."), "firmware-restart", "", false); }
                    }
                }
            }
            Card {
                title: @tr("Host");
                icon: Icons.system-host;
                HorizontalLayout {
                    spacing: Theme.spacing;
                    height: 64px;
                    IconButton {
                        icon: Icons.system-restart;
                        text: @tr("Reboot");
                        enabled: Printer.is-connected && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Reboot host"), @tr("The printer host restarts. The connection is lost for a while."), "reboot-host", "", true); }
                    }
                    IconButton {
                        icon: Icons.system-shutdown;
                        text: @tr("Shutdown");
                        enabled: Printer.is-connected && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Shut down host"), @tr("The printer host powers off and must be switched on by hand."), "shutdown-host", "", true); }
                    }
                }
                Text { text: @tr("Restart service"); color: Theme.muted; font-size: Theme.font-small; }
                HorizontalLayout {
                    spacing: Theme.spacing;
                    height: 64px;
                    for service in [{ id: "klipper", name: @tr("Klipper") }, { id: "moonraker", name: @tr("Moonraker") }]: IconButton {
                        text: service.name;
                        icon: Icons.system-restart;
                        enabled: Printer.is-connected && !Printer.host-actions-locked;
                        clicked => { Confirm.ask(@tr("Restart service"), service.name, "restart-service", service.id, false); }
                    }
                }
                if Printer.host-actions-locked: IconLabel {
                    icon: Icons.ui-lock;
                    text: Printer.updates-busy ? @tr("Locked while updating")
                        : Printer.is-printing ? @tr("Locked while printing") : @tr("Locked while Klipper is busy");
                    color: Theme.warning;
                    font-size: Theme.font-small;
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing;
            if Printer.has-power: Card {
                title: @tr("Power devices");
                icon: Icons.accessory-power-device;
                for device in Printer.power-devices: ToggleRow {
                    height: Theme.row-height-small;
                    text: device.name;
                    checked: device.on;
                    enabled: !(device.locked && Printer.is-printing);
                    toggled => {
                        if (device.on) {
                            Confirm.ask(@tr("Switch off"), device.name, "power-off", device.name, true);
                        } else {
                            Actions.set-power(device.name, true);
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    }
}
