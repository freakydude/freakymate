// Dialogs of the Gates tab: what can be done with one gate (a tap on its tile) and with the bypass.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, MmuDialogs, MmuGateItem, Printer, SpoolPicker } from "../state.slint";
import { IconButton, IconLabel, TextWithValue } from "../components/controls.slint";
import { FilamentColors, FilamentSwatch } from "../components/filament-swatch.slint";
import { DialogHeader, DialogPanel, Scrim } from "../components/dialog.slint";
import { GateAvailabilityLabel } from "../components/mmu-tiles.slint";

// Happy Hare unloads loaded filament before it checks another gate, and loads it again afterwards outside a print.
export global GateCheck {
    pure public function unloads-first(gate: int) -> bool {
        return Printer.mmu-filament != "unloaded" && gate != Printer.mmu-gate;
    }

    public function ask(title: string, action: string, argument: string) {
        Confirm.ask(title, @tr("Happy Hare unloads the loaded filament first and, outside a print, loads it again afterwards."), action, argument, false);
    }
}

// Materials and colours offered for a gate without Spoolman: the common ones, as chips and swatches big enough for
// a finger rather than a free colour picker.
global GateFilaments {
    out property <[string]> materials: ["PLA", "PETG", "ABS", "ASA", "TPU", "PA", "PC"];
    out property <[color]> colors: [
        #000000, #ffffff, #808080, #ff0000, #ff8000, #ffff00,
        #00a000, #00c0ff, #0000ff, #800080, #ff69b4, #8b4513,
    ];
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> checked;
    callback clicked;

    min-height: Theme.touch;
    border-radius: Theme.radius;
    border-width: root.checked ? 3px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-checked: root.checked;

    // The field draws a colour with alpha over a checkerboard.
    FilamentSwatch {
        x: root.checked ? 3px : 0px;
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.x;
        radius: Theme.radius;
        colors: { first: root.swatch, count: 1 };
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// One tile of the Gates tab, a gate of Happy Hare or a lane of AFC: load, unload, eject it, and the filament in it: the
// spool with Spoolman, otherwise material and colour in Happy Hare's gate map or in the lane. Select, Preload, Check
// and the title's tools are Happy Hare's; the tools and the EndlessSpool group are set on the Tools tab only.
// Actions that move the filament close the dialog, so the load path on the tab shows how it goes; the settings
// keep it open. The dialog hangs from the top, so its actions stay in the same place with and without Spoolman.
export component GateDialog inherits Scrim {
    property <MmuGateItem> item: Printer.mmu-gates[MmuDialogs.gate-row];
    // A gate without a spool of Spoolman (no Spoolman at all, or a spool that is not kept there) has its material and
    // colour in Happy Hare's gate map, and a tap sets them right away. With a spool, Spoolman gives them, and when
    // Happy Hare takes them from Spoolman (`pull`) they cannot be set here. AFC has no such mode: its lane always takes them.
    property <bool> sets-filament: !Printer.has-mmu || (Printer.mmu-gate-map-local && (!Printer.has-spoolman || root.item.spool-id < 0));
    visible: MmuDialogs.gate-row >= 0 && MmuDialogs.gate-row < Printer.mmu-gates.length;

    function close() {
        MmuDialogs.gate-row = -1;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: root.item.tools != "" ? root.item.title + " · " + root.item.tools : root.item.title;
                close => { root.close(); }
                GateAvailabilityLabel {
                    availability: root.item.availability;
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                FilamentSwatch {
                    cross-axis-self-alignment: center;
                    width: 14px;
                    height: 36px;
                    radius: 4px;
                    colors: root.item.availability == "available" || root.item.availability == "buffered" ? FilamentColors.generic(root.item.colors) : root.item.colors;
                    empty: root.item.availability == "empty";
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.item.material == "" ? "-" : root.item.material;
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        font-weight: 700;
                        overflow: elide;
                    }
                    TextWithValue {
                        text: root.item.name;
                        value: root.item.spool-text;
                        color: root.item.spool-low ? Theme.warning : Theme.muted;
                    }
                }
                // With Spoolman the tile takes the filament of a spool.
                if Printer.has-spoolman: IconButton {
                    width: 200px;
                    icon: Icons.filament-spool;
                    text: root.item.spool-id >= 0 ? @tr("Change spool") : @tr("Pick spool");
                    horizontal: true;
                    clicked => { SpoolPicker.show-lane(MmuDialogs.gate-row, root.item.spool-id, root.item.title); }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: 76px;
                if Printer.has-mmu: IconButton {
                    icon: Icons.mmu-select-gate;
                    text: @tr("Select");
                    // Happy Hare changes the gate only with the filament unloaded.
                    enabled: !root.item.selected && Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-select-gate(root.item.index);
                        root.close();
                    }
                }
                // The loaded tile unloads, any other loads.
                if !root.item.loaded: IconButton {
                    icon: Icons.mmu-load;
                    text: @tr("Load");
                    enabled: (!Printer.has-mmu || Printer.mmu-filament != "loaded") && root.item.availability != "empty";
                    clicked => {
                        Actions.lane-load(MmuDialogs.gate-row);
                        root.close();
                    }
                }
                if root.item.loaded: IconButton {
                    icon: Icons.mmu-unload;
                    text: @tr("Unload");
                    clicked => {
                        Actions.lane-unload(MmuDialogs.gate-row);
                        root.close();
                    }
                }
                if Printer.has-mmu: IconButton {
                    icon: Icons.mmu-preload;
                    text: @tr("Preload");
                    // Happy Hare refuses to preload while printing.
                    enabled: Printer.print-state != "printing";
                    clicked => {
                        Actions.mmu-preload(root.item.index);
                        root.close();
                    }
                }
                if Printer.has-mmu: IconButton {
                    icon: Icons.mmu-check-gate;
                    text: @tr("Check");
                    clicked => {
                        if (GateCheck.unloads-first(root.item.index)) {
                            GateCheck.ask(@tr("Check gate {}", root.item.index), "mmu-check-gate", root.item.index);
                        } else {
                            Actions.mmu-check-gate(root.item.index);
                        }
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-eject;
                    text: @tr("Eject");
                    enabled: root.item.availability != "empty" && (Printer.has-mmu || Printer.print-state != "printing");
                    // Pulls the filament out of the unit, so it asks first.
                    clicked => {
                        Confirm.ask(@tr("Eject filament"), Printer.has-mmu
                            ? @tr("Pulls the filament of gate {} out of the MMU. If it is loaded, it is only unloaded; eject again to pull it out.", root.item.index)
                            : @tr("Pulls the filament of {} out of its unit.", root.item.title), "lane-eject", MmuDialogs.gate-row, false);
                        root.close();
                    }
                }
            }

            if root.sets-filament: HorizontalLayout {
                spacing: Theme.spacing;
                for material in GateFilaments.materials: IconButton {
                    horizontal-stretch: 1;
                    text: material;
                    checked: root.item.material == material;
                    clicked => { Actions.set-lane-material(MmuDialogs.gate-row, material); }
                }
            }
            if root.sets-filament: HorizontalLayout {
                spacing: Theme.spacing;
                for swatch in GateFilaments.colors: ColorSwatch {
                    horizontal-stretch: 1;
                    swatch: swatch;
                    checked: root.item.has-color && root.item.colors.first == swatch;
                    clicked => { Actions.set-lane-color(MmuDialogs.gate-row, swatch); }
                }
            }
        }
    }
}

// The bypass: filament fed by hand past the gates, straight to the extruder. Happy Hare selects it only while no
// filament is loaded; material and colour of the bypass are not in its status, so the dialog offers none.
export component BypassDialog inherits Scrim {
    visible: MmuDialogs.bypass-open;

    function close() {
        MmuDialogs.bypass-open = false;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("Bypass");
                close => { root.close(); }
            }
            Text {
                text: @tr("Filament fed by hand past the gates, straight to the extruder. Load pulls it in once it is pushed into the bypass.");
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if Printer.mmu-filament == "loaded" && !Printer.mmu-bypass: IconLabel {
                icon: Icons.ui-info;
                text: @tr("Unload first: Happy Hare selects the bypass only without loaded filament.");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: 76px;
                IconButton {
                    icon: Icons.mmu-select-gate;
                    text: @tr("Select");
                    enabled: !Printer.mmu-bypass && Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-select-bypass();
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-load;
                    text: @tr("Load");
                    enabled: Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-load-bypass();
                        root.close();
                    }
                }
            }
        }
    }
}
