// Dialogs of the Gates tab: what can be done with one gate (a tap on its tile) and with the bypass.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, MmuDialogs, MmuGateItem, Printer, SpoolPicker } from "../state.slint";
import { ColorBar, IconButton, IconLabel, TextWithValue } from "../components/controls.slint";
import { DialogHeader, DialogPanel, Scrim } from "../components/dialog.slint";
import { GateAvailabilityLabel } from "mmu.slint";

// Happy Hare unloads loaded filament before it checks another gate, and loads it again afterwards outside a print.
export global GateCheck {
    pure public function unloads-first(gate: int) -> bool {
        return Printer.mmu-filament != "unloaded" && gate != Printer.mmu-gate;
    }

    public function ask(title: string, action: string, argument: string) {
        Confirm.ask(title, @tr("Happy Hare unloads the loaded filament first and, outside a print, loads it again afterwards."), action, argument, false);
    }
}

// Materials and colours offered for a gate without Spoolman: the common ones, as chips and swatches big enough for
// a finger rather than a free colour picker.
global GateFilaments {
    out property <[string]> materials: ["PLA", "PETG", "ABS", "ASA", "TPU", "PA", "PC"];
    out property <[color]> colors: [
        #000000, #ffffff, #808080, #ff0000, #ff8000, #ffff00,
        #00a000, #00c0ff, #0000ff, #800080, #ff69b4, #8b4513,
    ];
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> checked;
    callback clicked;

    min-height: Theme.touch;
    border-radius: Theme.radius;
    background: root.swatch;
    border-width: root.checked ? 3px : 1px;
    border-color: root.checked ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-checked: root.checked;

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// One gate: select, load, preload, check or eject it, and the filament in it: the spool with Spoolman, otherwise
// material and colour in Happy Hare's gate map. The title names the tools that take their filament from the gate;
// they and the EndlessSpool group are set on the Tools tab only.
// Actions that move the filament close the dialog, so the filament path on the tab shows how it goes; the settings
// keep it open. The dialog hangs from the top, so its actions stay in the same place with and without Spoolman.
export component GateDialog inherits Scrim {
    property <MmuGateItem> item: Printer.mmu-gates[MmuDialogs.gate];
    visible: MmuDialogs.gate >= 0 && MmuDialogs.gate < Printer.mmu-gates.length;

    function close() {
        MmuDialogs.gate = -1;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: root.item.tools != "" ? @tr("Gate {} · {}", root.item.index, root.item.tools) : @tr("Gate {}", root.item.index);
                close => { root.close(); }
                GateAvailabilityLabel {
                    availability: root.item.availability;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                height: Theme.touch;
                ColorBar {
                    cross-axis-self-alignment: center;
                    width: 14px;
                    height: 36px;
                    vertical: true;
                    first: root.item.has-color ? root.item.color : Theme.border;
                    second: root.item.color-2;
                    third: root.item.color-3;
                    count: max(1, root.item.color-count);
                    longitudinal: root.item.longitudinal;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.item.material == "" ? "-" : root.item.material;
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        font-weight: 700;
                        overflow: elide;
                    }
                    TextWithValue {
                        text: root.item.name;
                        value: root.item.spool-text;
                        color: root.item.spool-low ? Theme.warning : Theme.muted;
                    }
                }
                // With Spoolman the gate takes the filament of a spool.
                if Printer.has-spoolman: IconButton {
                    width: 200px;
                    icon: Icons.filament-spool;
                    text: root.item.spool-id >= 0 ? @tr("Change spool") : @tr("Pick spool");
                    horizontal: true;
                    clicked => { SpoolPicker.show(root.item.index, root.item.spool-id); }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: 76px;
                IconButton {
                    icon: Icons.mmu-select-gate;
                    text: @tr("Select");
                    // Happy Hare changes the gate only with the filament unloaded.
                    enabled: !root.item.selected && Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-select-gate(root.item.index);
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-load;
                    text: @tr("Load");
                    enabled: Printer.mmu-filament != "loaded" && root.item.availability != "empty";
                    clicked => {
                        Actions.mmu-load-gate(root.item.index);
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-preload;
                    text: @tr("Preload");
                    // Happy Hare refuses to preload while printing.
                    enabled: Printer.print-state != "printing";
                    clicked => {
                        Actions.mmu-preload(root.item.index);
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-check-gate;
                    text: @tr("Check");
                    clicked => {
                        if (GateCheck.unloads-first(root.item.index)) {
                            GateCheck.ask(@tr("Check gate {}", root.item.index), "mmu-check-gate", root.item.index);
                        } else {
                            Actions.mmu-check-gate(root.item.index);
                        }
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-eject;
                    text: @tr("Eject");
                    enabled: root.item.availability != "empty";
                    // Pulls the filament out of the MMU, so it asks first.
                    clicked => {
                        Confirm.ask(@tr("Eject filament"), @tr("Pulls the filament of gate {} out of the MMU. If it is loaded, it is only unloaded; eject again to pull it out.", root.item.index), "mmu-eject", root.item.index, false);
                        root.close();
                    }
                }
            }

            // Without Spoolman material and colour live in Happy Hare's gate map; a tap sets them right away.
            if !Printer.has-spoolman: HorizontalLayout {
                spacing: Theme.spacing;
                for material in GateFilaments.materials: IconButton {
                    horizontal-stretch: 1;
                    text: material;
                    checked: root.item.material == material;
                    clicked => { Actions.set-gate-material(root.item.index, material); }
                }
            }
            if !Printer.has-spoolman: HorizontalLayout {
                spacing: Theme.spacing;
                for swatch in GateFilaments.colors: ColorSwatch {
                    horizontal-stretch: 1;
                    swatch: swatch;
                    checked: root.item.has-color && root.item.color == swatch;
                    clicked => { Actions.set-gate-color(root.item.index, swatch); }
                }
            }
        }
    }
}

// The bypass: filament fed by hand past the gates, straight to the extruder. Happy Hare selects it only while no
// filament is loaded; material and colour of the bypass are not in its status, so the dialog offers none.
export component BypassDialog inherits Scrim {
    visible: MmuDialogs.bypass-open;

    function close() {
        MmuDialogs.bypass-open = false;
    }

    DialogPanel {
        width: min(parent.width - 16px, 680px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 8px;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("Bypass");
                close => { root.close(); }
            }
            Text {
                text: @tr("Filament fed by hand past the gates, straight to the extruder. Load pulls it in once it is pushed into the bypass.");
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if Printer.mmu-filament == "loaded" && !Printer.mmu-bypass: IconLabel {
                icon: Icons.ui-info;
                text: @tr("Unload first: Happy Hare selects the bypass only without loaded filament.");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: 76px;
                IconButton {
                    icon: Icons.mmu-select-gate;
                    text: @tr("Select");
                    enabled: !Printer.mmu-bypass && Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-select-bypass();
                        root.close();
                    }
                }
                IconButton {
                    icon: Icons.mmu-load;
                    text: @tr("Load");
                    enabled: Printer.mmu-filament != "loaded";
                    clicked => {
                        Actions.mmu-load-bypass();
                        root.close();
                    }
                }
            }
        }
    }
}
