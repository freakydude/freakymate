// Gates tab of the Filament page: the gates and the bypass (four or five slots at a time), the filament path with sensors and
// buffer, unload of the loaded filament; a tap on a gate or the bypass opens what can be done with it
// (`mmu-dialogs.slint`).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, MmuDialogs, MmuGateItem, MmuGatePage, MmuPageRange, Navigation, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, Card, IconButton, IconLabel, TextWithValue } from "../components/controls.slint";
import { FilamentColors, FilamentSwatch } from "../components/filament-swatch.slint";
import { FilamentPath } from "../components/filament-path.slint";
import { BypassTile, FlowGuardInstrument, GateTile, MmuTexts, SlotTile } from "../components/mmu-tiles.slint";

// Recover and unlock while the MMU holds the print or is locked; the print page shows the same in its strip.
component MmuRecoverRow inherits HorizontalLayout {
    spacing: Theme.spacing;
    height: Theme.touch;
    IconButton {
        icon: Icons.mmu-recover;
        text: @tr("Recover");
        horizontal: true;
        clicked => { Actions.mmu-recover(); }
    }
    IconButton {
        icon: Icons.ui-unlock;
        text: @tr("Unlock");
        horizontal: true;
        clicked => { Actions.mmu-unlock(); }
    }
}

// A tap on a gate opens its dialog instead of moving the selector, so looking at a gate or setting its colour never
// moves anything. Loading belongs to a gate (its dialog); unloading takes out whatever is loaded, so it sits at the
// filament path. The tools and the commands for the MMU as a whole are on the Changer page.
export component MmuGatesTab inherits Rectangle {
    // Height of the row of gate tiles and the page arrows.
    property <length> tile-row-height: 150px;
    // The head whose gates the tab shows, a row of `Printer.heads`; -1 without a head level (all gates).
    in property <int> head-index: -1;
    // The pages of this view: one unit at a time, four or five tiles at most (the split is made in the core, `gate_pages.rs`).
    property <MmuPageRange> range: Printer.mmu-page-ranges[max(0, root.head-index)];
    property <int> pages: root.range.count;
    // Until a chevron is used the tab opens on the unit of the loaded gate.
    property <int> page: max(0, min(Navigation.mmu-page < 0 ? root.range.start : Navigation.mmu-page, root.pages - 1));
    property <MmuGatePage> current: Printer.mmu-pages[root.range.first + root.page];
    // With several units a caption names the unit, its head and the gates; one unit or none has no caption.
    property <bool> captioned: root.current.unit != "";
    // Tiles (the bypass included) across the tab: with arrows beside them four, so the longest state word ("Available",
    // "Unknown") fits its tile beside the icon; without arrows (one page) five. The core pages by the same numbers.
    property <int> slots-per-page: root.pages > 1 ? 4 : 5;
    property <bool> needs-recovery: Printer.mmu-paused || Printer.mmu-locked;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        if root.captioned: HorizontalLayout {
            spacing: Theme.spacing;
            Text {
                text: root.current.head != "" ? @tr("{} · on {}", root.current.unit, root.current.head) : root.current.unit;
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 700;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.current.first-gate < 0 ? "" : root.current.first-gate == root.current.last-gate ? @tr("Gate {}", root.current.first-gate) : @tr("Gates {}–{}", root.current.first-gate, root.current.last-gate);
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            // The arrows stay in the row (no `if`), so the stretch of the tiles keeps its place; one page takes none.
            spacing: root.pages > 1 ? Theme.spacing : 0px;
            height: root.tile-row-height;
            IconButton {
                visible: root.pages > 1;
                min-width: root.pages > 1 ? Theme.touch : 0px;
                max-width: self.min-width;
                icon: Icons.ui-chevron-left;
                enabled: root.page > 0;
                clicked => { Navigation.mmu-page = root.page - 1; }
            }
            tiles := Rectangle {
                horizontal-stretch: 1;
                property <length> cell-width: (self.width - (root.slots-per-page - 1) * Theme.spacing) / root.slots-per-page;
                for slot in root.current.count: GateTile {
                    x: slot * (tiles.cell-width + Theme.spacing);
                    width: tiles.cell-width;
                    height: tiles.height;
                    gate: Printer.mmu-gates[root.current.first-row + slot];
                    clicked => {
                        Actions.lane-tapped(root.current.first-row + slot);
                        MmuDialogs.gate-row = root.current.first-row + slot;
                    }
                }
                if root.current.bypass: BypassTile {
                    x: root.current.count * (tiles.cell-width + Theme.spacing);
                    width: tiles.cell-width;
                    height: tiles.height;
                    clicked => {
                        Actions.bypass-tapped();
                        MmuDialogs.bypass-open = true;
                    }
                }
            }
            IconButton {
                visible: root.pages > 1;
                min-width: root.pages > 1 ? Theme.touch : 0px;
                max-width: self.min-width;
                icon: Icons.ui-chevron-right;
                enabled: root.page < root.pages - 1;
                clicked => { Navigation.mmu-page = root.page + 1; }
            }
        }

        Card {
            title: @tr("Filament path");
            icon: Icons.filament-sensor;
            HorizontalLayout {
                spacing: Printer.has-mmu ? Theme.spacing : 0px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing;
                    // Gate or lane to nozzle with the sensors on the way, the one tapped last; further sensors below as chips.
                    FilamentPath { path: Printer.lane-path; }
                    // Grid with equal columns, so every name gets the same width.
                    if Printer.mmu-sensors.length > 0: sensor-grid := Rectangle {
                        property <int> columns: max(1, min(Printer.mmu-sensors.length, floor(self.width / 150px)));
                        property <length> cell-width: (self.width - (self.columns - 1) * Theme.spacing) / self.columns;
                        property <length> row-height: 26px;
                        height: ceil(Printer.mmu-sensors.length / self.columns) * self.row-height;
                        for sensor[index] in Printer.mmu-sensors: IconLabel {
                            x: mod(index, sensor-grid.columns) * (sensor-grid.cell-width + Theme.spacing);
                            y: floor(index / sensor-grid.columns) * sensor-grid.row-height;
                            width: sensor-grid.cell-width;
                            height: sensor-grid.row-height;
                            icon: sensor.state == "disabled" ? Icons.ui-minus : sensor.state == "triggered" ? Icons.ui-check : Icons.filament-runout;
                            text: sensor.label;
                            color: sensor.state == "triggered" ? Theme.foreground : sensor.state == "disabled" ? Theme.disabled-foreground : Theme.muted;
                            font-size: Theme.font-small;
                        }
                    }
                    // While the MMU holds the print, recovering needs the room of the buffer.
                    if root.needs-recovery: MmuRecoverRow { }
                    // The lane of AFC: the side its buffer leans to, as a word; nothing is measured beyond that.
                    if !Printer.has-mmu && Printer.lane-buffer != "": IconLabel {
                        icon: Icons.mmu-sync;
                        text: Printer.lane-buffer == "unknown" ? @tr("Buffer: -") : @tr("Buffer: {}", MmuTexts.buffer(Printer.lane-buffer));
                        color: Theme.muted;
                        font-size: Theme.font-small;
                    }
                    // Buffer and FlowGuard are the selected gate's: another lane on the card has none to show. With an
                    // encoder alone there is no buffer, but FlowGuard still has its line.
                    if Printer.has-mmu && !root.needs-recovery && (Printer.mmu-flowguard-state != "off" || (Printer.mmu-has-buffer && Printer.lane-buffer != "")): FlowGuardInstrument {
                        with-buffer: Printer.lane-buffer != "";
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                // Unloading a lane of AFC is in its tile's dialog.
                VerticalLayout {
                    visible: Printer.has-mmu;
                    min-width: Printer.has-mmu ? 120px : 0px;
                    max-width: self.min-width;
                    spacing: Theme.spacing;
                    IconButton {
                        icon: Icons.mmu-unload;
                        text: @tr("Unload");
                        enabled: !Printer.motion-locked && Printer.mmu-filament != "unloaded";
                        clicked => { Actions.mmu-unload(); }
                    }
                    // Accent only while the MMU is not homed (most commands need it); a homed one has no main action here.
                    IconButton {
                        icon: Icons.mmu-home;
                        text: @tr("Home");
                        kind: Printer.mmu-homed ? ButtonKind.normal : ButtonKind.accent;
                        enabled: !Printer.motion-locked;
                        clicked => { Actions.mmu-home(); }
                    }
                    // Moving the filament waits for the end of the print.
                    if Printer.motion-locked: Text {
                        text: @tr("Not while printing");
                        color: Theme.muted;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}

// The filament in use on the print page with Happy Hare: tool and gate, the spool, and what the MMU does with it: the
// way while the filament moves, buffer and FlowGuard while it prints and, when the MMU paused the print, the buttons to
// recover.
export component MmuStrip inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    property <bool> recovering: Printer.print-state == "paused" && (Printer.mmu-paused || Printer.mmu-locked);
    // Room left over goes evenly between the lines, not to one of them.
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing-medium;
        alignment: space-between;
        // While a paused print waits for Recover or Unlock the line is left out: the banner's hint names the gate.
        if !root.recovering: HorizontalLayout {
            spacing: Theme.spacing;
            Image {
                cross-axis-self-alignment: center;
                width: Theme.icon-small;
                height: Theme.icon-small;
                source: Icons.mmu-unit;
                colorize: Theme.muted;
            }
            TextWithValue {
                text: Printer.mmu-bypass ? @tr("Bypass") : Printer.mmu-gate >= 0 ? (Printer.mmu-tool >= 0 ? "T" + Printer.mmu-tool : "") : @tr("No gate");
                value: !Printer.mmu-bypass && Printer.mmu-gate >= 0 ? @tr("Gate {}", Printer.mmu-gate) : "";
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 700;
            }
            Rectangle { horizontal-stretch: 1; }
            // The spool of the gate in use: its colours, its filament and what is left of it.
            if Printer.has-spool: FilamentSwatch {
                cross-axis-self-alignment: center;
                width: 34px;
                height: 12px;
                colors: FilamentColors.generic(Printer.spool-colors);
            }
            if Printer.has-spool: TextWithValue {
                alignment: end;
                text: Printer.spool-title;
                value: Printer.spool-weight;
                color: Printer.spool-low ? StateIcons.severity-color(Severity.attention) : Theme.muted;
            }
        }
        // Where the filament is, while it is on its way: once loaded the line would only repeat itself.
        if !Printer.mmu-paused && !Printer.mmu-path-settled: FilamentPath { path: Printer.mmu-path; compact: true; }
        // While the MMU holds the print, the reason and the buttons need the room; the reason already names the cause.
        if !Printer.mmu-paused && (Printer.mmu-has-buffer || Printer.mmu-flowguard-state != "off"): FlowGuardInstrument {
            measured-flow-only: true;
        }
        // The reason of the pause stands in the banner of the print page.
        if Printer.mmu-paused || Printer.mmu-locked: MmuRecoverRow { }
    }
}
