// Gates tab of the Filament page: the gates and the bypass (five slots at a time), the filament path with sensors and
// buffer, unload of the loaded filament; a tap on a gate or the bypass opens what can be done with it
// (`mmu-dialogs.slint`).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, MmuDialogs, MmuGateItem, Navigation, Printer } from "../state.slint";
import { Card, ColorBar, IconButton, IconLabel, TextWithValue } from "../components/controls.slint";
import { FilamentPath } from "../components/filament-path.slint";

// Texts of the buffer and FlowGuard and the colour of FlowGuard, shared by the Gates tab and the strip on the print page.
export global MmuTexts {
    pure public function buffer(state: string) -> string {
        if (state == "neutral") { return @tr("Neutral"); }
        if (state == "tension") { return @tr("Tension"); }
        if (state == "compressed") { return @tr("Compression"); }
        if (state == "inactive") { return @tr("Inactive"); }
        return @tr("Off");
    }
    pure public function flowguard(state: string, detail: string) -> string {
        if (state == "triggered") { return @tr("FlowGuard triggered") + (detail == "" ? "" : ": " + detail); }
        if (state == "boosting") { return @tr("FlowGuard: tangle prevention"); }
        if (state == "monitoring") { return @tr("FlowGuard monitoring"); }
        return @tr("FlowGuard ready");
    }
    // Ready and monitoring are fine; tangle prevention is a deviation, triggered an error.
    pure public function flowguard-color(state: string) -> color {
        if (state == "triggered") { return Theme.danger; }
        if (state == "boosting") { return Theme.warning; }
        return Theme.success;
    }
    pure public function availability(availability: string) -> string {
        if (availability == "available") { return @tr("Available"); }
        if (availability == "buffered") { return @tr("Buffered"); }
        if (availability == "empty") { return @tr("Empty"); }
        return @tr("Unknown");
    }
}

// Whether a gate has filament, as an icon with a word; shared by the Gates tab and the gate dialog.
export component GateAvailabilityLabel inherits IconLabel {
    in property <string> availability;
    property <bool> has-filament: root.availability == "available" || root.availability == "buffered";

    icon: root.has-filament ? Icons.mmu-gate-available : root.availability == "empty" ? Icons.mmu-gate-empty : Icons.mmu-gate-unknown;
    text: MmuTexts.availability(root.availability);
    color: root.has-filament ? Theme.success : root.availability == "empty" ? Theme.warning : Theme.muted;
    font-size: Theme.font-small;
}

// The frame of a gate and of the bypass: a tile to tap, with an accent border while selected.
component SlotTile inherits Rectangle {
    in property <bool> selected;
    in property <string> label;
    callback clicked;

    border-radius: Theme.radius;
    background: tile-touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-width: root.selected ? 3px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;

    tile-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        @children
    }
}

component GateTile inherits SlotTile {
    in property <MmuGateItem> gate;

    property <bool> has-filament: root.gate.availability == "available" || root.gate.availability == "buffered";
    property <bool> shows-spool: Printer.has-spoolman && root.has-filament;

    selected: root.gate.selected;
    label: @tr("Gate {}", root.gate.index);

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: @tr("Gate {}", root.gate.index);
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 700;
        }
        // The tools that take their filament from this gate; several share it after a remap.
        Text {
            horizontal-stretch: 1;
            text: root.gate.tools;
            color: Theme.accent;
            font-size: Theme.font-normal;
            font-weight: 700;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
    ColorBar {
        height: 12px;
        border-radius: 6px;
        first: root.gate.color;
        second: root.gate.color-2;
        third: root.gate.color-3;
        count: root.gate.color-count;
        longitudinal: root.gate.longitudinal;
    }
    Text {
        text: root.gate.material == "" ? "-" : root.gate.material;
        color: Theme.foreground;
        font-size: Theme.font-large;
        overflow: elide;
    }
    // With Spoolman the line of the filament name says what is left of the spool instead (the name repeats the
    // material and the colour above); a gate without one invites to pick one in the gate's dialog.
    Text {
        text: !root.shows-spool ? root.gate.name : root.gate.spool-text != "" ? root.gate.spool-text : @tr("+ spool");
        color: root.shows-spool && root.gate.spool-low ? Theme.warning : root.shows-spool && root.gate.spool-text == "" ? Theme.accent : Theme.muted;
        font-size: Theme.font-small;
        overflow: elide;
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        GateAvailabilityLabel {
            availability: root.gate.availability;
        }
        if Printer.mmu-endless-spool && root.gate.group >= 0: IconLabel {
            icon: Icons.mmu-endless-spool;
            text: root.gate.group;
            color: Theme.muted;
            font-size: Theme.font-small;
        }
    }
}

// Happy Hare offers the bypass on every MMU: filament fed by hand past the gates. Material and colour of the bypass
// are not in its status, so the tile only names it.
component BypassTile inherits SlotTile {
    selected: Printer.mmu-bypass;
    label: @tr("Bypass");

    Text {
        text: @tr("Bypass");
        color: Theme.foreground;
        font-size: Theme.font-normal;
        font-weight: 700;
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: center;
        Image {
            source: Icons.mmu-bypass;
            colorize: Printer.mmu-bypass ? Theme.accent : Theme.muted;
            width: 40px;
            height: 40px;
        }
    }
    Rectangle { vertical-stretch: 1; }
    Text {
        text: @tr("Fed by hand");
        color: Theme.muted;
        font-size: Theme.font-small;
        overflow: elide;
    }
}

// Position of the filament in the buffer: tension on the left, compression on the right, the neutral zone in the middle.
export component BufferGauge inherits Rectangle {
    in property <float> bias;
    in property <string> state;
    // Only a measuring buffer marks its neutral zone as the place where all is fine.
    property <bool> measuring: root.state == "neutral" || root.state == "tension" || root.state == "compressed";
    out property <color> marker-color: root.state == "neutral" ? Theme.success : root.state == "tension" || root.state == "compressed" ? Theme.warning : Theme.muted;

    height: 18px;
    Rectangle {
        border-radius: 4px;
        background: Theme.border;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: parent.width * 0.1;
        background: root.measuring ? Theme.success.with-alpha(0.35) : Theme.surface-active;
    }
    Rectangle {
        width: 8px;
        height: parent.height;
        x: clamp((root.bias + 1) / 2, 0, 1) * (parent.width - self.width);
        border-radius: 4px;
        background: root.marker-color;
    }
}

// Recover and unlock while the MMU holds the print or is locked; the print page shows the same in its strip.
component MmuRecoverRow inherits HorizontalLayout {
    spacing: Theme.spacing;
    height: Theme.touch;
    IconButton {
        icon: Icons.mmu-recover;
        text: @tr("Recover");
        horizontal: true;
        kind: "accent";
        clicked => { Actions.mmu-recover(); }
    }
    IconButton {
        icon: Icons.ui-unlock;
        text: @tr("Unlock");
        horizontal: true;
        clicked => { Actions.mmu-unlock(); }
    }
}

// A tap on a gate opens its dialog instead of moving the selector, so looking at a gate or setting its colour never
// moves anything. Loading belongs to a gate (its dialog); unloading takes out whatever is loaded, so it sits at the
// filament path. The tools are on the Tools tab, the commands for the MMU as a whole on the Service tab.
export component MmuGatesTab inherits Rectangle {
    // The bypass is one more slot after the last gate.
    property <int> bypass-slot: Printer.mmu-gates.length;
    property <int> slots-per-page: 5;
    property <int> pages: max(1, ceil((root.bypass-slot + 1) / root.slots-per-page));
    property <int> page: min(Navigation.mmu-page, root.pages - 1);
    property <int> first: root.page * root.slots-per-page;
    property <bool> needs-recovery: Printer.mmu-paused || Printer.mmu-locked;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            height: 150px;
            if root.pages > 1: IconButton {
                width: 48px;
                icon: Icons.ui-chevron-left;
                enabled: root.page > 0;
                clicked => { Navigation.mmu-page = root.page - 1; }
            }
            tiles := Rectangle {
                horizontal-stretch: 1;
                property <length> cell-width: (self.width - (root.slots-per-page - 1) * Theme.spacing) / root.slots-per-page;
                for item in Printer.mmu-gates: GateTile {
                    visible: item.index >= root.first && item.index < root.first + root.slots-per-page;
                    x: mod(item.index, root.slots-per-page) * (tiles.cell-width + Theme.spacing);
                    width: tiles.cell-width;
                    height: tiles.height;
                    gate: item;
                    clicked => { MmuDialogs.gate = item.index; }
                }
                if root.bypass-slot >= root.first && root.bypass-slot < root.first + root.slots-per-page: BypassTile {
                    x: mod(root.bypass-slot, root.slots-per-page) * (tiles.cell-width + Theme.spacing);
                    width: tiles.cell-width;
                    height: tiles.height;
                    clicked => { MmuDialogs.bypass-open = true; }
                }
            }
            if root.pages > 1: IconButton {
                width: 48px;
                icon: Icons.ui-chevron-right;
                enabled: root.page < root.pages - 1;
                clicked => { Navigation.mmu-page = root.page + 1; }
            }
        }

        Card {
            title: @tr("Filament path");
            icon: Icons.filament-sensor;
            HorizontalLayout {
                spacing: Theme.spacing;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    // Gate to nozzle with the sensors on the way; further sensors below as chips.
                    FilamentPath { path: Printer.mmu-path; }
                    // Grid with equal columns, so every name gets the same width.
                    if Printer.mmu-sensors.length > 0: sensor-grid := Rectangle {
                        property <int> columns: max(1, min(Printer.mmu-sensors.length, floor(self.width / 150px)));
                        property <length> cell-width: (self.width - (self.columns - 1) * Theme.spacing) / self.columns;
                        property <length> row-height: 26px;
                        height: ceil(Printer.mmu-sensors.length / self.columns) * self.row-height;
                        for sensor[index] in Printer.mmu-sensors: IconLabel {
                            x: mod(index, sensor-grid.columns) * (sensor-grid.cell-width + Theme.spacing);
                            y: floor(index / sensor-grid.columns) * sensor-grid.row-height;
                            width: sensor-grid.cell-width;
                            height: sensor-grid.row-height;
                            icon: sensor.state == "disabled" ? Icons.ui-minus : sensor.state == "triggered" ? Icons.ui-check : Icons.filament-runout;
                            text: sensor.label;
                            color: sensor.state == "triggered" ? Theme.foreground : sensor.state == "disabled" ? Theme.disabled-foreground : Theme.muted;
                            font-size: Theme.font-small;
                        }
                    }
                    // While the MMU holds the print, recovering needs the room of the buffer.
                    if root.needs-recovery: MmuRecoverRow { }
                    if Printer.mmu-has-buffer && !root.needs-recovery: VerticalLayout {
                        spacing: 4px;
                        IconLabel {
                            icon: Icons.mmu-sync;
                            text: @tr("Buffer: {}", MmuTexts.buffer(Printer.mmu-buffer-state));
                            color: gauge.marker-color;
                            font-size: Theme.font-small;
                        }
                        // The ends named beside the gauge, so the card keeps its height with the filament path above.
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: @tr("Tension"); color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                            gauge := BufferGauge {
                                horizontal-stretch: 1;
                                bias: Printer.mmu-buffer-bias;
                                state: Printer.mmu-buffer-state;
                            }
                            Text { text: @tr("Compression"); color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        if Printer.mmu-flowguard-state != "off": IconLabel {
                            icon: Icons.mmu-flowguard;
                            text: MmuTexts.flowguard(Printer.mmu-flowguard-state, Printer.mmu-flowguard-detail);
                            color: MmuTexts.flowguard-color(Printer.mmu-flowguard-state);
                            font-size: Theme.font-small;
                        }
                        if Printer.mmu-flow-rate >= 0: IconLabel {
                            icon: Icons.filament-flow;
                            text: @tr("Flow {} %", round(Printer.mmu-flow-rate));
                            color: Theme.muted;
                            font-size: Theme.font-small;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                VerticalLayout {
                    width: 120px;
                    spacing: Theme.spacing;
                    IconButton {
                        icon: Icons.mmu-unload;
                        text: @tr("Unload");
                        enabled: Printer.mmu-filament != "unloaded";
                        clicked => { Actions.mmu-unload(); }
                    }
                    // A hint, not a lock: an MMU without home is still shown, but most commands need it.
                    if !Printer.mmu-homed: IconButton {
                        icon: Icons.mmu-home;
                        text: @tr("Home");
                        kind: "accent";
                        clicked => { Actions.mmu-home(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}

// Condensed state of the MMU for the print page: selected tool and gate, buffer, FlowGuard and, when the MMU paused the
// print, the reason with the buttons to recover.
export component MmuStrip inherits Card {
    title: @tr("MMU");
    icon: Icons.mmu-unit;
    // Room left over goes evenly between the lines, not to one of them.
    VerticalLayout {
        spacing: 6px;
        alignment: space-between;
        HorizontalLayout {
            spacing: Theme.spacing;
            Text {
                text: Printer.mmu-bypass ? @tr("Bypass") : Printer.mmu-gate >= 0 ? (Printer.mmu-tool >= 0 ? "T" + Printer.mmu-tool + " · " : "") + @tr("Gate {}", Printer.mmu-gate) : @tr("No gate");
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 700;
            }
            Rectangle { horizontal-stretch: 1; }
            // The spool of the gate in use: its colours, its filament and what is left of it.
            if Printer.has-spool: ColorBar {
                cross-axis-self-alignment: center;
                width: 34px;
                height: 12px;
                border-radius: 6px;
                first: Printer.spool-color;
                second: Printer.spool-color-2;
                third: Printer.spool-color-3;
                count: Printer.spool-color-count;
                longitudinal: Printer.spool-longitudinal;
            }
            if Printer.has-spool: TextWithValue {
                alignment: end;
                text: Printer.spool-title;
                value: Printer.spool-weight;
                color: Printer.spool-low ? Theme.warning : Theme.muted;
            }
        }
        // Where the filament is, in the short form without the distance.
        if !Printer.mmu-paused: FilamentPath { path: Printer.mmu-path; compact: true; }
        // While the MMU holds the print, the reason and the buttons need the room; the reason already names the cause.
        if Printer.mmu-has-buffer && !Printer.mmu-paused: VerticalLayout {
            spacing: 4px;
            IconLabel {
                icon: Icons.mmu-sync;
                text: @tr("Buffer: {}", MmuTexts.buffer(Printer.mmu-buffer-state));
                color: strip-gauge.marker-color;
                font-size: Theme.font-small;
            }
            strip-gauge := BufferGauge {
                bias: Printer.mmu-buffer-bias;
                state: Printer.mmu-buffer-state;
            }
        }
        if !Printer.mmu-paused: HorizontalLayout {
            spacing: Theme.spacing;
            // The flow rate is short and stays whole; the FlowGuard text gives way when the strip is narrow.
            if Printer.mmu-flowguard-state != "off": IconLabel {
                icon: Icons.mmu-flowguard;
                text: MmuTexts.flowguard(Printer.mmu-flowguard-state, Printer.mmu-flowguard-detail);
                color: MmuTexts.flowguard-color(Printer.mmu-flowguard-state);
                font-size: Theme.font-small;
                horizontal-stretch: 1;
                min-width: 0px;
            }
            if Printer.mmu-flow-rate >= 0: IconLabel {
                icon: Icons.filament-flow;
                text: @tr("Flow {} %", round(Printer.mmu-flow-rate));
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-stretch: 0;
            }
        }
        // The reason of the pause stands in the banner of the print page.
        if Printer.mmu-paused || Printer.mmu-locked: MmuRecoverRow { }
    }
}
