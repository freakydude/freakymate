// Motion: jog, home and level the axes, tune the print while it runs (Z offset, speed and flow, the expert values of
// the configuration) and calibrate the bed. Axes and Calibrate move the axes, so a running print greys them out and the
// page shows Tune instead.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, MotionTab, Navigation, Printer, UiSettings } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, Card, IconButton, Note, StepSelector, TabBar, TabButton } from "../components/controls.slint";
import { CalibrateTab } from "calibrate.slint";
import { TuneBasicsTab, TuneExpertTab } from "tune.slint";

component AxisValue inherits HorizontalLayout {
    in property <string> axis;
    in property <float> value;
    in property <bool> homed;
    spacing: Theme.spacing-small;
    Text {
        text: root.axis;
        color: StateIcons.ok-color(root.homed, Theme.muted);
        font-size: Theme.font-normal;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.homed ? root.value.to-fixed(2) : "?";
        color: Theme.foreground;
        font-size: Theme.font-large;
        vertical-alignment: center;
        min-width: 80px;
    }
}

component AxesTab inherits Rectangle {
    property <float> step: UiSettings.move-step;

    // The step row sits under the jog cards only, so the right column with three touch buttons gets the full height.
    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        VerticalLayout {
            spacing: Theme.spacing;

            HorizontalLayout {
                spacing: Theme.spacing;
                vertical-stretch: 1;

                Card {
                    title: @tr("X / Y");
                    icon: Icons.motion-position;
                    horizontal-stretch: 2;
                    GridLayout {
                        spacing: Theme.spacing;
                        vertical-stretch: 1;
                        Row {
                            Rectangle { }
                            IconButton { icon: Icons.motion-y-plus; text: "Y+"; enabled: Printer.homed-y; clicked => { Actions.jog("y", root.step); } }
                            Rectangle { }
                        }
                        Row {
                            IconButton { icon: Icons.motion-x-minus; text: "X-"; enabled: Printer.homed-x; clicked => { Actions.jog("x", -root.step); } }
                            IconButton { icon: Icons.motion-home-xy; text: @tr("Home XY"); enabled: !Printer.position-locked; done: Printer.homed-xy; clicked => { Actions.home(true, true, false); } }
                            IconButton { icon: Icons.motion-x-plus; text: "X+"; enabled: Printer.homed-x; clicked => { Actions.jog("x", root.step); } }
                        }
                        Row {
                            Rectangle { }
                            IconButton { icon: Icons.motion-y-minus; text: "Y-"; enabled: Printer.homed-y; clicked => { Actions.jog("y", -root.step); } }
                            Rectangle { }
                        }
                    }
                }

                Card {
                    title: "Z";
                    width: 120px;
                    VerticalLayout {
                        spacing: Theme.spacing;
                        vertical-stretch: 1;
                        IconButton { icon: Icons.motion-z-plus; text: "Z+"; vertical-stretch: 1; enabled: Printer.homed-z; clicked => { Actions.jog("z", root.step); } }
                        IconButton { icon: Icons.motion-home-z; text: @tr("Home Z"); vertical-stretch: 1; enabled: !Printer.position-locked; done: Printer.homed-z; clicked => { Actions.home(false, false, true); } }
                        IconButton { icon: Icons.motion-z-minus; text: "Z-"; vertical-stretch: 1; enabled: Printer.homed-z; clicked => { Actions.jog("z", -root.step); } }
                    }
                }
            }

            StepSelector {
                label: @tr("Step");
                values: [0.1, 1, 10, 50, 100];
                unit: " mm";
                selected <=> UiSettings.move-step;
                changed => { UiSettings.steps-changed(); }
            }
        }

        VerticalLayout {
            width: 150px;
            spacing: Theme.spacing;
            Card {
                title: @tr("Position");
                AxisValue { axis: "X"; value: Printer.position-x; homed: Printer.homed-x; }
                AxisValue { axis: "Y"; value: Printer.position-y; homed: Printer.homed-y; }
                AxisValue { axis: "Z"; value: Printer.position-z; homed: Printer.homed-z; }
            }
            // The buttons share the rest of the height like those of the Z card, with or without levelling.
            IconButton {
                icon: Icons.motion-home;
                text: @tr("Home all");
                horizontal: true;
                align-start: true;
                vertical-stretch: 1;
                enabled: !Printer.position-locked;
                done: Printer.homed-xy && Printer.homed-z;
                clicked => { Actions.home(true, true, true); }
            }
            if Printer.can-quad-gantry-level || Printer.can-z-tilt: IconButton {
                icon: Icons.calibration-gantry-level;
                text: Printer.can-quad-gantry-level ? @tr("QGL") : @tr("Z tilt");
                horizontal: true;
                align-start: true;
                vertical-stretch: 1;
                enabled: !Printer.position-locked;
                done: Printer.leveling-state == "applied";
                clicked => { Actions.level(); }
            }
            IconButton {
                icon: Icons.motion-steppers-off;
                text: @tr("Motors off");
                horizontal: true;
                align-start: true;
                vertical-stretch: 1;
                enabled: !Printer.position-locked;
                clicked => { Confirm.ask(@tr("Motors off"), @tr("The axes lose their reference and must be homed again."), "disable-motors", "", false); }
            }
        }
    }
}

export component MotionPage inherits Rectangle {
    property <bool> can-calibrate: Printer.has-bed-mesh || Printer.has-screws-tilt || Printer.has-bed-screws
        || Printer.z-calibration != "" || Printer.can-quad-gantry-level || Printer.can-z-tilt;
    // The tab the user chose, fallen back where the printer has nothing for it ...
    property <MotionTab> chosen: Navigation.motion-tab == MotionTab.expert && Printer.tuning.length == 0 ? MotionTab.tune
        : Navigation.motion-tab == MotionTab.calibrate && !root.can-calibrate ? MotionTab.axes : Navigation.motion-tab;
    // ... and the tab shown: while printing the axes stay still, so Tune. `Navigation.motion-tab` is not touched, the
    // choice is back after the print.
    property <MotionTab> tab: Printer.motion-locked && (root.chosen == MotionTab.axes || root.chosen == MotionTab.calibrate)
        ? MotionTab.tune : root.chosen;

    VerticalLayout {
        TabBar {
            TabButton {
                icon: Icons.nav-move;
                text: @tr("Axes");
                enabled: !Printer.motion-locked;
                checked: root.tab == MotionTab.axes;
                clicked => { Navigation.motion-tab = MotionTab.axes; }
            }
            TabButton {
                icon: Icons.nav-tuning;
                text: @tr("Tune");
                checked: root.tab == MotionTab.tune;
                clicked => { Navigation.motion-tab = MotionTab.tune; }
            }
            if Printer.tuning.length > 0: TabButton {
                icon: Icons.nav-tuning-advanced;
                text: @tr("Expert");
                checked: root.tab == MotionTab.expert;
                clicked => { Navigation.motion-tab = MotionTab.expert; }
            }
            if root.can-calibrate: TabButton {
                icon: Icons.nav-calibration;
                text: @tr("Calibrate");
                enabled: !Printer.motion-locked;
                checked: root.tab == MotionTab.calibrate;
                clicked => { Navigation.motion-tab = MotionTab.calibrate; }
            }
        }
        // While paused: moving and extruding stay possible, what would lose the print's position does not.
        if Printer.position-locked && (root.tab == MotionTab.axes || root.tab == MotionTab.calibrate): Note {
            text: @tr("Print paused: homing, leveling, calibrating and motors off stay off until the print ends.");
            horizontal-alignment: center;
            height: Theme.font-small * 2;
            vertical-alignment: center;
        }
        if root.tab == MotionTab.axes: AxesTab { vertical-stretch: 1; }
        if root.tab == MotionTab.tune: TuneBasicsTab { vertical-stretch: 1; }
        if root.tab == MotionTab.expert: TuneExpertTab { vertical-stretch: 1; }
        if root.tab == MotionTab.calibrate: CalibrateTab { vertical-stretch: 1; }
    }
}
