// Thermal: heaters with presets, fans, further temperature sensors; each in its own tab.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, FanItem, HeaterItem, HeatTab, Navigation, Printer, SensorItem, UiSettings } from "../state.slint";
import { NumberEntryDialog } from "../components/overlays.slint";
import { IconButton, IconLabel, ProgressBar, ScrollList, StepSelector, TabBar, TabButton, TouchSlider } from "../components/controls.slint";

component HeaterRow inherits Rectangle {
    in property <HeaterItem> heater;
    in property <float> step;
    callback edit-target();
    height: 60px;
    background: history-touch.pressed ? Theme.surface-raised : Theme.surface;
    border-radius: Theme.radius;

    // A tap beside the buttons shows the temperature history, where Moonraker keeps one; the buttons lie above.
    history-touch := TouchArea {
        enabled: root.heater.has-history;
        clicked => { Actions.open-history(root.heater.object); }
    }

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: root.heater.object == "heater_bed" ? Icons.thermal-bed : root.heater.object == "extruder" ? Icons.thermal-nozzle : Icons.thermal-chamber;
            colorize: root.heater.target > 0 ? Theme.accent : Theme.muted;
            width: 28px;
            height: 28px;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.heater.label;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
                if root.heater.has-history: Image {
                    cross-axis-self-alignment: center;
                    source: Icons.nav-history;
                    colorize: Theme.muted;
                    width: 14px;
                    height: 14px;
                }
                // The spool in use recommends another temperature than the target: a quiet note, nothing is changed.
                if root.heater.spool-hint != "": IconLabel {
                    icon: Icons.ui-warning;
                    icon-size: 14px;
                    text: root.heater.spool-hint;
                    color: Theme.warning;
                    font-size: Theme.font-small;
                }
            }
            Text {
                text: root.heater.temperature.to-fixed(1) + " °C";
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 600;
            }
        }
        // The target is a field: a tap opens the numeric keypad to type it.
        Rectangle {
            width: 96px;
            border-radius: Theme.radius;
            background: target-touch.pressed ? Theme.surface-active : Theme.surface-raised;
            accessible-role: button;
            accessible-label: @tr("Target");
            target-touch := TouchArea {
                clicked => { root.edit-target(); }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Target");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.heater.target > 0 ? round(root.heater.target) + " °C" : @tr("off");
                    color: root.heater.target > 0 ? Theme.accent : Theme.muted;
                    font-size: Theme.font-large;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        IconButton {
            width: 64px;
            icon: Icons.ui-minus;
            enabled: root.heater.target > 0;
            clicked => { Actions.step-heater(root.heater.object, -root.step); }
        }
        IconButton {
            width: 64px;
            icon: Icons.ui-plus;
            enabled: root.heater.can-raise;
            clicked => { Actions.step-heater(root.heater.object, root.step); }
        }
        IconButton {
            width: 64px;
            icon: Icons.thermal-off;
            enabled: root.heater.target > 0;
            clicked => { Actions.set-heater(root.heater.object, 0); }
        }
    }
}

// Off, slider and 100 % for a fan that can be set; a bar for one that Klipper drives.
component FanRow inherits Rectangle {
    in property <FanItem> fan;
    height: 60px;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            // A fan that does not turn although it should is an error: its icon and its speeds turn red.
            source: root.fan.stalled ? Icons.state-error : Icons.thermal-fan;
            colorize: root.fan.stalled ? Theme.danger : root.fan.speed > 0 ? Theme.accent : Theme.muted;
            width: 28px;
            height: 28px;
        }
        VerticalLayout {
            alignment: center;
            width: 170px;
            Text { text: root.fan.label; color: Theme.muted; font-size: Theme.font-small; overflow: elide; }
            Text {
                text: round(fan-slider.shown) + " %" + (root.fan.rpm == "" ? "" : "  ·  " + root.fan.rpm);
                color: root.fan.stalled ? Theme.danger : Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 600;
                overflow: elide;
            }
        }
        if root.fan.controllable: IconButton {
            width: 64px;
            text: @tr("Off");
            checked: root.fan.speed < 1;
            clicked => { Actions.set-fan(root.fan.object, 0); }
        }
        fan-slider := TouchSlider {
            cross-axis-self-alignment: center;
            horizontal-stretch: 1;
            visible: root.fan.controllable;
            value: root.fan.speed;
            changed(level) => { Actions.set-fan(root.fan.object, level); }
        }
        if root.fan.controllable: IconButton {
            width: 64px;
            text: "100%";
            checked: root.fan.speed > 99;
            clicked => { Actions.set-fan(root.fan.object, 100); }
        }
        // Klipper switches heater and controller fans itself: only how fast they run.
        if !root.fan.controllable: ProgressBar {
            cross-axis-self-alignment: center;
            horizontal-stretch: 1;
            progress: root.fan.speed / 100;
            bar-color: Theme.accent;
        }
        if !root.fan.controllable: Text {
            width: 64px;
            text: @tr("auto");
            color: Theme.muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component HeatersTab inherits Rectangle {
    callback edit-target(HeaterItem);
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                for heater in Printer.heaters: HeaterRow {
                    heater: heater;
                    step: UiSettings.temperature-step;
                    edit-target => { root.edit-target(heater); }
                }
                Rectangle { vertical-stretch: 1; }
                // Under the heaters, so the presets can take the full height beside them.
                StepSelector {
                    label: @tr("Step");
                    values: [1, 5, 10, 25];
                    unit: " °C";
                    selected <=> UiSettings.temperature-step;
                    changed => { UiSettings.steps-changed(); }
                }
            }

            VerticalLayout {
                width: 120px;
                // With the spool preset there are six buttons, which only fit above the step selector with narrow gaps.
                spacing: Printer.has-spool-preset ? 4px : Theme.spacing;
                // The spool in use, if Spoolman knows its temperatures: heats to them.
                if Printer.has-spool-preset: IconButton {
                    icon: Icons.filament-spool;
                    text: Printer.spool-preset-text;
                    clicked => { Actions.apply-spool-preset(); }
                }
                for preset[index] in UiSettings.presets: IconButton {
                    icon: Icons.thermal-preset;
                    text: preset.name + "  " + round(preset.extruder) + "/" + round(preset.bed);
                    clicked => { Actions.apply-preset(index); }
                }
                IconButton {
                    icon: Icons.thermal-cooling;
                    text: @tr("Cool down");
                    kind: "accent";
                    clicked => { Actions.cool-down(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

// Every fan; scrolls when there are many.
component FansTab inherits Rectangle {
    property <length> row-step: 64px;

    list := ScrollList {
        x: Theme.padding;
        y: Theme.padding;
        width: parent.width - 2 * Theme.padding;
        height: parent.height - 2 * Theme.padding;
        content-height: Printer.fans.length * root.row-step;
        for fan[index] in Printer.fans: FanRow {
            y: index * root.row-step;
            width: list.row-width;
            fan: fan;
        }
    }
}

// Every temperature without a target, three per row; a tap shows the history.
component SensorsTab inherits Rectangle {
    property <int> columns: 3;
    property <length> tile-height: 64px;

    list := ScrollList {
        x: Theme.padding;
        y: Theme.padding;
        width: parent.width - 2 * Theme.padding;
        height: parent.height - 2 * Theme.padding;
        content-height: ceil(Printer.sensors.length / root.columns) * (root.tile-height + Theme.spacing);
        for sensor[index] in Printer.sensors: Rectangle {
            property <length> tile-width: (list.row-width - (root.columns - 1) * Theme.spacing) / root.columns;
            x: mod(index, root.columns) * (self.tile-width + Theme.spacing);
            y: floor(index / root.columns) * (root.tile-height + Theme.spacing);
            width: self.tile-width;
            height: root.tile-height;
            background: sensor-touch.pressed ? Theme.surface-raised : Theme.surface;
            border-radius: Theme.radius;
            sensor-touch := TouchArea {
                enabled: sensor.has-history;
                clicked => { Actions.open-history(sensor.object); }
            }
            // Marks the sensors with a history in Moonraker; the others cannot open a chart.
            if sensor.has-history: Image {
                x: parent.width - self.width - 8px;
                y: 8px;
                source: Icons.nav-history;
                colorize: Theme.muted;
                width: 16px;
                height: 16px;
            }
            VerticalLayout {
                padding-left: 10px;
                alignment: center;
                Text { text: sensor.label; color: Theme.muted; font-size: Theme.font-small; overflow: elide; }
                Text {
                    text: sensor.known ? sensor.temperature.to-fixed(1) + " °C" : "–";
                    color: sensor.known ? Theme.foreground : Theme.muted;
                    font-size: Theme.font-large;
                    font-weight: 600;
                }
            }
        }
    }
}

// Shrinks on narrow windows instead of running off the edge.
export component TemperaturePage inherits Rectangle {
    property <bool> has-fans: Printer.fans.length > 0;
    property <bool> has-sensors: Printer.sensors.length > 0;
    // A tab that the printer does not have falls back to the heaters.
    property <HeatTab> tab: (Navigation.heat-tab == HeatTab.fans && root.has-fans) || (Navigation.heat-tab == HeatTab.sensors && root.has-sensors) ? Navigation.heat-tab : HeatTab.heaters;

    VerticalLayout {
        if root.has-fans || root.has-sensors: TabBar {
            TabButton {
                icon: Icons.thermal-heating;
                text: @tr("Heaters");
                checked: root.tab == HeatTab.heaters;
                clicked => { Navigation.heat-tab = HeatTab.heaters; }
            }
            if root.has-fans: TabButton {
                icon: Icons.thermal-fan;
                text: @tr("Fans");
                checked: root.tab == HeatTab.fans;
                clicked => { Navigation.heat-tab = HeatTab.fans; }
            }
            if root.has-sensors: TabButton {
                icon: Icons.nav-temperature;
                text: @tr("Sensors");
                checked: root.tab == HeatTab.sensors;
                clicked => { Navigation.heat-tab = HeatTab.sensors; }
            }
        }
        if root.tab == HeatTab.heaters: HeatersTab {
            vertical-stretch: 1;
            edit-target(heater) => {
                root.target-heater = heater.object;
                target-entry.title = @tr("Target {}", heater.label);
                target-entry.hint = heater.target-range;
                target-entry.text = heater.target > 0 ? round(heater.target) : "";
                target-entry.open = true;
            }
        }
        if root.tab == HeatTab.fans: FansTab { vertical-stretch: 1; }
        if root.tab == HeatTab.sensors: SensorsTab { vertical-stretch: 1; }
    }

    // The heater whose target is being typed. Klipper enforces its limits (min/max_temp) and reports a refusal.
    property <string> target-heater;
    target-entry := NumberEntryDialog {
        unit: "°C";
        hint-warning: Actions.heater-target-outside(root.target-heater, self.text);
        accepted(text) => {
            if (text.is-float()) {
                Actions.set-heater(root.target-heater, text.to-float());
            }
        }
    }
}
