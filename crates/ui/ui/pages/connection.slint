// Shown instead of the control pages while Moonraker or Klipper is not ready, or Moonraker wants a login.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Page, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, IconButton } from "../components/controls.slint";
import { TextEntryDialog } from "../components/entry-dialogs.slint";

export component ConnectionPage inherits Rectangle {
    property <bool> connected: Printer.is-connected;
    property <bool> login-required: Printer.connection == "login-required";
    // Kept between attempts, so a wrong password needs only the password again.
    property <string> username;
    background: Theme.background;

    TouchArea { }

    HorizontalLayout {
        padding: 2 * Theme.spacing-large;
        spacing: 2 * Theme.spacing-large;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.spacing-large;
            // Wrapped, so the fixed width of the symbol does not limit the width of the texts below it.
            HorizontalLayout {
                alignment: start;
                Image {
                    source: StateIcons.klippy-state(Printer.connection, Printer.klippy-state);
                    colorize: root.connected && Printer.klippy-state == "startup" ? StateIcons.severity-color(Severity.info) : StateIcons.severity-color(Severity.attention);
                    width: 72px;
                    height: 72px;
                }
            }
            Text {
                text: root.login-required ? @tr("Moonraker wants a login")
                    : !root.connected
                    ? (Printer.connection == "connecting" ? @tr("Connecting to Moonraker …") : @tr("Moonraker not reachable"))
                    : Printer.klippy-state == "startup" ? @tr("Klipper is starting …")
                    : Printer.klippy-state == "shutdown" ? @tr("Klipper is shut down")
                    : Printer.klippy-state == "error" ? @tr("Klipper reports an error")
                    : @tr("Klipper is not connected");
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.connected ? Printer.klippy-message : Printer.endpoint;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.login-required && Printer.login-error != "": Text {
                text: Printer.login-error;
                color: Theme.warning;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            width: 240px;
            alignment: center;
            spacing: Theme.spacing;
            if root.login-required: IconButton {
                icon: Icons.ui-unlock;
                text: @tr("Log in");
                horizontal: true;
                align-start: true;
                kind: ButtonKind.accent;
                clicked => {
                    user-entry.text = root.username;
                    user-entry.open = true;
                }
            }
            if root.connected: IconButton {
                icon: Icons.system-restart;
                text: @tr("Restart Klipper");
                horizontal: true;
                align-start: true;
                clicked => { Confirm.ask(@tr("Restart Klipper"), @tr("Reloads the configuration."), "restart-klipper", "", false); }
            }
            if root.connected: IconButton {
                icon: Icons.system-firmware-restart;
                text: @tr("Firmware restart");
                horizontal: true;
                align-start: true;
                kind: ButtonKind.accent;
                clicked => { Confirm.ask(@tr("Firmware restart"), @tr("Restarts Klipper and all MCUs."), "firmware-restart", "", false); }
            }
            IconButton {
                icon: Icons.nav-settings;
                text: @tr("Settings");
                horizontal: true;
                align-start: true;
                clicked => { Navigation.page = Page.settings; }
            }
        }
    }

    // The keyboard needs the whole screen, so user and password are two entries one after the other.
    user-entry := TextEntryDialog {
        title: @tr("User");
        accepted(text) => {
            root.username = text;
            password-entry.text = "";
            password-entry.open = true;
        }
    }

    password-entry := TextEntryDialog {
        title: @tr("Password");
        secret: true;
        accepted(text) => { Actions.log-in(root.username, text); }
    }
}
