// Shown instead of the control pages while Moonraker or Klipper is not ready, or Moonraker wants a login.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Page, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { ButtonKind, IconButton } from "../components/controls.slint";
import { TextEntryDialog } from "../components/entry-dialogs.slint";

export component ConnectionPage inherits Rectangle {
    property <bool> connected: Printer.is-connected;
    property <bool> login-required: Printer.connection == "login-required";
    property <bool> untrusted: Printer.connection == "untrusted-certificate";
    // A different certificate than the one trusted before for this address.
    property <bool> changed: Printer.certificate-before != "";
    // Kept between attempts, so a wrong password needs only the password again.
    property <string> username;
    background: Theme.background;

    TouchArea { }

    HorizontalLayout {
        padding: 2 * Theme.spacing-large;
        spacing: 2 * Theme.spacing-large;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.spacing-large;
            // Wrapped, so the fixed width of the symbol does not limit the width of the texts below it.
            HorizontalLayout {
                alignment: start;
                Image {
                    source: StateIcons.klippy-state(Printer.connection, Printer.klippy-state);
                    colorize: StateIcons.severity-color(root.connected && Printer.klippy-state == "startup" ? Severity.info : root.connected && (Printer.klippy-state == "shutdown" || Printer.klippy-state == "error") ? Severity.error : Severity.attention);
                    width: 72px;
                    height: 72px;
                }
            }
            Text {
                text: root.login-required ? @tr("Moonraker wants a login")
                    : root.untrusted ? (root.changed ? @tr("Certificate has changed") : @tr("Certificate not trusted"))
                    : !root.connected
                    ? (Printer.connection == "connecting" ? @tr("Connecting to Moonraker …") : @tr("Moonraker not reachable"))
                    : Printer.klippy-state == "startup" ? @tr("Klipper is starting …")
                    : Printer.klippy-state == "shutdown" ? @tr("Klipper is shut down")
                    : Printer.klippy-state == "error" ? @tr("Klipper reports an error")
                    : @tr("Klipper is not connected");
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.connected ? Printer.klippy-message : Printer.endpoint;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.untrusted: Text {
                text: root.changed
                    ? @tr("The printer presents a different certificate than the one trusted before. Replace it only if the printer got a new certificate.")
                    : @tr("Compare the SHA-256 fingerprint with the printer's certificate before you trust it.");
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.untrusted: VerticalLayout {
                Text {
                    text: "SHA-256";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
                Text {
                    text: Printer.certificate-fingerprint-lines;
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                }
            }
            if root.untrusted && root.changed: Text {
                text: @tr("Trusted before: {}", Printer.certificate-before);
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if root.login-required && Printer.login-error != "": Text {
                text: Printer.login-error;
                color: StateIcons.severity-color(Severity.attention);
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            width: 240px;
            alignment: center;
            spacing: Theme.spacing;
            if root.login-required: IconButton {
                icon: Icons.ui-unlock;
                text: @tr("Log in");
                horizontal: true;
                align-start: true;
                kind: ButtonKind.accent;
                clicked => {
                    user-entry.text = root.username;
                    user-entry.open = true;
                }
            }
            if root.untrusted && !root.changed: IconButton {
                icon: Icons.ui-lock;
                text: @tr("Trust certificate");
                horizontal: true;
                align-start: true;
                kind: ButtonKind.accent;
                clicked => { Actions.trust-certificate(Printer.certificate-fingerprint); }
            }
            if root.untrusted && root.changed: IconButton {
                icon: Icons.ui-lock;
                text: @tr("Replace certificate");
                horizontal: true;
                align-start: true;
                clicked => {
                    Confirm.ask(@tr("Replace certificate"), @tr("Trust the new certificate instead of the one trusted before?"), "trust-certificate", Printer.certificate-fingerprint, true);
                }
            }
            if root.connected: IconButton {
                icon: Icons.system-klipper-restart;
                text: @tr("Restart Klipper");
                horizontal: true;
                align-start: true;
                clicked => { Confirm.ask(@tr("Restart Klipper"), @tr("Restarts Klipper and reloads the configuration; the MCUs keep running."), "restart-klipper", "", false); }
            }
            if root.connected: IconButton {
                icon: Icons.system-firmware-restart;
                text: @tr("Firmware restart");
                horizontal: true;
                align-start: true;
                kind: ButtonKind.accent;
                clicked => { Confirm.ask(@tr("Firmware restart"), @tr("Restarts Klipper and resets all MCUs, e.g. after a firmware update or an MCU error."), "firmware-restart", "", false); }
            }
            IconButton {
                icon: Icons.nav-printer;
                text: @tr("Printers");
                horizontal: true;
                align-start: true;
                clicked => { Navigation.page = Page.printers; }
            }
            IconButton {
                icon: Icons.nav-settings;
                text: @tr("Settings");
                horizontal: true;
                align-start: true;
                clicked => { Navigation.page = Page.settings; }
            }
        }
    }

    // The keyboard needs the whole screen, so user and password are two entries one after the other.
    user-entry := TextEntryDialog {
        title: @tr("User");
        accepted(text) => {
            root.username = text;
            password-entry.text = "";
            password-entry.open = true;
        }
    }

    password-entry := TextEntryDialog {
        title: @tr("Password");
        secret: true;
        accepted(text) => { Actions.log-in(root.username, text); }
    }
}
