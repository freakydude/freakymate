// The file list over the print page: a row per file with its facts, a tap prepares the file as the print job.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Printer } from "../state.slint";
import { ButtonKind, IconButton, IconLabel, ScrollList } from "../components/controls.slint";
import { Thumbnail } from "../components/thumbnail.slint";

// A fact of a file keeps its whole width; only the material gives way (see FileRow).
component FileChip inherits IconLabel {
    color: Theme.muted;
    font-size: Theme.font-small;
    icon-size: 16px;
    min-width: self.preferred-width;
}

component FileRow inherits Rectangle {
    in property <string> name;
    in property <string> modified;
    in property <string> material;
    in property <string> weight;
    in property <string> nozzle;
    in property <string> time;
    in property <string> extruder-temperature;
    in property <string> bed-temperature;
    in property <string> chamber-temperature;
    in property <image> thumbnail;
    in property <bool> has-thumbnail;
    in property <bool> show-thumbnail;
    // Marked for preparing (a single one) or deleting.
    in property <bool> selected;
    // The job of the print page.
    in property <bool> prepared;
    callback clicked;
    height: 72px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.surface-active : row-touch.pressed ? Theme.surface-raised : Theme.surface;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;

    row-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: Theme.spacing-small;
        padding-left: root.show-thumbnail ? 4px : 14px;
        spacing: Theme.spacing;
        if root.show-thumbnail: Thumbnail {
            width: 64px;
            source: root.thumbnail;
            available: root.has-thumbnail;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-small;
            HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    text: root.name;
                    color: Theme.foreground;
                    font-size: Theme.font-normal;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.prepared: FileChip {
                    icon: Icons.print-load;
                    text: @tr("Prepared");
                    color: Theme.foreground;
                }
                Text {
                    text: root.modified;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                // Files for several tools list a material per tool; the list is cut so the weight and the other facts
                // stay readable.
                if root.material != "" || root.weight != "": HorizontalLayout {
                    spacing: Theme.spacing-medium;
                    FileChip {
                        icon: Icons.filament-spool;
                        text: root.material;
                        min-width: min(self.preferred-width, 72px);
                    }
                    if root.weight != "": Text {
                        text: root.weight;
                        color: Theme.muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        min-width: self.preferred-width;
                    }
                }
                if root.nozzle != "": FileChip { icon: Icons.print-nozzle-diameter; text: root.nozzle; }
                if root.time != "": FileChip { icon: Icons.print-duration; text: root.time; }
                if root.extruder-temperature != "": FileChip {
                    icon: Icons.thermal-nozzle;
                    text: root.extruder-temperature;
                }
                if root.bed-temperature != "": FileChip {
                    icon: Icons.thermal-bed;
                    text: root.bed-temperature;
                }
                if root.chamber-temperature != "": FileChip {
                    icon: Icons.thermal-chamber;
                    text: root.chamber-temperature;
                }
                Rectangle { }
            }
        }
    }
}

// File list over the print page; scroll by swiping or with the bar at the right edge.
export component FileBrowser inherits Rectangle {
    property <length> row-step: 76px;
    property <bool> print-running: Printer.is-printing;
    background: Theme.background;
    visible: Navigation.files-open;

    TouchArea { }

    // A print started elsewhere (another client, a macro) leaves nothing to choose here.
    changed print-running => {
        if (self.print-running) {
            Actions.clear-file-marks();
            Navigation.files-open = false;
        }
    }

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        list := ScrollList {
            horizontal-stretch: 1;
            content-height: Printer.files.length * root.row-step;
            for file[index] in Printer.files: FileRow {
                y: index * root.row-step;
                width: list.row-width;
                name: file.name;
                modified: file.modified;
                material: file.material;
                weight: file.weight;
                nozzle: file.nozzle;
                time: file.time;
                extruder-temperature: file.extruder-temperature;
                bed-temperature: file.bed-temperature;
                chamber-temperature: file.chamber-temperature;
                thumbnail: file.thumbnail;
                has-thumbnail: file.has-thumbnail;
                show-thumbnail: file.show-thumbnail;
                selected: file.marked;
                prepared: file.path == Printer.prepared-path;
                clicked => { Actions.toggle-file-mark(file.path); }
            }
        }

        VerticalLayout {
            width: 96px;
            spacing: Theme.spacing;
            IconButton {
                icon: Icons.ui-close;
                text: @tr("Close");
                clicked => {
                    Actions.clear-file-marks();
                    Navigation.files-open = false;
                }
            }
            // One marked file can be prepared or deleted, several only deleted.
            IconButton {
                icon: Icons.ui-delete;
                text: Printer.marked-file-count > 1 ? @tr("Delete {}", Printer.marked-file-count) : @tr("Delete");
                enabled: Printer.marked-file-count > 0;
                clicked => {
                    Confirm.ask-for-items(@tr("Delete files"), "", Printer.marked-file-names, "delete-files", "", true);
                }
            }
            // Preparing changes nothing at the printer, so it asks nothing; the print page then shows the file.
            IconButton {
                icon: Icons.print-prepare;
                text: @tr("Prepare");
                kind: ButtonKind.accent;
                vertical-stretch: 1;
                enabled: Printer.marked-file-path != "";
                clicked => {
                    Actions.prepare-file(Printer.marked-file-path);
                    Actions.clear-file-marks();
                    Navigation.files-open = false;
                }
            }
        }
    }
}
