// Preview: print stopped by a Klipper error, with Klipper's message in the banner. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintErrorPreview inherits AppWindow {
    init => {
        Sample.printing();
        Printer.print-state = "error";
        Printer.remaining = "-";
        Printer.eta = "-";
        Printer.ended = "14:05";
        Printer.layer-pause-next = false;
        Printer.layer-pause-at = false;
        Printer.interruption-text = "Move out of range: 310.000 150.000 12.400 [482.120]";
        Printer.interruption-headline = "Move out of range: 310.000 150.000 12.400 [482.120]";
        Navigation.page = Page.print;
    }
}
