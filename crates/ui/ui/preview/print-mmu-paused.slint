// Preview: print paused by the MMU with the reason and the buttons to recover. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintMmuPausedPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Sample.printing();
        Navigation.page = Page.print;
        Printer.print-state = "paused";
        Printer.mmu-gate = 1;
        Printer.mmu-tool = 1;
        Printer.mmu-paused = true;
        Printer.mmu-locked = true;
        Printer.interruption-text = "Filament runout detected at the entry sensor of gate 1";
        Printer.interruption-headline = "Filament runout detected at the entry sensor of gate 1";
        Printer.mmu-buffer-state = "tension";
        Printer.mmu-buffer-bias = -1;
        Printer.mmu-flowguard-state = "triggered";
        Printer.mmu-flowguard-detail = "clog";
    }
}
