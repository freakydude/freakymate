// Preview: Gates tab with Spoolman: spools of one, two and three colours, one nearly empty, one gate without a spool and without a colour (the accent colour as a generic filament).
// Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuSpoolColorsPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.gates;
        Printer.has-spoolman = true;
        Printer.mmu-gates = [
            { index: 0, availability: "available", name: "Red", material: "ABS+", colors: { first: #e31f2b, count: 1 }, has-color: true, tools: "T0", selected: true, spool-text: "613 g", spool-low: false, spool-id: 18 },
            { index: 1, availability: "available", name: "Red+Green", material: "PLA", colors: { first: #e31f2b, second: #2e7d32, count: 2 }, has-color: true, tools: "T1", selected: false, spool-text: "38 g", spool-low: true, spool-id: 21 },
            { index: 2, availability: "buffered", name: "Silk Red+Gold+Black", material: "PLA", colors: { first: #ff0004, second: #ffa424, third: #000000, count: 3 }, has-color: true, tools: "T2", selected: false, spool-text: "802 g", spool-low: false, spool-id: 19 },
            { index: 3, availability: "available", name: "", material: "PETG", colors: { first: #000000, count: 0 }, has-color: false, tools: "T3", selected: false, spool-text: "", spool-low: false, spool-id: -1 },
        ];
    }
}
