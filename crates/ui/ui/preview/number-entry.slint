// Preview: the numeric keypad, as it opens for the target of the nozzle on the temperature page. Open in the Slint
// preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { NumberEntryDialog } from "../components/entry-dialogs.slint";
import { Navigation, Page } from "../state.slint";
import { Sample } from "sample.slint";

export component NumberEntryPreview inherits AppWindow {
    NumberEntryDialog {
        open: true;
        title: "Target Nozzle";
        unit: "°C";
        hint: "Klipper: 10–280 °C";
        text: "215";
    }

    init => {
        Sample.ready-printer();
        Navigation.page = Page.temperature;
    }
}
