// Preview: Extruder tab of the Filament page while printing: viewable, extrude, load and unload are disabled, with a
// note. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentExtruderPrintingPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Printer.print-state = "printing";
        Printer.job-state = "printing";
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.extruder;
    }
}
