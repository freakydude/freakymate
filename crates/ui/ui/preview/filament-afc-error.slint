// Preview: Filament page with AFC in its error state: the hint and "Clear error" in the tab row. Open in the Slint
// preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentAfcErrorPreview inherits AppWindow {
    init => {
        Sample.afc();
        Navigation.page = Page.filament;
        Printer.afc-error = true;
        Printer.afc-state = "Error";
    }
}
