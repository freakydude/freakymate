// Preview: print page with a prepared file on a printer with MMU, after an earlier print. T0 fits, T1 sits on the empty
// gate 3, T3 takes PETG where the file wants orange PLA, T4 has no gate. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintPreparedMmuPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.print;
        Printer.print-state = "complete";
        Printer.filename = "benchy.gcode";
        Printer.job-name = "benchy";
        Printer.prepared-path = "cube-mc5-all_pla-t0_t1_t3_t4.gcode";
        Printer.prepared = {
            path: "cube-mc5-all_pla-t0_t1_t3_t4.gcode",
            name: "cube-mc5-all_pla-t0_t1_t3_t4",
            material: "PLA, PETG",
            weight: "32.6 g",
            nozzle: "0.4",
            time: "1h 48m",
            extruder-temperature: "220°",
            bed-temperature: "60°",
            show-thumbnail: true,
        };
        Printer.mmu-match-file = "cube-mc5-all_pla-t0_t1_t3_t4.gcode";
        Printer.mmu-match-summary = @tr("1 of 4 tools fit");
        Printer.mmu-match-verdict = "differs";
        Printer.prepared-tools = [
            { tool: 0, gate: 0, used: true, wanted-color: #e03131, wanted-has-color: true, wanted-material: "PLA", verdict: "fits" },
            { tool: 1, gate: 3, used: true, wanted-color: #f4e2c1, wanted-has-color: true, wanted-material: "PLA", verdict: "gate-empty" },
            { tool: 3, gate: 1, used: true, wanted-color: #e8590c80, wanted-has-color: true, wanted-material: "PLA", verdict: "differs" },
            { tool: 4, gate: -1, used: true, wanted-color: #ffffff00, wanted-has-color: true, wanted-material: "PETG", verdict: "no-gate" },
        ];
    }
}
