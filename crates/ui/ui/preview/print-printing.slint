// Preview: print page while a job is running. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintPrintingPreview inherits AppWindow {
    init => {
        Sample.printing();
        Navigation.page = Page.print;
    }
}
