// Preview: dialog of a gate without Spoolman, with material and colour from Happy Hare's gate map, the tools of the
// gate (T1 and T3, T2 from elsewhere) and its EndlessSpool group. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, MmuDialogs, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuGateDialogPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.gates;
        Printer.has-spoolman = false;
        Printer.mmu-endless-spool = true;
        Printer.mmu-gates = [
            { title: "Gate 0", index: 0, availability: "available", name: "Red PLA", material: "PLA", colors: { first: #ff0000, count: 1 }, has-color: true, tools: "T0 T2", group: 0, selected: true },
            { title: "Gate 1", index: 1, availability: "available", name: "", material: "PETG", colors: { first: #ff8000, count: 1 }, has-color: true, tools: "T1 T3", group: 1, selected: false },
            { title: "Gate 2", index: 2, availability: "empty", name: "", material: "", colors: { first: #000000 }, has-color: false, tools: "", group: 0, selected: false },
            { title: "Gate 3", index: 3, availability: "available", name: "", material: "PLA", colors: { first: #ff0000, count: 1 }, has-color: true, tools: "", group: 0, selected: false },
        ];
        Printer.mmu-tools = [{ tool: 0, gate: 0 }, { tool: 1, gate: 1 }, { tool: 2, gate: 0 }, { tool: 3, gate: 1 }];
        MmuDialogs.gate-row = 1;
    }
}
