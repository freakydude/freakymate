// Preview: the expert tab of the Tune page with one changed value. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, TuneTab } from "../state.slint";
import { Sample } from "sample.slint";

export component TuneExpertPreview inherits AppWindow {
    init => {
        Sample.printing();
        Navigation.page = Page.tune;
        Navigation.tune-tab = TuneTab.expert;
    }
}
