// Preview: the picker of Spoolman for gate 1 of an MMU: spools in a gate first, one nearly empty, then the others.
// Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer, SpoolPicker } from "../state.slint";
import { Sample } from "sample.slint";

export component SpoolPickerPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.print;
        Printer.has-spoolman = true;
        Printer.spools = [
            { id: 18, title: "Geeetech Red", material: "ABS+", remaining: "613 g", colors: { first: #e31f2b, count: 1 }, place: "Gate 0", low: false },
            { id: 21, title: "Sunlu HS Matte PETG", material: "PETG", remaining: "38 g", colors: { first: #2e7d32, count: 1 }, place: "Gate 1", low: true },
            { id: 19, title: "Silk Red+Gold+Black", material: "PLA", remaining: "802 g", colors: { first: #ff0004, second: #ffa424, third: #000000, count: 3 }, place: "", low: false },
            { id: 20, title: "Red+Green", material: "PLA", remaining: "540 g", colors: { first: #e31f2b, second: #2e7d32, count: 2 }, place: "", low: false },
            { id: 7, title: "Sunlu ASA", material: "ASA", remaining: "266 g", colors: { first: #1a1a1a, count: 1 }, place: "", low: false },
            { id: 3, title: "Unknown", material: "PLA", colors: { first: #000000, count: 0 }, place: "", low: false },
        ];
        SpoolPicker.show(1, 21);
    }
}
