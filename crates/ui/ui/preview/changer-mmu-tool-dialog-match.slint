// Preview: the choice of gate for T3 compared with the job's file: what the file wants, what differs, and gate 0
// marked as fitting. Open in the Slint preview or render with scripts/ui-preview.sh.

import { MmuDialogs, Printer } from "../state.slint";
import { ChangerMmuToolsMatchPreview } from "changer-mmu-tools-match.slint";

export component ChangerMmuToolDialogMatchPreview inherits ChangerMmuToolsMatchPreview {
    init => {
        Printer.has-spoolman = true;
        MmuDialogs.tool = 3;
    }
}
