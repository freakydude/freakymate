// Preview: Tools tab with two tools remapped and EndlessSpool on. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuToolsPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.tools;
        Printer.mmu-endless-spool = true;
        Printer.mmu-tools = [{ tool: 0, gate: 0 }, { tool: 1, gate: 3 }, { tool: 2, gate: 2 }, { tool: 3, gate: 1 }];
    }
}
