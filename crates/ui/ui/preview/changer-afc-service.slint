// Preview: Service tab with AFC in its error state; lane1 is held back because it is loaded in the toolhead. Open in the
// Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { ChangerTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component ChangerAfcServicePreview inherits AppWindow {
    init => {
        Sample.afc();
        Navigation.page = Page.changer;
        Navigation.changer-tab = ChangerTab.service;
        Printer.afc-error = true;
        Printer.afc-state = "Error";
    }
}
