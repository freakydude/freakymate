// Preview: Tools tab with two tools remapped and EndlessSpool on. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { ChangerTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component ChangerMmuToolsPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.changer;
        Navigation.changer-tab = ChangerTab.tools;
        Printer.mmu-endless-spool = true;
        Printer.mmu-tools = [
            { tool: 0, gate: 0, loaded-material: "PLA", loaded-colors: { first: #e03131, count: 1 }, loaded-name: "Red PLA" },
            { tool: 1, gate: 3, gate-empty: true },
            { tool: 2, gate: 2, loaded-material: "ABS", loaded-colors: { first: #4dabf7, count: 1 } },
            { tool: 3, gate: 1, loaded-material: "PETG", loaded-colors: { first: #37b24d, count: 1 }, loaded-name: "Green PETG" },
        ];
    }
}
