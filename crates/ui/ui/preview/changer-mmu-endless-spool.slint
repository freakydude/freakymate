// Preview: the EndlessSpool dialog of the Tools tab, switched on, with the groups of the gates. Open in the Slint
// preview or render with scripts/ui-preview.sh.

import { MmuDialogs } from "../state.slint";
import { ChangerMmuToolsPreview } from "changer-mmu-tools.slint";

export component ChangerMmuEndlessSpoolPreview inherits ChangerMmuToolsPreview {
    init => {
        MmuDialogs.endless-spool-open = true;
    }
}
