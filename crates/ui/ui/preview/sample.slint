    // Network tab with two Wi-Fi and two Ethernet adapters; Garage is joined by the second Wi-Fi adapter.
    public function managed-network-many() {
        self.managed-network();
        Network.adapters = [
            { interface: "wlan0", wireless: true, status: AdapterStatus.connected, ssid: "Workshop", address: "192.168.1.57", prefix: 24, gateway: "192.168.1.1", speed: 0, mac: "dc:a6:32:01:02:03" },
            { interface: "wlx00c0ca3f12ab", wireless: true, status: AdapterStatus.connected, ssid: "Garage", address: "192.168.1.61", prefix: 24, gateway: "192.168.1.1", speed: 0, mac: "00:c0:ca:3f:12:ab" },
            { interface: "end0", wireless: false, status: AdapterStatus.connected, ssid: "", address: "192.168.1.42", prefix: 24, gateway: "192.168.1.1", speed: 1000, mac: "02:81:3c:5e:21:7a" },
            { interface: "enx00e04c680a1b", wireless: false, status: AdapterStatus.unavailable, ssid: "", address: "", prefix: 0, gateway: "", speed: 0, mac: "00:e0:4c:68:0a:1b" },
        ];
        Network.selected = Network.adapters[0];
        Network.networks[2].active-on-other = "wlx00c0ca3f12ab";
    }
}
