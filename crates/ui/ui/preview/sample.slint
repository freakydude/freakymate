// Sample data for previews (VS Code Slint preview, slint-viewer, scripts/ui-preview.sh).
// Not part of the app: nothing in app.slint imports this folder. In the app, Rust fills these globals.

import { AdapterStatus, FilamentPathItem, MotionTab, Navigation, Network, Page, PathPartKind, Printer, PrinterChoice, Severity, UiSettings } from "../state.slint";

export global Sample {
    // The way at a head without sensors of its own, as the core builds it (`LoadPath::parts`, `PathScope::HeadOnly`) and
    // the fake's `toolchanger` profile shows it: tube, gears, tube, nozzle.
    out property <FilamentPathItem> head-path: {
        direction: 0, distance: "", gate-label: "",
        parts: [
            { kind: PathPartKind.link, fill: 0 },
            { kind: PathPartKind.gears, active: false },
            { kind: PathPartKind.link, fill: 0 },
            { kind: PathPartKind.nozzle, active: false },
        ],
        colors: { first: #4dabf7, count: 1, longitudinal: false },
    };

    // Connected Voron-like printer, homed, nozzle and bed at temperature, no job.
    public function ready-printer() {
        Printer.connection = "connected";
        Printer.klippy-state = "ready";
        Printer.ready = true;
        Printer.endpoint = "http://voron.local:7125";
        UiSettings.moonraker = "http://voron.local:7125";
        PrinterChoice.active-name = "voron";
        Printer.activity = "ready";
        Printer.homed-x = true;
        Printer.homed-y = true;
        Printer.homed-z = true;
        Printer.position-x = 150;
        Printer.position-y = 150;
        Printer.position-z = 10;
        Printer.nozzle-temperature = 214.6;
        Printer.nozzle-target = 215;
        Printer.has-bed = true;
        Printer.bed-temperature = 59.8;
        Printer.bed-target = 60;
        Printer.fans = [
            { object: "fan", label: "Fan", kind: "part", controllable: true, speed: 40, rpm: "" },
            { object: "fan_generic nevermore", label: "Nevermore", kind: "generic", controllable: true, speed: 0, rpm: "" },
            { object: "fan_generic exhaust", label: "Exhaust", kind: "generic", controllable: true, speed: 60, rpm: "1680 rpm" },
            { object: "heater_fan hotend", label: "Hotend", kind: "heater", controllable: false, speed: 100, rpm: "7200 rpm" },
        ];
        Printer.leds = [
            { object: "neopixel chamber", label: "Chamber", on: true, level-known: true, level: 80 },
            { object: "wled enclosure", label: "Enclosure", on: true, level-known: false, level: 0 },
        ];
        Printer.led-effects = [{ name: "rainbow", label: "Rainbow", enabled: false }];
        Printer.has-light = true;
        Printer.light-name = "Chamber";
        Printer.light-on = true;
        Printer.flow-factor = { id: "flow_factor", value: "100 %", configured: "100 %", changed: false, can-reset: false };
        Printer.tuning = [
            { id: "max_velocity", value: "300 mm/s", configured: "300 mm/s", changed: false, can-reset: false },
            { id: "max_accel", value: "3500 mm/s²", configured: "3000 mm/s²", changed: true, can-reset: true },
            { id: "pressure_advance", value: "0.040", configured: "0.040", changed: false, can-reset: false },
        ];
        Printer.can-extrude = true;
        Printer.can-quad-gantry-level = true;
        Printer.has-probe = true;
        Printer.has-load-macro = true;
        Printer.has-unload-macro = true;
        Printer.has-power = true;
        Printer.has-update-manager = true;
        Printer.heaters = [
            {
                object: "extruder",
                label: "Extruder",
                temperature: 214.6,
                target: 215,
                power: 0.42,
                can-raise: true
            },
            {
                object: "heater_bed",
                label: "Heater Bed",
                temperature: 59.8,
                target: 60,
                power: 0.3,
                can-raise: true
            },
            {
                object: "heater_generic chamber",
                label: "Chamber",
                temperature: 38.2,
                target: 0,
                power: 0,
                can-raise: true
            },
        ];
        Printer.sensors = [
            { object: "temperature_sensor raspberry_pi", label: "Raspberry Pi", temperature: 45, known: true },
            { object: "tmc2240 stepper_x", label: "Stepper X", temperature: 0, known: false },
        ];
        Printer.filament-sensors = [
            { label: "Toolhead Runout", enabled: true, detected: true },
            { label: "Extruder Encoder", enabled: true, detected: false },
        ];
        Printer.macros = ["PRINT_START", "PRINT_END", "LOAD_FILAMENT", "UNLOAD_FILAMENT", "PARK"];
        Printer.power-devices = [{ name: "printer", on: true, locked: true }, { name: "lights", on: false, locked: false }];
        Printer.updates = [
            { name: "klipper", label: "Klipper", version: "v0.13.0-100", detail: "20 commits behind", has-update: true },
            { name: "moonraker", label: "Moonraker", version: "v0.9.3-50", detail: "v0.9.3-50", has-update: false, up-to-date: true },
            { name: "mainsail", label: "Mainsail", version: "v2.14.0", detail: "v2.14.0", has-update: false, up-to-date: true },
        ];
        UiSettings.presets = [{ name: "PLA", extruder: 215, bed: 60 }, { name: "PETG", extruder: 240, bed: 80 }];
    }

    // A bed slinger like a Sidewinder X2 on the Calibrate tab: probe, both screw tools, three mesh profiles (one more
    // than fit, so the list scrolls), screws measured and a probe offset waiting for SAVE_CONFIG.
    public function calibration() {
        self.ready-printer();
        Navigation.page = Page.motion;
        Navigation.motion-tab = MotionTab.calibrate;
        Printer.can-quad-gantry-level = false;
        Printer.has-probe = true;
        Printer.z-calibration = "probe";
        Printer.has-bed-mesh = true;
        Printer.has-screws-tilt = true;
        Printer.has-bed-screws = true;
        Printer.bed-mesh-active = "default";
        Printer.bed-mesh-profiles = ["default", "hot-bed-100", "pei-textured"];
        Printer.screw-results = [
            { name: "back left", turns: "00:00", clockwise: true, is-base: true },
            { name: "front left", turns: "00:18", clockwise: true },
            { name: "front right", turns: "01:05", clockwise: false },
            { name: "back right", turns: "00:02", clockwise: true },
        ];
        Printer.save-config-pending = true;
        Printer.pending-config = "probe: z_offset = 1.800 · bed_mesh default: 8 values";
    }

    // AFC with four lanes (one empty), tools mapped to them and a hub that two of the lanes can be pulled back out of.
    public function afc() {
        self.ready-printer();
        Printer.has-afc = true;
        Printer.has-lanes = true;
        Printer.afc-state = "Idle";
        Printer.mmu-gates = [
            { title: "lane1", index: -1, availability: "available", name: "Red PLA", material: "PLA", colors: { first: #e03131, count: 1 }, has-color: true, tools: "T0", group: -1, selected: true, temperature: 210, spool-id: -1, entry-sensor: "detected", exit-sensor: "detected" },
            { title: "lane2", index: -1, availability: "available", name: "Green PETG", material: "PETG", colors: { first: #37b24d, count: 1 }, has-color: true, tools: "T1", group: -1, selected: false, temperature: 240, spool-id: -1 },
            { title: "lane3", index: -1, availability: "available", name: "", material: "ABS", colors: { first: #4dabf7, count: 1 }, has-color: true, tools: "T2", group: -1, selected: false, temperature: 255, spool-id: -1 },
            { title: "lane4", index: -1, availability: "empty", name: "", material: "", colors: { first: #000000 }, has-color: false, tools: "T3", group: -1, selected: false, spool-id: -1 },
        ];
        Printer.afc-tools = [
            { tool: 0, lane: "lane1", lane-row: 0 },
            { tool: 1, lane: "lane2", lane-row: 1 },
            { tool: 2, lane: "lane3", lane-row: 2 },
            { tool: 3, lane: "lane4", lane-row: 3 },
        ];
        Printer.afc-hub-returns = [
            { lane: "lane1", unit: "Turtle_1", enabled: false, reason: "Unload lane1 first" },
            { lane: "lane2", unit: "Turtle_1", enabled: true, reason: "" },
            { lane: "lane3", unit: "Turtle_1", enabled: true, reason: "" },
        ];
    }

    // Ready printer with a job at 37 %.
    // Happy Hare with four gates, one of them empty, and a sync-feedback buffer in tension.
    public function mmu() {
        self.ready-printer();
        Printer.has-mmu = true;
        Printer.has-lanes = true;
        Printer.mmu-gate-map-local = true;
        Printer.mmu-homed = true;
        Printer.mmu-filament = "unloaded";
        Printer.mmu-action = "Idle";
        Printer.mmu-gate = 0;
        Printer.mmu-tool = 0;
        Printer.mmu-gates = [
            { title: "Gate 0", index: 0, availability: "available", name: "Red PLA", material: "PLA", colors: { first: #e03131, count: 1 }, has-color: true, tools: "T0", group: 0, selected: true, temperature: 210, entry-sensor: "detected", exit-sensor: "empty" },
            { title: "Gate 1", index: 1, availability: "available", name: "Green PETG", material: "PETG", colors: { first: #37b24d, count: 1 }, has-color: true, tools: "T1", group: 1, selected: false, temperature: 240, entry-sensor: "empty", sensor-conflict: true },
            { title: "Gate 2", index: 2, availability: "buffered", name: "", material: "ABS", colors: { first: #4dabf7, count: 1 }, has-color: true, tools: "T2", group: 2, selected: false, temperature: 255 },
            { title: "Gate 3", index: 3, availability: "empty", name: "", material: "", colors: { first: #000000 }, has-color: false, tools: "T3", group: 3, selected: false, entry-sensor: "detected", sensor-conflict: true },
        ];
        Printer.mmu-pages = [{ first-row: 0, count: 4, bypass: true, unit: "", head: "", first-gate: 0, last-gate: 3 }];
        Printer.mmu-page-ranges = [{ first: 0, count: 1, start: 0 }];
        Printer.mmu-tools = [
            { tool: 0, gate: 0, loaded-material: "PLA", loaded-colors: { first: #e03131, count: 1 }, loaded-name: "Red PLA" },
            { tool: 1, gate: 1, loaded-material: "PETG", loaded-colors: { first: #37b24d, count: 1 }, loaded-name: "Green PETG" },
            { tool: 2, gate: 2, loaded-material: "ABS", loaded-colors: { first: #4dabf7, count: 1 } },
            { tool: 3, gate: 3, gate-empty: true },
        ];
        // Entry, exit, extruder and toolhead are drawn on the filament path, so only the other sensors are chips.
        Printer.mmu-sensors = [
            { label: "Pre gate 0", state: "triggered" },
            { label: "Gear touch", state: "open" },
        ];
        Printer.mmu-has-buffer = true;
        Printer.mmu-path = {
            direction: 1, distance: "1712 mm", gate-label: "Gate 2",
            parts: [
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.lane, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.buffer, active: true },
                { kind: PathPartKind.bowden, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.gears, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.nozzle, active: true },
            ],
            colors: { first: #4dabf7, count: 1, longitudinal: false },
        };
        Printer.lane-path = {
            direction: 1, distance: "1712 mm", gate-label: "Gate 2",
            parts: [
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.lane, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.hub, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.buffer, active: true },
                { kind: PathPartKind.bowden, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.gears, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.sensor, active: true },
                { kind: PathPartKind.link, fill: 1 },
                { kind: PathPartKind.nozzle, active: true },
            ],
            colors: { first: #4dabf7, count: 1, longitudinal: false },
        };
        Printer.lane-buffer = "tension";
        Printer.mmu-buffer-state = "tension";
        Printer.mmu-buffer-bias = -0.9;
        Printer.mmu-flowguard-state = "ready";
    }

    public function printing() {
        self.ready-printer();
        Printer.print-state = "printing";
        Printer.job-state = "printing";
        Printer.activity = "busy";
        Printer.filename = "benchy.gcode";
        Printer.job-name = "benchy";
        Printer.progress = 0.37;
        Printer.elapsed = "45 min 12 s";
        Printer.remaining = "1 h 16 min";
        Printer.eta = "15:49";
        Printer.layers = "74 / 200";
        Printer.print-heights = "14.80 / 40.00 mm";
        Printer.filament = "1.9 / 5.2 m";
        Printer.live-velocity = 182;
        Printer.live-flow = 11.4;
        Printer.layer-pause-next = true;
        Printer.layer-pause-at = true;
        Printer.current-layer = 74;
        Printer.total-layers = 200;
        Printer.layer-pause-plan-known = true;
        Printer.layer-pause-planned = "120";
    }

    // The tool changer of the fake's `toolchanger` profile (fake-moonraker: `MachineProfile::toolchanger()`): three heads
    // T0 to T2 with their own nozzles and `fan_generic T<n>_partfan`, spools 1 and 3 on T0 and T1 (Spoolman), no MMU.
    // Call after `ready-printer()` or `printing()`: it replaces fans, heaters and the head data. T1 is mounted, so the
    // nozzle shown is the one of T1 and its fan comes first on Thermal > Fans (`fans_part_fan_first`).
    public function toolchanger() {
        Printer.has-spoolman = true;
        // The spool in use is the one of the mounted head: spool 3 on T1.
        Printer.has-spool = true;
        Printer.spool-id = 3;
        Printer.spool-tool = 1;
        Printer.spool-target = "T1";
        Printer.spool-title = "Blue PLA";
        Printer.spool-material = "PLA";
        Printer.spool-weight = "905 g";
        Printer.spool-colors = { first: #0033ff, count: 1 };
        Printer.has-toolchanger = true;
        Printer.has-drop = true;
        Printer.changer-status = "ready";
        Printer.changer-initialize-on = "first-use";
        Printer.changer-head = "T1";
        Printer.changer-head-detected = "T1";
        Printer.changer-note = "";
        Printer.nozzle-head = "T1";
        Printer.mounted-head = 1;
        Printer.heads = [
            { name: "T0", label: "T0", subtitle: "", has-nozzle: true, temperature: 24, target: 0, mounted: false, detected: false, lanes: 1, pick-up: "macro", pick-up-macro: "T0", has-spool: true, spool-title: "Red PLA", spool-material: "PLA", spool-weight: "812 g", spool-colors: { first: #ff0000, count: 1 }, spool-id: 1, spool-tool: 0, can-pick-spool: true, path: Sample.head-path },
            { name: "T1", label: "T1", subtitle: "", has-nozzle: true, temperature: 214.6, target: 215, mounted: true, detected: true, lanes: 1, pick-up: "macro", pick-up-macro: "T1", has-spool: true, spool-title: "Blue PLA", spool-material: "PLA", spool-weight: "905 g", spool-colors: { first: #0033ff, count: 1 }, spool-id: 3, spool-tool: 1, can-pick-spool: true, path: Sample.head-path },
            { name: "T2", label: "T2", subtitle: "", has-nozzle: true, temperature: 24, target: 0, mounted: false, detected: false, lanes: 1, pick-up: "macro", pick-up-macro: "T2", has-spool: false, spool-id: -1, spool-tool: 2, can-pick-spool: true, path: Sample.head-path },
        ];
        // The fake has no `[fan]` with heads (the plugin refuses it); the fan of the mounted head leads the list.
        Printer.fans = [
            { object: "fan_generic T1_partfan", label: "T1 Partfan", kind: "generic", controllable: true, speed: 50, rpm: "" },
            { object: "fan_generic T0_partfan", label: "T0 Partfan", kind: "generic", controllable: true, speed: 0, rpm: "" },
            { object: "fan_generic T2_partfan", label: "T2 Partfan", kind: "generic", controllable: true, speed: 0, rpm: "" },
            { object: "fan_generic nevermore", label: "Nevermore", kind: "generic", controllable: true, speed: 0, rpm: "" },
            { object: "fan_generic exhaust", label: "Exhaust", kind: "generic", controllable: true, speed: 60, rpm: "1680 rpm" },
            { object: "heater_fan hotend", label: "Hotend", kind: "heater", controllable: false, speed: 100, rpm: "7200 rpm" },
        ];
        Printer.heaters = [
            { object: "extruder", label: "Extruder T0", temperature: 24, target: 0, power: 0, can-raise: true, nozzle: true },
            { object: "extruder1", label: "Extruder1 T1", temperature: 214.6, target: 215, power: 0.42, can-raise: true, nozzle: true },
            { object: "extruder2", label: "Extruder2 T2", temperature: 24, target: 0, power: 0, can-raise: true, nozzle: true },
            { object: "heater_bed", label: "Heater Bed", temperature: 59.8, target: 60, power: 0.3, can-raise: true },
            { object: "heater_generic chamber", label: "Chamber", temperature: 38.2, target: 0, power: 0, can-raise: true },
        ];
    }

    // Heaters and sensors with the scale under their temperature (`TemperatureScale`): a nozzle with target, window and
    // lowest extrusion temperature, a bed in the yellow zone, an idle chamber and a sensor with its lowest and highest
    // reading. Call after `ready-printer()`: it replaces heaters and sensors.
    public function temperature-scales() {
        Printer.heaters = [
            {
                object: "extruder",
                label: "Extruder",
                temperature: 214.6,
                target: 215,
                power: 0.42,
                can-raise: true,
                nozzle: true,
                scale: {
                    shown: true,
                    min: 0,
                    max: 300,
                    has-window: true,
                    window-low: 213,
                    window-high: 217,
                    danger-from: 285,
                    target: 215,
                    min-extrude: 170,
                    level: Severity.calm,
                    max-text: "max 300 °C"
                }
            },
            {
                object: "heater_bed",
                label: "Heater Bed",
                temperature: 112,
                target: 0,
                power: 0,
                can-raise: true,
                scale: {
                    shown: true,
                    min: 0,
                    max: 120,
                    has-warning: true,
                    warning-from: 100,
                    danger-from: 110,
                    level: Severity.error,
                    max-text: "max 120 °C"
                }
            },
            {
                object: "heater_generic chamber",
                label: "Chamber",
                temperature: 38.2,
                target: 0,
                power: 0,
                can-raise: true,
                scale: {
                    shown: true,
                    min: 0,
                    max: 70,
                    has-warning: true,
                    warning-from: 60,
                    danger-from: 66,
                    level: Severity.calm,
                    max-text: "max 70 °C"
                }
            },
        ];
        Printer.sensors = [
            {
                object: "temperature_sensor raspberry_pi",
                label: "Raspberry Pi",
                temperature: 72,
                known: true,
                scale: {
                    shown: true,
                    min: 0,
                    max: 100,
                    has-warning: true,
                    warning-from: 70,
                    danger-from: 85,
                    has-measured: true,
                    measured-low: 38,
                    measured-high: 78,
                    level: Severity.attention,
                    max-text: "max 100 °C"
                }
            },
        ];
    }

    // Printers page: the active printer, a saved one in reach, one found on the network, a saved one that does not answer.
    public function printers() {
        PrinterChoice.active-name = "voron";
        PrinterChoice.printers = [
            { name: "voron", address: "http://192.168.40.6:7125", saved: true, active: true, reachability: "reachable" },
            { name: "sidewinder", address: "http://192.168.40.21:7125", saved: true, active: false, reachability: "reachable" },
            { name: "mainsailos", address: "http://192.168.40.35:7125", saved: false, active: false, reachability: "reachable" },
            { name: "ender", address: "http://192.168.40.48:7125", saved: true, active: false, reachability: "unreachable" },
        ];
    }

