// Sample data for previews (VS Code Slint preview, slint-viewer, scripts/ui-preview.sh).
// Not part of the app: nothing in app.slint imports this folder. In the app, Rust fills these globals.

import { MoveTab, Navigation, Network, Page, Printer, UiSettings } from "../state.slint";

export global Sample {
    // Connected Voron-like printer, homed, nozzle and bed at temperature, no job.
    public function ready-printer() {
        Printer.connection = "connected";
        Printer.klippy-state = "ready";
        Printer.ready = true;
        Printer.endpoint = "http://voron.local:7125";
        Printer.activity = "ready";
        Printer.homed-x = true;
        Printer.homed-y = true;
        Printer.homed-z = true;
        Printer.position-x = 150;
        Printer.position-y = 150;
        Printer.position-z = 10;
        Printer.nozzle-temperature = 214.6;
        Printer.nozzle-target = 215;
        Printer.has-bed = true;
        Printer.bed-temperature = 59.8;
        Printer.bed-target = 60;
        Printer.fans = [
            { object: "fan", label: "Part fan", kind: "part", controllable: true, speed: 40, rpm: "" },
            { object: "fan_generic nevermore", label: "Nevermore", kind: "generic", controllable: true, speed: 0, rpm: "" },
            { object: "fan_generic exhaust", label: "Exhaust", kind: "generic", controllable: true, speed: 60, rpm: "1680 rpm" },
            { object: "heater_fan hotend", label: "Hotend", kind: "heater", controllable: false, speed: 100, rpm: "7200 rpm" },
        ];
        Printer.leds = [
            { object: "neopixel chamber", label: "Chamber", on: true, level-known: true, level: 80 },
            { object: "wled enclosure", label: "Enclosure", on: true, level-known: false, level: 0 },
        ];
        Printer.led-effects = [{ name: "rainbow", label: "Rainbow", enabled: false }];
        Printer.has-light = true;
        Printer.light-name = "Chamber";
        Printer.light-on = true;
        Printer.flow-factor = { id: "flow_factor", value: "100 %", configured: "100 %", changed: false, can-reset: false };
        Printer.has-part-fan = true;
        Printer.part-fan = { object: "fan", label: "Part fan", kind: "fan", controllable: true, speed: 40, rpm: "", stalled: false };
        Printer.tuning = [
            { id: "max_velocity", value: "300 mm/s", configured: "300 mm/s", changed: false, can-reset: false },
            { id: "max_accel", value: "3500 mm/s²", configured: "3000 mm/s²", changed: true, can-reset: true },
            { id: "pressure_advance", value: "0.040", configured: "0.040", changed: false, can-reset: false },
        ];
        Printer.can-extrude = true;
        Printer.can-quad-gantry-level = true;
        Printer.has-probe = true;
        Printer.has-load-macro = true;
        Printer.has-unload-macro = true;
        Printer.has-power = true;
        Printer.has-update-manager = true;
        Printer.heaters = [
            {
                object: "extruder",
                label: "Nozzle",
                temperature: 214.6,
                target: 215,
                power: 0.42,
                can-raise: true
            },
            {
                object: "heater_bed",
                label: "Bed",
                temperature: 59.8,
                target: 60,
                power: 0.3,
                can-raise: true
            },
            {
                object: "heater_generic chamber",
                label: "Chamber",
                temperature: 38.2,
                target: 0,
                power: 0,
                can-raise: true
            },
        ];
        Printer.sensors = [
            { object: "temperature_sensor raspberry_pi", label: "Raspberry Pi", temperature: 45, known: true },
            { object: "tmc2240 stepper_x", label: "Stepper X", temperature: 0, known: false },
        ];
        Printer.filament-sensors = [
            { label: "Toolhead Runout", enabled: true, detected: true },
            { label: "Extruder Encoder", enabled: true, detected: false },
        ];
        Printer.print-start-macro = "PRINT_START";
        Printer.macros = ["PRINT_START", "PRINT_END", "LOAD_FILAMENT", "UNLOAD_FILAMENT", "PARK"];
        Printer.power-devices = [{ name: "printer", on: true, locked: true }, { name: "lights", on: false, locked: false }];
        Printer.updates = [
            { name: "klipper", version: "v0.13.0-100", detail: "20 commits behind", has-update: true },
            { name: "moonraker", version: "v0.9.3-50", detail: "v0.9.3-50", has-update: false, up-to-date: true },
            { name: "mainsail", version: "v2.14.0", detail: "v2.14.0", has-update: false, up-to-date: true },
        ];
        UiSettings.presets = [{ name: "PLA", extruder: 215, bed: 60 }, { name: "PETG", extruder: 240, bed: 80 }];
    }

    // A bed slinger like a Sidewinder X2 on the Calibrate tab: probe, both screw tools, three mesh profiles (one more
    // than fit, so the list scrolls), screws measured and a probe offset waiting for SAVE_CONFIG.
    public function calibration() {
        self.ready-printer();
        Navigation.page = Page.move;
        Navigation.move-tab = MoveTab.calibrate;
        Printer.can-quad-gantry-level = false;
        Printer.has-probe = true;
        Printer.z-calibration = "probe";
        Printer.has-bed-mesh = true;
        Printer.has-screws-tilt = true;
        Printer.has-bed-screws = true;
        Printer.bed-mesh-active = "default";
        Printer.bed-mesh-profiles = ["default", "hot-bed-100", "pei-textured"];
        Printer.screw-results = [
            { name: "back left", turns: "00:00", clockwise: true, is-base: true },
            { name: "front left", turns: "00:18", clockwise: true },
            { name: "front right", turns: "01:05", clockwise: false },
            { name: "back right", turns: "00:02", clockwise: true },
        ];
        Printer.save-config-pending = true;
        Printer.pending-config = "probe: z_offset = 1.800 · bed_mesh default: 8 values";
    }

    // AFC with four lanes (one empty), tools mapped to them and a hub that two of the lanes can be pulled back out of.
    public function afc() {
        self.ready-printer();
        Printer.has-afc = true;
        Printer.has-lanes = true;
        Printer.afc-state = "Idle";
        Printer.mmu-gates = [
            { title: "lane1", index: -1, availability: "available", name: "Red PLA", material: "PLA", colors: { first: #e03131, count: 1 }, has-color: true, tools: "T0", group: -1, selected: true },
            { title: "lane2", index: -1, availability: "available", name: "Green PETG", material: "PETG", colors: { first: #37b24d, count: 1 }, has-color: true, tools: "T1", group: -1, selected: false },
            { title: "lane3", index: -1, availability: "available", name: "", material: "ABS", colors: { first: #4dabf7, count: 1 }, has-color: true, tools: "T2", group: -1, selected: false },
            { title: "lane4", index: -1, availability: "empty", name: "", material: "", colors: { first: #000000 }, has-color: false, tools: "T3", group: -1, selected: false },
        ];
        Printer.afc-tools = [
            { tool: 0, lane: "lane1", lane-row: 0 },
            { tool: 1, lane: "lane2", lane-row: 1 },
            { tool: 2, lane: "lane3", lane-row: 2 },
            { tool: 3, lane: "lane4", lane-row: 3 },
        ];
        Printer.afc-hub-returns = [
            { lane: "lane1", unit: "Turtle_1", enabled: false, reason: "Unload lane1 first" },
            { lane: "lane2", unit: "Turtle_1", enabled: true, reason: "" },
            { lane: "lane3", unit: "Turtle_1", enabled: true, reason: "" },
        ];
    }

    // Ready printer with a job at 37 %.
    // Happy Hare with four gates, one of them empty, and a sync-feedback buffer in tension.
    public function mmu() {
        self.ready-printer();
        Printer.has-mmu = true;
        Printer.has-lanes = true;
        Printer.mmu-gate-map-local = true;
        Printer.mmu-homed = true;
        Printer.mmu-filament = "unloaded";
        Printer.mmu-action = "Idle";
        Printer.mmu-gate = 0;
        Printer.mmu-tool = 0;
        Printer.mmu-gates = [
            { title: "Gate 0", index: 0, availability: "available", name: "Red PLA", material: "PLA", colors: { first: #e03131, count: 1 }, has-color: true, tools: "T0", group: 0, selected: true },
            { title: "Gate 1", index: 1, availability: "available", name: "Green PETG", material: "PETG", colors: { first: #37b24d, count: 1 }, has-color: true, tools: "T1", group: 1, selected: false },
            { title: "Gate 2", index: 2, availability: "buffered", name: "", material: "ABS", colors: { first: #4dabf7, count: 1 }, has-color: true, tools: "T2", group: 2, selected: false },
            { title: "Gate 3", index: 3, availability: "empty", name: "", material: "", colors: { first: #000000 }, has-color: false, tools: "T3", group: 3, selected: false },
        ];
        Printer.mmu-pages = [{ first-row: 0, count: 4, bypass: true, unit: "", head: "", first-gate: 0, last-gate: 3 }];
        Printer.mmu-page-ranges = [{ first: 0, count: 1, start: 0 }];
        Printer.mmu-tools = [
            { tool: 0, gate: 0, loaded-material: "PLA", loaded-colors: { first: #e03131, count: 1 }, loaded-name: "Red PLA" },
            { tool: 1, gate: 1, loaded-material: "PETG", loaded-colors: { first: #37b24d, count: 1 }, loaded-name: "Green PETG" },
            { tool: 2, gate: 2, loaded-material: "ABS", loaded-colors: { first: #4dabf7, count: 1 } },
            { tool: 3, gate: 3, gate-empty: true },
        ];
        // Entry, exit, extruder and toolhead are drawn on the filament path, so only the other sensors are chips.
        Printer.mmu-sensors = [
            { label: "Pre gate 0", state: "triggered" },
            { label: "Gear touch", state: "open" },
        ];
        Printer.mmu-has-buffer = true;
        Printer.mmu-path = {
            bowden-progress: -1, position: 10, direction: 1, distance: "1712.4 mm", gate-label: "Gate 2",
            gate-entry-sensor: 1, gate-sensor: 1, hub-sensor: -1, extruder-sensor: 1, toolhead-sensor: 1,
            colors: { first: #4dabf7, count: 1, longitudinal: false },
        };
        Printer.lane-path = {
            bowden-progress: -1, position: 10, direction: 1, distance: "1712.4 mm", gate-label: "Gate 2",
            gate-entry-sensor: 1, gate-sensor: 1, hub-sensor: 1, extruder-sensor: 1, toolhead-sensor: 1,
            colors: { first: #4dabf7, count: 1, longitudinal: false },
        };
        Printer.lane-buffer = "tension";
        Printer.mmu-buffer-state = "tension";
        Printer.mmu-buffer-bias = -0.9;
        Printer.mmu-flowguard-state = "ready";
    }

    public function printing() {
        self.ready-printer();
        Printer.print-state = "printing";
        Printer.activity = "busy";
        Printer.filename = "benchy.gcode";
        Printer.job-name = "benchy";
        Printer.progress = 0.37;
        Printer.elapsed = "45:12";
        Printer.remaining = "1:16:40";
        Printer.eta = "15:49";
        Printer.layers = "74 / 200";
        Printer.print-heights = "14.80 / 40.0 mm";
        Printer.filament = "1.92 / 5.20 m";
        Printer.live-velocity = 182;
        Printer.live-flow = 11.4;
        Printer.layer-pause-next = true;
        Printer.layer-pause-at = true;
        Printer.current-layer = 74;
        Printer.total-layers = 200;
        Printer.layer-pause-plan-known = true;
        Printer.layer-pause-planned = "120";
    }

    // Network tab of a printer host managed with NetworkManager.
    public function managed-network() {
        Network.managed = true;
        Network.local = true;
        Network.wifi-present = true;
        Network.wifi-enabled = true;
        Network.active-ssid = "Workshop";
        Network.wifi-address = "192.168.1.57";
        Network.networks = [
            {
                ssid: "Workshop",
                bars: 3,
                secured: true,
                supported: true,
                known: true,
                active: true,
                in-range: true
            },
            {
                ssid: "Cafe Guest",
                bars: 2,
                secured: false,
                supported: true,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Garage",
                bars: 2,
                secured: true,
                supported: true,
                known: true,
                active: false,
                in-range: true
            },
            {
                ssid: "Office",
                bars: 1,
                secured: true,
                supported: false,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Neighbour",
                bars: 1,
                secured: true,
                supported: true,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Holiday Flat",
                bars: 0,
                secured: false,
                supported: true,
                known: true,
                active: false,
                in-range: false
            },
        ];
        Network.wired = [{ interface: "eth0", cable: true, connected: true, address: "192.168.1.42" }];
        Navigation.page = Page.network;
    }
}
