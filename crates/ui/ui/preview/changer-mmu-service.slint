// Preview: Service tab of an ERCF with a servo selector, not homed after the motors were off. Open in the Slint
// preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { ChangerTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component ChangerMmuServicePreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.changer;
        Navigation.changer-tab = ChangerTab.service;
        Printer.mmu-homed = false;
        Printer.mmu-servo = "up";
        Printer.mmu-action = "Homing";
    }
}
