// Preview: dialog of a gate with Spoolman that has no spool of it (the filament is not kept in Spoolman) and no colour:
// the bar is drawn in the accent colour as a generic filament, and material and colour can be set in Happy Hare's gate
// map. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, MmuDialogs, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuGateNoSpoolPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.gates;
        Printer.has-spoolman = true;
        Printer.mmu-gates = [
            { title: "Gate 0", index: 0, availability: "available", name: "Red", material: "ABS+", colors: { first: #e31f2b, count: 1 }, has-color: true, tools: "T0", selected: true, spool-text: "613 g", spool-low: false, spool-id: 18 },
            { title: "Gate 1", index: 1, availability: "available", name: "", material: "", colors: { first: #000000, count: 0 }, has-color: false, tools: "T1", selected: false, spool-text: "", spool-low: false, spool-id: -1 },
            { title: "Gate 2", index: 2, availability: "available", name: "", material: "PETG", colors: { first: #26a69a, count: 1 }, has-color: true, tools: "T2", selected: false, spool-text: "", spool-low: false, spool-id: -1 },
            { title: "Gate 3", index: 3, availability: "empty", name: "", material: "", colors: { first: #000000, count: 0 }, has-color: false, tools: "T3", selected: false, spool-text: "", spool-low: false, spool-id: -1 },
        ];
        MmuDialogs.gate-row = 1;
    }
}
