// Preview: the temporary dialog for the standby times on the Settings page. Open in the Slint preview or render with
// scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { ScreenOffDialog } from "../pages/settings.slint";
import { Backlight, Navigation, Page } from "../state.slint";
import { Sample } from "sample.slint";

export component SettingsScreenOffPreview inherits AppWindow {
    ScreenOffDialog { open: true; }

    init => {
        Sample.ready-printer();
        Backlight.available = true;
        Backlight.idle-minutes = 5;
        Navigation.page = Page.settings;
    }
}
