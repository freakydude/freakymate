// Preview: dialog of an AFC lane without a spool of Spoolman: material, colour and the nozzle temperature AFC loads it
// at are set in the lane. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { FilamentTab, MmuDialogs, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentAfcLaneDialogPreview inherits AppWindow {
    init => {
        Sample.afc();
        Navigation.page = Page.filament;
        Navigation.filament-tab = FilamentTab.gates;
        Printer.has-spoolman = false;
        MmuDialogs.gate-row = 1;
    }
}
