      "type": "lldb",
      "request": "launch",
      "name": "debug: freakymate (fake Moonraker)",
      "cargo": {
        "args": [
          "build",
          "-p",
          "freakymate",
          "--bin",
          "freakymate"
        ]
      },
      "args": [
        "--moonraker",
        "http://127.0.0.1:7125"
