{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop: fake-moonraker",
      "type": "shell",
      "command": "pkill -f '[f]ake-moonraker.*--port 7125'; true",
      "problemMatcher": []
    },
    {
      "label": "run: fake-moonraker",
      "type": "shell",
      "command": "cargo run -p fake-moonraker -- --port 7125 --time-scale 10 --profile voron",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "^.*(Compiling|Finished|Running).*$",
          "endsPattern": "^Fake-Moonraker listening.*$"
        }
      }
    },
