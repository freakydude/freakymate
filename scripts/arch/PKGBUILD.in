# Packages the prebuilt binary, nothing is compiled. Placeholders (@...@) are filled in by .github/scripts/build-arch.sh.
# Maintainer: Frank Roth <developer@freakydu.de>
pkgname=sailhand
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Touch screen UI for Klipper printers via Moonraker (experimental)'
arch=('@ARCH@')
url='https://github.com/freakydude/sailhand'
license=('GPL-3.0-or-later')
depends=(@DEPENDS@)
optdepends=('networkmanager: Wi-Fi settings')
options=('!strip' '!debug')
install=sailhand.install

# FM_ARTIFACT (folder with the binary) and FM_REPO (repository checkout) come from the environment.
package() {
  install -D -m 0755 "$FM_ARTIFACT/sailhand" "$pkgdir/usr/bin/sailhand"
  install -D -m 0644 "$FM_REPO/scripts/debian/sailhand@.service" "$pkgdir/usr/lib/systemd/system/sailhand@.service"
  install -D -m 0644 "$FM_REPO/scripts/polkit/50-sailhand.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-sailhand.rules"
  install -D -m 0644 "$FM_REPO/scripts/udev/70-sailhand-backlight.rules" "$pkgdir/usr/lib/udev/rules.d/70-sailhand-backlight.rules"
  install -D -m 0644 "$FM_REPO/LICENSE" "$pkgdir/usr/share/licenses/sailhand/LICENSE"
  install -D -m 0644 "$FM_ARTIFACT/THIRD-PARTY-LICENSES.html" "$pkgdir/usr/share/licenses/sailhand/THIRD-PARTY-LICENSES.html"
  install -D -m 0644 "$FM_REPO/scripts/debian/sailhand.desktop" "$pkgdir/usr/share/applications/sailhand.desktop"
  install -D -m 0644 "$FM_REPO/assets/logo/sailhand.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sailhand.svg"
  local size
  for size in 16 24 32; do
    install -D -m 0644 "$FM_REPO/assets/logo/sailhand-small.svg" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/sailhand.svg"
  done
}
