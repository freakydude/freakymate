[Unit]
Description=FreakyMate touch UI for Klipper (user %i)
After=systemd-user-sessions.service network-online.target moonraker.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
Environment=XDG_RUNTIME_DIR=/run/user/%U
# -d: no client-side frame, otherwise winit keeps room for its title bar after leaving fullscreen (black bar).
ExecStart=/usr/bin/cage -d -s -- /usr/bin/freakymate --fullscreen --settings /home/%i/printer_data/config/freakymate.json --logfile /home/%i/printer_data/logs/freakymate.log
Restart=always
RestartSec=5

[Install]
# Klipper hosts run multi-user.target without a desktop; graphical.target is never reached there.
WantedBy=multi-user.target
